{
  "path": ["core", "feature", "shared", "android", "androidApp", "iosApp/Sources", "webApp/src"],
  "format": ["kotlin", "swift", "typescript", "tsx"],
  "minTokens": 70,
  "ignore": [
    "**/build/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/Generated/**",
    "**/*.kts",
    "**/commonTest/**",
    "**/jvmTest/**",
    "**/*Test.kt",
    "**/*Tests.swift",
    "**/*.test.ts",
    "**/*.test.tsx",
    "core/*/testing/**"
  ],
  "gitignore": true,
  "absolute": true,
  "reporters": ["json"],
  "output": "build/jscpd",
  "silent": true
}
