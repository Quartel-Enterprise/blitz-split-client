{
  "path": ["core", "feature", "shared", "android", "androidApp", "iosApp/Sources", "iosApp/Watch", "iosApp/Widgets", "webApp/src"],
  "format": ["kotlin", "swift", "tsx"],
  "formatsExts": { "tsx": ["ts", "tsx"] },
  "minTokens": 70,
  "ignore": [
    "**/build/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/Generated/**",
    "**/*.kts",
    "**/commonTest/**",
    "**/jvmTest/**",
    "**/*Test.kt",
    "**/*Tests.swift",
    "**/*.test.ts",
    "**/*.test.tsx",
    "core/*/testing/**"
  ],
  "gitignore": true,
  "silent": true
}
