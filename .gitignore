# Gradle and Kotlin
.gradle
.kotlin
**/build/
!src/**/build/
/build-logic/convention/bin/
local.properties

# Firebase: each app starts it only when its file is there (docs/crash-reporting.md)
androidApp/google-services.json
iosApp/Resources/GoogleService-Info.plist

# IDEs
.idea/
*.iml
.vscode/
.DS_Store
captures/
.externalNativeBuild
.cxx

# Xcode (iosApp/.gitignore also ignores the XcodeGen output)
xcuserdata/
*.xcappdata
**/*.mobileprovision
**/*.provisionprofile
**/*.p12
**/*.cer
**/*.certSigningRequest

# Web (webApp/.gitignore covers its own build)
node_modules/
.vite/

# Claude Code: skills and launch.json are versioned, the rest is local
.claude/worktrees/
.claude/memory/
.claude/settings.json
.claude/settings.local.json

# Store listing screenshots: generated, never versioned (docs/store-listing-screenshots.md)
/store_listings/
/fastlane/screenshots/
/fastlane/screenshots-mac/
/fastlane/metadata/android/*/images/
/fastlane/report.xml
