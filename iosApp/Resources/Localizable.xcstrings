        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čistý zůstatek už vzájemně započítává skupiny: Požádat o platbu a Zaplaceno mi použijí %@. Aplikace zaznamená platbu v každé skupině."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettobeløbet udligner allerede grupperne: Bed om betaling og Fik betaling bruger %@. Appen registrerer en betaling i hver gruppe."
