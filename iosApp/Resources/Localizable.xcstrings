        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ și-a simplificat datoriile, așa că în loc să-i plătești lui %@, îmi plătești direct mie; totalul tău nu s-a schimbat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В группе %@ упростили долги, поэтому вместо того чтобы платить участнику %@, ты платишь мне напрямую; твоя сумма не изменилась."
          }
