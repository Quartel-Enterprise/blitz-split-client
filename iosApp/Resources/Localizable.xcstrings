    "Whoever is left at %@ is out of the bill." : {
      "comment" : "Hint of the split by amount; %@ is zero in the currency",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يبقى عند %@ يكون خارج الفاتورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer bei %@ bleibt, ist nicht in der Ausgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se queda con %@ sale del gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque reste à %@ n’est pas dans la dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שנשאר על %@ לא נכלל בחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिसकी रकम %@ रहेगी, वह इस खर्च से बाहर रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dibiarkan %@ tidak ikut tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi resta a %@ è fuori dalla spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のままの人は、この支出の対象外になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금액을 %@ 그대로 둔 사람은 지출에서 제외돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie op %@ blijft staan, doet niet mee met de uitgave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto zostanie z kwotą %@, będzie poza wydatkiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem fica com %@ sai da conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, у кого осталось %@, не участвуют в счёте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ยังเป็น %@ จะไม่อยู่ในบิล"
