    "Add it and bills with this word in their title arrive with the right category." : {
      "comment" : "Category map search",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفه لتصل الفواتير التي تحتوي هذه الكلمة في عنوانها بالفئة الصحيحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ihn hinzu, und Ausgaben mit diesem Wort im Titel kommen mit der richtigen Kategorie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelo y los gastos con esa palabra en el título llegarán con la categoría correcta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute-le et les dépenses avec ce mot dans leur titre arrivent avec la bonne catégorie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף אותו, וחשבונות עם המילה הזו בכותרת יגיעו עם הקטגוריה הנכונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे जोड़ें, फिर जिन खर्चों के टाइटल में यह शब्द होगा वे सही श्रेणी के साथ आएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan, dan tagihan dengan kata ini di judulnya akan masuk ke kategori yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungilo e le spese con questa parola nel titolo arriveranno con la categoria giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加すると、タイトルにこの単語を含む支出に正しいカテゴリが付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하면 제목에 이 단어가 있는 지출이 알맞은 카테고리로 들어가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hem toe en uitgaven met dit woord in de titel krijgen meteen de juiste categorie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj je, a wydatki z tym słowem w tytule dostaną właściwą kategorię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione e as contas com essa palavra no título já chegam com a categoria certa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona e as contas com essa palavra no título já chegam com a categoria certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь его, и счета с этим словом в названии будут сразу в нужной категории."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มคำนี้ แล้วบิลที่มีคำนี้ในชื่อจะได้หมวดหมู่ที่ถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekle, başlığında bu kelime geçen harcamalar doğru kategoriyle gelsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай його, і рахунки з цим словом у назві отримуватимуть правильну категорію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm vào và các khoản chi có từ này trong tiêu đề sẽ có đúng danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加后，标题中含有这个词的账单会自动归入正确的类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增後，標題中含有這個詞的帳單會自動歸入正確的類別。"
          }
        }
      }
    },
