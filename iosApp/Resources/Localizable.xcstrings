    "No word of your map. The bill stays in Other; tap the icon to pick one." : {
      "comment" : "Under a bill's description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Wort deiner Zuordnung. Die Ausgabe bleibt in „Sonstiges“; tippe auf das Symbol, um eine zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna palabra de tu mapa. El gasto queda en Otros; toca el ícono para elegir una."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna palabra de tu mapa. El gasto queda en Otros; toca el icono para elegir una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mot de ta carte. La dépense reste dans Autre ; touche l’icône pour en choisir un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada kata dari petamu. Tagihan tetap di Lainnya; ketuk ikon untuk memilih kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna parola della tua mappa. La spesa resta in Altro; tocca l’icona per sceglierne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップの単語がありません。支出は「その他」のままです。アイコンをタップして選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 키워드에 해당하는 단어가 없어요. 지출은 기타에 남아요. 아이콘을 탭해서 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen woord uit je kaart. De uitgave blijft in Overig; tik op het icoon om er een te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak słowa z twojej mapy. Wydatek zostaje w kategorii Inne; stuknij ikonę, aby wybrać kategorię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma palavra do seu mapa. A conta fica em Outros; toque no ícone para escolher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma palavra do teu mapa. A conta fica em Outros; toca no ícone para escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одного слова из твоей карты. Счёт остаётся в «Другое»; нажми на значок, чтобы выбрать категорию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritanda kelime yok. Harcama Diğer'de kalır; birini seçmek için simgeye dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодного слова з твоєї мапи. Рахунок залишається в «Інше»; торкнись значка, щоб обрати категорію."
          }
        }
      }
    },
