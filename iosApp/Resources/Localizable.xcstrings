    },
    "Whoever pays you sees your full CPF. If you'd rather not share it, use a phone, email or random key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer dich bezahlt, sieht deine vollständige CPF. Wenn du sie lieber nicht teilen willst, nutze Telefon, E-Mail oder einen Zufallsschlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa celular, correo o clave aleatoria."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa móvil, correo o clave aleatoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui te paie voit ton CPF en entier. Si tu préfères ne pas le partager, utilise une clé téléphone, e-mail ou aléatoire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang membayarmu melihat CPF-mu secara lengkap. Kalau tidak mau membagikannya, pakai kunci telepon, email, atau acak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ti paga vede il tuo CPF completo. Se preferisci non condividerlo, usa una chiave telefono, email o casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う人にはCPFがすべて表示されます。共有したくない場合は、電話番号、メール、ランダムキーを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나에게 송금하는 사람은 CPF 전체를 봐요. 공유하고 싶지 않다면 전화번호, 이메일 또는 랜덤 키를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jou betaalt, ziet je volledige CPF. Wil je die liever niet delen, gebruik dan een telefoon-, e-mail- of willekeurige sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto ci płaci, widzi twój pełny numer CPF. Jeśli wolisz go nie udostępniać, użyj klucza telefonu, e-maila lub losowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem for te pagar vê o CPF completo. Se preferir não expor, use celular, e-mail ou chave aleatória."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem te pagar vê o teu CPF completo. Se preferires não o expor, usa telemóvel, e-mail ou chave aleatória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, кто тебе платит, видят твой полный CPF. Если не хочешь им делиться, используй телефон, эл. почту или случайный ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ödeme yapan kişi CPF'nin tamamını görür. Paylaşmak istemiyorsan telefon, e-posta veya rastgele anahtar kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той, хто тобі платить, бачить твій повний CPF. Якщо не хочеш ним ділитися, використай телефон, email або випадковий ключ."
          }
        }
      }
    },
    "Whole numbers only. The leftover cents go to whoever paid." : {
      "comment" : "Hint of the split by percentage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ganze Zahlen. Die restlichen Cent gehen an die Person, die bezahlt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo números enteros. Los centavos que sobran se quedan con quien pagó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombres entiers uniquement. Les centimes restants vont à la personne qui a payé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya bilangan bulat. Sisa sennya untuk yang membayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo numeri interi. I centesimi avanzati vanno a chi ha pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整数のみ。端数は支払った人に回ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정수만 입력할 수 있어요. 남는 잔돈은 낸 사람 몫이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen hele getallen. De resterende centen gaan naar wie heeft betaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
