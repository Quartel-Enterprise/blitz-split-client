        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் ஃபோனில் இருப்பதைப் பார்த்தோம். உங்கள் குழுக்கள் ஏற்கனவே அங்கே உள்ளன, ஆப்பைப் பதிவிறக்கும் அழைப்பு இனி காட்டப்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
