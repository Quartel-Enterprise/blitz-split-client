    "The watch syncs on its own, even away from your iPhone." : {
      "comment" : "Apple Watch, connected (15.11)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتزامن الساعة تلقائيًا، حتى بعيدًا عن iPhone."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часовникът се синхронизира сам, дори далеч от iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘড়ি নিজেই সিঙ্ক হয়, iPhone থেকে দূরে থাকলেও।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rellotge se sincronitza sol, fins i tot lluny del teu iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodinky se synchronizují samy, i daleko od iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uret synkroniserer af sig selv, også væk fra din iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr synchronisiert von selbst, auch fern vom iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ρολόι συγχρονίζεται μόνο του, ακόμη και μακριά από το iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj se sincroniza solo, incluso lejos del iPhone."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kell sünkroonib ise, ka iPhone’ist eemal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعت خودش همگام‌سازی می‌کند، حتی دور از iPhone شما."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kello synkronoi itsenäisesti, myös iPhonen ollessa kaukana."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusang nagsi-sync ang watch, kahit malayo sa iPhone mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La montre se synchronise seule, même loin de ton iPhone."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વૉચ આપમેળે સિંક થાય છે, તમારા iPhone થી દૂર હોય ત્યારે પણ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השעון מסתנכרן לבד, גם רחוק מה-iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉच अपने आप सिंक होती है, iPhone से दूर होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat se sinkronizira sam, čak i daleko od iPhonea."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az óra magától szinkronizál, az iPhone-tól távol is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam tangan menyinkronkan sendiri, bahkan saat jauh dari iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’orologio si sincronizza da solo, anche lontano dall’iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneから離れても、ウォッチは自動で同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone과 떨어져 있어도 워치가 알아서 동기화돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikrodis sinchronizuojasi pats, net toli nuo iPhone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulkstenis sinhronizējas pats, pat tad, ja iPhone nav tuvumā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या iPhone पासून दूर असतानाही वॉच आपोआप सिंक होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam tangan menyegerak sendiri, walaupun jauh dari iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klokken synkroniserer av seg selv, også når du er unna iPhonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het horloge synchroniseert vanzelf, ook ver van je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegarek synchronizuje się sam, nawet z dala od iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio sincroniza sozinho, mesmo longe do iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceasul se sincronizează singur, chiar și departe de iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы синхронизируются сами, даже вдали от iPhone."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodinky sa synchronizujú samy, aj keď sú ďaleko od iPhonu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ura se sinhronizira sama, tudi stran od iPhona."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat se sam sinhronizuje, čak i kad je daleko od iPhone-a."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klockan synkroniserar själv, även långt från din iPhone."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saa inasawazisha yenyewe, hata ikiwa mbali na iPhone yako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் iPhone அருகில் இல்லாவிட்டாலும், வாட்ச் தானாகவே ஒத்திசைக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ iPhoneకి దూరంగా ఉన్నా వాచ్ దానంతట అదే సింక్ అవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาฬิกาซิงค์เอง แม้อยู่ห่างจาก iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat, iPhone'dan uzaktayken bile kendi kendine eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годинник синхронізується сам, навіть далеко від iPhone."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واچ خود سے سنک ہوتی ہے، iPhone سے دور ہونے پر بھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng hồ tự đồng bộ, kể cả khi ở xa iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表会自动同步，即使远离iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手錶會自動同步，即使遠離iPhone。"
          }
        }
