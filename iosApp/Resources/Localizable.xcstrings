    "Type the code your watch shows. It signs in to your account and then syncs on its own." : {
      "comment" : "Connect watch: what the sheet does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب الرمز الظاهر على ساعتك. ستسجّل الساعة الدخول إلى حسابك ثم تتزامن تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведи кода, който показва часовникът ти. Той влиза в акаунта ти и после се синхронизира сам."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ঘড়িতে দেখানো কোডটি লিখুন। ঘড়িটি আপনার অ্যাকাউন্টে সাইন ইন করবে এবং তারপর নিজে থেকেই সিঙ্ক হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escriu el codi que mostra el teu rellotge. Inicia la sessió al teu compte i després se sincronitza sol."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadej kód, který ukazují hodinky. Přihlásí se k tvému účtu a pak se budou synchronizovat samy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv koden, som dit ur viser. Det logger ind på din konto og synkroniserer derefter af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den Code ein, den deine Uhr anzeigt. Sie meldet sich bei deinem Konto an und synchronisiert dann von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολόγησε τον κωδικό που δείχνει το ρολόι σου. Συνδέεται στον λογαριασμό σου και μετά συγχρονίζεται μόνο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el código que muestra tu reloj. Inicia sesión en tu cuenta y luego se sincroniza solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisesta kood, mida sinu kell näitab. See logib sinu kontole sisse ja sünkroonib seejärel ise."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
