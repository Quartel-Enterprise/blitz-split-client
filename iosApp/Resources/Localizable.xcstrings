          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi tentativi. Aspetta qualche minuto e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
