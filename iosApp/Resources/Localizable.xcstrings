          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sceglie il proprio nome dalla lista o entra come nuovo membro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はリストから自分の名前を選ぶか、新しいメンバーとして参加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 목록에서 자기 이름을 고르거나 새 멤버로 참여해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kiest de eigen naam in de lijst of wordt lid als nieuw lid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wybierze swoje imię z listy albo dołączy jako nowy członek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ escolhe o nome na lista ou entra como membro novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ выбирает своё имя в списке или присоединяется как новый участник."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เลือกชื่อของตัวเองในรายการ หรือเข้าร่วมเป็นสมาชิกใหม่"
