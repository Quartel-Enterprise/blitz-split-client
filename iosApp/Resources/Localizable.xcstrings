    "Want to comment? Sign in with an account. You don't need to be in the group." : {
      "comment" : "A bill's link page, in the composer's place while nobody is signed in",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد التعليق؟ سجّل الدخول بحساب. لا يلزم أن تكون في المجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искаш да коментираш? Влез с акаунт. Не е нужно да си в групата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মন্তব্য করতে চান? অ্যাকাউন্ট দিয়ে সাইন ইন করুন। গ্রুপে থাকার দরকার নেই।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš komentovat? Přihlas se účtem. Ve skupině být nemusíš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du kommentieren? Melde dich mit einem Konto an. Du musst nicht in der Gruppe sein."
