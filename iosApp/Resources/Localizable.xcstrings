    "Allow camera access in Settings to take a photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الكاميرا في الإعدادات لالتقاط صورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff in den Einstellungen, um ein Foto aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en Ajustes para tomar una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’accès à l’appareil photo dans les Réglages pour prendre une photo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לצלם, יש לאשר גישה למצלמה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो लेने के लिए सेटिंग में कैमरा एक्सेस की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses kamera di Pengaturan untuk mengambil foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso alla fotocamera nelle Impostazioni per scattare una foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮るには、設定でカメラへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍으려면 설정에서 카메라 접근을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta cameratoegang toe in Instellingen om een foto te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do aparatu w Ustawieniach, aby zrobić zdjęcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à câmera nos Ajustes para tirar uma foto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite o acesso à câmara nas Definições para tirar uma fotografia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши доступ к камере в Настройках, чтобы сделать фото."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการเข้าถึงกล้องในการตั้งค่าเพื่อถ่ายรูป"
          }
        },
        "tr" : {
