    "Everything added for you shows up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was für dich hinzugefügt wird, erscheint hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se añada para ti aparece aquí."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se añada para ti aparece aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui est ajouté pour toi s’affiche ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
