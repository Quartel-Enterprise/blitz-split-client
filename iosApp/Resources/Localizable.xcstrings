    "“%@” already picks %@. Each term has one category." : {
      "comment" : "New term",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wählt schon %2$@. Jeder Begriff hat eine Kategorie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ya elige %2$@. Cada término tiene una sola categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » choisit déjà %2$@. Chaque terme a une seule catégorie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sudah memilih %@. Setiap istilah punya satu kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sceglie già %@. Ogni termine ha una sola categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでに%@に設定されています。各キーワードのカテゴリは1つです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” valt al onder %@. Elke term heeft één categorie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” już wybiera kategorię %2$@. Każde słowo ma jedną kategorię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” já escolhe %2$@. Cada termo tem uma categoria só."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” zaten şunu seçiyor: %@. Her terimin tek bir kategorisi olur."
          }
        }
      }
    },
    "“%@” can only be deleted once everyone has settled up." : {
      "comment" : "Why the group can't be deleted yet; %@ is the group's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann erst gelöscht werden, wenn alle beglichen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” solo se puede eliminar cuando todos hayan saldado cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut être supprimé que quand tout le monde a réglé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” baru bisa dihapus setelah semua orang lunas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» si può eliminare solo quando tutti hanno saldato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は全員が精算してからでないと削除できません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kan pas worden verwijderd als iedereen alles heeft verrekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” można usunąć dopiero, gdy wszyscy się rozliczą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” só pode ser apagado quando todo mundo tiver acertado."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ancak herkes hesaplaştığında silinebilir."
          }
        }
      }
    },
    "“%@” leaves the group and everyone's share of it stops counting." : {
      "comment" : "Body of the confirmation before deleting a bill; %@ is its description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verschwindet aus der Gruppe, und die Anteile aller daran zählen nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sale del grupo y la parte de cada persona en este gasto deja de contar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » quitte le groupe et la part de chacun n’est plus comptée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” keluar dari grup dan bagian semua orang di dalamnya tidak dihitung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» esce dal gruppo e la parte di ciascuno smette di contare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はグループから削除され、全員の負担分も計算されなくなります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verdwijnt uit de groep en ieders deel ervan telt niet meer mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” zniknie z grupy, a udział każdej osoby przestanie się liczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sai do grupo e a parte de cada um nesta conta deixa de contar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gruptan çıkar ve herkesin bu harcamadaki payı artık sayılmaz."
          }
        }
      }
    },
