    "Only you see these. Mark which one you paid a bill with." : {
      "comment" : "Under Profile's payment methods",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يراها أحد غيرك. حدّد أيها استخدمت لدفع فاتورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само ти ги виждаш. Отбележи с кой от тях е платен даден разход."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এগুলো শুধু আপনি দেখতে পাবেন। কোন বিল কোনটি দিয়ে পরিশোধ করেছেন তা চিহ্নিত করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només els veus tu. Marca amb quin has pagat una despesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidíš je jen ty. Označ, kterým jsi výdaj zaplatil(a)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun du kan se dem. Markér, hvilken du betalte en udgift med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst sie. Markiere, womit du eine Ausgabe bezahlt hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τους βλέπεις μόνο εσύ. Σημείωσε με ποιον πλήρωσες ένα έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú los ves. Marca con cuál pagaste cada gasto."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú los ves. Marca con cuál has pagado cada gasto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neid näed ainult sina. Märgi, millega kulu maksid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط شما این‌ها را می‌بینید. مشخص کنید هر هزینه را با کدام پرداخت کرده‌اید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sinä näet nämä. Merkitse, millä maksoit kulun."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikaw lang ang nakakakita nito. Markahan kung alin ang ginamit mong pambayad sa bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous seul les voyez. Indiquez avec lequel vous avez payé chaque dépense."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ફક્ત તમે જ જુઓ છો. કોઈ ખર્ચ તમે કઈ પદ્ધતિથી ચૂકવ્યો તે માર્ક કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק לך הם גלויים. אפשר לסמן באיזה מהם שולם חשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें सिर्फ़ आप देखते हैं। बताएं कि आपने किसी खर्च का भुगतान किससे किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo ti ih vidiš. Označi kojim je plaćen trošak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeket csak te látod. Jelöld meg, melyikkel fizettél egy számlát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya kamu yang melihatnya. Tandai metode yang kamu pakai untuk membayar tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li vedi solo tu. Segna con quale hai pagato ogni spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなただけに表示されます。どの方法で支払ったかを支出に記録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만 볼 수 있어요. 어떤 수단으로 지출을 결제했는지 표시하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juos matai tik tu. Pažymėk, kuriuo apmokėjai išlaidą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tos redzi tikai tu. Atzīmē, ar kuru veidu samaksāji rēķinu."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या फक्त तुम्हाला दिसतात. खर्चाचे पैसे कोणत्या पद्धतीने दिले ते चिन्हांकित करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya anda yang melihat ini. Tandakan kaedah yang anda gunakan untuk membayar bil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare du ser disse. Marker hvilken du betalte en utgift med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen jij ziet ze. Geef aan waarmee je een uitgave betaalde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzisz je tylko Ty. Zaznaczaj, czym płacisz za wydatki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você vê. Marque com qual pagou cada conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
