    "Point your iPhone's camera at the code. It opens the App Store." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجّه كاميرا iPhone نحو الرمز. سيفتح App Store."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насочи камерата на iPhone към кода. Ще отвори App Store."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iPhone-এর ক্যামেরা কোডটির দিকে ধরুন। App Store খুলে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiř fotoaparát iPhonu na kód. Otevře se App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera deines iPhone auf den Code. Er öffnet den App Store."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψε την κάμερα του iPhone στον κωδικό. Ανοίγει το App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara del iPhone al código. Abre la App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوربین iPhone خود را به سمت کد بگیرید. App Store را باز می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itutok ang camera ng iPhone mo sa code. Magbubukas ito ng App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointe l’appareil photo de ton iPhone vers le code. Il ouvre l’App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לכוון את המצלמה של ה-iPhone אל הקוד. הוא פותח את ה-App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने iPhone का कैमरा कोड की ओर करें। इससे App Store खुलेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmjeri kameru iPhonea prema kodu. Otvorit će se App Store."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irányítsd az iPhone-od kameráját a kódra. Megnyitja az App Store-t."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan kamera iPhone ke kode. App Store akan terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice con la fotocamera dell’iPhone. Si apre l’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
