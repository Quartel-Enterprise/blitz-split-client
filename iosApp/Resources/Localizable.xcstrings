    "%@ just joined from another device" : {
      "comment" : "Someone else joined as the member just picked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade von einem anderen Gerät beigetreten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acaba de entrar desde otro dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vient de rejoindre depuis un autre appareil"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ baru saja bergabung dari perangkat lain"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha appena aderito da un altro dispositivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が別のデバイスから参加しました"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is net lid geworden vanaf een ander apparaat"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ właśnie dołączył(a) z innego urządzenia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acabou de entrar por outro aparelho"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ az önce başka bir cihazdan katıldı"
          }
        }
      }
    },
    "%@ leaves your Contacts. They stay in %@ and come back by themselves if they join a new bill with you. You can show them again in Hidden." : {
      "comment" : "Hide a contact?; the first %@ is them, the second their groups",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verschwindet aus deinen Kontakten. Bleibt aber in %2$@ und kommt von selbst zurück, wenn ihr gemeinsam bei einer neuen Ausgabe dabei seid. Unter „Ausgeblendet“ kannst du die Person wieder einblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sale de tu lista de Contactos. Se mantiene en %2$@ y vuelve automáticamente si se une a un gasto nuevo contigo. Puedes mostrarlo de nuevo en Ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quitte tes Contacts. La personne reste dans %2$@ et revient toute seule si elle rejoint une nouvelle dépense avec toi. Tu peux l’afficher de nouveau dans Masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hilang dari Kontakmu. Dia tetap ada di %@ dan kembali dengan sendirinya jika ikut tagihan baru bersamamu. Kamu bisa menampilkannya lagi di Tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ esce dai tuoi Contatti. Resta in %@ e ricompare da sé se partecipa a una nuova spesa con te. Puoi mostrare di nuovo questo contatto in Nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は連絡先から外れます。%@には残り、あなたと一緒に新しい支出に加わると自動で戻ります。「非表示」から再表示できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verdwijnt uit je Contacten. Diegene blijft in %2$@ en komt vanzelf terug bij een nieuwe uitgave met jou. Je kunt diegene weer tonen bij Verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ znika z twoich Kontaktów. Zostaje w: %2$@ i wróci samoczynnie, jeśli dołączy z tobą do nowego wydatku. Możesz pokazać tę osobę ponownie w sekcji Ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sai da lista de Contatos. Continua em %2$@ e volta sozinho se entrar numa conta nova com você. Dá para mostrar de novo em Ocultos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kişiler'inden çıkar. %@ içinde kalır ve seninle yeni bir harcamaya katılırsa kendiliğinden geri gelir. Onu Gizli'de yeniden gösterebilirsin."
          }
        }
      }
    },
