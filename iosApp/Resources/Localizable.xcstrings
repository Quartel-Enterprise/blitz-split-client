        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא את הקבלה. כדאי לנסות שוב עם יותר אור ועם כל הקבלה בתמונה, או למלא ידנית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसीद पढ़ी नहीं जा सकी। ज़्यादा रोशनी में और पूरी रसीद फ़ोटो में लेकर फिर से कोशिश करें, या खुद भरें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun nije bilo moguće pročitati. Pokušaj ponovno s više svjetla i cijelim računom na fotografiji ili ga ispuni ručno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült beolvasni a nyugtát. Próbáld újra több fénnyel, a teljes nyugtával a fotón, vagy töltsd ki kézzel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal membaca struk. Coba lagi dengan cahaya lebih terang dan seluruh struk di foto, atau isi manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere lo scontrino. Riprova con più luce e lo scontrino intero nella foto, o compila a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートを読み取れませんでした。明るい場所でレシート全体が写るように撮り直すか、手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증을 읽지 못했어요. 더 밝은 곳에서 영수증 전체가 나오게 다시 찍거나 직접 입력하세요."
