          }
        }
      }
    },
    "Whoever is left at %@ is out of the bill." : {
      "comment" : "Hint of the split by amount; %@ is zero in the currency",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer bei %@ bleibt, ist nicht in der Ausgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se queda con %@ sale del gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque reste à %@ n’est pas dans la dépense."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dibiarkan %@ tidak ikut tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi resta a %@ è fuori dalla spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のままの人は、この支出の対象外になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie op %@ blijft staan, doet niet mee met de uitgave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto zostanie z kwotą %@, będzie poza wydatkiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem fica com %@ sai da conta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarı %@ kalan kişi harcamaya dahil olmaz."
          }
        }
      }
    },
    "Whoever joined as %@ leaves the group. %@'s name, color and bills stay, and %@ can be picked again through the group's link." : {
      "comment" : "The same member's name, three times",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer als %1$@ beigetreten ist, verlässt die Gruppe. Name, Farbe und Ausgaben von %2$@ bleiben, und %3$@ kann über den Link der Gruppe wieder gewählt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se unió como %1$@ sale del grupo. El nombre, el color y los gastos de %2$@ se quedan, y se puede elegir a %3$@ de nuevo con el enlace del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne entrée comme %1$@ quitte le groupe. Le nom, la couleur et les dépenses de %2$@ restent, et %3$@ peut être choisi à nouveau via le lien du groupe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang bergabung sebagai %@ keluar dari grup. Nama, warna, dan tagihan %@ tetap ada, dan %@ bisa dipilih lagi lewat tautan grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi aveva aderito come %@ lascia il gruppo. Il nome, il colore e le spese di %@ restano, e %@ si può scegliere di nuovo tramite il link del gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@として参加した人はグループから外れます。%@の名前、色、支出は残り、グループのリンクから再び%@を選べるようになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie meedeed als %@ verlaat de groep. De naam, kleur en uitgaven van %@ blijven, en %@ kan opnieuw worden gekozen via de link van de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba, która dołączyła jako %1$@, opuści grupę. Imię %2$@, kolor i wydatki zostają, a imię %3$@ będzie można znowu wybrać przez link grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem entrou como %1$@ sai do grupo. O nome, a cor e as contas de %2$@ ficam, e dá para escolher %3$@ de novo pelo link do grupo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ olarak katılan kişi gruptan çıkar. %@ ismi, rengi ve harcamaları yerinde kalır ve %@ grubun bağlantısıyla yeniden seçilebilir."
          }
        }
      }
    },
    "Whoever opens the link joins the group. No account needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Link öffnet, tritt der Gruppe bei. Kein Konto nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra el enlace se une al grupo. No hace falta una cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque ouvre le lien rejoint le groupe. Pas besoin de compte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang membuka tautannya bergabung ke grup. Tidak perlu akun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi apre il link entra nel gruppo. Non serve un account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開いた人はグループに参加します。アカウントは不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de link opent, wordt lid van de groep. Geen account nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto otworzy link, dołączy do grupy. Konto nie jest potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link entra no grupo. Não precisa criar conta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı açan kişi gruba katılır. Hesap gerekmez."
          }
        }
      }
    },
    "Whoever opens the link picks who they are on the list: %@. No account needed." : {
      "comment" : "%@ is the names of the members who haven't joined, in bold: \"Ana, Bruno or Carla\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Link öffnet, wählt in der Liste, wer er ist: %@. Kein Konto nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra el enlace elige quién es en la lista: %@. No hace falta una cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque ouvre le lien choisit son nom dans la liste : %@. Pas besoin de compte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang membuka tautannya memilih siapa dirinya dari daftar: %@. Tidak perlu akun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi apre il link sceglie chi è dalla lista: %@. Non serve un account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開いた人は、リストから自分を選びます：%@。アカウントは不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de link opent, kiest wie hij is in de lijst: %@. Geen account nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto otworzy link, wybierze z listy, kim jest: %@. Konto nie jest potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link escolhe quem é na lista: %@. Não precisa criar conta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı açan kişi listeden kim olduğunu seçer: %@. Hesap gerekmez."
          }
        }
      }
    },
    "Whoever opens this link joins straight in as %@, without picking from the list. It works once." : {
      "comment" : "Explains a member's personal invite link; %@ is the member",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer diesen Link öffnet, tritt direkt als %@ bei, ohne aus der Liste zu wählen. Er funktioniert einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra este enlace entra directo como %@, sin elegir de la lista. Funciona una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque ouvre ce lien entre directement comme %@, sans choisir dans la liste. Il ne fonctionne qu’une fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang membuka tautan ini langsung bergabung sebagai %@, tanpa memilih dari daftar. Hanya bisa dipakai sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi apre questo link entra direttamente come %@, senza scegliere dalla lista. Funziona una sola volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクを開いた人は、リストから選ばずに%@としてそのまま参加します。使えるのは1回だけです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie deze link opent, doet direct mee als %@, zonder uit de lijst te kiezen. Hij werkt één keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto otworzy ten link, dołączy od razu jako %@, bez wybierania z listy. Link działa jeden raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir este link entra direto como %@, sem escolher na lista. Ele vale uma vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantıyı açan kişi listeden seçmeden doğrudan %@ olarak katılır. Yalnızca bir kez çalışır."
          }
        }
      }
    },
    "Whoever owes you sees your default key when settling up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer dir etwas schuldet, sieht beim Begleichen deinen Standardschlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien te deba ve tu clave predeterminada al saldar cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui te doit voit ta clé par défaut au moment de régler."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang berutang ke kamu melihat kunci default-mu saat melunasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ti deve vede la tua chiave predefinita al momento di saldare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う人には、精算時にデフォルトのキーが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jou iets schuldig is, ziet je standaardsleutel bij het verrekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby, które mają ci oddać, widzą przy rozliczaniu twój domyślny klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem te deve vê a chave padrão na hora do acerto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana borcu olanlar hesaplaşırken varsayılan anahtarını görür."
          }
        }
      }
    },
    "Whoever pays you sees this key when settling up. Which type of key?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer dich bezahlt, sieht diesen Schlüssel beim Begleichen. Welche Art von Schlüssel?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve esta clave al saldar cuentas. ¿Qué tipo de clave?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui te paie voit cette clé au moment de régler. Quel type de clé ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang membayarmu melihat kunci ini saat melunasi. Jenis kunci apa?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ti paga vede questa chiave al momento di saldare. Che tipo di chiave?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う人には、精算時にこのキーが表示されます。キーの種類は？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jou betaalt, ziet deze sleutel bij het verrekenen. Welk type sleutel?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto ci płaci, widzi ten klucz przy rozliczaniu. Jaki typ klucza?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem for te pagar vê esta chave no acerto. Qual tipo de chave?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ödeme yapan kişi hesaplaşırken bu anahtarı görür. Hangi tür anahtar?"
          }
        }
      }
    },
    "Whoever pays you sees your full CPF. If you'd rather not share it, use a phone, email or random key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer dich bezahlt, sieht deine vollständige CPF. Wenn du sie lieber nicht teilen willst, nutze Telefon, E-Mail oder einen Zufallsschlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa celular, correo o clave aleatoria."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa móvil, correo o clave aleatoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui te paie voit ton CPF en entier. Si tu préfères ne pas le partager, utilise une clé téléphone, e-mail ou aléatoire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang membayarmu melihat CPF-mu secara lengkap. Kalau tidak mau membagikannya, pakai kunci telepon, email, atau acak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ti paga vede il tuo CPF completo. Se preferisci non condividerlo, usa una chiave telefono, email o casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う人にはCPFがすべて表示されます。共有したくない場合は、電話番号、メール、ランダムキーを使ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jou betaalt, ziet je volledige CPF. Wil je die liever niet delen, gebruik dan een telefoon-, e-mail- of willekeurige sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto ci płaci, widzi twój pełny numer CPF. Jeśli wolisz go nie udostępniać, użyj klucza telefonu, e-maila lub losowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem for te pagar vê o CPF completo. Se preferir não expor, use celular, e-mail ou chave aleatória."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ödeme yapan kişi CPF'nin tamamını görür. Paylaşmak istemiyorsan telefon, e-posta veya rastgele anahtar kullan."
          }
        }
      }
    },
    "Whole numbers only. The leftover cents go to whoever paid." : {
      "comment" : "Hint of the split by percentage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
