        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamnija isprekidana linija preko grafikona, kao ona u ovoj legendi, je prosek: ukupna potrošnja podeljena brojem svih prikazanih perioda, uključujući prazne."
