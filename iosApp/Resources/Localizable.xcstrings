    "It leaves the bill for everyone. Its replies stay." : {
      "comment" : "The message of Delete comment?",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُزال من الفاتورة للجميع. تبقى الردود عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verschwindet für alle aus der Ausgabe. Die Antworten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece del gasto para todos. Las respuestas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le commentaire disparaît de la dépense pour tout le monde. Ses réponses restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היא תוסר מהחשבון אצל כולם. התשובות אליה יישארו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह खर्च से सभी के लिए हट जाएगी। इसके जवाब बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentar ini hilang dari tagihan untuk semua orang. Balasannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparisce dalla spesa per tutti. Le risposte restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支出から全員分削除されます。返信は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사람에게서 댓글이 사라져요. 답글은 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De reactie verdwijnt voor iedereen uit de uitgave. De antwoorden blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zniknie z wydatku dla wszystkich. Odpowiedzi zostaną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele sai da conta para todos. As respostas continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он исчезнет из счёта для всех. Ответы на него останутся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคิดเห็นจะหายไปจากบิลสำหรับทุกคน แต่คำตอบกลับยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorum herkes için harcamadan kalkar. Yanıtları kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він зникне з рахунку для всіх. Відповіді на нього залишаться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bình luận sẽ bị xóa khỏi khoản chi đối với mọi người. Các câu trả lời vẫn giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将对所有人从账单中移除。它的回复会保留。"
