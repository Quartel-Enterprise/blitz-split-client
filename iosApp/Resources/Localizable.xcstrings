          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa partes cuando alguien consume más, como quien llevó acompañante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les parts quand quelqu’un a plus, comme quelqu’un venu avec un invité."
