    },
    "The receipt reader didn't answer. It isn't your photo: try again in a moment, or fill it in by hand." : {
      "comment" : "Split a bill: the server's receipt reader didn't answer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Belegleser hat nicht geantwortet. Es liegt nicht an deinem Foto: Versuch es gleich noch mal, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lector de recibos no respondió. No es tu foto: inténtalo de nuevo en un momento o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur de reçus n’a pas répondu. Ce n’est pas ta photo : réessaie dans un instant, ou remplis à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lettore di scontrini non ha risposto. Non è colpa della tua foto: riprova tra un attimo, o compila a mano."
