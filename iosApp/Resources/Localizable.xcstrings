        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касовата бележка не можа да бъде прочетена. Опитай отново с повече светлина и цялата бележка в снимката или я попълни ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রসিদ পড়া যায়নি। আরও আলোতে পুরো রসিদ ছবিতে রেখে আবার চেষ্টা করুন, অথবা নিজে পূরণ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut llegir el tiquet. Torna-ho a provar amb més llum i amb tot el tiquet a la foto, o omple-ho a mà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účtenku se nepodařilo přečíst. Zkus to znovu s větším světlem a celou účtenkou na fotce, nebo to vyplň ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvitteringen kunne ikke læses. Prøv igen med mere lys og hele kvitteringen på billedet, eller udfyld den manuelt."
