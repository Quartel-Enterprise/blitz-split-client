    "No internet: the new split holds on this %@ now and reaches the others once it reconnects." : {
      "comment" : "Default split offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إنترنت: يسري التقسيم الجديد على هذا الـ %@ الآن ويصل إلى الآخرين عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма интернет: новото разделяне важи на този %@ сега и стига до другите, щом се свърже отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট নেই: নতুন ভাগ এখন এই %@ ডিভাইসে কার্যকর থাকবে এবং আবার সংযুক্ত হলে অন্যদের কাছে পৌঁছাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha internet: la divisió nova es manté en aquest %@ i arribarà als altres quan es torni a connectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetu: nové rozdělení teď platí v zařízení %@ a k ostatním se dostane, až se znovu připojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet internet: den nye deling gælder på denne %@ nu og når ud til de andre, når den har forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Die neue Aufteilung gilt jetzt auf diesem %@ und erreicht die anderen, sobald die Verbindung zurück ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ίντερνετ: η νέα μοιρασιά ισχύει τώρα σε αυτό το %@ και θα φτάσει στους άλλους μόλις συνδεθεί ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: la nueva división vale en este %@ ahora y llega a los demás cuando se reconecte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internetti pole: uus jaotus kehtib nüüd selles seadmes (%@) ja jõuab teisteni, kui ühendus taastub."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اینترنت ندارید: تقسیم جدید فعلاً روی این %@ می‌ماند و پس از اتصال دوباره به دیگران می‌رسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei internetyhteyttä: uusi jako on nyt voimassa tällä laitteella (%@) ja välittyy muille, kun yhteys palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang internet: nasa %@ na ito muna ang bagong hatian at maaabot nito ang iba kapag nakakonekta ka ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : la nouvelle répartition est prise en compte sur ton %@ et arrive sur les autres dès la reconnexion."
