        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 그룹 전체의 카테고리예요. 그룹의 누구나 사용, 수정, 삭제할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
