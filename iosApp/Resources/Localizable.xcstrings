        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko nuskaityti kvito. Bandyk dar kartą su daugiau šviesos ir visu kvitu nuotraukoje arba užpildyk ranka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās nolasīt čeku. Mēģini vēlreiz ar labāku apgaismojumu un visu čeku fotoattēlā vai aizpildi to manuāli."
