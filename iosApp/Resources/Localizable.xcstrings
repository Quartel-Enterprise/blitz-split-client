    "%@ joins right away, with no part in the old bills, and sees the group in their list." : {
      "comment" : "Adding someone who uses the app to a group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينضم %@ فورًا، دون حصة في الفواتير القديمة، ويرى المجموعة في قائمته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ се присъединява веднага, без дял в старите разходи, и вижда групата в списъка си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ সঙ্গে সঙ্গে যোগ দেবেন, পুরোনো বিলে তাঁর কোনো অংশ থাকবে না, এবং তিনি নিজের তালিকায় গ্রুপটি দেখতে পাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se připojí hned, bez podílu na starých výdajích, a uvidí skupinu ve svém seznamu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tritt sofort bei, ohne Anteil an den alten Ausgaben, und sieht die Gruppe in der eigenen Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ μπαίνει αμέσως, χωρίς μερίδιο στα παλιά έξοδα, και βλέπει την ομάδα στη λίστα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entra directo, sin parte en los gastos anteriores, y ve el grupo en su lista de grupos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بلافاصله می‌پیوندد، بدون سهمی در هزینه‌های قبلی، و گروه را در فهرست خود می‌بیند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agad na sasali si %@, walang bahagi sa mga lumang bill, at makikita ang grupo sa listahan niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rejoint tout de suite, sans part dans les anciennes dépenses, et voit le groupe dans sa liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההצטרפות של %@ מיידית, בלי חלק בחשבונות הישנים, והקבוצה תופיע ברשימה האישית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तुरंत जुड़ जाएंगे, पुराने खर्चों में बिना किसी हिस्से के, और ग्रुप उनकी सूची में दिखेगा।"
