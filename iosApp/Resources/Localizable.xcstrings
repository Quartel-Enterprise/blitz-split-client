    "Only those who paid this bill can mark what they paid with." : {
      "comment" : "Toast and VoiceOver hint of the dimmed Paid with, tapped by someone who didn't pay the bill",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط من دفع هذه الفاتورة يمكنه تحديد وسيلة الدفع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само платилите този разход могат да отбележат с какво са платили."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাঁরা এই বিল পরিশোধ করেছেন শুধু তাঁরাই কীভাবে পরিশোধ করেছেন তা চিহ্নিত করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím se platilo, můžou označit jen ti, kdo tento výdaj zaplatili."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wer diese Ausgabe bezahlt hat, kann angeben, womit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο όσοι πλήρωσαν αυτό το έξοδο μπορούν να σημειώσουν με τι πλήρωσαν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo quien pagó este gasto puede marcar con qué pagó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط کسانی که این هزینه را پرداخت کرده‌اند می‌توانند روش پرداخت خود را مشخص کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga nagbayad lang ng bill na ito ang puwedeng magmarka kung ano ang ibinayad nila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls ceux qui ont payé cette dépense peuvent indiquer avec quoi ils ont payé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק מי ששילמו את החשבון הזה יכולים לסמן באיזה אמצעי שילמו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ इस खर्च का भुगतान करने वाले ही बता सकते हैं कि उन्होंने किससे भुगतान किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo oni koji su platili ovaj trošak mogu označiti čime su platili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak azok jelölhetik meg, mivel fizettek, akik ezt a számlát kifizették."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya yang membayar tagihan ini yang bisa menandai cara bayarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo chi ha pagato questa spesa può indicare con cosa ha pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支出を支払った人だけが支払い方法を選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지출을 낸 사람만 결제 수단을 표시할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mereka yang membayar bil ini boleh menandakan cara pembayaran mereka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen wie deze uitgave heeft betaald, kan aangeven waarmee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko osoby, które zapłaciły za ten wydatek, mogą zaznaczyć, czym zapłaciły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só quem pagou esta conta pode marcar com o que pagou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só quem pagou esta conta pode marcar com o que pagou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar cei care au plătit această cheltuială pot marca cu ce au plătit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметить, чем оплачено, могут только те, кто платил за этот счёт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím sa platilo, môžu označiť len tí, ktorí tento výdavok zaplatili."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo oni koji su platili ovaj račun mogu da označe čime su platili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara de som betalade den här utgiften kan markera vad de betalade med."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் செலவைச் செலுத்தியவர்கள் மட்டுமே எதன் மூலம் செலுத்தினார்கள் என்று குறிக்க முடியும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะคนที่จ่ายบิลนี้เท่านั้นที่ระบุช่องทางการจ่ายได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeme şeklini yalnızca bu harcamayı ödeyenler seçebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначити, чим сплачено, можуть лише ті, хто платив за цей рахунок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف وہی لوگ جنہوں نے یہ خرچ ادا کیا، بتا سکتے ہیں کہ انہوں نے کس ذریعے سے ادا کیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ người đã trả khoản chi này mới có thể đánh dấu phương thức thanh toán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有支付了这笔账单的人才能标记支付方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有支付了這筆帳單的人才能標記付款方式。"
          }
        }
      }
