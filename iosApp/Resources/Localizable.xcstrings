    "Add the first expense or invite who's splitting with you. People without the app count too." : {
      "comment" : "Message of a group without bills",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أول مصروف أو ادعُ من يقسّم معك. الأشخاص الذين ليس لديهم التطبيق يُحتسبون أيضًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добави първия разход или покани тези, с които делиш. Хората без приложението също се броят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রথম খরচ যোগ করুন বা যাঁরা আপনার সঙ্গে ভাগ করবেন তাঁদের আমন্ত্রণ জানান। অ্যাপ ছাড়া ব্যক্তিরাও এতে থাকতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix la primera despesa o convida qui divideix amb tu. La gent sense l’app també compta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej první výdaj nebo pozvi ty, s kým se dělíš. Počítají se i lidé bez aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj den første udgift, eller invitér dem, der deler med dig. Personer uden appen tæller også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die erste Ausgabe hinzu oder lade ein, wer mit dir teilt. Personen ohne die App zählen auch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε το πρώτο έξοδο ή προσκάλεσε όσους μοιράζονται μαζί σου. Μετράνε και τα άτομα χωρίς την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el primer gasto o invita a quien va a dividir contigo. Las personas sin la app también cuentan."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el primer gasto o invita a quien va a dividir contigo. Las personas sin la app también cuentan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa esimene kulu või kutsu need, kellega jagad. Ka rakenduseta inimesed lähevad arvesse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اولین هزینه را اضافه کنید یا کسانی را که با شما تقسیم می‌کنند دعوت کنید. افراد بدون برنامه هم حساب می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ensimmäinen kulu tai kutsu ne, joiden kanssa jaat. Myös ihmiset ilman sovellusta lasketaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang unang gastos o imbitahan ang kasama mong maghahati. Kasama rin ang mga taong walang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la première dépense ou invite qui partage avec toi. Les personnes sans l’app comptent aussi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પહેલો ખર્ચ ઉમેરો અથવા તમારી સાથે વહેંચનારાઓને આમંત્રણ આપો. ઍપ વિનાના લોકો પણ ગણાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף את ההוצאה הראשונה או להזמין את מי שמתחלק איתך. גם אנשים בלי האפליקציה נספרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला खर्च जोड़ें या जिनके साथ बांट रहे हैं उन्हें आमंत्रित करें। बिना ऐप वाले लोग भी गिने जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj prvi trošak ili pozovi one s kojima dijeliš. Računaju se i osobe bez aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá az első kiadást, vagy hívd meg, akivel osztozol. Azok is számítanak, akiknek nincs meg az app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan pengeluaran pertama atau undang yang ikut patungan denganmu. Orang tanpa aplikasi juga dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la prima spesa o invita chi divide con te. Contano anche le persone senza l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の支出を追加するか、一緒に割り勘する人を招待しましょう。アプリを使っていない人も含められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 지출을 추가하거나 함께 나눌 사람을 초대하세요. 앱이 없는 사람도 포함돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėk pirmą išlaidą arba pakviesk tuos, su kuriais dalijiesi. Žmonės be programėlės irgi skaičiuojami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievieno pirmo izdevumu vai uzaicini tos, ar kuriem dalies. Cilvēki bez lietotnes arī skaitās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहिला खर्च जोडा किंवा तुमच्यासोबत खर्च वाटणाऱ्यांना आमंत्रित करा. ॲप नसलेले लोकही मोजले जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah perbelanjaan pertama atau jemput orang yang berkongsi dengan anda. Orang tanpa aplikasi turut dikira."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til den første utgiften eller inviter de som deler med deg. Personer uten appen teller også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de eerste uitgave toe of nodig uit wie met je meedeelt. Mensen zonder de app tellen ook mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj pierwszy wydatek lub zaproś osoby, z którymi dzielisz koszty. Osoby bez aplikacji też się liczą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance a primeira despesa ou chame quem vai dividir com você. Quem ainda não tem o app também entra na conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista a primeira despesa ou convida quem vai dividir contigo. Quem ainda não tem a app também entra na conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă prima cheltuială sau invită-i pe cei cu care împarți. Contează și cei fără aplicație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь первый расход или пригласи тех, с кем делишь. Люди без приложения тоже считаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridaj prvý výdavok alebo pozvi tých, s ktorými delíš. Rátajú sa aj ľudia bez aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj prvi strošek ali povabi tiste, s katerimi deliš stroške. Štejejo tudi ljudje brez aplikacije."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj prvi trošak ili pozovi one sa kojima deliš. Osobe bez aplikacije se takođe računaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till den första utgiften eller bjud in dem som delar med dig. Personer utan appen räknas också."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza gharama ya kwanza au waalike mnaogawanya nao. Watu wasio na programu wanahesabika pia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முதல் செலவைச் சேருங்கள் அல்லது உங்களுடன் பிரித்துக்கொள்பவர்களை அழையுங்கள். ஆப் இல்லாதவர்களும் கணக்கில் வருவார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మొదటి ఖర్చును జోడించండి లేదా మీతో పంచుకునేవారిని ఆహ్వానించండి. యాప్ లేనివారు కూడా లెక్కలోకి వస్తారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มบิลแรก หรือเชิญคนที่หารกับคุณ คนที่ไม่มีแอปก็นับด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk harcamayı ekle veya seninle bölüşenleri davet et. Uygulaması olmayanlar da sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай першу витрату або запроси тих, з ким ділиш рахунки. Люди без застосунку теж рахуються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلا خرچ شامل کریں یا ان لوگوں کو دعوت دیں جو آپ کے ساتھ بانٹ رہے ہیں۔ ایپ کے بغیر لوگ بھی شمار ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm khoản chi đầu tiên hoặc mời những người chia cùng bạn. Người không dùng ứng dụng cũng được tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加第一笔账单，或邀请和你一起分摊的人。没有安装应用的人也算在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增第一筆帳單，或邀請和你一起分攤的人。沒有安裝App的人也算在內。"
          }
        }
      }
    },
