          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entra directo, sin parte en los gastos anteriores, y ve el grupo en su lista de grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rejoint tout de suite, sans part dans les anciennes dépenses, et voit le groupe dans sa liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההצטרפות של %@ מיידית, בלי חלק בחשבונות הישנים, והקבוצה תופיע ברשימה האישית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तुरंत जुड़ जाएंगे, पुराने खर्चों में बिना किसी हिस्से के, और ग्रुप उनकी सूची में दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ langsung bergabung, tanpa bagian di tagihan lama, dan melihat grup ini di daftarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entra subito, senza parte nelle spese passate, e vede il gruppo nella sua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は過去の支出に関わらずすぐに参加し、リストにグループが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 이전 지출에 몫 없이 바로 참여하고, 자기 목록에서 그룹을 보게 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt meteen lid, zonder deel in de oude uitgaven, en ziet de groep in de eigen lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dołączy od razu, bez udziału w starych wydatkach, i zobaczy grupę na swojej liście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entra direto, sem parte nas contas antigas, e vê o grupo na lista de grupos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сразу присоединится, без доли в старых счетах, и увидит группу в своём списке."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จะเข้าร่วมทันที โดยไม่มีส่วนในบิลเก่า และจะเห็นกลุ่มในรายการของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eski harcamalarda payı olmadan hemen katılır ve grubu kendi listesinde görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ одразу приєднується, без частки в старих рахунках, і бачить групу у своєму списку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tham gia ngay, không có phần trong các khoản chi cũ, và thấy nhóm trong danh sách của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
