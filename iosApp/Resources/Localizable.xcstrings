        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Klik untuk mencatat yang dia bayar ke kamu; dia tidak mendapat pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Fai clic per annotare quanto ti ha pagato; non riceve alcun avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリを使っていないゲストです。クリックして、受け取った支払いを記録できます。相手に通知は届きません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is een gast zonder de app. Klik om te noteren wat diegene je heeft betaald; diegene krijgt geen melding."
