    "Pay in your bank's app and come back to mark it as paid. Check that the bank shows %@'s name." : {
      "comment" : "Pay with a key (4.5): the note under the keys",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع في تطبيق البنك ثم عد لوضع علامة «مدفوع». تحقّق من أن البنك يعرض اسم %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плати в приложението на банката си и се върни, за да го отбележиш като платено. Провери дали банката показва името на %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ব্যাংকের অ্যাপে পরিশোধ করে ফিরে এসে এটি পরিশোধিত হিসেবে চিহ্নিত করুন। ব্যাংকে প্রাপকের নাম %@ দেখাচ্ছে কি না মিলিয়ে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplať v aplikaci své banky a vrať se, abys to označil(a) jako zaplacené. Zkontroluj, že banka ukazuje jméno %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahle in deiner Banking-App und komm zurück, um als bezahlt zu markieren. Prüfe, dass die Bank den Namen von %@ anzeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρωσε από την εφαρμογή της τράπεζάς σου και γύρνα για να το σημειώσεις ως πληρωμένο. Έλεγξε ότι η τράπεζα εμφανίζει το όνομα: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga en la app de tu banco y vuelve para marcarlo como pagado. Verifica que el banco muestre el nombre de %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در برنامه بانک خود پرداخت کنید و برگردید تا آن را پرداخت‌شده علامت بزنید. بررسی کنید که بانک نام %@ را نشان دهد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magbayad sa app ng bangko mo at bumalik para markahan itong bayad na. Tiyaking pangalan ni %@ ang lumalabas sa bangko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paie dans l’app de ta banque et reviens le marquer comme payé. Vérifie que la banque affiche le nom de %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לשלם באפליקציית הבנק ולחזור לכאן כדי לסמן כשולם. כדאי לוודא שהבנק מציג את השם של %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने बैंक ऐप में भुगतान करें और भुगतान हो गया मार्क करने के लिए वापस आएं। देख लें कि बैंक %@ का नाम दिखा रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plati u aplikaciji svoje banke i vrati se da označiš kao plaćeno. Provjeri prikazuje li banka ime: %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizess a bankod appjában, majd gyere vissza, és jelöld meg fizetettként. Ellenőrizd, hogy a bank %@ nevét mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar di aplikasi bankmu, lalu kembali untuk menandainya sudah dibayar. Pastikan bank menampilkan nama %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga nell’app della tua banca e torna qui per segnarlo come pagato. Controlla che la banca mostri il nome di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行アプリで支払ってから戻り、支払い済みにしてください。銀行に%@の名前が表示されることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "은행 앱에서 송금한 뒤 돌아와서 송금 완료로 표시하세요. 은행에 %@ 님의 이름이 표시되는지 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar dalam aplikasi bank anda dan kembali untuk menandakannya sebagai dibayar. Pastikan bank memaparkan nama %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betaal in de app van je bank en kom terug om het als betaald te markeren. Controleer of de bank de naam van %@ toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapłać w aplikacji banku i wróć, aby oznaczyć jako zapłacone. Sprawdź, czy bank pokazuje odbiorcę: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague no app do seu banco e volte para marcar como pago. Confira se o banco mostra o nome de %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga na app do teu banco e volta para marcar como pago. Confirma se o banco mostra o nome de %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plătește din aplicația băncii și revino ca să marchezi ca plătit. Verifică dacă banca afișează numele: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплати в приложении банка и вернись, чтобы отметить как оплаченное. Проверь, что банк показывает имя: %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplať v aplikácii svojej banky a vráť sa označiť to ako zaplatené. Skontroluj, či banka zobrazuje meno %@."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plati u aplikaciji svoje banke pa se vrati da označiš kao plaćeno. Proveri da banka prikazuje ime: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala i bankens app och kom tillbaka för att markera som betald. Kontrollera att banken visar %@s namn."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வங்கி ஆப்பில் செலுத்திவிட்டுத் திரும்ப வந்து செலுத்தியதாகக் குறியுங்கள். வங்கி காட்டும் பெயர் இதுதானா எனச் சரிபாருங்கள்: %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายในแอปธนาคารของคุณ แล้วกลับมาทำเครื่องหมายว่าจ่ายแล้ว ตรวจสอบว่าธนาคารแสดงชื่อของ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bankanın uygulamasından öde ve ödendi olarak işaretlemek için geri dön. Bankanın alıcı olarak %@ adını gösterdiğini kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сплати в застосунку свого банку й повернись, щоб позначити як сплачене. Перевір, що банк показує ім'я: %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے بینک کی ایپ میں ادائیگی کریں اور ادا شدہ نشان زد کرنے کے لیے واپس آئیں۔ دیکھ لیں کہ بینک %@ کا نام دکھا رہا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy trả trong ứng dụng ngân hàng rồi quay lại đánh dấu đã trả. Kiểm tra ngân hàng có hiện tên của %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的银行应用中付款，然后回来标记为已付款。请确认银行显示的是%@的名字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的銀行App中付款，然後回來標記為已付款。請確認銀行顯示的是%@的名字。"
          }
        }
      }
    },
