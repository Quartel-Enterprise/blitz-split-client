        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản thanh toán sẽ quay lại giữa những người đã chia từng khoản chi. Không khoản chi hay khoản thanh toán đã ghi nhận nào bị thay đổi."
