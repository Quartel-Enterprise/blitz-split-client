    "%@ from the receipt. Tap the icon to change it." : {
      "comment" : "Split a bill: the receipt chose the category",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ من الإيصال. لتغييرها، يمكنك النقر على الأيقونة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ laut Beleg. Tippe auf das Symbol, um sie zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por el recibo. Toca el ícono para cambiar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por el recibo. Toca el icono para cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ d’après le reçu. Touche l’icône pour changer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ מהקבלה. אפשר להקיש על הסמל כדי לשנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसीद से %@। बदलने के लिए आइकन पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dari struk. Ketuk ikonnya untuk mengubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dallo scontrino. Tocca l’icona per cambiarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートから%@。アイコンをタップして変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증에서 고른 카테고리: %@. 아이콘을 탭해 바꾸세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ volgens het bonnetje. Tik op het icoon om het te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategoria %@ z paragonu. Stuknij ikonę, aby ją zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pelo cupom fiscal. Toque no ícone para trocar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pelo talão. Toca no ícone para trocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — по чеку. Нажми на значок, чтобы изменить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จากใบเสร็จ แตะไอคอนเพื่อเปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fişten geldi. Değiştirmek için simgeye dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — з чека. Торкнись значка, щоб змінити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ theo hóa đơn. Chạm vào biểu tượng để đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@来自小票。点按图标可更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@來自收據。點一下圖示可更改。"
          }
        }
      }
    },
