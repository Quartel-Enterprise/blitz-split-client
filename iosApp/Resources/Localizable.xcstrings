    "Tap a term to change its category or remove it. It matches the whole word, ignoring accents and case." : {
      "comment" : "Category map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Begriff, um seine Kategorie zu ändern oder ihn zu entfernen. Er passt auf das ganze Wort, Akzente und Groß-/Kleinschreibung egal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un término para cambiar su categoría o quitarlo. Coincide con la palabra completa, sin importar acentos ni mayúsculas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche un terme pour changer sa catégorie ou le retirer. Il correspond au mot entier, sans tenir compte des accents ni de la casse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un termine per cambiarne la categoria o rimuoverlo. Corrisponde alla parola intera, ignorando accenti e maiuscole."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij słowo, aby zmienić jego kategorię lub je usunąć. Dopasowuje całe słowo, bez względu na akcenty i wielkość liter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num termo para mudar a categoria ou remover. Casa com a palavra inteira, sem ligar para acento ou maiúscula."
          }
        }
      }
    },
