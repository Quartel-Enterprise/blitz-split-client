    "On your iPhone, connect an account in Profile and tap Connect here again." : {
      "comment" : "Apple Watch: the iPhone's profile is local only (15.11b)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على iPhone، اربط حسابًا من الملف الشخصي ثم اضغط ربط هنا مجددًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone свържи акаунт в Профил и докосни отново Свържи тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এ প্রোফাইল থেকে একটি অ্যাকাউন্ট সংযুক্ত করুন, তারপর এখানে আবার সংযুক্ত করুন-এ ট্যাপ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V iPhonu propoj účet v Profilu a tady znovu klepni na Propojit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde auf deinem iPhone ein Konto unter Profil und tippe hier erneut auf Verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο iPhone, σύνδεσε έναν λογαριασμό στο Προφίλ και πάτησε ξανά Σύνδεση εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPhone, conecta una cuenta en Perfil y toca Conectar aquí de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در iPhone خود، در پروفایل یک حساب کاربری وصل کنید و دوباره اینجا روی «اتصال» بزنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa iPhone mo, mag-connect ng account sa Profile at i-tap ulit ang Connect dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ton iPhone, connecte un compte dans Profil et touche à nouveau Connecter ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-iPhone, יש לחבר חשבון בפרופיל ולהקיש כאן שוב על חיבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone पर प्रोफ़ाइल में अकाउंट कनेक्ट करें और यहां फिर से कनेक्ट करें पर टैप करें।"
