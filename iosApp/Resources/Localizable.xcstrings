    "Anyone in the group can edit or delete it." : {
      "comment" : "Under the form of Edit bill",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي عضو في المجموعة تعديلها أو حذفها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки в групата може да го редактира или изтрие."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপের যে কেউ এটি সম্পাদনা করতে বা মুছতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli ze skupiny ho může upravit nebo smazat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle in der Gruppe können sie bearbeiten oder löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιοδήποτε μέλος της ομάδας μπορεί να το επεξεργαστεί ή να το διαγράψει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier persona del grupo puede editarlo o eliminarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی در گروه می‌تواند آن را ویرایش یا حذف کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit sino sa grupo ay puwedeng mag-edit o magbura nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde dans le groupe peut le modifier ou le supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל מי שבקבוצה יש אפשרות לערוך או למחוק אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप में कोई भी इसे बदल या हटा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko u grupi može ga urediti ili izbrisati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoportban bárki szerkesztheti vagy törölheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun di grup bisa mengedit atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque nel gruppo può modificarla o eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループの誰でも編集・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 누구나 수정하거나 삭제할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiapa dalam kumpulan boleh mengedit atau memadamnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen in de groep kan hem bewerken of verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy w grupie może go edytować lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa do grupo pode editar ou apagar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oricine din grup o poate edita sau șterge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой в группе может изменить или удалить его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktokoľvek v skupine ho môže upraviť alebo odstrániť."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako u grupi može da ga izmeni ili obriše."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla i gruppen kan redigera eller radera den."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "குழுவில் உள்ள யார் வேண்டுமானாலும் இதைத் திருத்தலாம் அல்லது நீக்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนในกลุ่มแก้ไขหรือลบได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruptaki herkes düzenleyebilir veya silebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто в групі може змінити або видалити його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروپ میں کوئی بھی اس میں ترمیم کر سکتا ہے یا اسے حذف کر سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất kỳ ai trong nhóm đều có thể sửa hoặc xóa khoản chi này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群组中的任何人都可以编辑或删除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群組中的任何人都可以編輯或刪除它。"
          }
        }
      }
    },
