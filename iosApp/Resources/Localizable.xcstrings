    "When it doesn't split evenly, the leftover cents go to whoever paid." : {
      "comment" : "Hint of the equal split",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما لا يتساوى التقسيم، تذهب الكسور المتبقية إلى الدافع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато не се дели поравно, останалите стотинки отиват при платилия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমান ভাগ না হলে বাকি পয়সা যিনি পরিশোধ করেছেন তাঁর ভাগে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když to nejde rozdělit přesně, zbylé haléře jdou tomu, kdo platil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es nicht glatt aufgeht, gehen die restlichen Cent an die Person, die bezahlt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν δεν μοιράζεται ακριβώς, τα λεπτά που περισσεύουν πάνε σε όποιον πλήρωσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la división no es exacta, los centavos que sobran se quedan con quien pagó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی تقسیم دقیق نشود، سنت‌های باقی‌مانده به پرداخت‌کننده می‌رسد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag hindi pantay ang hatian, mapupunta sa nagbayad ang matitirang sentimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand ça ne tombe pas juste, les centimes restants vont à la personne qui a payé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהסכום לא מתחלק בדיוק, השארית הולכת למי ששילם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब बराबर न बंटे, तो बचे हुए पैसे भुगतान करने वाले को जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad se ne dijeli jednako, preostali centi idu onome tko je platio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nem osztható el egyenlően, a maradék fillérek a fizetőhöz kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau tidak bisa dibagi rata, sisa sennya untuk yang membayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando non si divide in parti esatte, i centesimi avanzati vanno a chi ha pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均等に割り切れないときは、端数は支払った人に回ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "똑같이 나누어떨어지지 않으면 남는 잔돈은 낸 사람 몫이 돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak dapat dibahagi sama rata, baki sen diberikan kepada orang yang membayar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het niet precies uitkomt, gaan de resterende centen naar wie heeft betaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy kwota nie dzieli się równo, pozostałe grosze trafiają do osoby, która zapłaciła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando não dá conta exata, os centavos que sobram ficam com quem pagou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a divisão não é exata, os cêntimos que sobram ficam com quem pagou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când nu se împarte exact, banii rămași merg la cel care a plătit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда сумма не делится поровну, оставшиеся копейки достаются тому, кто платил."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď sa to nedá rozdeliť presne, zvyšné centy dostane ten, kto platil."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada se ne deli ravnomerno, preostali centi idu onome ko je platio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det inte går jämnt ut går de överblivna örena till den som betalade."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சமமாகப் பிரிக்க முடியாதபோது, மீதமுள்ள சில்லறை செலுத்தியவருக்குச் செல்லும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าหารไม่ลงตัว เศษสตางค์จะไปที่คนจ่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bölünmediğinde artan kuruşlar ödeyen kişiye gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо не ділиться порівну, залишок копійок отримує той, хто платив."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب برابر تقسیم نہ ہو، تو بچے ہوئے پیسے ادا کرنے والے کو جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không chia đều được, số lẻ còn dư sẽ thuộc về người trả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法平均分摊时，剩下的零头归付款人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法平均分攤時，剩下的零頭歸付款人。"
          }
        }
      }
    },
    "When settling up, we show the amount in sats at the current rate. It's only an estimate: the payer confirms it in their wallet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التسوية، نعرض المبلغ بالساتوشي بالسعر الحالي. إنه تقدير فقط: يؤكده الدافع في محفظته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При уреждане на сметките показваме сумата в сатоши по текущия курс. Това е само приблизително: платецът я потвърждава в портфейла си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিসাব মেটানোর সময় আমরা বর্তমান রেটে পরিমাণটি sats-এ দেখাই। এটি শুধু একটি আনুমানিক হিসাব: যিনি পরিশোধ করছেন তিনি তাঁর ওয়ালেটে তা নিশ্চিত করবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vyrovnání ukážeme částku v sats podle aktuálního kurzu. Je to jen odhad: plátce ji potvrdí ve své peněžence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Begleichen zeigen wir den Betrag in Sats zum aktuellen Kurs. Das ist nur eine Schätzung: Wer zahlt, bestätigt ihn in der eigenen Wallet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά την εξόφληση, δείχνουμε το ποσό σε sats με την τρέχουσα ισοτιμία. Είναι μόνο εκτίμηση: ο πληρωτής το επιβεβαιώνει στο πορτοφόλι του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al saldar cuentas, mostramos el monto en sats al tipo de cambio del momento. Es solo una estimación: quien paga confirma el monto en su billetera."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al saldar cuentas, mostramos el importe en sats al tipo de cambio del momento. Es solo una estimación: quien paga confirma el importe en su cartera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام تسویه حساب، مبلغ را به ساتوشی با نرخ فعلی نشان می‌دهیم. این فقط یک تخمین است: پرداخت‌کننده آن را در کیف پول خود تأیید می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag nagbabayaran, ipinapakita namin ang halaga sa sats sa kasalukuyang rate. Tantiya lang ito: kokumpirmahin ito ng nagbayad sa wallet niya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moment de régler, on affiche le montant en sats au taux actuel. Ce n’est qu’une estimation : le payeur la confirme dans son portefeuille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בסגירת החשבון נציג את הסכום ב-sats לפי השער הנוכחי. זו רק הערכה: הסכום מאושר בארנק של המשלם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हिसाब चुकाते समय हम मौजूदा दर पर रकम sats में दिखाते हैं। यह सिर्फ़ एक अनुमान है: भुगतान करने वाला इसे अपने वॉलेट में कन्फ़र्म करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri podmirivanju prikazujemo iznos u satsima po trenutačnom tečaju. To je samo procjena: platitelj ga potvrđuje u svom novčaniku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elszámoláskor az összeget satsban mutatjuk az aktuális árfolyamon. Ez csak becslés: a fizető a tárcájában erősíti meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat melunasi, kami tampilkan nominalnya dalam sats dengan kurs saat ini. Ini hanya perkiraan: pembayar mengonfirmasinya di dompetnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento di saldare, mostriamo l’importo in sats al cambio attuale. È solo una stima: chi paga lo conferma nel proprio wallet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精算時には、現在のレートでsats換算の金額を表示します。あくまで目安です：金額は支払う人がウォレットで確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정산할 때 현재 환율로 sats 금액을 보여 줘요. 추정치일 뿐이에요: 실제 금액은 내는 사람이 지갑에서 확인해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semasa penyelesaian, kami menunjukkan amaun dalam sats pada kadar semasa. Ini hanya anggaran: pembayar mengesahkannya dalam dompet mereka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het verrekenen tonen we het bedrag in sats tegen de huidige koers. Het is maar een schatting: de betaler bevestigt het in zijn wallet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy rozliczaniu pokazujemy kwotę w satoshi po bieżącym kursie. To tylko szacunek: płacący potwierdza ją w swoim portfelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No acerto, mostramos o valor em sats pela cotação do momento. É só uma estimativa: quem paga confirma o valor na carteira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La achitare, arătăm suma în sats la cursul actual. E doar o estimare: plătitorul o confirmă în portofelul său."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При расчёте мы показываем сумму в сатоши по текущему курсу. Это лишь оценка: плательщик подтверждает её в своём кошельке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vyrovnaní ukážeme sumu v satoch podľa aktuálneho kurzu. Je to len odhad: platiteľ ju potvrdí vo svojej peňaženke."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilikom izmirivanja prikazujemo iznos u sats po trenutnom kursu. To je samo procena: uplatilac je potvrđuje u svom novčaniku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ni gör upp visar vi beloppet i sats till aktuell kurs. Det är bara en uppskattning: betalaren bekräftar det i sin plånbok."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணக்கைத் தீர்க்கும்போது, தற்போதைய விகிதத்தில் தொகையை sats-இல் காட்டுவோம். இது ஒரு மதிப்பீடு மட்டுமே: செலுத்துபவர் தங்கள் வாலட்டில் அதை உறுதிசெய்வார்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนเคลียร์ยอด เราจะแสดงจำนวนเป็น sats ตามอัตราปัจจุบัน เป็นแค่ค่าประมาณ: คนจ่ายจะยืนยันในวอลเล็ตของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplaşırken tutarı güncel kurla sats olarak gösteririz. Bu yalnızca bir tahmin: ödeyen kişi tutarı cüzdanında onaylar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час розрахунку ми показуємо суму в сатоші за поточним курсом. Це лише оцінка: платник підтверджує її у своєму гаманці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب برابر کرتے وقت ہم موجودہ ریٹ پر رقم sats میں دکھاتے ہیں۔ یہ صرف ایک اندازہ ہے: ادا کرنے والا اپنے والیٹ میں اس کی تصدیق کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi thanh toán, chúng tôi hiển thị số tiền bằng sats theo tỷ giá hiện tại. Đây chỉ là ước tính: người trả sẽ xác nhận trong ví của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结清时，我们会按当前汇率以sats显示金额。这只是估算：付款人会在自己的钱包中确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結清時，我們會按目前匯率以sats顯示金額。這只是估算：付款人會在自己的錢包中確認。"
          }
        }
      }
    },
