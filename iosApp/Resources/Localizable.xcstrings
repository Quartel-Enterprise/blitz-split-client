        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクからすでに誰かが参加したか、リンクが変更されました。送った人に新しいリンクを頼んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
