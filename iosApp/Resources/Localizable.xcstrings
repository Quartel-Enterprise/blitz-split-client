            "value" : "Todo lo que se añada para ti aparece aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر چیزی که برای شما اضافه شود اینجا نمایش داده می‌شود."
