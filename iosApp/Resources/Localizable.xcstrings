        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ приєднується до групи як ім'я, без частки в старих рахунках."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ایک نام کے طور پر گروپ میں شامل ہوں گے، پرانے خرچوں میں کسی حصے کے بغیر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
