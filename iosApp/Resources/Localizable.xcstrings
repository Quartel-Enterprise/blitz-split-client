    "An app term. Restore default brings it back as it came." : {
      "comment" : "Edit term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصطلح من التطبيق. «استعادة الافتراضي» تعيده كما كان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термин на приложението. „Възстанови по подразбиране“ го връща такъв, какъвто е бил."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি অ্যাপের নিজস্ব শব্দ। ডিফল্ট ফিরিয়ে আনলে এটি আগের অবস্থায় ফিরে আসবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terme de l’app. Restaurar el valor per defecte el torna tal com venia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výraz aplikace. Obnovit výchozí ho vrátí do původní podoby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ord fra appen. Gendan standard bringer det tilbage, som det var."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Begriff der App. „Standard wiederherstellen“ bringt ihn wie ursprünglich zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρος της εφαρμογής. Η επαναφορά προεπιλογής τον φέρνει πίσω όπως ήταν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un término de la app. Restaurar predeterminado lo devuelve como venía."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenduse märksõna. Taasta vaikimisi toob selle tagasi algsel kujul."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژه‌ای از برنامه. «بازگرداندن پیش‌فرض» آن را به حالت اولیه برمی‌گرداند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen oma sana. Palauta oletus tuo sen takaisin alkuperäisenä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termino ito ng app. Ibinabalik ito ng Ibalik ang default kung paano ito dati."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terme de l’app. Rétablir par défaut le remet tel qu’il était."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઍપનો શબ્દ. ડિફૉલ્ટ પાછું લાવો તેને મૂળ જેવો પાછો લાવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מונח של האפליקציה. \"שחזור ברירת המחדל\" מחזיר אותו כמו שהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का शब्द। डिफ़ॉल्ट वापस लाएं इसे वैसे ही लौटा देता है जैसा यह आया था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojam aplikacije. Vrati zadano vraća ga u izvorni oblik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az app kifejezése. Az „Alapértelmezés visszaállítása” az eredeti állapotában hozza vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata bawaan aplikasi. Pulihkan default mengembalikannya seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un termine dell’app. Ripristina predefinita lo riporta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの単語です。「デフォルトに戻す」で元の状態に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 기본 키워드예요. 기본값 복원을 누르면 원래대로 돌아와요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programėlės raktažodis. „Atkurti numatytuosius“ grąžina jį tokį, koks buvo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotnes vārds. „Atjaunot noklusējumu” to atgriež sākotnējā veidā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ॲपचा शब्द. ‘डीफॉल्ट रिस्टोअर करा’ तो मूळ स्वरूपात परत आणते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istilah aplikasi. Pulihkan lalai mengembalikannya seperti asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ord fra appen. Gjenopprett standard henter det tilbake slik det var."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een term van de app. Standaard herstellen zet hem terug zoals hij was."
          }
