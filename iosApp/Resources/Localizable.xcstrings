    "Create a group first: an invite is always a group's link." : {
      "comment" : "Contacts' invite with no group yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعة أولًا: الدعوة دائمًا رابط لمجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първо създай група: поканата винаги е линк към група."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগে একটি গ্রুপ তৈরি করুন: আমন্ত্রণ সব সময় কোনো গ্রুপের লিংক হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív vytvoř skupinu: pozvánka je vždy odkaz na skupinu."
          }
        },
        "de" : {
          "stringUnit" : {
