    "Paste the link someone sent you in a message." : {
      "comment" : "Subtitle of the invite reader's paste panel",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق الرابط الذي أُرسل إليك في رسالة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постави линка, който някой ти е изпратил в съобщение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ মেসেজে যে লিংক পাঠিয়েছেন সেটি পেস্ট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enganxa l’enllaç que t’han enviat en un missatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlož odkaz, který ti někdo poslal ve zprávě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt det link, nogen har sendt dig i en besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Link ein, den dir jemand in einer Nachricht geschickt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικόλλησε τον σύνδεσμο που σου έστειλαν σε μήνυμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el enlace que te enviaron por mensaje."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleebi link, mille keegi sulle sõnumiga saatis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینکی را که کسی در پیامی برایتان فرستاده جای‌گذاری کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä linkki, jonka joku lähetti sinulle viestissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idikit ang link na ipinadala sa iyo sa mensahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colle le lien qu’on t’a envoyé dans un message."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈએ મેસેજમાં મોકલેલી લિંક પેસ્ટ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
