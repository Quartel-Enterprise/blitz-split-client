          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не дійшло до зчитувача. Спробуй ще раз, щойно будеш онлайн, або заповни вручну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh chưa đến được trình đọc. Hãy thử lại khi có mạng, hoặc tự nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
