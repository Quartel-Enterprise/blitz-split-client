        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישור לשימוש חד-פעמי. ההצטרפות של %@ מיידית, ישירות לשם הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार इस्तेमाल होने वाला लिंक। %@ जुड़ते ही तुरंत खुद बन जाएंगे।"
