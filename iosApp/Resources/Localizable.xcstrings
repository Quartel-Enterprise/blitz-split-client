    "Someone already joined through this link, or it was changed. Ask whoever sent it for a new one." : {
      "comment" : "Why a personal invite link no longer works: its member joined or was removed, or the group's link changed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبق أن انضم أحد عبر هذا الرابط، أو تم تغييره. اطلب رابطًا جديدًا ممن أرسله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über diesen Link ist schon jemand beigetreten, oder er wurde geändert. Bitte die Person, die ihn geschickt hat, um einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien ya se unió con este enlace, o se cambió. Pide uno nuevo a quien te lo envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un a déjà rejoint avec ce lien, ou il a été changé. Demande-en un nouveau à la personne qui te l’a envoyé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מישהו כבר הצטרף דרך הקישור הזה, או שהוא הוחלף. כדאי לבקש קישור חדש ממי ששלח אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस लिंक से कोई पहले ही जुड़ चुका है, या इसे बदल दिया गया है। जिसने भेजा है उनसे नया लिंक मांगें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seseorang sudah bergabung lewat tautan ini, atau tautannya diubah. Minta tautan baru ke orang yang mengirimnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
