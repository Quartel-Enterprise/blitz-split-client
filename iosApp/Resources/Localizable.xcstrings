    "Blitz Split doesn't move money: the payer pays in their bank app. Check that the key is in your name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينقل Blitz Split الأموال: يدفع الدافع من تطبيق بنكه. تحقّق من أن المفتاح باسمك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split не превежда пари: платецът плаща в приложението на банката си. Провери дали ключът е на твое име."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split টাকা স্থানান্তর করে না: যিনি পরিশোধ করবেন, তিনি নিজের ব্যাংকের অ্যাপে পরিশোধ করবেন। কী-টি আপনার নামে আছে কি না মিলিয়ে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split peníze nepřevádí: plátce platí v aplikaci své banky. Zkontroluj, že klíč je na tvoje jméno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split bewegt kein Geld: Wer zahlt, zahlt in der eigenen Banking-App. Prüfe, dass der Schlüssel auf deinen Namen läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Blitz Split δεν μεταφέρει χρήματα: ο πληρωτής πληρώνει από την εφαρμογή της τράπεζάς του. Έλεγξε ότι το κλειδί είναι στο όνομά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split no mueve dinero: el pago lo hace en la app del banco quien paga. Verifica que la clave esté a tu nombre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split پولی جابه‌جا نمی‌کند: پرداخت‌کننده در برنامه بانک خود پرداخت می‌کند. بررسی کنید که کلید به نام شما باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi naglilipat ng pera ang Blitz Split: nagbabayad ang nagbabayad sa bank app niya. Tiyaking nasa pangalan mo ang key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split ne déplace pas d’argent : le payeur paie dans l’app de sa banque. Vérifie que la clé est à ton nom."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split לא מעביר כסף: התשלום נעשה באפליקציית הבנק. כדאי לוודא שהמפתח רשום על שמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split पैसे ट्रांसफ़र नहीं करता: भुगतान करने वाला अपने बैंक ऐप में भुगतान करता है। देख लें कि कुंजी आपके नाम पर है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split ne prenosi novac: platitelj plaća u aplikaciji svoje banke. Provjeri je li ključ na tvoje ime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Blitz Split nem mozgat pénzt: a fizető a bankja appjában fizet. Ellenőrizd, hogy a kulcs a te nevedre szól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split tidak memindahkan uang: pembayar membayar di aplikasi banknya. Pastikan kunci ini atas namamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split non sposta denaro: chi paga lo fa nell’app della sua banca. Controlla che la chiave sia a tuo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Splitはお金を動かしません。支払う人は自分の銀行アプリで支払います。キーがあなたの名義であることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split은 돈을 옮기지 않아요. 내는 사람이 자기 은행 앱에서 송금해요. 키가 내 명의인지 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split tidak memindahkan wang: pembayar membayar dalam aplikasi banknya. Pastikan kunci itu atas nama anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split verplaatst geen geld: de betaler betaalt in de app van de bank. Controleer of de sleutel op jouw naam staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split nie przesyła pieniędzy: płacący płaci w aplikacji swojego banku. Sprawdź, czy klucz jest na twoje nazwisko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bora Rachar não movimenta dinheiro: o pagamento é feito no app do banco de quem paga. Confira se a chave está no seu nome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Blitz Split não movimenta dinheiro: o pagamento é feito na app do banco de quem paga. Confirma se a chave está no teu nome."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split nu mută bani: plătitorul plătește din aplicația băncii. Verifică dacă cheia este pe numele tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split не переводит деньги: плательщик платит в приложении своего банка. Проверь, что ключ оформлен на твоё имя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split nepresúva peniaze: platiteľ zaplatí vo svojej bankovej aplikácii. Skontroluj, či je kľúč na tvoje meno."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split ne prenosi novac: platilac plaća u svojoj bankarskoj aplikaciji. Proveri da je ključ na tvoje ime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split flyttar inga pengar: betalaren betalar i sin bankapp. Kontrollera att nyckeln står i ditt namn."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split பணத்தை அனுப்பாது: செலுத்துபவர் தங்கள் வங்கி ஆப்பில் செலுத்துவார். கீ உங்கள் பெயரில் உள்ளதா எனச் சரிபாருங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split ไม่ได้โอนเงิน คนจ่ายจะจ่ายในแอปธนาคารของตัวเอง ตรวจสอบว่าคีย์เป็นชื่อของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split para aktarmaz: ödeyen kişi kendi banka uygulamasından öder. Anahtarın senin adına olduğunu kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split не переказує гроші: платник платить у застосунку свого банку. Перевір, що ключ оформлено на тебе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split پیسے منتقل نہیں کرتا: ادا کرنے والا اپنی بینک ایپ میں ادائیگی کرتا ہے۔ چیک کریں کہ کلید آپ کے نام پر ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split không chuyển tiền: người trả sẽ trả trong ứng dụng ngân hàng của họ. Hãy kiểm tra khóa đứng tên bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split不经手资金：付款人在自己的银行应用中付款。请确认密钥登记在你的名下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split不經手資金：付款人在自己的銀行App中付款。請確認金鑰登記在你的名下。"
          }
        }
      }
    },
