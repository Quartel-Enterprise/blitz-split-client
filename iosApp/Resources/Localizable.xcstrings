    "Only you see these. Mark which one you paid a bill with." : {
      "comment" : "Under Profile's payment methods",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يراها أحد غيرك. حدّد أيها استخدمت لدفع فاتورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst sie. Markiere, womit du eine Ausgabe bezahlt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú los ves. Marca con cuál pagaste cada gasto."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú los ves. Marca con cuál has pagado cada gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous seul les voyez. Indiquez avec lequel vous avez payé chaque dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק לך הם גלויים. אפשר לסמן באיזה מהם שולם חשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें सिर्फ़ आप देखते हैं। बताएं कि आपने किसी खर्च का भुगतान किससे किया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya kamu yang melihatnya. Tandai metode yang kamu pakai untuk membayar tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li vedi solo tu. Segna con quale hai pagato ogni spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなただけに表示されます。どの方法で支払ったかを支出に記録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만 볼 수 있어요. 어떤 수단으로 지출을 결제했는지 표시하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen jij ziet ze. Geef aan waarmee je een uitgave betaalde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzisz je tylko Ty. Zaznaczaj, czym płacisz za wydatki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você vê. Marque com qual pagou cada conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só tu vês isto. Marca com qual pagaste cada conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их видишь только ты. Отмечай, каким способом ты оплатил(а) счёт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีแค่คุณที่เห็น ใช้ทำเครื่องหมายว่าจ่ายบิลด้วยช่องทางไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları yalnızca sen görürsün. Her harcamayı hangisiyle ödediğini işaretle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Їх бачиш лише ти. Познач, яким способом ти оплатив рахунок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ bạn thấy những mục này. Đánh dấu phương thức bạn đã dùng để trả một khoản chi."
