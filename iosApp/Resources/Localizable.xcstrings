        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ elige su nombre en la lista o se une como miembro nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ valib loendist oma nime või liitub uue liikmena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نام خود را از فهرست انتخاب می‌کند یا به‌عنوان عضو جدید می‌پیوندد."
          }
        },
        "fi" : {
          "stringUnit" : {
