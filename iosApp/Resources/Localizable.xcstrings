        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループで%@を支払う必要があった人は、引き続き%@を支払います。お金の行き先だけが変わります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie %@ schuldig was in de groep, is nog steeds %@ schuldig. Alleen waar het geld heen gaat, verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto miał w grupie do oddania %1$@, nadal ma do oddania %2$@. Zmienia się tylko, dokąd trafiają pieniądze."
