        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ההצטרפות הייתה שלך, כדאי לפנות למי ששלח את ההזמנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह आप थे, तो जिसने आपको आमंत्रित किया है उससे बात करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau itu kamu, bicaralah dengan orang yang mengundangmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eri tu, parlane con chi ti ha invitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身の場合は、招待した人に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인이라면 초대한 사람과 이야기해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jij het? Neem contact op met wie je heeft uitgenodigd."
