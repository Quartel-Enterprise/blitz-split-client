    "%@ simplified the debts just now. You no longer owe %@ in %@." : {
      "comment" : "Record payment, 13.5c: who turned Simplify debts on, the receiver, the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: تبسيط الديون للتو. لم يعد عليك شيء لـ %@ في %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ опрости дълговете току-що. Вече не дължиш на %@ в %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ এইমাত্র দেনা সহজ করেছেন। %3$@ গ্রুপে আপনাকে আর %2$@-কে দিতে হবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acaba de simplificar els deutes. Ja no deus res a %@ al grup «%@»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ právě zjednodušil(a) dluhy. Už nedlužíš osobě %@ ve skupině %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forenklede gælden lige nu. Du skylder ikke længere %@ i %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat gerade die Schulden vereinfacht. Du schuldest %2$@ in %3$@ nichts mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ απλοποίησε τα χρέη μόλις τώρα. Δεν χρωστάς πια σε %@ στην ομάδα %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó las deudas hace un momento. Ya no le debes %2$@ a %3$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on just võlgu lihtsustanud. Sa ei võlgne enam liikmele %@ grupis %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ همین الان بدهی‌ها را ساده کرد. دیگر به %@ در %@ بدهکار نیستید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yksinkertaisti juuri velat. Et ole enää velkaa henkilölle %@ ryhmässä %@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinasimple ni %@ ang mga utang ngayon lang. Wala ka nang utang na %@ sa %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vient de simplifier les dettes. Tu ne dois plus rien à %2$@ dans %3$@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ એ હમણાં જ દેવાં સરળ કર્યાં. હવે તમારે %@ ને આપવાના નથી (ગ્રુપ: %@)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: פישוט חובות, ממש עכשיו. ל-%2$@ כבר לא מגיע ממך כלום ב-%3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने अभी-अभी कर्ज़ सरल किए। अब %3$@ में आप पर %2$@ का बकाया नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je upravo pojednostavio/la dugove. Više ne duguješ članu %@ u grupi „%@“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ egyszerűsítette az adósságokat az imént. Már nem tartozol neki: %2$@, ebben a csoportban: %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ baru saja menyederhanakan utang. Kamu tidak lagi berutang ke %@ di %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha appena semplificato i debiti. Non devi più niente a %@ in %@."
