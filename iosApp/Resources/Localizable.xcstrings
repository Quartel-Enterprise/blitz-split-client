        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile lasciare il gruppo. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループから退出できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹에서 나가지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko išeiti iš grupės. Patikrink ryšį ir bandyk dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās pamest grupu. Pārbaudi savienojumu un mēģini vēlreiz."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप सोडता आला नाही. तुमचे कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
