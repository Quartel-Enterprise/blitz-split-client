          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語をタップすると、カテゴリを変更したり削除したりできます。単語全体に一致し、アクセントや大文字・小文字は区別しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een term om de categorie te wijzigen of hem te verwijderen. Hij komt overeen met het hele woord, ongeacht accenten en hoofdletters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij słowo, aby zmienić jego kategorię lub je usunąć. Dopasowuje całe słowo, bez względu na akcenty i wielkość liter."
