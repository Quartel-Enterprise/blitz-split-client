    "Touch and hold one of the group's categories to edit or delete it." : {
      "comment" : "Category picker",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مطولًا إحدى فئات المجموعة لتعديلها أو حذفها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръж върху някоя от категориите на групата, за да я редактираш или изтриеш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পাদনা করতে বা মুছতে গ্রুপের কোনো ক্যাটাগরি চেপে ধরে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premuda una de les categories del grup per editar-la o suprimir-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž jednu z kategorií skupiny, abys ji upravil(a) nebo smazal(a)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på en af gruppens kategorier for at redigere eller slette den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine der Kategorien der Gruppe gedrückt, um sie zu bearbeiten oder zu löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα μια κατηγορία της ομάδας για να την επεξεργαστείς ή να τη διαγράψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una de las categorías del grupo para editarla o eliminarla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta ja hoia grupi kategooriat, et seda muuta või kustutada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ویرایش یا حذف یکی از دسته‌بندی‌های گروه، آن را لمس کرده و نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ryhmän luokkaa painettuna muokataksesi tai poistaaksesi sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal ang isa sa mga kategorya ng grupo para i-edit o burahin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie longuement sur une catégorie du groupe pour la modifier ou la supprimer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ગ્રુપની કોઈ કેટેગરીને એડિટ કે ડિલીટ કરવા માટે તેને દબાવી રાખો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה ארוכה על אחת מהקטגוריות של הקבוצה מאפשרת לערוך או למחוק אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप की किसी श्रेणी को बदलने या हटाने के लिए उसे दबाकर रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni i drži jednu od kategorija grupe da je urediš ili izbrišeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd lenyomva a csoport egyik kategóriáját a szerkesztéshez vagy törléshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan salah satu kategori grup untuk mengedit atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una delle categorie del gruppo per modificarla o eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループのカテゴリを長押しすると、編集や削除ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹 카테고리를 길게 눌러 수정하거나 삭제하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paliesk ir palaikyk vieną iš grupės kategorijų, kad ją redaguotum ar ištrintum."
          }
        },
