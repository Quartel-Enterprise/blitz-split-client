    "Doesn't have the app: let them know with Request." : {
      "comment" : "Simplify debts: a guest whose payments change",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون التطبيق: يمكنك الإبلاغ عبر «طلب الدفع»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма приложението: уведоми го с Поискай."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তাঁর অ্যাপ নেই: “টাকা চান” দিয়ে তাঁকে জানান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No té l’app: avisa’l amb Demanar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemá aplikaci: dej vědět přes Požádat o platbu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ikke appen: giv besked med Bed om betaling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat die App nicht: Sag Bescheid mit „Anfordern“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει την εφαρμογή: ενημέρωσε το άτομο με το «Ζήτησε πληρωμή»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene la app: avísale con Cobrar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tal pole rakendust: anna talle teada nupuga Küsi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه را ندارد: با «درخواست» به او خبر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänellä ei ole sovellusta: kerro hänelle Pyydä maksua -toiminnolla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang app: ipaalam sa kanila gamit ang Hilingin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’a pas l’app : préviens cette personne avec Demander."
          }
        },
