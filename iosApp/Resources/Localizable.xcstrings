    "Know when someone records a payment or asks you to pay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف متى يسجّل أحدهم دفعة أو يطلب منك الدفع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разбери, когато някой запише плащане или те помоли да платиш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ পেমেন্ট নথিভুক্ত করলে বা আপনাকে পরিশোধ করতে বললে জানতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
