    "You still have an open balance in “%@”. Leaving now would leave it unsettled for the others." : {
      "comment" : "Why someone can't leave the group yet; %@ is the group's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما زال لديك رصيد مفتوح في «%@». المغادرة الآن ستتركه دون تسوية للآخرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch einen offenen Saldo in „%@“. Wenn du jetzt gehst, bleibt er für die anderen unbeglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún tienes un saldo pendiente en “%@”. Salir ahora dejaría las cuentas sin saldar para los demás."
