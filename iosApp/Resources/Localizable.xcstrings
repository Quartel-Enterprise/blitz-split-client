    "Whoever is hidden stays in the groups. They come back to the list by themselves if they join a new bill with you." : {
      "comment" : "Under the hidden contacts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Personen bleiben in den Gruppen. Sie kommen von selbst in die Liste zurück, wenn ihr gemeinsam bei einer neuen Ausgabe dabei seid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien está oculto sigue en los grupos. Vuelve a la lista automáticamente si se une a un gasto nuevo contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes masquées restent dans les groupes. Elles reviennent dans la liste toutes seules si elles rejoignent une nouvelle dépense avec toi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang disembunyikan tetap ada di grup. Mereka kembali ke daftar dengan sendirinya kalau ikut tagihan baru bersamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi è nascosto resta nei gruppi. Torna nella lista da sé se partecipa a una nuova spesa con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示にした人もグループには残ります。あなたと一緒に新しい支出に加わると、自動的にリストに戻ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie verborgen is, blijft in de groepen. Ze komen vanzelf terug in de lijst als ze met jou in een nieuwe uitgave zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryte osoby zostają w grupach. Wrócą na listę samoczynnie, jeśli dołączą z tobą do nowego wydatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem está oculto continua nos grupos. Volta para a lista sozinho se entrar numa conta nova com você."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlenen kişiler gruplarda kalır. Seninle yeni bir harcamaya katılırsa listeye kendiliğinden geri döner."
          }
        }
      }
    },
    "Whoever opens the link picks their name on the group's list or joins as a new member." : {
      "comment" : "An invite for anyone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Link öffnet, wählt den eigenen Namen in der Liste der Gruppe oder tritt als neues Mitglied bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra el enlace elige su nombre en la lista del grupo o se une como miembro nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque ouvre le lien choisit son nom dans la liste du groupe ou rejoint comme nouveau membre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang membuka tautannya memilih namanya dari daftar grup atau bergabung sebagai anggota baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi apre il link sceglie il proprio nome dalla lista del gruppo o entra come nuovo membro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開いた人は、グループのリストから自分の名前を選ぶか、新しいメンバーとして参加します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de link opent, kiest zijn naam in de lijst van de groep of doet mee als nieuw lid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto otworzy link, wybierze swoje imię z listy grupy albo dołączy jako nowy członek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link escolhe o nome na lista do grupo ou entra como membro novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı açan kişi grubun listesinden ismini seçer ya da yeni üye olarak katılır."
          }
        }
      }
    },
    "Whoever shares a group with you shows up here, with the balance of each one." : {
      "comment" : "Contacts with nobody yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer eine Gruppe mit dir teilt, erscheint hier, jeweils mit dem Saldo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien comparta un grupo contigo aparece aquí, con el saldo de cada persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui partage un groupe avec toi s’affiche ici, avec le solde de chacun."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang satu grup denganmu muncul di sini, dengan saldo masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi condivide un gruppo con te compare qui, con il saldo di ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたとグループを共有している人が、それぞれの残高とともにここに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie een groep met je deelt, verschijnt hier, met het saldo van ieder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawi się każdy, kto ma z tobą wspólną grupę, z saldem każdej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem dividir um grupo com você aparece aqui, com o saldo de cada um."
