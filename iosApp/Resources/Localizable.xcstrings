    "To read the QR code, allow Blitz Split to use the camera in Settings. Or paste the link below." : {
      "comment" : "The camera permission was denied, on iPhone and iPad",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den QR-Code zu lesen, erlaube Blitz Split in den Einstellungen, die Kamera zu nutzen. Oder füge den Link unten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leer el código QR, permite que Blitz Split use la cámara en Ajustes. O pega el enlace abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire le QR code, autorise Blitz Split à utiliser l’appareil photo dans les Réglages. Ou colle le lien ci-dessous."
