          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un a déjà rejoint avec ce lien, ou il a été changé. Demande-en un nouveau à la personne qui te l’a envoyé."
          }
