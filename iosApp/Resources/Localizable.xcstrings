    "Couldn't merge. Try again." : {
      "comment" : "A toast: the claim didn't reach the server",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenführen fehlgeschlagen. Versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo fusionar. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de fusionner. Réessaie."
          }
