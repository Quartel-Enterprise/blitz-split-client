    "It becomes a payment in the group: it shows in Expenses and can be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح دفعة في المجموعة: تظهر في المصروفات ويمكن التراجع عنها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Става плащане в групата: показва се в Разходи и може да бъде отменено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি গ্রুপে একটি পেমেন্ট হিসেবে যুক্ত হবে: খরচের তালিকায় দেখা যাবে এবং পূর্বাবস্থায় ফেরানো যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze záznamu se stane platba ve skupině: zobrazí se ve Výdajích a jde vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zu einer Zahlung in der Gruppe: Sie erscheint in „Ausgaben“ und lässt sich rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεται πληρωμή στην ομάδα: εμφανίζεται στα Έξοδα και μπορεί να αναιρεθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se convierte en un pago del grupo: aparece en Gastos y se puede deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به یک پرداخت در گروه تبدیل می‌شود: در هزینه‌ها نمایش داده می‌شود و قابل لغو است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magiging bayad ito sa grupo: lalabas ito sa Mga gastos at puwedeng i-undo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça devient un paiement dans le groupe : il s’affiche dans Dépenses et peut être annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה נרשם כתשלום בקבוצה: הוא מופיע בהוצאות ואפשר לבטל אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ग्रुप में एक भुगतान बन जाता है: यह खर्चों में दिखता है और इसे पहले जैसा किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaje uplata u grupi: prikazuje se u Troškovima i može se poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizetés lesz belőle a csoportban: megjelenik a Kiadások között, és visszavonható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menjadi pembayaran di grup: tampil di Pengeluaran dan bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventa un pagamento nel gruppo: compare in Spese e si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループ内の支払いとして記録されます：「支出」に表示され、取り消すこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 송금으로 기록돼요: 지출에 표시되고 되돌릴 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia menjadi bayaran dalam kumpulan: dipaparkan dalam Perbelanjaan dan boleh dibuat asal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt een betaling in de groep: die staat bij Uitgaven en kan ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanie się płatnością w grupie: pojawi się w Wydatkach i można ją cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vira um acerto no grupo: aparece em Despesas e dá para desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a ser um acerto no grupo: aparece em Despesas e é possível desfazer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devine o plată în grup: apare în Cheltuieli și poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это станет платежом в группе: он появится в Расходах, и его можно будет отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stane sa z toho platba v skupine: zobrazí sa vo Výdavkoch a dá sa vrátiť späť."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaje uplata u grupi: prikazuje se u Troškovima i može da se poništi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det blir en betalning i gruppen: den syns under Utgifter och kan ångras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது குழுவில் ஒரு பேமெண்ட்டாக மாறும்: செலவுகளில் தெரியும், செயல்தவிர்க்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะกลายเป็นการจ่ายเงินในกลุ่ม: แสดงในบิล และเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupta bir ödeme olur: Harcamalar'da görünür ve geri alınabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це стане платежем у групі: він з'явиться у Витратах, і його можна скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ گروپ میں ایک ادائیگی بن جاتی ہے: یہ اخراجات میں نظر آتی ہے اور واپس لی جا سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản này sẽ thành một khoản thanh toán trong nhóm: hiển thị trong Khoản chi và có thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会成为群组中的一笔付款：显示在“账单”中，并且可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會成為群組中的一筆付款：顯示在「帳單」中，並且可以復原。"
          }
        }
      }
    },
    "No internet: it's saved on this device and syncs when you reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إنترنت: تم الحفظ على هذا الجهاز وتتم المزامنة عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма интернет: запазено е на това устройство и ще се синхронизира, когато се свържеш отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট নেই: এটি এই ডিভাইসে সংরক্ষিত হয়েছে এবং আবার সংযুক্ত হলে সিঙ্ক হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetu: uloží se v tomto zařízení a synchronizuje se, až se znovu připojíš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Sie ist auf diesem Gerät gespeichert und wird synchronisiert, wenn du wieder verbunden bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ίντερνετ: αποθηκεύτηκε σε αυτή τη συσκευή και θα συγχρονιστεί όταν συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: queda guardado en el dispositivo y se sincroniza al reconectarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اینترنت ندارید: در این دستگاه ذخیره می‌شود و با اتصال دوباره همگام‌سازی می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang internet: nakasave ito sa device na ito at magsi-sync kapag nakakonekta ka ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : c’est enregistré sur cet appareil et se synchronise à la reconnexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אינטרנט: זה נשמר במכשיר הזה ויסונכרן כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नहीं है: यह इस डिवाइस पर सहेजा गया है और दोबारा कनेक्ट होने पर सिंक होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema interneta: spremljeno je na ovom uređaju i sinkronizira se kad se ponovno povežeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs internet: ezen az eszközön mentve, és szinkronizálódik, amint újra csatlakozol."
          }
        },
        "id" : {
