        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl deinen Namen. Du siehst die Ausgaben, die für diese Person schon hinzugefügt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se agregeron para esa persona."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se añadieron para esa persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis ton nom. Tu verras les dépenses déjà ajoutées pour cette personne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih namamu. Kamu akan melihat pengeluaran yang sudah ditambahkan untuk orang itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il tuo nome. Vedrai le spese già aggiunte per quella persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の名前を選んでください。その人の分としてすでに追加された支出が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 이름을 고르세요. 그 사람 앞으로 이미 추가된 지출을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies je naam. Je ziet de uitgaven die al voor die persoon zijn toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz swoje imię. Zobaczysz wydatki już dodane dla tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha seu nome. Você vai ver os gastos que já foram lançados para essa pessoa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o teu nome. Vais ver as despesas já registadas para essa pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери своё имя. Ты увидишь расходы, уже добавленные для этого человека."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsmini seç. O kişi için önceden eklenen harcamaları görürsün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обери своє ім'я. Ти побачиш витрати, уже додані для цієї людини."
          }
        }
      }
    },
