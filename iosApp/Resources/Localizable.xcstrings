    },
    "This is an on-chain address, so we switched to On-chain." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é um endereço on-chain, então mudamos para On-chain."
          }
        }
      }
    },
    "This isn't a Lightning Address (name@wallet) or an LNURL." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto não é um Lightning Address (nome@carteira) nem um LNURL."
          }
        }
      }
    },
    "To change it, make another key the default." : {
      "localizations" : {
