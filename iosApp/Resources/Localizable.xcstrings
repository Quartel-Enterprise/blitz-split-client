    "By continuing, you accept the [Terms of Service](legal:terms) and acknowledge the [Privacy Policy](legal:privacy)." : {
      "comment" : "Welcome: the legal notice under the buttons; keep both links with their legal: addresses",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, akzeptierst du die [Nutzungsbedingungen](legal:terms) und bestätigst, die [Datenschutzerklärung](legal:privacy) gelesen zu haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas los [Términos de Servicio](legal:terms) y declaras conocer la [Política de Privacidad](legal:privacy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
