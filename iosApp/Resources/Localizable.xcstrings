        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens 1 pagamento na fila: %@. A simplificação conta com ele; se ele mudar, os pagamentos sugeridos ajustam-se sozinhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя 1 платёж в очереди: %@. Упрощение его учитывает; если он изменится, предлагаемые платежи подстроятся сами."
          }
        },
        "tr" : {
          "stringUnit" : {
