    "%@ deleted “%@” after everyone settled up. Nothing was left open, and the group leaves your list." : {
      "comment" : "Someone else deleted the group while it was open; the first %@ is who, the second the group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat „%2$@“ gelöscht, nachdem alle beglichen hatten. Nichts war mehr offen, und die Gruppe verschwindet aus deiner Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eliminó “%2$@” después de que todos saldaron cuentas. No quedó nada pendiente, y el grupo sale de tu lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a supprimé « %2$@ » après que tout le monde a réglé. Il ne restait rien d’ouvert, et le groupe quitte ta liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha eliminato «%@» dopo che tutti avevano saldato. Non era rimasto nulla in sospeso e il gruppo esce dalla tua lista."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skasował(a) „%2$@” po pełnym rozliczeniu. Nic nie zostało otwarte, a grupa znika z twojej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois que todo mundo acertou. Nada ficou pendente, e o grupo sai da sua lista."
          }
        }
      }
    },
