    "Couldn't leave the group. Check your connection and try again." : {
      "comment" : "Leaving the group failed: no sync or no answer from the server",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت مغادرة المجموعة. تحقّق من الاتصال وأعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppe konnte nicht verlassen werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo salir del grupo. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de quitter le groupe. Vérifie ta connexion et réessaie."
