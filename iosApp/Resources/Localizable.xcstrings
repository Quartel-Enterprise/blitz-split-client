        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підсумок уже враховує всі групи: «Нагадати про оплату» й «Мені сплатили» використовують %@. Застосунок записує платіж у кожній групі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خالص رقم پہلے ہی گروپس کو ایڈجسٹ کرتی ہے: “رقم مانگیں” اور “رقم مل گئی” میں %@ استعمال ہوتا ہے۔ ایپ ہر گروپ میں ایک ادائیگی درج کرتی ہے۔"
          }
