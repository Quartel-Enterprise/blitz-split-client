        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra interneto: išlaida išsaugota šiame įrenginyje ir jau įskaičiuota į balansus. Ji bus sinchronizuota, kai vėl prisijungsi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav interneta: rēķins ir saglabāts šajā ierīcē un jau tiek ieskaitīts bilancēs. Tas sinhronizēsies, kad atjaunosies savienojums."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नाही: खर्च या डिव्हाइसवर सेव्ह झाला आहे आणि आत्ताच बॅलन्समध्ये मोजला जातो. तुम्ही पुन्हा कनेक्ट झाल्यावर तो सिंक होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada internet: bil disimpan pada peranti ini dan dikira dalam baki sekarang. Ia akan disegerakkan apabila anda kembali dalam talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten nett: utgiften er lagret på denne enheten og teller med i saldoene med en gang. Den synkroniseres når du kobler til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internet: de uitgave is op dit apparaat bewaard en telt nu al mee in de saldi. Hij wordt gesynchroniseerd zodra je weer verbinding hebt."
