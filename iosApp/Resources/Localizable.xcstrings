    "Whoever owed %@ in the group still owes %@. Only where the money goes changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Gruppe %1$@ geschuldet hat, schuldet weiterhin %2$@. Nur wohin das Geld geht, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien debía %1$@ en el grupo sigue debiendo %2$@. Solo cambia a quién va el dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui devait %1$@ dans le groupe doit toujours %2$@. Seul change où va l’argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi doveva %@ nel gruppo deve ancora %@. Cambia solo dove vanno i soldi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto miał w grupie do oddania %1$@, nadal ma do oddania %2$@. Zmienia się tylko, dokąd trafiają pieniądze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem devia %1$@ no grupo continua devendo %2$@. Só muda para quem vai o dinheiro."
          }
        }
      }
    },
    "You may owe someone you never split a bill with" : {
