    "This bill is from the group %@. Whoever is in the group also sees their own part and the history." : {
      "comment" : "Over a bill opened from its link; %@ is the group's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الفاتورة من المجموعة %@. كل من في المجموعة يرى أيضًا حصته والسجل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ausgabe gehört zur Gruppe %@. Wer in der Gruppe ist, sieht auch den eigenen Anteil und den Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gasto es del grupo %@. Quien esté en el grupo también ve su propia parte y el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette dépense vient du groupe %@. Les membres du groupe voient aussi leur propre part et l’historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון הזה שייך לקבוצה %@. חברי הקבוצה רואים גם את החלק האישי שלהם ואת ההיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह खर्च %@ ग्रुप का है। ग्रुप में जो भी है, वह अपना हिस्सा और इतिहास भी देखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan ini dari grup %@. Siapa pun di grup juga melihat bagiannya sendiri dan riwayatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa spesa è del gruppo %@. Chi è nel gruppo vede anche la propria parte e la cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支出はグループ「%@」のものです。グループのメンバーは、自分の分と履歴も見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지출은 ‘%@’ 그룹의 지출이에요. 그룹에 있는 사람은 자기 몫과 기록도 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze uitgave is van de groep %@. Wie in de groep zit, ziet ook het eigen deel en de geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten wydatek pochodzi z grupy %@. Osoby z grupy widzą też swój udział i historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta é do grupo %@. Quem está no grupo vê também a própria parte e o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот счёт из группы %@. Участники группы также видят свою долю и историю."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลนี้มาจากกลุ่ม “%@” ใครที่อยู่ในกลุ่มจะเห็นส่วนของตัวเองและประวัติด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu harcama %@ grubuna ait. Gruptaki herkes kendi payını ve geçmişi de görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей рахунок із групи %@. Учасники групи також бачать свою частку й історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản chi này thuộc nhóm %@. Người trong nhóm còn thấy phần của mình và lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这笔账单来自群组“%@”。群组中的人还能看到自己的份额和历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這筆帳單來自群組「%@」。群組中的人還能看到自己的份額和歷史紀錄。"
          }
        }
      }
    },
    "Want to comment? Sign in with an account. You don't need to be in the group." : {
      "comment" : "A bill's link page, in the composer's place while nobody is signed in",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد التعليق؟ سجّل الدخول بحساب. لا يلزم أن تكون في المجموعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du kommentieren? Melde dich mit einem Konto an. Du musst nicht in der Gruppe sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres comentar? Inicia sesión con una cuenta. No necesitas estar en el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux commenter ? Connecte-toi avec un compte. Pas besoin d’être dans le groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוצה להגיב? אפשר להתחבר עם חשבון משתמש. אין צורך להיות בקבוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टिप्पणी करना चाहते हैं? किसी अकाउंट से साइन इन करें। आपका ग्रुप में होना ज़रूरी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mau berkomentar? Masuk dengan akun. Kamu tidak perlu ada di grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi commentare? Accedi con un account. Non serve essere nel gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コメントするにはアカウントでログインしてください。グループに参加している必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "댓글을 남기고 싶나요? 계정으로 로그인하세요. 그룹에 없어도 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je reageren? Log in met een account. Je hoeft niet in de groep te zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz skomentować? Zaloguj się na konto. Nie musisz być w grupie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer comentar? Entre com uma conta. Não precisa estar no grupo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queres comentar? Inicia sessão com uma conta. Não precisas de estar no grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочешь прокомментировать? Войди с аккаунтом. Быть в группе не обязательно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยากแสดงความคิดเห็นไหม ลงชื่อเข้าใช้ด้วยบัญชี ไม่จำเป็นต้องอยู่ในกลุ่ม"
