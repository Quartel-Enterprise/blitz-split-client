    "Day works for periods of up to 3 months." : {
      "comment" : "The group statistics: why Day is off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار «يوم» متاح للفترات حتى 3 أشهر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Tag“ funktioniert für Zeiträume bis zu 3 Monaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Día vale para períodos de hasta 3 meses."
          }
        },
        "fr" : {
          "stringUnit" : {
