        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“గ్రూప్‌ను ఎడిట్ చేయండి”లో. ఎవరు మార్చారో యాక్టివిటీ చూపిస్తుంది, ఇప్పుడు వేరొకరికి చెల్లించేవారికి లేదా వేరొకరి నుండి అందుకునేవారికి నోటిఫికేషన్ వస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
