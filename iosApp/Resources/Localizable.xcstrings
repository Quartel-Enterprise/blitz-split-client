    "With 2 people it's already a single payment. Available once a third person joins." : {
      "comment" : "Edit group: why Simplify debts is unavailable",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع شخصين تكون دفعة واحدة أصلًا. يتاح عند انضمام شخص ثالث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С 2 души това вече е едно плащане. Достъпно е, когато се присъедини трети човек."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 জনের ক্ষেত্রে এটি আগে থেকেই একটি পেমেন্ট। তৃতীয় কেউ যোগ দিলে পাওয়া যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb 2 persones ja és un sol pagament. Disponible quan entri una tercera persona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se 2 lidmi je to už jedna platba. K dispozici, až se připojí třetí člověk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med 2 personer er det allerede én betaling. Tilgængelig, når en tredje person bliver medlem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 2 Personen ist es schon eine einzige Zahlung. Verfügbar, sobald eine dritte Person beitritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με 2 άτομα είναι ήδη μία πληρωμή. Διαθέσιμο μόλις μπει τρίτο άτομο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 2 personas ya es un solo pago. Estará disponible cuando se una una tercera persona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahe inimesega on see juba üks makse. Saadaval, kui kolmas inimene liitub."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با 2 نفر از قبل فقط یک پرداخت است. وقتی نفر سوم بپیوندد در دسترس می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahdella henkilöllä se on jo yksi maksu. Käytettävissä, kun kolmas henkilö liittyy."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
