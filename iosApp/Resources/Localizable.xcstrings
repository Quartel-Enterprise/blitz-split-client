    "Blitz Split doesn't move money: the payer pays in their bank app. Check that the key is in your name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split bewegt kein Geld: Wer zahlt, zahlt in der eigenen Banking-App. Prüfe, dass der Schlüssel auf deinen Namen läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split no mueve dinero: el pago lo hace en la app del banco quien paga. Verifica que la clave esté a tu nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split ne déplace pas d’argent : le payeur paie dans l’app de sa banque. Vérifie que la clé est à ton nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split tidak memindahkan uang: pembayar membayar di aplikasi banknya. Pastikan kunci ini atas namamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split non sposta denaro: chi paga lo fa nell’app della sua banca. Controlla che la chiave sia a tuo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Splitはお金を動かしません。支払う人は自分の銀行アプリで支払います。キーがあなたの名義であることを確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split verplaatst geen geld: de betaler betaalt in de app van de bank. Controleer of de sleutel op jouw naam staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split nie przesyła pieniędzy: płacący płaci w aplikacji swojego banku. Sprawdź, czy klucz jest na twoje nazwisko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bora Rachar não movimenta dinheiro: o pagamento é feito no app do banco de quem paga. Confira se a chave está no seu nome."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
