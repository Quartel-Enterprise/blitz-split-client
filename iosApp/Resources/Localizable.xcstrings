        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ลดความซับซ้อนของหนี้แล้ว คุณจึงจ่ายให้ฉันโดยตรงแทนที่จะจ่ายให้ %@ ยอดรวมของคุณไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubu borçlarını sadeleştirdi; bu yüzden %@ kişisine ödemek yerine doğrudan bana ödüyorsun. Toplamın değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У групі %@ спростили борги, тож замість платити учаснику %@ ти платиш мені напряму; твоя загальна сума не змінилася."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے اپنے قرض آسان کیے، اس لیے %@ کو ادا کرنے کے بجائے آپ مجھے سیدھا ادا کریں؛ آپ کی کل رقم نہیں بدلی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã đơn giản hóa nợ, nên thay vì trả cho %@, bạn trả thẳng cho mình; tổng của bạn không thay đổi."
