          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene på den slettes når det den hadde i kø, er sendt. iPhonen din forblir pålogget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevens worden gewist zodra alles in de wachtrij is verstuurd. Je iPhone blijft ingelogd."
