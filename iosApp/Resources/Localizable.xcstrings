    "Bill saved in %@, not in %@, which the map suggested. Teach the map?" : {
      "comment" : "Despesas, after saving",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabe in %1$@ gespeichert, nicht in %2$@, wie die Zuordnung vorschlug. Zuordnung anlernen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasto guardado en %1$@, y no en %2$@, que sugirió el mapa. ¿Enseñárselo al mapa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépense enregistrée dans %1$@, et non dans %2$@, que la carte proposait. Apprendre à la carte ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan disimpan di %@, bukan di %@ yang disarankan peta. Ajari peta?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesa salvata in %@, non in %@ come suggeriva la mappa. Vuoi insegnarlo alla mappa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出は%@に保存されました（マップの提案は%@）。マップに覚えさせますか？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgave opgeslagen in %1$@, niet in %2$@, wat de kaart voorstelde. De kaart iets leren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydatek zapisano w kategorii %1$@ zamiast sugerowanej przez mapę: %2$@. Nauczyć mapę?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta salva em %1$@, e não em %2$@, que o mapa sugeriu. Ensinar ao mapa?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcama %@ kategorisine kaydedildi, haritanın önerdiği %@ kategorisine değil. Haritaya öğretilsin mi?"
          }
        }
      }
    },
