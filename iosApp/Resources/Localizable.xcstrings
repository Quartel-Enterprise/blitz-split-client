    "%@ picks their name on the list or joins as a new member." : {
      "comment" : "An invite for someone of the agenda",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار %@ اسمه من القائمة أو ينضم كعضو جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ избира името си от списъка или се присъединява като нов член."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ তালিকা থেকে নিজের নাম বেছে নেবেন বা নতুন সদস্য হিসেবে যোগ দেবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tria el seu nom a la llista o entra com a membre nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si vybere své jméno ze seznamu nebo se připojí jako nový člen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vælger sit navn på listen eller bliver medlem som et nyt medlem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wählt den eigenen Namen in der Liste oder tritt als neues Mitglied bei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ διαλέγει όνομα από τη λίστα ή μπαίνει ως νέο μέλος."
