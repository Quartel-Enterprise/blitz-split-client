    "The %lld bills with %@ move to %@. The category goes for all of %@." : {
      "comment" : "Delete category",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورتان فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فواتير فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              }
            }
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld разхода с %@ се преместват в %@. Категорията изчезва за цялата група „%@“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে %lld টি বিলে %@ আছে, সেগুলো %@ ক্যাটাগরিতে চলে যাবে। পুরো %@ গ্রুপ থেকে ক্যাটাগরিটি মুছে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdaje s %@ (%lld) se přesunou do %@. Kategorie zmizí pro celou skupinu %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$lld Ausgaben mit %2$@ wandern zu %3$@. Die Kategorie verschwindet für ganz %4$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα %lld έξοδα με %@ μεταφέρονται σε %@. Η κατηγορία καταργείται για όλη την ομάδα %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %1$lld gastos con %2$@ pasan a %3$@. La categoría desaparece para todo el grupo %4$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld هزینه دارای %@ به %@ منتقل می‌شوند. دسته‌بندی برای همه اعضای %@ حذف می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang %lld bill na may %@ ay mapupunta sa %@. Para sa buong %@ ang kategorya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$lld dépenses avec %2$@ passent dans %3$@. La catégorie vaut pour tout %4$@."
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבון עם %@ יעבור ל-%@. הקטגוריה תימחק עבור כל הקבוצה %@."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבונות עם %@ עוברים ל-%@. הקטגוריה נמחקת לכל חברי %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבונות עם %@ עוברים ל-%@. הקטגוריה נמחקת לכל חברי %@."
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ वाले %1$lld खर्च %3$@ में चले जाएंगे। यह श्रेणी पूरे %4$@ से हट जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troškovi s kategorijom %2$@ (%1$lld) prelaze u kategoriju %3$@. Kategorija nestaje za cijelu grupu „%4$@“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld számla, amely ezt használja: %@, ide kerül: %@. A kategória mindenkinél törlődik ebben a csoportban: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tagihan dengan %@ pindah ke %@. Kategori ini hilang untuk semua anggota %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le %lld spese con %@ passano a %@. La categoria sparisce per tutto %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の支出%lld件は%@に移ります。カテゴリは%@の全員から削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%2$@’ 카테고리의 지출 %1$lld건은 ‘%3$@’ 카테고리로 옮겨져요. ‘%4$@’ 그룹 전체에서 카테고리가 사라져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld bil dengan %@ dipindahkan ke %@. Kategori ini hilang untuk semua dalam %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %1$lld uitgaven met %2$@ gaan naar %3$@. De categorie verdwijnt voor heel %4$@."
          }
        },
        "pl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld wydatek z kategorii %2$@ przechodzi do kategorii %3$@. Kategoria znika dla całej grupy %4$@."
                }
              },
