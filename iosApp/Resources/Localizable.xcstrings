        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves dades es queden en aquest %@ fins que acabi la sincronització. Quan s’hagi pujat tot, tancarem la sessió i esborrarem la còpia local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje data zůstanou v zařízení %@, dokud nedoběhne synchronizace. Jakmile se vše nahraje, odhlásíme tě a smažeme místní kopii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data bliver på denne %@, indtil synkroniseringen er færdig. Når alt er uploadet, logger vi ud og sletter den lokale kopi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
