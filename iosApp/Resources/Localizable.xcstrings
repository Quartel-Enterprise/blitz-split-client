    "%@ is a guest without the app. They only learn about it from this message, so it already says what went into the bill." : {
      "comment" : "Request to a guest",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ضيف دون التطبيق. هذه الرسالة هي مصدر المعلومة الوحيد، لذا تذكر بالفعل ما دخل في الفاتورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App und erfährt es nur aus dieser Nachricht, daher steht schon drin, was in die Ausgabe eingeflossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Solo se entera por este mensaje, así que ya incluye lo que entró en el gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. La personne ne le saura que par ce message, qui précise donc déjà ce qui compose la dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: אורח בלי האפליקציה. ההודעה הזו היא הדרך היחידה לדעת על החוב, ולכן היא כבר מפרטת מה נכלל בחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना ऐप वाले मेहमान हैं। उन्हें इसके बारे में सिर्फ़ इसी मैसेज से पता चलेगा, इसलिए इसमें पहले से लिखा है कि खर्च में क्या-क्या शामिल था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Dia hanya tahu dari pesan ini, jadi pesannya sudah menjelaskan isi tagihannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Lo saprà solo da questo messaggio, quindi spiega già cosa c’era nella spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリを使っていないゲストです。このメッセージでしか知らないので、支出の内訳もすでに書いてあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 앱이 없는 게스트예요. 이 메시지로만 알게 되니, 지출에 무엇이 들어갔는지 미리 적혀 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is een gast zonder de app. Die hoort het alleen via dit bericht, dus er staat al in wat er in de uitgave zat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to gość bez aplikacji. Dowie się o tym tylko z tej wiadomości, więc od razu wyjaśnia ona, z czego wynika kwota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem o app. Só fica sabendo por esta mensagem, então ela já leva o que entrou na conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem a app. Só fica a saber por esta mensagem, por isso ela já leva o que entrou na conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гость без приложения. Об этом можно узнать только из этого сообщения, поэтому в нём уже сказано, из чего сложился счёт."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เป็นแขกที่ไม่มีแอป เขาจะรู้เรื่องนี้จากข้อความนี้เท่านั้น ข้อความจึงบอกไว้แล้วว่ามีอะไรอยู่ในบิล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulaması olmayan bir misafir. Bundan yalnızca bu mesajla haberi olacak, bu yüzden mesaj harcamada neler olduğunu zaten anlatıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гість без застосунку. Він(вона) дізнається про це лише з цього повідомлення, тож у ньому вже сказано, що увійшло в рахунок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là khách và không dùng ứng dụng. Họ chỉ biết về khoản này qua tin nhắn này, nên tin nhắn đã ghi rõ những gì có trong khoản chi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是未安装应用的访客，只能通过这条消息得知情况，所以消息里已经写明了账单包含的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是未安裝App的訪客，只能透過這則訊息得知情況，所以訊息裡已經寫明了帳單包含的內容。"
          }
        }
      }
    },
