          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品目をダブルクリックして、誰の分かチェックしてください。すべての品目に誰かが入ると「完了」が押せます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklik op elk item en vink aan wie het had. Gereed werkt zodra elk item iemand heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij dwukrotnie każdą pozycję i zaznacz, kto ją miał. „Gotowe” odblokuje się, gdy każda pozycja będzie mieć kogoś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
