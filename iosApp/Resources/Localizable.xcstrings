    "push.debts_simplified_to_you" : {
      "comment" : "Push notification: someone turned on Simplify debts and someone now pays you. 1: who, 2: the payer, 3: the amount",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: تبسيط الديون. الآن على %2$@ لك %3$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ опрости дълговете. Сега %2$@ ти плаща %3$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ দেনা সহজ করেছেন। এখন %2$@ আপনাকে %3$@ দেবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha simplificat els deutes. Ara %2$@ et paga %3$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zjednodušil(a) dluhy. Teď ti %2$@ platí %3$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ forenklede gælden. Nu betaler %2$@ dig %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
