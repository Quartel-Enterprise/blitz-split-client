        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget internet: du kan fortfarande markera allt. Utgiften förblir sparad på den här Macen och synkroniseras när du är ansluten igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuna intaneti: bado unaweza kuweka alama kila kitu. Gharama inabaki imehifadhiwa kwenye Mac hii na itasawazishwa utakapounganishwa tena."
