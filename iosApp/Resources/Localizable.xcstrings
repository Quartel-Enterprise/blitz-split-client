          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le commentaire disparaît de la dépense pour tout le monde. Ses réponses restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היא תוסר מהחשבון אצל כולם. התשובות אליה יישארו."
