    "The map works offline: changes count right away on this device and reach your others once back online." : {
      "comment" : "Category map offline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الخريطة دون اتصال: تُحتسب التغييرات فورًا على هذا الجهاز وتصل إلى أجهزتك الأخرى عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картата работи офлайн: промените важат веднага на това устройство и стигат до другите ти, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ম্যাপ অফলাইনেও কাজ করে: পরিবর্তন এই ডিভাইসে সঙ্গে সঙ্গে কার্যকর হবে এবং আবার অনলাইনে এলে আপনার অন্য ডিভাইসে পৌঁছে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa funguje offline: změny platí hned na tomto zařízení a na ostatní se dostanou, až budeš zase online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuordnung funktioniert offline: Änderungen gelten sofort auf diesem Gerät und erreichen deine anderen, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χάρτης λειτουργεί εκτός σύνδεσης: οι αλλαγές ισχύουν αμέσως σε αυτή τη συσκευή και φτάνουν στις άλλες σου μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa funciona sin conexión: los cambios valen al instante en este dispositivo y llegan a los demás cuando vuelva internet."
