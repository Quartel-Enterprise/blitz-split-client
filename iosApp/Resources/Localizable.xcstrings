    "Add it and bills with this word in their title arrive with the right category." : {
      "comment" : "Category map search",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضفه لتصل الفواتير التي تحتوي هذه الكلمة في عنوانها بالفئة الصحيحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добави го и разходите с тази дума в заглавието ще идват с правилната категория."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি যোগ করলে শিরোনামে এই শব্দ থাকা বিল সঠিক ক্যাটাগরিতে চলে আসবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix-lo i les despeses amb aquesta paraula al títol arribaran amb la categoria correcta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej ho a výdaje s tímto slovem v názvu dostanou správnou kategorii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj det, så får udgifter med dette ord i titlen den rigtige kategori."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ihn hinzu, und Ausgaben mit diesem Wort im Titel kommen mit der richtigen Kategorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσέ τον και τα έξοδα με αυτή τη λέξη στον τίτλο θα έρχονται με τη σωστή κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelo y los gastos con esa palabra en el título llegarán con la categoría correcta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa see ja kulud, mille pealkirjas on see sõna, saavad õige kategooria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن را اضافه کنید تا هزینه‌هایی که این واژه در عنوانشان است با دسته‌بندی درست بیایند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää se, niin kulut, joiden otsikossa on tämä sana, saavat oikean luokan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ito at darating na may tamang kategorya ang mga bill na may salitang ito sa pamagat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute-le et les dépenses avec ce mot dans leur titre arrivent avec la bonne catégorie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તેને ઉમેરો અને જે ખર્ચના શીર્ષકમાં આ શબ્દ હોય તે સાચી કેટેગરી સાથે આવશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף אותו, וחשבונות עם המילה הזו בכותרת יגיעו עם הקטגוריה הנכונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे जोड़ें, फिर जिन खर्चों के टाइटल में यह शब्द होगा वे सही श्रेणी के साथ आएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ga i troškovi s ovom riječi u naslovu dobit će pravu kategoriju."
