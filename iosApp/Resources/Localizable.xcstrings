        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của bạn vẫn ở trên %@ này cho đến khi đồng bộ xong. Khi mọi thứ đã được tải lên, chúng tôi sẽ đăng xuất và xóa bản sao trên máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
