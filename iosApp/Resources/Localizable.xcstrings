    "%lld of %lld groups. You can use the app meanwhile: what has arrived shows below." : {
      "comment" : "Groups: the first download's card, the groups that came down of those coming",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld من %lld مجموعات. يمكنك استخدام التطبيق في الأثناء: ما وصل يظهر أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld от %lld групи. Междувременно можеш да ползваш приложението: пристигналото се показва по-долу."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld টি গ্রুপের মধ্যে %1$lld টি এসেছে। এর মধ্যেই অ্যাপটি ব্যবহার করতে পারেন: যা এসেছে তা নিচে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de %lld grups. Mentrestant pots fer servir l’app: el que ja ha arribat es mostra a sota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld z %lld skupin. Mezitím můžeš aplikaci používat: co už dorazilo, vidíš níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld af %lld grupper. Du kan bruge appen imens: det, der er kommet, vises nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld von %lld Gruppen. Du kannst die App solange nutzen: Was schon da ist, siehst du unten."
          }
        },
        "el" : {
