          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log op je iPhone in met hetzelfde Apple-account en je groepen staan er."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
