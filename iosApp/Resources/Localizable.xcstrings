          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde dans le groupe peut changer le nom, l’icône, le type et Simplifier les dettes. Activité montre qui l’a changé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השם, הסמל, הסוג ופישוט החובות פתוחים לשינוי לכל מי שבקבוצה. בפעילות רואים מי שינה."
