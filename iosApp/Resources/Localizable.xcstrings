    "%@ owes you %@ · %@" : {
      "comment" : "Under Request's title: the person, the amount and the group or how many",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على %@ لك %@ · %@"
