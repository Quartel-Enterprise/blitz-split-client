          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspond au mot entier, sans tenir compte des accents ni de la casse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
