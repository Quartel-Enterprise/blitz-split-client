    "Touch and hold one of the group's categories to edit or delete it." : {
      "comment" : "Category picker",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مطولًا إحدى فئات المجموعة لتعديلها أو حذفها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръж върху някоя от категориите на групата, за да я редактираш или изтриеш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পাদনা করতে বা মুছতে গ্রুপের কোনো ক্যাটাগরি চেপে ধরে রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž jednu z kategorií skupiny, abys ji upravil(a) nebo smazal(a)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine der Kategorien der Gruppe gedrückt, um sie zu bearbeiten oder zu löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα μια κατηγορία της ομάδας για να την επεξεργαστείς ή να τη διαγράψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una de las categorías del grupo para editarla o eliminarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ویرایش یا حذف یکی از دسته‌بندی‌های گروه، آن را لمس کرده و نگه دارید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal ang isa sa mga kategorya ng grupo para i-edit o burahin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie longuement sur une catégorie du groupe pour la modifier ou la supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה ארוכה על אחת מהקטגוריות של הקבוצה מאפשרת לערוך או למחוק אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप की किसी श्रेणी को बदलने या हटाने के लिए उसे दबाकर रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni i drži jednu od kategorija grupe da je urediš ili izbrišeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
