          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Adósságok egyszerűsítése 3 főnél kevesebb esetén nem érhető el. Akkor válik elérhetővé, ha a csoportban legalább 3 ember van."
          }
        },
        "id" : {
          "stringUnit" : {
