          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai mở liên kết sẽ chọn tên mình trong danh sách của nhóm hoặc tham gia với tư cách thành viên mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
