        }
      }
    },
    "You have %lld payments in the queue. The simplification counts them; if they change, the suggested payments adjust by themselves." : {
      "comment" : "Simplify debts: several payments recorded here and not up yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %lld Zahlungen in der Warteschlange. Die Vereinfachung berücksichtigt sie; ändern sie sich, passen sich die vorgeschlagenen Zahlungen von selbst an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld pagos en la cola. La simplificación los cuenta; si cambian, los pagos sugeridos se ajustan solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld paiements dans la file. La simplification les compte ; s’ils changent, les paiements suggérés s’ajustent tout seuls."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu punya %lld pembayaran dalam antrean. Penyederhanaan ikut menghitungnya; kalau berubah, saran pembayaran menyesuaikan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %lld pagamenti in coda. La semplificazione li conta; se cambiano, i pagamenti suggeriti si adattano da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューに%lld件の支払いがあります。シンプル化にはそれも含まれ、変わった場合は提案される支払いが自動で調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열에 송금 %lld건이 있어요. 간소화에 포함되며, 바뀌면 추천 송금도 자동으로 조정돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt %lld betalingen in de wachtrij. De vereenvoudiging telt ze mee; als ze veranderen, passen de voorgestelde betalingen zich vanzelf aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności w kolejce: %lld. Uproszczenie je uwzględnia; jeśli się zmienią, sugerowane płatności dostosują się same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %lld pagamentos na fila. A simplificação conta com eles; se mudarem, os pagamentos sugeridos se ajustam sozinhos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens %lld pagamentos na fila. A simplificação conta com eles; se mudarem, os pagamentos sugeridos ajustam-se sozinhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежей в очереди: %lld. Упрощение их учитывает; если они изменятся, предлагаемые платежи подстроятся сами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada %lld ödemen var. Sadeleştirme bunları hesaba katar; değişirlerse önerilen ödemeler kendiliğinden ayarlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебе в черзі платежів: %lld. Спрощення їх враховує; якщо вони зміняться, пропоновані платежі скоригуються самі."
          }
        }
      }
    },
