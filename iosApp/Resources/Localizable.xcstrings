    "The current link and QR code stop working, unused personal invites included. Whoever already joined stays in the group." : {
      "comment" : "Invite: the message of the alert before changing the link",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Link und QR-Code funktionieren nicht mehr, auch nicht genutzte persönliche Einladungen. Wer schon beigetreten ist, bleibt in der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace y el código QR actuales dejan de funcionar, incluidas las invitaciones personales sin usar. Quienes ya se unieron siguen en el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien et le QR code actuels cessent de fonctionner, y compris les invitations personnelles non utilisées. Les personnes déjà entrées restent dans le groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link e il codice QR attuali smettono di funzionare, compresi gli inviti personali non usati. Chi ha già aderito resta nel gruppo."
          }
        },
        "pl" : {
