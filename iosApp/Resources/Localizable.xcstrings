          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre, wenn jemand eine Zahlung erfasst oder dich um eine Zahlung bittet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μάθε πότε κάποιος καταγράφει μια πληρωμή ή σου ζητά να πληρώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entérate cuando alguien registre un pago o te pida pagar."
