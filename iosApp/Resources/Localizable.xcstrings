    "When" : {
      "comment" : "When the bill was",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando"
          }
        }
      }
    },
    "When it doesn't split evenly, the leftover cents go to whoever paid." : {
      "comment" : "Hint of the equal split",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la división no es exacta, los centavos que sobran se quedan con quien pagó."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando não dá conta exata, os centavos que sobram ficam com quem pagou."
          }
        }
      }
    },
    "When settling up, we show the amount in sats at the current rate. It's only an estimate: the payer confirms it in their wallet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al saldar cuentas, mostramos el monto en sats al tipo de cambio del momento. Es solo una estimación: quien paga confirma el monto en su billetera."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al saldar cuentas, mostramos el importe en sats al tipo de cambio del momento. Es solo una estimación: quien paga confirma el importe en su cartera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No acerto, mostramos o valor em sats pela cotação do momento. É só uma estimativa: quem paga confirma o valor na carteira."
          }
        }
      }
    },
    "When:" : {
      "comment" : "When the bill was, on the Mac",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando:"
          }
        }
      }
    },
    "Who are you in the group?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quién eres en el grupo?"
          }
        },
        "pt-BR" : {
