        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A predefinição fica em Editar grupo › Divisão predefinida. As contas já registadas não mudam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
