    "The default lives in Edit group › Default split. Bills already added don't change." : {
      "comment" : "Split, for a group with a default split: under the modes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعداد الافتراضي في تعديل المجموعة › التقسيم الافتراضي. الفواتير المضافة سابقًا لا تتغير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подразбирането се намира в Редактирай групата › Разделяне по подразбиране. Вече добавените разходи не се променят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিফল্ট বদলানোর জায়গা: গ্রুপ সম্পাদনা › ডিফল্ট ভাগ। আগে যোগ করা বিল বদলাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La divisió per defecte és a Editar el grup › Divisió per defecte. Les despeses ja afegides no canvien."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí nastavení najdeš v Upravit skupinu › Výchozí rozdělení. Už přidané výdaje se nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standarden findes under Redigér gruppe › Standarddeling. Udgifter, der allerede er tilføjet, ændres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standard steht unter „Gruppe bearbeiten“ › „Standardaufteilung“. Bereits hinzugefügte Ausgaben ändern sich nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προεπιλογή βρίσκεται στο Επεξεργασία ομάδας › Προεπιλεγμένη μοιρασιά. Τα έξοδα που έχουν ήδη προστεθεί δεν αλλάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo predeterminado está en Editar grupo › División predeterminada. Los gastos ya agregados no cambian."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo predeterminado está en Editar grupo › División predeterminada. Los gastos ya añadidos no cambian."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikimisi jaotus asub jaotises Muuda gruppi › Vaikimisi jaotus. Juba lisatud kulud ei muutu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌فرض در ویرایش گروه › تقسیم پیش‌فرض است. هزینه‌هایی که قبلاً اضافه شده‌اند تغییر نمی‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletus on kohdassa Muokkaa ryhmää › Oletusjako. Jo lisätyt kulut eivät muutu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa Edit group › Default na hatian ang default. Hindi nagbabago ang mga bill na naidagdag na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur par défaut se règle dans Modifier le groupe › Répartition par défaut. Les dépenses déjà ajoutées ne changent pas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડિફૉલ્ટ “ગ્રુપ એડિટ કરો › ડિફૉલ્ટ વહેંચણી” માં છે. પહેલેથી ઉમેરાયેલા ખર્ચ બદલાતા નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ברירת המחדל מוגדרת בעריכת קבוצה › חלוקת ברירת מחדל. חשבונות שכבר נוספו לא משתנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट ग्रुप बदलें › डिफ़ॉल्ट बंटवारा में है। पहले जोड़े गए खर्च नहीं बदलते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadana postavka nalazi se u Uredi grupu › Zadana podjela. Već dodani troškovi se ne mijenjaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alapértelmezést a Csoport szerkesztése › Alapértelmezett felosztás alatt találod. A már hozzáadott számlák nem változnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan default ada di Edit grup › Pembagian default. Tagihan yang sudah ditambahkan tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La predefinita si trova in Modifica gruppo › Divisione predefinita. Le spese già aggiunte non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトは「グループを編集」›「デフォルトの分け方」にあります。追加済みの支出は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 그룹 수정 › 기본 분담에 있어요. 이미 추가된 지출은 바뀌지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
