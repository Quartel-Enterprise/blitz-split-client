    "Add the first expense or invite who's splitting with you. People without the app count too." : {
      "comment" : "Message of a group without bills",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die erste Ausgabe hinzu oder lade ein, wer mit dir teilt. Personen ohne die App zählen auch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el primer gasto o invita a quien va a dividir contigo. Las personas sin la app también cuentan."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el primer gasto o invita a quien va a dividir contigo. Las personas sin la app también cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
