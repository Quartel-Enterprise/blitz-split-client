    "You picked %@. By the map it would be %@ (“%@”)." : {
      "comment" : "Under a bill's description: the category picked by hand differs from the map's",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt. Laut Zuordnung wäre es %2$@ („%3$@“)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegiste %1$@. Según el mapa sería %2$@ (“%3$@”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as choisi %1$@. D’après la carte, ce serait %2$@ (« %3$@ »)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memilih %@. Menurut peta, seharusnya %@ (“%@”)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto %@. Secondo la mappa sarebbe %@ («%@»)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選びました。マップでは%@（「%@」）になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 카테고리를 골랐어요. 키워드 기준으로는 ‘%2$@’ 카테고리예요(“%3$@”)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je koos %1$@. Volgens de kaart zou het %2$@ zijn (“%3$@”)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano %1$@. Według mapy byłaby to kategoria %2$@ („%3$@”)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolheu %1$@. Pelo mapa seria %2$@ (“%3$@”)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolheste %1$@. Pelo mapa seria %2$@ (“%3$@”)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты выбрал(а) «%@». По карте было бы «%@» («%@»)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin: %@. Haritaya göre %@ olurdu (“%@”)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти обрав(-ла) %@. За мапою було б %@ («%@»)."
          }
        }
      }
    },
    "You picked %@. By the map it would be %@ (“%@”). On saving, we ask whether the map learns." : {
      "comment" : "Under a bill's description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt. Laut Zuordnung wäre es %2$@ („%3$@“). Beim Speichern fragen wir, ob die Zuordnung dazulernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegiste %1$@. Según el mapa sería %2$@ (“%3$@”). Al guardar, te preguntaremos si el mapa aprende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as choisi %1$@. D’après la carte, ce serait %2$@ (« %3$@ »). À l’enregistrement, on te demande si la carte apprend."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memilih %@. Menurut peta, seharusnya %@ (“%@”). Saat menyimpan, kami bertanya apakah peta perlu belajar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto %@. Secondo la mappa sarebbe %@ («%@»). Al salvataggio ti chiediamo se la mappa deve impararlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選びました。マップでは%@（「%@」）になります。保存するときに、マップに覚えさせるか確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 카테고리를 골랐어요. 키워드 기준으로는 ‘%2$@’ 카테고리예요(“%3$@”). 저장할 때 키워드에 알려 줄지 물어봐요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je koos %1$@. Volgens de kaart zou het %2$@ zijn (“%3$@”). Bij het opslaan vragen we of de kaart dit leert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano %1$@. Według mapy byłaby to kategoria %2$@ („%3$@”). Przy zapisie zapytamy, czy mapa ma się tego nauczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolheu %1$@. Pelo mapa seria %2$@ (“%3$@”). Ao salvar, perguntamos se o mapa aprende."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolheste %1$@. Pelo mapa seria %2$@ (“%3$@”). Ao guardar, perguntamos se o mapa aprende."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты выбрал(а) «%@». По карте было бы «%@» («%@»). При сохранении мы спросим, научить ли карту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin: %@. Haritaya göre %@ olurdu (“%@”). Kaydederken haritanın öğrenip öğrenmeyeceğini sorarız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти обрав(-ла) %@. За мапою було б %@ («%@»). Під час збереження ми запитаємо, чи має мапа навчитися."
          }
        }
      }
    },
    "You've used the app on your phone since %@. This code always stays in Settings, for when you change iPhones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt die App seit %@ auf deinem Handy. Dieser Code bleibt immer in den Einstellungen, für den Fall, dass du dein iPhone wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas la app en tu celular desde %@. Este código queda siempre en Ajustes, para cuando cambies de iPhone."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas la app en tu móvil desde %@. Este código queda siempre en Ajustes, para cuando cambies de iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu utilises l’app sur ton téléphone depuis %@. Ce code reste toujours dans les Réglages, pour quand tu changeras d’iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sudah memakai aplikasi di ponselmu sejak %@. Kode ini selalu ada di Pengaturan, untuk saat kamu ganti iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usi l’app sul telefono dal %@. Questo codice resta sempre nelle Impostazioni, per quando cambi iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からスマートフォンでアプリを使っています。このコードはiPhoneを買い替えるときのために、いつでも設定にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@부터 휴대폰에서 앱을 사용하고 있어요. 이 코드는 iPhone을 바꿀 때를 위해 항상 설정에 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebruikt de app op je telefoon sinds %@. Deze code blijft altijd in Instellingen, voor als je van iPhone wisselt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używasz aplikacji na telefonie od %@. Ten kod zawsze zostaje w Ustawieniach, na wypadek zmiany iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já usa o app no celular desde %@. Este código fica sempre em Ajustes, para quando trocar de iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas a app no telemóvel desde %@. Este código fica sempre em Definições, para quando mudares de iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты пользуешься приложением на телефоне с %@. Этот код всегда остаётся в Настройках — на случай, если сменишь iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı %@ tarihinden beri telefonunda kullanıyorsun. Bu kod, iPhone değiştirdiğin zamanlar için her zaman Ayarlar'da kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти користуєшся застосунком на телефоні з %@. Цей код завжди залишається в Налаштуваннях — на випадок, коли зміниш iPhone."
          }
        }
      }
    },
    "You, who did it" : {
