        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップはオフラインでも使えます。変更はこのデバイスですぐに反映され、オンラインに戻るとほかのデバイスにも届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드는 오프라인에서도 작동해요. 변경 사항은 이 기기에 바로 적용되고, 다시 온라인이 되면 다른 기기에도 반영돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
