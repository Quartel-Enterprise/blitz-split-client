    "%@ leaves your Contacts. They stay in %@ and come back by themselves if they join a new account with you. You can show them again in Hidden." : {
      "comment" : "Hide a contact?; the first %@ is them, the second their groups",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verschwindet aus deinen Kontakten. Bleibt aber in %2$@ und kommt von selbst zurück, wenn ihr gemeinsam in einer neuen Gruppe seid. Unter „Ausgeblendet“ kannst du die Person wieder einblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sale de tu lista de Contactos. Se mantiene en %2$@ y vuelve automáticamente si se une a una cuenta nueva contigo. Puedes mostrarlo de nuevo en Ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quitte tes Contacts. La personne reste dans %2$@ et revient toute seule si elle rejoint un nouveau compte avec toi. Tu peux l’afficher de nouveau dans Masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ esce dai tuoi Contatti. Resta in %@ e ricompare da sé se entra in un nuovo gruppo con te. Puoi mostrare di nuovo questo contatto in Nascosti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ znika z twoich Kontaktów. Zostaje w: %2$@ i wróci samoczynnie, jeśli połączy się z tobą przez nowe konto. Możesz pokazać tę osobę ponownie w sekcji Ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sai da lista de Contatos. Continua em %2$@ e volta sozinho se entrar numa conta nova com você. Dá para mostrar de novo em Ocultos."
          }
        }
      }
    },
