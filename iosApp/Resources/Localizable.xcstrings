        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ olarak katılan kişi gruptan çıkar. %@ ismi, rengi ve harcamaları yerinde kalır ve %@ grubun bağlantısıyla yeniden seçilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той, хто приєднався як %@, виходить з групи. Ім'я, колір і рахунки учасника %@ залишаються, і %@ можна знову обрати за посиланням групи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو %@ کے طور پر شامل ہوا تھا وہ گروپ چھوڑ دیتا ہے۔ %@ کا نام، رنگ اور خرچ برقرار رہتے ہیں، اور گروپ کے لنک سے %@ کو دوبارہ منتخب کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người đã tham gia với tên %@ sẽ rời nhóm. Tên, màu và các khoản chi của %@ vẫn được giữ, và %@ có thể được chọn lại qua liên kết của nhóm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以%1$@身份加入的人将退出群组。%2$@的名字、颜色和账单都会保留，其他人也可以通过群组链接再次选择%3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
