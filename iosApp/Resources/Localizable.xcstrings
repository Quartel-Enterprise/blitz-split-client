    "Needs internet. Fill it in by hand or scan the receipt once you reconnect." : {
      "comment" : "Split a bill: Scan receipt while offline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الإنترنت. يمكنك الإدخال يدويًا أو مسح الإيصال عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изисква интернет. Попълни ръчно или сканирай бележката, когато се свържеш отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট লাগবে। নিজে পূরণ করুন অথবা আবার সংযুক্ত হলে রসিদ স্ক্যান করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cal internet. Omple-ho a mà o escaneja el tiquet quan et tornis a connectar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potřebuje internet. Vyplň to ručně nebo naskenuj účtenku, až se znovu připojíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver internet. Udfyld den manuelt, eller scan kvitteringen, når du har forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht Internet. Füll es von Hand aus oder scanne den Beleg, wenn du wieder verbunden bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεται ίντερνετ. Συμπλήρωσέ το χειροκίνητα ή σάρωσε την απόδειξη όταν συνδεθείς ξανά."
