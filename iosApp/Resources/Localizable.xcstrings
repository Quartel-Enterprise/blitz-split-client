          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pagou %@?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagaste %@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты заплатил(а) участнику %@?"
          }
        },
