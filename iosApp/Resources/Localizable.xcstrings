    "Without an account, the app on iPhone starts empty. Connect an Apple or Google account in Settings to take your groups." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون حساب، يبدأ التطبيق على iPhone فارغًا. اربط حساب Apple أو Google في الإعدادات لنقل مجموعاتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Konto startet die App auf dem iPhone leer. Verbinde in den Einstellungen einen Apple- oder Google-Account, um deine Gruppen mitzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, la app en el iPhone empieza vacía. Conecta una cuenta de Apple o Google en Ajustes para llevar tus grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans compte, l’app sur iPhone démarre vide. Connecte un compte Apple ou Google dans les Réglages pour emporter tes groupes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי חשבון משתמש, האפליקציה ב-iPhone מתחילה ריקה. אפשר לחבר חשבון Apple או Google בהגדרות כדי להעביר את הקבוצות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट के बिना iPhone पर ऐप खाली शुरू होता है। अपने ग्रुप ले जाने के लिए सेटिंग में Apple या Google अकाउंट जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akun, aplikasi di iPhone mulai kosong. Hubungkan akun Apple atau Google di Pengaturan untuk membawa grupmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un account, l’app sull’iPhone parte vuota. Collega un account Apple o Google nelle Impostazioni per portare i tuoi gruppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントがないと、iPhoneのアプリは空の状態で始まります。グループを移すには、設定でAppleまたはGoogleアカウントを連携してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 없으면 iPhone 앱은 빈 상태로 시작해요. 그룹을 가져가려면 설정에서 Apple 또는 Google 계정을 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder account begint de app op iPhone leeg. Koppel een Apple- of Google-account in Instellingen om je groepen mee te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta aplikacja na iPhonie startuje pusta. Połącz konto Apple lub Google w Ustawieniach, aby przenieść swoje grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, o app no iPhone começa vazio. Conecte uma conta Apple ou Google em Ajustes para levar seus grupos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, a app no iPhone começa vazia. Liga uma conta Apple ou Google em Definições para levares os teus grupos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без аккаунта приложение на iPhone начнётся с нуля. Подключи аккаунт Apple или Google в Настройках, чтобы перенести свои группы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีบัญชี แอปบน iPhone จะเริ่มต้นแบบว่างเปล่า เชื่อมต่อบัญชี Apple หรือ Google ในการตั้งค่าเพื่อย้ายกลุ่มของคุณไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap olmadan iPhone'daki uygulama boş başlar. Gruplarını taşımak için Ayarlar'da bir Apple veya Google hesabı bağla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без облікового запису застосунок на iPhone починається порожнім. Підключи обліковий запис Apple або Google у Налаштуваннях, щоб перенести свої групи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có tài khoản, ứng dụng trên iPhone sẽ bắt đầu trống. Hãy kết nối tài khoản Apple hoặc Google trong Cài đặt để mang theo các nhóm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有账号时，iPhone上的应用会是空的。在设置中关联Apple或Google账号即可带上你的群组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有帳號時，iPhone上的App會是空的。在設定中連結Apple或Google帳號即可帶上你的群組。"
          }
        }
      }
    },
