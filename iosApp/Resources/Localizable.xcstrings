    "Only you see these. Mark which one you paid a bill with." : {
      "comment" : "Under Profile's payment methods",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst sie. Markiere, womit du eine Ausgabe bezahlt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú los ves. Marca con cuál pagaste cada gasto."
          }
        },
