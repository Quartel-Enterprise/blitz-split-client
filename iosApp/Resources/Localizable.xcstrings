    "New bills start in this currency; each bill can use another." : {
      "comment" : "Under the group's default currency, in New group and Edit group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ الفواتير الجديدة بهذه العملة؛ ويمكن لكل فاتورة استخدام عملة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новите разходи започват в тази валута; всеки разход може да използва друга."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন বিল এই মুদ্রায় শুরু হবে; প্রতিটি বিলে অন্য মুদ্রাও ব্যবহার করা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové výdaje začínají v této měně; každý výdaj může použít jinou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Ausgaben starten in dieser Währung; jede Ausgabe kann eine andere nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα νέα έξοδα ξεκινούν με αυτό το νόμισμα. Κάθε έξοδο μπορεί να χρησιμοποιεί άλλο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos nuevos empiezan en esta moneda; cada gasto puede usar otra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه‌های جدید با این ارز شروع می‌شوند؛ هر هزینه می‌تواند ارز دیگری داشته باشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa currency na ito magsisimula ang mga bagong bill; puwedeng gumamit ng iba ang bawat bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles dépenses démarrent dans cette devise ; chaque dépense peut en utiliser une autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות חדשים מתחילים במטבע הזה; כל חשבון יכול להשתמש במטבע אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए खर्च इसी मुद्रा में शुरू होते हैं; हर खर्च कोई दूसरी मुद्रा इस्तेमाल कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi troškovi počinju u ovoj valuti; svaki trošak može koristiti drugu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új számlák ebben a pénznemben indulnak; minden számla használhat másikat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan baru dimulai dengan mata uang ini; tiap tagihan bisa memakai mata uang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove spese partono in questa valuta; ogni spesa può usarne un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい支出はこの通貨で始まります。支出ごとに別の通貨も使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 지출은 이 통화로 시작해요. 지출마다 다른 통화를 쓸 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil baharu bermula dengan mata wang ini; setiap bil boleh menggunakan mata wang lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe uitgaven beginnen in deze valuta; elke uitgave kan een andere gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe wydatki zaczynają się w tej walucie; każdy wydatek może używać innej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas despesas começam nesta moeda; cada despesa pode usar outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuielile noi pornesc în această monedă; fiecare cheltuială poate folosi alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые счета начинаются в этой валюте; в каждом счёте можно выбрать другую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové výdavky začínajú v tejto mene; každý výdavok môže použiť inú."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi računi počinju u ovoj valuti; svaki račun može da koristi drugu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya utgifter börjar i den här valutan; varje utgift kan använda en annan."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புதிய செலவுகள் இந்த நாணயத்தில் தொடங்கும்; ஒவ்வொரு செலவும் வேறு நாணயத்தைப் பயன்படுத்தலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลใหม่จะเริ่มด้วยสกุลเงินนี้ แต่ละบิลใช้สกุลเงินอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni harcamalar bu para birimiyle başlar; her harcama başka birini kullanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові рахунки починаються в цій валюті; кожен рахунок може використовувати іншу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئے خرچ اسی کرنسی میں شروع ہوتے ہیں؛ ہر خرچ کوئی اور کرنسی استعمال کر سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản chi mới bắt đầu bằng tiền tệ này; mỗi khoản chi có thể dùng tiền tệ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新账单默认使用此货币；每笔账单都可以改用其他货币。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新帳單預設使用此幣別；每筆帳單都可以改用其他幣別。"
          }
        }
      }
    },
