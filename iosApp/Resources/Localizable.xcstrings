        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplamı sonradan değiştirmek tutarları orantılı olarak yeniden ölçekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо пізніше змінити суму, частки буде перераховано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد میں کل رقم بدلنے سے رقمیں تناسب سے بدل جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi tổng sau này sẽ điều chỉnh lại các số tiền theo tỷ lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后更改总额会按比例调整各金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之後更改總額會按比例調整各金額。"
          }
        }
      }
