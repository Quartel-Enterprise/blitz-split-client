    "Payments go back to being between whoever split each bill. Totals don't change." : {
      "comment" : "Simplify debts: what turning it off does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الدفعات لتكون بين من قسّموا كل فاتورة. الإجماليات لا تتغير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащанията отново са между тези, които са разделили всеки разход. Общите суми не се променят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট আবার যাঁরা প্রতিটি বিল ভাগ করেছেন তাঁদের মধ্যেই হবে। মোট পরিমাণ বদলাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els pagaments tornen a ser entre els qui han dividit cada despesa. Els totals no canvien."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby budou zase mezi těmi, kdo si každý výdaj rozdělili. Celkové částky se nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingerne går tilbage til at være mellem dem, der delte hver udgift. Totalerne ændres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen laufen wieder zwischen denen, die die jeweilige Ausgabe geteilt haben. Die Summen ändern sich nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πληρωμές επιστρέφουν ανάμεσα σε όσους μοιράστηκαν κάθε έξοδο. Τα σύνολα δεν αλλάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos vuelven a ser entre quienes dividieron cada gasto. Los totales no cambian."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksed lähevad tagasi nende vahele, kes iga kulu jagasid. Kogusummad ei muutu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت‌ها دوباره بین کسانی خواهد بود که هر هزینه را تقسیم کرده‌اند. مجموع‌ها تغییر نمی‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksut palaavat kunkin kulun jakaneiden välisiksi. Kokonaissummat eivät muutu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babalik ang mga bayad sa pagitan ng mga naghati sa bawat bill. Hindi magbabago ang mga total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements redeviennent ceux entre les personnes qui ont partagé chaque dépense. Les totaux ne changent pas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચુકવણીઓ ફરી દરેક ખર્ચ વહેંચનારા લોકો વચ્ચે થશે. કુલ રકમ બદલાતી નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלומים חוזרים להיות בין מי שפיצלו כל חשבון. הסכומים הכוללים לא משתנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान फिर से उन्हीं लोगों के बीच होंगे जिन्होंने हर खर्च बांटा। कुल नहीं बदलते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju između onih koji su dijelili svaki trošak. Ukupni iznosi se ne mijenjaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetések újra azok között lesznek, akik az egyes számlákat felosztották. Az összegek nem változnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran kembali terjadi di antara orang yang membagi setiap tagihan. Totalnya tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti tornano a essere tra chi ha diviso ogni spesa. I totali non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いは各支出を割り勘した人同士に戻ります。合計は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 다시 각 지출을 나눈 사람끼리 이뤄져요. 합계는 바뀌지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokėjimai vėl vyksta tarp tų, kurie dalijosi kiekviena išlaida. Bendros sumos nesikeičia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksājumi atkal notiek starp tiem, kas sadalīja katru rēķinu. Kopsummas nemainās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेमेंट पुन्हा प्रत्येक खर्च ज्यांनी वाटला त्यांच्यामध्ये होतील. एकूण रक्कम बदलत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayaran kembali antara orang yang berkongsi setiap bil. Jumlah tidak berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingene går tilbake til å være mellom dem som delte hver utgift. Totalene endres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen gaan weer tussen wie elke uitgave heeft verdeeld. De totalen veranderen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności znów odbywają się między osobami, które dzieliły dany wydatek. Sumy się nie zmieniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Os totais não mudam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plățile revin între cei care au împărțit fiecare cheltuială. Totalurile nu se schimbă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежи снова будут между теми, кто делил каждый счёт. Итоги не меняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby sa vrátia medzi tých, ktorí si rozdelili jednotlivé výdavky. Celkové sumy sa nezmenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plačila so spet med tistimi, ki so si razdelili posamezen strošek. Skupni zneski se ne spremenijo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju na one između osoba koje su podelile svaki račun. Ukupni iznosi se ne menjaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalningarna går tillbaka till att vara mellan dem som delade varje utgift. Totalerna ändras inte."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malipo yanarudi kuwa kati ya waliogawanya kila gharama. Jumla hazibadiliki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு செலவையும் பிரித்தவர்களுக்கு இடையேயே பேமெண்ட்டுகள் மீண்டும் நடக்கும். மொத்தங்கள் மாறாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చెల్లింపులు మళ్లీ ప్రతి ఖర్చును పంచుకున్నవారి మధ్యే ఉంటాయి. మొత్తాలు మారవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจ่ายเงินจะกลับไปเป็นระหว่างคนที่หารแต่ละบิล ยอดรวมไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemeler yeniden her harcamayı bölenler arasında olur. Toplamlar değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
