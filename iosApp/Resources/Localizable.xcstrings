        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse comentário é de um grupo em que você não está. Peça o convite a quem te mandou o link."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este comentário é de um grupo em que não estás. Pede o convite a quem te enviou o link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот комментарий в группе, в которой тебя нет. Попроси приглашение у того, кто прислал тебе ссылку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yorum, içinde olmadığın bir grupta. Davet için bağlantıyı gönderen kişiye sor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей коментар у групі, де тебе немає. Попроси запрошення в того, хто надіслав тобі посилання."
          }
        }
      }
    },
    "Toggle Sidebar" : {
      "comment" : "The Mac's button at the detail's leading edge that shows or hides the sidebar, in the main window and in Settings",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitenleiste ein-/ausblenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar u ocultar la barra lateral"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher ou masquer la barre latérale"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan/Sembunyikan Bar Samping"
          }
