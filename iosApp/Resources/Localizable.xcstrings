        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מה שכל אחד שילם באותו רגע. ההפרש בין התשלום לבין הצריכה הופך ליתרה, ביתרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर किसी ने उस समय जो भुगतान किया। जो भुगतान किया और जो इस्तेमाल किया, उसका अंतर बैलेंस बनता है, जो बैलेंस में दिखता है।"
