    "New bills start in this currency; each bill can use another." : {
      "comment" : "Under the group's default currency, in New group and Edit group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Ausgaben starten in dieser Währung; jede Ausgabe kann eine andere nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos nuevos empiezan en esta moneda; cada gasto puede usar otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles dépenses démarrent dans cette devise ; chaque dépense peut en utiliser une autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan baru dimulai dengan mata uang ini; tiap tagihan bisa memakai mata uang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove spese partono in questa valuta; ogni spesa può usarne un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい支出はこの通貨で始まります。支出ごとに別の通貨も使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe uitgaven beginnen in deze valuta; elke uitgave kan een andere gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe wydatki zaczynają się w tej walucie; każdy wydatek może używać innej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas despesas começam nesta moeda; cada despesa pode usar outra."
          }
        },
        "tr" : {
