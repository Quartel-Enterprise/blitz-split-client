    "Sees it without signing in. To comment, they sign in with an account, even outside the group." : {
      "comment" : "Share bill: what anyone with the link can do",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراها دون تسجيل الدخول. للتعليق، يلزم تسجيل الدخول بحساب، حتى من خارج المجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижда го без вход. За да коментира, трябва да влезе с акаунт, дори да не е в групата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইন ইন ছাড়াই দেখা যাবে। মন্তব্য করতে অ্যাকাউন্ট দিয়ে সাইন ইন করতে হবে, গ্রুপের বাইরের কেউ হলেও।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La veu sense iniciar la sessió. Per comentar, ha d’iniciar la sessió amb un compte, fins i tot fora del grup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidí ho bez přihlášení. Aby mohli komentovat, přihlásí se účtem, i když nejsou ve skupině."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser den uden at logge ind. For at kommentere logger vedkommende ind med en konto, også uden for gruppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht sie ohne Anmeldung. Zum Kommentieren meldet man sich mit einem Konto an, auch außerhalb der Gruppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το βλέπει χωρίς να συνδεθεί. Για να σχολιάσει, συνδέεται με λογαριασμό, ακόμα κι αν δεν είναι στην ομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo ve sin iniciar sesión. Para comentar, inicia sesión con una cuenta, aunque no esté en el grupo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näeb seda sisse logimata. Kommenteerimiseks tuleb kontoga sisse logida, isegi väljaspool gruppi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون ورود آن را می‌بیند. برای نظر دادن، حتی بیرون از گروه، با یک حساب کاربری وارد می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkee sen kirjautumatta. Kommentoidakseen hänen on kirjauduttava tilillä, myös ryhmän ulkopuolelta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakikita ito nang hindi nagsa-sign in. Para mag-comment, kailangan nilang mag-sign in gamit ang account, kahit hindi sila kasali sa grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit la dépense sans se connecter. Pour commenter, la personne se connecte avec un compte, même hors du groupe."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાઇન ઇન કર્યા વિના જુએ છે. કોમેન્ટ કરવા માટે, ગ્રુપની બહાર હોય તો પણ, એકાઉન્ટથી સાઇન ઇન કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפייה בלי התחברות. כדי להגיב צריך להתחבר עם חשבון משתמש, גם מחוץ לקבוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन किए बिना देख सकते हैं। टिप्पणी करने के लिए उन्हें किसी अकाउंट से साइन इन करना होगा, ग्रुप से बाहर होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidi ga bez prijave. Za komentiranje se prijavljuje računom, čak i izvan grupe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bejelentkezés nélkül is látja. Hozzászóláshoz be kell jelentkeznie egy fiókkal, akkor is, ha nem tagja a csoportnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa melihatnya tanpa masuk. Untuk berkomentar, mereka masuk dengan akun, meski di luar grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vede senza accedere. Per commentare accede con un account, anche fuori dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインせずに見られます。コメントするには、グループ外の人でもアカウントでログインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하지 않아도 볼 수 있어요. 댓글을 달려면 그룹 밖의 사람이라도 계정으로 로그인해야 해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mato ją neprisijungę. Norint komentuoti, reikia prisijungti su paskyra, net ir ne grupės nariams."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redz to bez pierakstīšanās. Lai komentētu, jāpierakstās ar kontu, pat ja nav grupā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन न करता पाहू शकतात. कमेंट करण्यासाठी त्यांना अकाउंटने साइन इन करावे लागते, ग्रुपबाहेरील असले तरीही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh melihatnya tanpa log masuk. Untuk memberi komen, mereka perlu log masuk dengan akaun, walaupun di luar kumpulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser den uten å logge inn. For å kommentere logger de inn med en konto, også utenfor gruppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziet hem zonder in te loggen. Om te reageren logt diegene in met een account, ook van buiten de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można go zobaczyć bez logowania. Aby komentować, trzeba zalogować się na konto, nawet spoza grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê sem entrar. Para comentar, entra com uma conta, mesmo sem estar no grupo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê sem iniciar sessão. Para comentar, inicia sessão com uma conta, mesmo sem estar no grupo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vede fără să se conecteze. Ca să comenteze, se conectează cu un cont, chiar și din afara grupului."
          }
