    "People who owe you won't see it when settling up anymore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يراه من عليهم لك عند التسوية بعد الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хората, които ти дължат, вече няма да го виждат при уреждане на сметките."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাঁদের কাছে আপনি টাকা পাবেন, তাঁরা হিসাব মেটানোর সময় এটি আর দেখতে পাবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les persones que et deuen diners ja no el veuran en liquidar comptes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidé, kteří ti dluží, ho při vyrovnání už neuvidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folk, der skylder dig, vil ikke længere se den, når de gør op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die dir etwas schulden, sehen ihn beim Begleichen nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσοι σου χρωστούν δεν θα το βλέπουν πια κατά την εξόφληση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes te deben dejarán de ver esta clave al saldar cuentas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need, kes sulle võlgnevad, ei näe seda arveldamisel enam."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسانی که به شما بدهکارند هنگام تسویه حساب دیگر آن را نمی‌بینند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulle velkaa olevat eivät enää näe sitä tasatessaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na ito makikita ng mga may utang sa iyo kapag nagbabayaran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes qui te doivent ne la verront plus au moment de régler."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જેમણે તમને પૈસા આપવાના છે તેમને હિસાબ પતાવતી વખતે હવે તે દેખાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שחייב לך כסף כבר לא יראה אותו בסגירת החשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन पर आपका बकाया है, उन्हें हिसाब चुकाते समय यह अब नहीं दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osobe koje ti duguju više ga neće vidjeti pri podmirivanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akik tartoznak neked, elszámoláskor már nem fogják látni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang berutang ke kamu tidak akan melihatnya lagi saat melunasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che ti devono non la vedranno più quando saldano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う必要がある人が精算するとき、これは表示されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나에게 줄 돈이 있는 사람은 정산할 때 더 이상 이 정보를 보지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie, kurie turi tau grąžinti, atsiskaitydami jo nebematys."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie, kas tev ir parādā, norēķinoties to vairs neredzēs."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज्यांना तुम्हाला पैसे द्यायचे आहेत त्यांना हिशोब पूर्ण करताना हे आता दिसणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang berhutang kepada anda tidak akan melihatnya lagi semasa membuat penyelesaian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De som skylder deg penger, ser den ikke lenger når de gjør opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen die jou iets schuldig zijn, zien hem niet meer bij het verrekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby, które mają ci oddać, nie zobaczą go już przy rozliczaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem te deve deixa de ver esta chave no acerto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cei care îți datorează nu o vor mai vedea când achită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, кто тебе должен, больше не увидят его при расчёте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ľudia, ktorí ti dlžia, ho pri vyrovnaní už neuvidia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tisti, ki ti dolgujejo, je ob poravnavi ne bodo več videli."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oni koji ti duguju više to neće videti prilikom izmirivanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De som är skyldiga dig ser den inte längre när de gör upp."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanaodaiwa na wewe hawataiona tena wakilipa deni."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுக்குத் தர வேண்டியவர்கள், கணக்கைத் தீர்க்கும்போது இனி இதைப் பார்க்க மாட்டார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు ఇవ్వాల్సినవారు లెక్క సెటిల్ చేసేటప్పుడు ఇకపై దీన్ని చూడరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ค้างคุณจะไม่เห็นคีย์นี้ตอนเคลียร์ยอดอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana borcu olanlar hesaplaşırken bunu artık görmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ті, хто тобі винен, більше не бачитимуть його під час розрахунку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جنہوں نے آپ کو پیسے دینے ہیں، وہ حساب برابر کرتے وقت اسے مزید نہیں دیکھیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người nợ bạn sẽ không còn thấy khóa này khi thanh toán nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欠你钱的人在结清时将不再看到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欠你錢的人在結清時將不再看到它。"
          }
        }
      }
    },
