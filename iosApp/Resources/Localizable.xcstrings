    "No internet: you can still check everything. The bill stays saved on this Mac and syncs when you reconnect." : {
      "comment" : "Bill items offline on the Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Du kannst trotzdem alles auswählen. Die Ausgabe bleibt auf diesem Mac gespeichert und wird synchronisiert, wenn du wieder verbunden bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: aún puedes marcar todo. El gasto queda guardado en este Mac y se sincroniza al reconectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : tu peux tout cocher quand même. La dépense reste enregistrée sur ce Mac et se synchronise à la reconnexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: puoi comunque selezionare tutto. La spesa resta salvata su questo Mac e si sincronizza quando ti riconnetti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: nadal możesz wszystko zaznaczyć. Wydatek zostaje zapisany na tym Macu i zsynchronizuje się po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: dá para marcar tudo. A conta fica salva neste Mac e sincroniza ao reconectar."
          }
        }
      }
    },
