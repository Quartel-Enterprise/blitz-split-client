    "Your contacts are empty. The invite link works without them." : {
      "comment" : "Invite from contacts: the agenda was read and holds nobody",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهات اتصالك فارغة. رابط الدعوة يعمل من دونها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контактите ти са празни. Линкът за покана работи и без тях."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কন্টাক্ট তালিকা খালি। কন্টাক্ট ছাড়াও আমন্ত্রণ লিংক কাজ করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tens cap contacte. L’enllaç d’invitació funciona igualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje kontakty jsou prázdné. Odkaz s pozvánkou funguje i bez nich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine kontakter er tomme. Invitationslinket virker uden dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kontakte sind leer. Der Einladungslink funktioniert auch ohne sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επαφές σου είναι κενές. Ο σύνδεσμος πρόσκλησης λειτουργεί και χωρίς αυτές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu agenda está vacía. El enlace de invitación funciona sin ella."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu kontaktid on tühjad. Kutselink töötab ka ilma nendeta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخاطبان شما خالی است. لینک دعوت بدون آن‌ها هم کار می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteystietosi ovat tyhjät. Kutsulinkki toimii ilman niitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang laman ang mga contact mo. Gumagana ang invite link kahit wala ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes contacts sont vides. Le lien d’invitation fonctionne sans eux."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા સંપર્કો ખાલી છે. આમંત્રણ લિંક તેમના વિના પણ કામ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אנשי קשר. קישור ההזמנה עובד גם בלעדיהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके संपर्क खाली हैं। आमंत्रण लिंक उनके बिना भी काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji kontakti su prazni. Poveznica za poziv radi i bez njih."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A névjegyeid üresek. A meghívólink nélkülük is működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakmu kosong. Tautan undangan tetap berfungsi tanpa kontak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua rubrica è vuota. Il link d’invito funziona anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先が空です。招待リンクは連絡先がなくても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처가 비어 있어요. 초대 링크는 연락처 없이도 작동해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo kontaktų sąrašas tuščias. Pakvietimo nuoroda veikia ir be jo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavi kontakti ir tukši. Uzaicinājuma saite darbojas arī bez tiem."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे संपर्क रिकामे आहेत. आमंत्रण लिंक त्यांच्याशिवायही काम करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenalan anda kosong. Pautan jemputan berfungsi tanpanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontaktene dine er tomme. Invitasjonslenken fungerer uten dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je contacten zijn leeg. De uitnodigingslink werkt zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje kontakty są puste. Link z zaproszeniem działa bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua agenda está vazia. O link de convite funciona sem ela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua lista de contactos está vazia. O link de convite funciona sem ela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactele tale sunt goale. Linkul de invitație funcționează și fără ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои контакты пусты. Ссылка-приглашение работает и без них."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje kontakty sú prázdne. Odkaz s pozvánkou funguje aj bez nich."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji stiki so prazni. Povezava za povabilo deluje tudi brez njih."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji kontakti su prazni. Link pozivnice radi i bez njih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina kontakter är tomma. Inbjudningslänken fungerar utan dem."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waasiliani wako hawapo. Kiungo cha mwaliko kinafanya kazi bila wao."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தொடர்புகள் காலியாக உள்ளன. அவை இல்லாமலும் அழைப்பு லிங்க் வேலை செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కాంటాక్ట్‌లు ఖాళీగా ఉన్నాయి. ఆహ్వాన లింక్ అవి లేకుండానే పనిచేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายชื่อติดต่อของคุณว่างเปล่า ลิงก์เชิญใช้ได้โดยไม่ต้องมีรายชื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilerin boş. Davet bağlantısı onlar olmadan da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої контакти порожні. Посилання-запрошення працює й без них."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے رابطے خالی ہیں۔ دعوت کا لنک ان کے بغیر بھی کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh bạ của bạn đang trống. Liên kết mời vẫn hoạt động mà không cần danh bạ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的通讯录是空的。不用通讯录也可以使用邀请链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的通訊錄是空的。不用通訊錄也可以使用邀請連結。"
          }
        }
      }
    },
    "Your groups are only on this Mac. Connect an Apple or Google account to see them on iPhone; without an account, the app on iPhone starts empty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموعاتك موجودة على هذا الـ Mac فقط. اربط حساب Apple أو Google لرؤيتها على iPhone؛ دون حساب، يبدأ التطبيق على iPhone فارغًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групите ти са само на този Mac. Свържи Apple или Google акаунт, за да ги виждаш на iPhone; без акаунт приложението на iPhone започва празно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার গ্রুপগুলো শুধু এই Mac-এ আছে। iPhone-এ দেখতে একটি Apple বা Google অ্যাকাউন্ট সংযুক্ত করুন; অ্যাকাউন্ট ছাড়া iPhone-এর অ্যাপটি খালি অবস্থায় শুরু হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus grups només són en aquest Mac. Connecta un compte d’Apple o de Google per veure’ls a l’iPhone; sense compte, l’app a l’iPhone comença buida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje skupiny jsou jen na tomto Macu. Propoj účet Apple nebo Google, abys je viděl(a) na iPhonu; bez účtu začne aplikace na iPhonu prázdná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine grupper er kun på denne Mac. Forbind en Apple- eller Google-konto for at se dem på iPhone; uden en konto starter appen på iPhone tom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen sind nur auf diesem Mac. Verbinde einen Apple- oder Google-Account, um sie auf dem iPhone zu sehen; ohne Konto startet die App auf dem iPhone leer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ομάδες σου βρίσκονται μόνο σε αυτό το Mac. Σύνδεσε έναν λογαριασμό Apple ή Google για να τις βλέπεις στο iPhone. Χωρίς λογαριασμό, η εφαρμογή στο iPhone ξεκινά κενή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos están solo en este Mac. Conecta una cuenta de Apple o Google para verlos en el iPhone; sin cuenta, la app en el iPhone empieza vacía."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu grupid on ainult selles Macis. Ühenda Apple’i või Google’i konto, et näha neid iPhone’is; ilma kontota algab rakendus iPhone’is tühjana."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌های شما فقط در این Mac هستند. برای دیدن آن‌ها در iPhone، یک حساب Apple یا Google متصل کنید؛ بدون حساب کاربری، برنامه در iPhone خالی شروع می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmäsi ovat vain tällä Macilla. Yhdistä Apple- tai Google-tili nähdäksesi ne iPhonella; ilman tiliä iPhonen sovellus alkaa tyhjänä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa Mac na ito lang ang mga grupo mo. Mag-connect ng Apple o Google account para makita ang mga ito sa iPhone; kapag walang account, walang laman ang app sa iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes groupes sont seulement sur ce Mac. Connecte un compte Apple ou Google pour les voir sur iPhone ; sans compte, l’app sur iPhone démarre vide."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા ગ્રુપ ફક્ત આ Mac પર છે. તેમને iPhone પર જોવા માટે Apple અથવા Google એકાઉન્ટ કનેક્ટ કરો; એકાઉન્ટ વિના, iPhone પરની ઍપ ખાલી શરૂ થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבוצות שלך נמצאות רק ב-Mac הזה. אפשר לחבר חשבון Apple או Google כדי לראות אותן ב-iPhone; בלי חשבון משתמש, האפליקציה ב-iPhone מתחילה ריקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके ग्रुप सिर्फ़ इस Mac पर हैं। उन्हें iPhone पर देखने के लिए Apple या Google अकाउंट जोड़ें; अकाउंट के बिना iPhone पर ऐप खाली शुरू होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje grupe su samo na ovom Macu. Poveži Apple ili Google račun da ih vidiš na iPhoneu; bez računa aplikacija na iPhoneu počinje prazna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoportjaid csak ezen a Macen vannak. Kapcsolj hozzá egy Apple- vagy Google-fiókot, hogy iPhone-on is lásd őket; fiók nélkül az iPhone-os app üresen indul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupmu hanya ada di Mac ini. Hubungkan akun Apple atau Google untuk melihatnya di iPhone; tanpa akun, aplikasi di iPhone mulai kosong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi gruppi sono solo su questo Mac. Collega un account Apple o Google per vederli sull’iPhone; senza account, l’app sull’iPhone parte vuota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループはこのMacにしかありません。iPhoneで見るにはAppleまたはGoogleアカウントを連携してください。アカウントがないと、iPhoneのアプリは空の状態で始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹이 이 Mac에만 있어요. iPhone에서 보려면 Apple 또는 Google 계정을 연결하세요. 계정이 없으면 iPhone 앱은 빈 상태로 시작해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo grupės yra tik šiame Mac. Prijunk „Apple“ arba „Google“ paskyrą, kad matytum jas iPhone; be paskyros programėlė iPhone prasideda tuščia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavas grupas ir tikai šajā Mac datorā. Pievieno Apple vai Google kontu, lai tās redzētu iPhone ierīcē; bez konta lietotne iPhone ierīcē sākas tukša."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे ग्रुप फक्त या Mac वर आहेत. ते iPhone वर पाहण्यासाठी Apple किंवा Google अकाउंट कनेक्ट करा; अकाउंटशिवाय, iPhone वरील ॲप रिकामे सुरू होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpulan anda hanya ada pada Mac ini. Sambungkan akaun Apple atau Google untuk melihatnya pada iPhone; tanpa akaun, aplikasi pada iPhone bermula kosong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppene dine er bare på denne Macen. Koble til en Apple- eller Google-konto for å se dem på iPhone; uten konto starter appen på iPhone tom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je groepen staan alleen op deze Mac. Koppel een Apple- of Google-account om ze op iPhone te zien; zonder account begint de app op iPhone leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje grupy są tylko na tym Macu. Połącz konto Apple lub Google, aby widzieć je na iPhonie; bez konta aplikacja na iPhonie startuje pusta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus grupos estão só neste Mac. Conecte uma conta Apple ou Google para vê-los no iPhone; sem conta, o app no iPhone começa vazio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus grupos estão só neste Mac. Liga uma conta Apple ou Google para os veres no iPhone; sem conta, a app no iPhone começa vazia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupurile tale sunt doar pe acest Mac. Conectează un cont Apple sau Google ca să le vezi pe iPhone; fără cont, aplicația de pe iPhone pornește goală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои группы есть только на этом Mac. Подключи аккаунт Apple или Google, чтобы видеть их на iPhone; без аккаунта приложение на iPhone начнётся с нуля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje skupiny sú len na tomto Macu. Pripoj účet Apple alebo Google, aby si ich videl(a) na iPhone; bez účtu sa aplikácia na iPhone spustí prázdna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje skupine so samo v tem Macu. Poveži račun Apple ali Google, da jih vidiš v iPhonu; brez računa se aplikacija v iPhonu začne prazna."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje grupe su samo na ovom Mac-u. Poveži Apple ili Google nalog da ih vidiš na iPhone-u; bez naloga, aplikacija na iPhone-u počinje prazna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina grupper finns bara på den här Macen. Anslut ett Apple- eller Google-konto för att se dem på iPhone; utan konto börjar appen på iPhone tom."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vikundi vyako viko kwenye Mac hii tu. Unganisha akaunti ya Apple au Google ili kuviona kwenye iPhone; bila akaunti, programu kwenye iPhone inaanza tupu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் குழுக்கள் இந்த Mac-இல் மட்டுமே உள்ளன. iPhone-இல் அவற்றைப் பார்க்க Apple அல்லது Google அக்கவுண்ட்டை இணையுங்கள்; அக்கவுண்ட் இல்லாமல், iPhone-இல் ஆப் காலியாகத் தொடங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ గ్రూప్‌లు ఈ Macలో మాత్రమే ఉన్నాయి. వాటిని iPhoneలో చూడటానికి Apple లేదా Google అకౌంట్‌ను కనెక్ట్ చేయండి; అకౌంట్ లేకుండా, iPhoneలో యాప్ ఖాళీగా మొదలవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มของคุณอยู่บน Mac เครื่องนี้เท่านั้น เชื่อมต่อบัญชี Apple หรือ Google เพื่อดูบน iPhone หากไม่มีบัญชี แอปบน iPhone จะเริ่มต้นแบบว่างเปล่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupların yalnızca bu Mac'te. Onları iPhone'da görmek için bir Apple veya Google hesabı bağla; hesap olmadan iPhone'daki uygulama boş başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої групи є лише на цьому Mac. Підключи обліковий запис Apple або Google, щоб бачити їх на iPhone; без облікового запису застосунок на iPhone починається порожнім."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے گروپ صرف اس Mac پر ہیں۔ انہیں iPhone پر دیکھنے کے لیے Apple یا Google اکاؤنٹ جوڑیں؛ اکاؤنٹ کے بغیر iPhone پر ایپ خالی شروع ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nhóm của bạn chỉ có trên máy Mac này. Hãy kết nối tài khoản Apple hoặc Google để xem trên iPhone; không có tài khoản, ứng dụng trên iPhone sẽ bắt đầu trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的群组只在这台Mac上。关联Apple或Google账号即可在iPhone上看到它们；没有账号时，iPhone上的应用会是空的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的群組只在這台Mac上。連結Apple或Google帳號即可在iPhone上看到它們；沒有帳號時，iPhone上的App會是空的。"
          }
        }
      }
    },
