    "If it was you, talk to %@." : {
      "comment" : "The group's creator, who can sort out a member taken by someone else",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كنت أنت، فتحدّث مع %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако си бил(а) ти, говори с %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি এটি আপনি হয়ে থাকেন, %@-কে জানান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eres tu, parla amb %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi to byl(a) ty, ozvi se: %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det var dig, så tal med %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, sprich mit %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ήσουν εσύ, μίλησε με %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuiste tú, habla con %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui see olid sina, võta ühendust: %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر خودتان بودید، با %@ صحبت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos se olit sinä, puhu henkilön %@ kanssa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung ikaw ito, kausapin si %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c’était toi, parle à %@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જો તે તમે હતા, તો %@ સાથે વાત કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם זה נעשה על ידך, אפשר לפנות ל-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह आप थे, तो %@ से बात करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako si to bio/la ti, razgovaraj s osobom %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha te voltál, beszélj vele: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika itu kamu, bicarakan dengan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eri tu, parlane con %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの場合は、%@に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인이라면 %@ 님과 이야기해 보세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei tai buvai tu, kreipkis į grupės kūrėją: %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja tas biji tu, sazinies ar grupas veidotāju %@."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जर ते तुम्ही असाल, तर %@ यांच्याशी बोला."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika itu anda, hubungi %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det var deg, snakk med %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jij het? Neem contact op met %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to ty, porozmawiaj z twórcą grupy: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se era você, fale com %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eras tu, fala com %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ai fost tu, vorbește cu %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это был(а) ты, поговори с участником %@."
