        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真の問題ではありません。少ししてからもう一度試すか、手動で入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
