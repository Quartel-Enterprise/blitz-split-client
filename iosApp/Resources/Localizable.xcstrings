    },
    "Your account has no Google or Apple sign in. When you sign out, we erase the copy on this %@. To come back, you need the recovery code." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto hat keine Anmeldung mit Google oder Apple. Wenn du dich abmeldest, löschen wir die Kopie auf diesem %@. Um zurückzukommen, brauchst du den Wiederherstellungscode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene Google ni Apple. Al cerrar sesión, borramos la copia de este %@. Para volver, necesitas el código de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n’a pas de connexion Google ni Apple. Quand tu te déconnectes, on efface la copie sur ton %@. Pour revenir, il te faut le code de récupération."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akunmu tidak punya login Google atau Apple. Saat kamu keluar, kami menghapus salinan di %@ ini. Untuk kembali, kamu butuh kode pemulihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha l’accesso con Google o Apple. Quando esci, cancelliamo la copia su questo %@. Per tornare ti serve il codice di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントにGoogleまたはAppleのログインがありません。ログアウトすると、この%@のデータは消去されます。戻るには復元コードが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account heeft geen inlog met Google of Apple. Als je uitlogt, wissen we de kopie op deze %@. Om terug te komen heb je de herstelcode nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie ma logowania przez Google ani Apple. Po wylogowaniu usuniemy kopię z tego urządzenia (%@). Aby wrócić, potrzebujesz kodu odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta não tem Google nem Apple. Ao sair, apagamos a cópia deste %@. Para voltar, só com o código de recuperação."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabında Google veya Apple girişi yok. Çıkış yaptığında bu %@ üzerindeki kopyayı sileriz. Geri dönmek için kurtarma kodu gerekir."
          }
        }
      }
    },
    "Your contacts are empty. The invite link works without them." : {
      "comment" : "Invite from contacts: the agenda was read and holds nobody",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kontakte sind leer. Der Einladungslink funktioniert auch ohne sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu agenda está vacía. El enlace de invitación funciona sin ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes contacts sont vides. Le lien d’invitation fonctionne sans eux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakmu kosong. Tautan undangan tetap berfungsi tanpa kontak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua rubrica è vuota. Il link d’invito funziona anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先が空です。招待リンクは連絡先がなくても使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je contacten zijn leeg. De uitnodigingslink werkt zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje kontakty są puste. Link z zaproszeniem działa bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua agenda está vazia. O link de convite funciona sem ela."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilerin boş. Davet bağlantısı onlar olmadan da çalışır."
          }
        }
      }
    },
    "Your groups are only on this Mac. Connect an Apple or Google account to see them on iPhone; without an account, the app on iPhone starts empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen sind nur auf diesem Mac. Verbinde einen Apple- oder Google-Account, um sie auf dem iPhone zu sehen; ohne Konto startet die App auf dem iPhone leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos están solo en este Mac. Conecta una cuenta de Apple o Google para verlos en el iPhone; sin cuenta, la app en el iPhone empieza vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes groupes sont seulement sur ce Mac. Connecte un compte Apple ou Google pour les voir sur iPhone ; sans compte, l’app sur iPhone démarre vide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupmu hanya ada di Mac ini. Hubungkan akun Apple atau Google untuk melihatnya di iPhone; tanpa akun, aplikasi di iPhone mulai kosong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi gruppi sono solo su questo Mac. Collega un account Apple o Google per vederli sull’iPhone; senza account, l’app sull’iPhone parte vuota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループはこのMacにしかありません。iPhoneで見るにはAppleまたはGoogleアカウントを連携してください。アカウントがないと、iPhoneのアプリは空の状態で始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je groepen staan alleen op deze Mac. Koppel een Apple- of Google-account om ze op iPhone te zien; zonder account begint de app op iPhone leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje grupy są tylko na tym Macu. Połącz konto Apple lub Google, aby widzieć je na iPhonie; bez konta aplikacja na iPhonie startuje pusta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus grupos estão só neste Mac. Conecte uma conta Apple ou Google para vê-los no iPhone; sem conta, o app no iPhone começa vazio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupların yalnızca bu Mac'te. Onları iPhone'da görmek için bir Apple veya Google hesabı bağla; hesap olmadan iPhone'daki uygulama boş başlar."
          }
        }
      }
    },
    "Your map is empty" : {
      "comment" : "Category map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zuordnung ist leer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mapa está vacío"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta carte est vide"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petamu kosong"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mappa è vuota"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップは空です"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kaart is leeg"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja mapa jest pusta"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu mapa está vazio"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritan boş"
          }
        }
      }
    },
    "Your map stays on this device only. To take it to your other devices, sign in with Google or Apple in your Profile." : {
      "comment" : "Category map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zuordnung bleibt nur auf diesem Gerät. Um sie auf deine anderen Geräte mitzunehmen, melde dich in deinem Profil mit Google oder Apple an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mapa queda solo en este dispositivo. Para llevarlo a tus otros dispositivos, inicia sesión con Google o Apple en tu Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta carte reste uniquement sur cet appareil. Pour l’emporter sur tes autres appareils, connecte-toi avec Google ou Apple dans ton Profil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petamu hanya ada di perangkat ini. Untuk membawanya ke perangkatmu yang lain, masuk dengan Google atau Apple di Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mappa resta solo su questo dispositivo. Per portarla sugli altri tuoi dispositivi, accedi con Google o Apple nel tuo Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップはこのデバイスにのみ保存されます。ほかのデバイスで使うには、プロフィールでGoogleまたはAppleでログインしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kaart blijft alleen op dit apparaat. Om hem naar je andere apparaten mee te nemen, log je in met Google of Apple in je Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja mapa zostaje tylko na tym urządzeniu. Aby przenieść ją na inne urządzenia, zaloguj się przez Google lub Apple w Profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu mapa fica só neste aparelho. Para levar a outros aparelhos, entre com Google ou Apple no Perfil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritan yalnızca bu cihazda kalır. Diğer cihazlarına taşımak için Profil'de Google veya Apple ile giriş yap."
          }
        }
      }
    },
