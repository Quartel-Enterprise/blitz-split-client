        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, uygulaması olmayan bir misafir. Sana ne ödediğini not etmek için tıkla; bildirim almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гість без застосунку. Клацни, щоб записати, що тобі сплатили; сповіщення не надійде."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ایپ کے بغیر مہمان ہیں۔ انہوں نے آپ کو جو ادائیگی کی، اسے درج کرنے کے لیے کلک کریں؛ انہیں کوئی اطلاع نہیں ملے گی۔"
