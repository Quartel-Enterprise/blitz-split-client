          "stringUnit" : {
            "state" : "translated",
            "value" : "এই রং ব্যবহৃত হচ্ছে এখানে: %@। আগে সেটির রং বদলান, তারপর মুছুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto barvu používá %@. Nejdřív té kategorii změň barvu, pak tuto barvu smaž."
