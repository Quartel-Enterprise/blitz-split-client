    "Its data is erased once what it queued is sent. Your iPhone stays signed in." : {
      "comment" : "Apple Watch: under Sign out of this watch?",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُمحى بياناتها بعد إرسال ما في قائمة الانتظار. يبقى iPhone مسجّل الدخول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните му се изтриват, след като изпрати чакащото в опашката. iPhone остава с вход."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অপেক্ষায় থাকা সব পাঠানো হলে এর ডেটা মুছে যাবে। আপনার iPhone-এ সাইন ইন থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jejich data se smažou, jakmile se odešle vše ve frontě. iPhone zůstane přihlášený."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Daten werden gelöscht, sobald alles Wartende gesendet ist. Dein iPhone bleibt angemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα του σβήνονται μόλις σταλούν όσα περιμένουν. Το iPhone σου μένει συνδεδεμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus datos se borran cuando se envíe lo que tiene en cola. Tu iPhone sigue con la sesión iniciada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داده‌های آن پس از ارسال موارد در صف پاک می‌شود. iPhone شما همچنان وارد شده می‌ماند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabubura ang data nito kapag naipadala na ang mga nakapila. Nananatiling naka-sign in ang iPhone mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses données sont effacées une fois ses modifications en attente envoyées. Ton iPhone reste connecté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנתונים שלו יימחקו אחרי שכל מה שבתור יישלח. ה-iPhone שלך יישאר מחובר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कतार में रखा सब भेजे जाने के बाद इसका डेटा मिट जाएगा। आपका iPhone साइन इन रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njegovi se podaci brišu kad se pošalje sve iz reda čekanja. iPhone ostaje prijavljen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adatai törlődnek, amint elküldte, ami sorban áll. Az iPhone-od bejelentkezve marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datanya dihapus setelah antreannya terkirim. iPhone-mu tetap masuk ke akun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi dati vengono cancellati dopo l’invio di ciò che è in coda. L’iPhone resta connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちの内容が送られた後、データは消去されます。iPhoneはログインしたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 변경 사항이 전송되면 데이터가 삭제돼요. iPhone은 로그인 상태로 유지돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datanya dipadam selepas apa yang beratur dihantar. iPhone anda kekal log masuk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevens worden gewist zodra alles in de wachtrij is verstuurd. Je iPhone blijft ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego dane znikną po wysłaniu tego, co czeka w kolejce. iPhone pozostanie zalogowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados dele são apagados depois que o que está na fila for enviado. Seu iPhone continua conectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados dele são apagados assim que o que está na fila for enviado. O teu iPhone continua com sessão iniciada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele lui se șterg după ce se trimite ce e în așteptare. iPhone-ul rămâne conectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные удалятся, когда отправится всё из очереди. На iPhone вход сохранится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich údaje sa vymažú, keď sa odošle, čo je vo fronte. Tvoj iPhone zostane prihlásený."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njegovi podaci se brišu kad se pošalje ono što je bilo u redu čekanja. iPhone ostaje prijavljen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess data raderas när det som väntar har skickats. Din iPhone förblir inloggad."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரிசையில் உள்ளவை அனுப்பப்பட்டதும் இதன் தரவு அழிக்கப்படும். உங்கள் iPhone உள்நுழைந்தபடியே இருக்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลในนาฬิกาจะถูกลบเมื่อส่งรายการที่รอส่งแล้ว iPhone ของคุณยังคงเข้าสู่ระบบอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradakiler gönderilince verileri silinir. iPhone'undaki oturum açık kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані видаляться, коли надішлеться все з черги. На iPhone вхід збережеться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قطار میں موجود چیزیں بھیجے جاتے ہی اس کا ڈیٹا مٹ جائے گا۔ آپ کا iPhone سائن اِن رہے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của đồng hồ sẽ bị xóa sau khi các mục đang chờ được gửi đi. iPhone của bạn vẫn đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待发送的内容发出后，手表上的数据会被清除。你的iPhone仍保持登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待傳送的內容送出後，手錶上的資料會被清除。你的iPhone仍會保持登入。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
