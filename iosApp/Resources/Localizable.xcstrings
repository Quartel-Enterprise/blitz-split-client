          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося вийти з групи. Перевір з'єднання й спробуй ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروپ نہیں چھوڑا جا سکا۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
