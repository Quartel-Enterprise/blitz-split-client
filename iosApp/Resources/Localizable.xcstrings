        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do kontaktów. Aby zapraszać z kontaktów, zezwól na dostęp do Kontaktów w Ustawieniach systemowych. Link z zaproszeniem działa bez tego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos contatos foi negado. Para convidar da agenda, libere Contatos nos Ajustes do Sistema. O link de convite funciona sem isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos contactos foi negado. Para convidar a partir dos contactos, permite o acesso a Contactos nas Definições do Sistema. O link de convite funciona sem isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la contacte a fost refuzat. Ca să inviți din contacte, permite Contacte în Configurări sistem. Linkul de invitație funcționează și fără."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к контактам запрещён. Чтобы приглашать из контактов, разреши доступ к Контактам в Системных настройках. Ссылка-приглашение работает и без этого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup ku kontaktom bol zamietnutý. Ak chceš pozývať z kontaktov, povoľ Kontakty v Systémových nastaveniach. Odkaz s pozvánkou funguje aj bez toho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop do stikov je bil zavrnjen. Da povabiš iz stikov, dovoli Stike v sistemskih nastavitvah. Povezava za povabilo deluje tudi brez tega."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kontaktima je odbijen. Da bi pozivao/la iz kontakata, dozvoli Kontakte u podešavanjima sistema. Link pozivnice radi i bez toga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till kontakter nekades. För att bjuda in från dina kontakter, tillåt Kontakter i Systeminställningar. Inbjudningslänken fungerar utan det."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufikiaji wa waasiliani umekataliwa. Ili kualika kutoka kwa waasiliani wako, ruhusu Waasiliani katika Mipangilio ya Mfumo. Kiungo cha mwaliko kinafanya kazi bila hilo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர்புகளுக்கான அணுகல் மறுக்கப்பட்டது. உங்கள் தொடர்புகளிலிருந்து அழைக்க, சிஸ்டம் அமைப்புகளில் தொடர்புகளை அனுமதியுங்கள். அழைப்பு லிங்க் அது இல்லாமலும் வேலை செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కాంటాక్ట్‌ల యాక్సెస్ నిరాకరించబడింది. మీ కాంటాక్ట్‌ల నుండి ఆహ్వానించడానికి, సిస్టమ్ సెట్టింగ్‌లలో కాంటాక్ట్‌లను అనుమతించండి. అది లేకుండానే ఆహ్వాన లింక్ పనిచేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงรายชื่อติดต่อถูกปฏิเสธ หากต้องการเชิญจากรายชื่อติดต่อ ให้อนุญาตรายชื่อในการตั้งค่าระบบ ลิงก์เชิญใช้ได้โดยไม่ต้องอนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilere erişim reddedildi. Kişilerinden davet etmek için Sistem Ayarları'nda Kişiler'e izin ver. Davet bağlantısı bu izin olmadan da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до контактів заборонено. Щоб запрошувати з контактів, дозволь Контакти в Системних параметрах. Посилання-запрошення працює й без цього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابطوں تک رسائی سے انکار کر دیا گیا۔ اپنے رابطوں سے دعوت دینے کے لیے سسٹم ترتیبات میں رابطوں کی اجازت دیں۔ دعوت کا لنک اس کے بغیر بھی کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập danh bạ đã bị từ chối. Để mời từ danh bạ, hãy cho phép Danh bạ trong Cài đặt hệ thống. Liên kết mời vẫn hoạt động mà không cần quyền này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通讯录访问被拒绝。要从通讯录邀请，请在系统设置中允许访问通讯录。邀请链接无需通讯录也能使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通訊錄存取被拒絕。要從通訊錄邀請，請在系統設定中允許存取通訊錄。邀請連結無需通訊錄也能使用。"
          }
        }
      }
    },
