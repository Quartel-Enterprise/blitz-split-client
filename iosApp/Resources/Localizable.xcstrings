    "Notices arrive when there's internet. To mute a group, use the menu inside it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل التنبيهات عند توفر الإنترنت. لكتم مجموعة، استخدم القائمة داخلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известията пристигат, когато има интернет. За да заглушиш група, използвай менюто в нея."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট থাকলে নোটিফিকেশন আসবে। কোনো গ্রুপ মিউট করতে সেই গ্রুপের ভেতরের মেনু ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els avisos arriben quan hi ha internet. Per silenciar un grup, fes servir el menú de dins del grup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení přicházejí, když je internet. Pro ztlumení skupiny použij nabídku uvnitř ní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer kommer, når der er internet. Brug menuen inde i en gruppe for at slå den på lydløs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise kommen an, wenn Internet da ist. Um eine Gruppe stummzuschalten, nutze das Menü in der Gruppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις φτάνουν όταν υπάρχει ίντερνετ. Για να σιγάσεις μια ομάδα, χρησιμοποίησε το μενού μέσα σε αυτήν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos llegan cuando hay internet. Para silenciar un grupo, usa el menú dentro de él."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teavitused saabuvad, kui internet on olemas. Grupi vaigistamiseks kasuta selle sees olevat menüüd."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها وقتی اینترنت باشد می‌رسند. برای بی‌صدا کردن یک گروه، از منوی داخل آن استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset saapuvat, kun internetyhteys on käytettävissä. Voit mykistää ryhmän sen sisällä olevasta valikosta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dumarating ang mga abiso kapag may internet. Para i-mute ang isang grupo, gamitin ang menu sa loob nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les avis arrivent quand il y a internet. Pour mettre un groupe en sourdine, utilise le menu à l’intérieur."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઇન્ટરનેટ હોય ત્યારે નોટિફિકેશન આવે છે. કોઈ ગ્રુપને મ્યૂટ કરવા, તેની અંદરનું મેનૂ વાપરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתראות מגיעות כשיש אינטרנט. כדי להשתיק קבוצה, אפשר להשתמש בתפריט שבתוכה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचनाएं इंटरनेट होने पर आती हैं। किसी ग्रुप को म्यूट करने के लिए उसके अंदर का मेन्यू इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijesti stižu kad ima interneta. Za utišavanje grupe upotrijebi izbornik unutar nje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értesítések akkor érkeznek, ha van internet. Egy csoport némításához használd a csoporton belüli menüt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi datang saat ada internet. Untuk membisukan grup, pakai menu di dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi arrivano quando c’è internet. Per silenziare un gruppo, usa il menu al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知はインターネット接続時に届きます。グループをミュートするには、グループ内のメニューを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림은 인터넷에 연결되면 도착해요. 그룹 알림을 끄려면 그룹 안의 메뉴를 사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pranešimai ateina, kai yra internetas. Kad nutildytum grupę, naudok jos meniu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paziņojumi pienāk, kad ir internets. Lai izslēgtu grupas paziņojumus, izmanto izvēlni grupā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट असताना सूचना येतात. एखादा ग्रुप म्यूट करण्यासाठी त्यातील मेनू वापरा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notis tiba apabila ada internet. Untuk membisukan kumpulan, gunakan menu di dalamnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får varsler når du har nett. Bruk menyen inne i en gruppe for å dempe den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen komen binnen als er internet is. Om een groep te dempen, gebruik je het menu in de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia przychodzą, gdy jest internet. Aby wyciszyć grupę, użyj menu w jej środku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os avisos chegam quando há internet. Para silenciar um grupo, use o menu dentro dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os avisos chegam quando há internet. Para silenciar um grupo, usa o menu dentro dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificările sosesc când există internet. Ca să dezactivezi notificările unui grup, folosește meniul din interiorul lui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления приходят, когда есть интернет. Чтобы отключить уведомления группы, используй меню внутри неё."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornenia prídu, keď bude internet. Ak chceš skupinu stlmiť, použi ponuku v nej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvestila prispejo, ko je na voljo internet. Če želiš utišati skupino, uporabi meni v njej."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obaveštenja stižu kada postoji internet. Da isključiš zvuk grupe, koristi meni unutar nje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviseringar kommer när det finns internet. Stäng av ljudet för en grupp via menyn i den."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arifa zinafika kukiwa na intaneti. Kunyamazisha kikundi, tumia menyu iliyo ndani yake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணையம் இருக்கும்போது அறிவிப்புகள் வரும். ஒரு குழுவை மியூட் செய்ய, அதன் உள்ளே உள்ள மெனுவைப் பயன்படுத்துங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంటర్నెట్ ఉన్నప్పుడు నోటిఫికేషన్‌లు వస్తాయి. ఒక గ్రూప్‌ను మ్యూట్ చేయడానికి, దానిలోని మెనూను ఉపయోగించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนจะมาถึงเมื่อมีอินเทอร์เน็ต หากต้องการปิดเสียงกลุ่ม ให้ใช้เมนูในกลุ่มนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler internet olunca gelir. Bir grubu sessize almak için içindeki menüyü kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення надходять, коли є інтернет. Щоб вимкнути звук групи, скористайся меню всередині неї."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوٹیفکیشن انٹرنیٹ ہونے پر آتے ہیں۔ کسی گروپ کو خاموش کرنے کے لیے اس کے اندر کا مینو استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đến khi có internet. Để tắt thông báo của một nhóm, dùng menu bên trong nhóm đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有网络时才会收到通知。要将某个群组设为免打扰，请使用群组内的菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
