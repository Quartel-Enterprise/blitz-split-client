    },
    "You use it without an account and haven't synced yet, so there is no recovery code. When you leave, your profile is gone for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt die App ohne Konto und hast noch nicht synchronisiert, daher gibt es keinen Wiederherstellungscode. Wenn du gehst, ist dein Profil endgültig weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La usas sin cuenta y aún no has sincronizado, así que no hay código de recuperación. Al salir, tu perfil desaparece para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu l’utilises sans compte et tu ne t’es pas encore synchronisé, donc il n’y a pas de code de récupération. Quand tu pars, ton profil disparaît définitivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memakainya tanpa akun dan belum menyinkronkan, jadi belum ada kode pemulihan. Saat kamu keluar, profilmu hilang selamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La usi senza account e non hai ancora sincronizzato, quindi non c’è un codice di recupero. Quando esci, il tuo profilo sparisce per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントなしで使っていて、まだ同期していないため、復元コードはありません。退出すると、プロフィールは完全に失われます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebruikt de app zonder account en hebt nog niet gesynchroniseerd, dus er is geen herstelcode. Als je weggaat, is je profiel voorgoed weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używasz aplikacji bez konta i jeszcze bez synchronizacji, więc nie ma kodu odzyskiwania. Gdy wyjdziesz, twój profil zniknie na zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usa sem conta e ainda não sincronizou, então não há código de recuperação. Ao sair, seu perfil some de vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesapsız kullanıyorsun ve henüz eşitleme yapmadın, bu yüzden kurtarma kodu yok. Ayrıldığında profilin tamamen silinir."
          }
        }
      }
    },
    "You're invited to %@" : {
