    "Screens and taps, to improve the app. Never names or amounts." : {
      "comment" : "Profile: what Share usage data sends",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشات والنقرات، لتحسين التطبيق. لا أسماء ولا مبالغ أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirme und Aktionen, um die App zu verbessern. Nie Namen oder Beträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantallas y toques, para mejorar la app. Nunca nombres ni montos."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantallas y toques, para mejorar la app. Nunca nombres ni importes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrans et appuis, pour améliorer l’app. Jamais de noms ni de montants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסכים והקשות, לשיפור האפליקציה. אף פעם לא שמות או סכומים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बेहतर बनाने के लिए स्क्रीन और टैप। नाम या रकम कभी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar dan ketukan, untuk meningkatkan aplikasi. Tidak pernah nama atau jumlah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermate e tocchi, per migliorare l’app. Mai nomi o importi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いた画面と操作をアプリの改善に使います。名前や金額は送りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 개선을 위한 화면과 탭 기록이에요. 이름이나 금액은 절대 보내지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermen en tikken, om de app te verbeteren. Nooit namen of bedragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrany i dotknięcia, by ulepszać aplikację. Nigdy imion ani kwot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telas e toques, para melhorar o app. Nunca nomes ou valores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecrãs e toques, para melhorar a app. Nunca nomes nem valores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экраны и нажатия, чтобы улучшать приложение. Никогда — имена или суммы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอและการแตะ เพื่อปรับปรุงแอป ไม่มีชื่อหรือจำนวนเงิน"
