    "%@ already settled up with %@ after this bill" : {
      "comment" : "Edit bill and Delete this bill?: the first %@ paid the second after the bill, which the change unsettles",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت التسوية بين %@ و%@ بعد هذه الفاتورة"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вече уреди сметките с %@ след този разход"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বিলের পরে %@ ইতিমধ্যে %@-কে পরিশোধ করে হিসাব মিটিয়েছেন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja havia liquidat comptes amb %@ després d’aquesta despesa"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už po tomto výdaji zaplatil(a) uživateli %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har allerede gjort op med %@ efter denne udgift"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat nach dieser Ausgabe schon mit %2$@ abgerechnet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ έκανε ήδη εξόφληση με %@ μετά από αυτό το έξοδο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya saldó cuentas con %2$@ después de este gasto"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arveldas pärast seda kulu juba liikmega %@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بعد از این هزینه با %@ تسویه حساب کرده است"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on jo tasannut velkansa henkilön %@ kanssa tämän kulun jälkeen"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ay nakipagbayaran na kay %@ pagkatapos ng bill na ito"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a déjà réglé avec %2$@ après cette dépense"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ખર્ચ પછી %@ એ %@ સાથે પહેલેથી હિસાબ પતાવી દીધો છે"
          }
        },
        "he" : {
