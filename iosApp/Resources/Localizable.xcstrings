    "Tap each item and check who had it. Done unlocks once every item has someone." : {
      "comment" : "Bill items: no item has anyone yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك النقر على كل عنصر وتحديد من تناوله. يتاح «تم» بعد أن يكون لكل عنصر شخص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни всеки артикул и отбележи кой го е имал. Готово се отключва, когато всеки артикул има някого."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি আইটেমে ট্যাপ করে কে কে নিয়েছেন তা চিহ্নিত করুন। প্রতিটি আইটেমে কেউ থাকলে “সম্পন্ন” চালু হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepni na každou položku a označ, kdo ji měl. Hotovo se odemkne, až bude mít každá položka někoho."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf jede Position und wähl aus, wer sie hatte. „Fertig“ wird aktiv, sobald jede Position jemanden hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε κάθε είδος και τσέκαρε ποιος το είχε. Το «Τέλος» ενεργοποιείται μόλις κάθε είδος έχει κάποιον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cada artículo y marca quién lo consumió. Listo se habilita cuando todos tengan a alguien."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی هر قلم بزنید و مشخص کنید چه کسی آن را داشت. وقتی هر قلم کسی را داشته باشد، «انجام شد» فعال می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang bawat item at i-check kung sino ang may nakuha. Magagamit ang Tapos na kapag may kasama na ang bawat item."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche chaque article et coche qui l’a pris. Terminé se débloque quand chaque article a quelqu’un."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להקיש על כל פריט ולסמן מי צרך אותו. הלחצן \"סיום\" יהיה זמין כשלכל פריט יהיה מישהו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम पर टैप करें और चुनें कि किसने लिया। हर आइटम में कोई होने पर हो गया चालू होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni svaku stavku i označi tko ju je imao. Gotovo se otključava kad svaka stavka ima nekoga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints az egyes tételekre, és jelöld be, ki fogyasztotta. A Kész akkor válik elérhetővé, ha minden tételhez tartozik valaki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk setiap item dan centang siapa yang mengambilnya. Selesai aktif begitu setiap item punya orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca ogni voce e seleziona chi l’ha presa. Fine si sblocca quando ogni voce ha qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品目をタップして、誰の分かチェックしてください。すべての品目に誰かが入ると「完了」が押せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목을 탭하고 누구 몫인지 선택하세요. 모든 항목에 사람이 있어야 완료할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik setiap item dan tandakan siapa yang mengambilnya. Selesai akan dibuka apabila setiap item ada orangnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op elk item en vink aan wie het had. Gereed werkt zodra elk item iemand heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij każdą pozycję i zaznacz, kto ją miał. „Gotowe” odblokuje się, gdy każda pozycja będzie mieć kogoś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em cada item e marque quem consumiu. Pronto libera quando todos tiverem dono."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em cada item e marca quem consumiu. Pronto fica ativo quando todos os itens tiverem dono."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge fiecare produs și bifează cine l-a avut. Gata se activează când fiecare produs are pe cineva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми на каждую позицию и отметь, кто её брал. «Готово» станет доступно, когда у каждой позиции будет кто-то."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťukni na každú položku a označ, kto ju mal. Hotovo sa odomkne, keď bude mať každá položka niekoho."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni svaku stavku i označi ko ju je imao. Gotovo se otključava kad svaka stavka ima nekoga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på varje artikel och markera vem som hade den. Klar blir tillgängligt när varje artikel har någon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு பொருளையும் தட்டி, அதை யார் எடுத்தார்கள் என்று தேர்வு செய்யுங்கள். ஒவ்வொரு பொருளுக்கும் யாராவது இருந்தால் முடிந்தது இயக்கப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะแต่ละรายการแล้วเลือกว่าใครสั่ง ปุ่มเสร็จสิ้นจะกดได้เมื่อทุกรายการมีคนแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kaleme dokun ve kimin aldığını işaretle. Her kalemde biri olunca Bitti açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкнись кожної позиції й познач, хто її брав. «Готово» стане доступним, коли в кожної позиції буде хтось."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر آئٹم پر ٹیپ کریں اور نشان لگائیں کہ کس نے لیا۔ ہر آئٹم کے ساتھ کوئی ہونے پر ہو گیا فعال ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào từng món và đánh dấu ai đã dùng. Nút Xong sẽ mở khi mỗi món đều có người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按每个项目，勾选谁消费了它。每个项目都有人后才能点“完成”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下每個項目，勾選誰消費了它。每個項目都有人後才能點「完成」。"
          }
        }
      }
    },
    "Double-click each item and check who had it. Done unlocks once every item has someone." : {
      "comment" : "Bill items on the Mac, where a double click opens an item: no item has anyone yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك النقر المزدوج على كل عنصر وتحديد من تناوله. يتاح «تم» بعد أن يكون لكل عنصر شخص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щракни два пъти върху всеки артикул и отбележи кой го е имал. Готово се отключва, когато всеки артикул има някого."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি আইটেমে ডাবল-ক্লিক করে কে কে নিয়েছেন তা চিহ্নিত করুন। প্রতিটি আইটেমে কেউ থাকলে “সম্পন্ন” চালু হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvakrát klikni na každou položku a označ, kdo ji měl. Hotovo se odemkne, až bude mít každá položka někoho."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke auf jede Position und wähl aus, wer sie hatte. „Fertig“ wird aktiv, sobald jede Position jemanden hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνε διπλό κλικ σε κάθε είδος και τσέκαρε ποιος το είχε. Το «Τέλος» ενεργοποιείται μόλις κάθε είδος έχει κάποιον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en cada artículo y marca quién lo consumió. Listo se habilita cuando todos tengan a alguien."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی هر قلم دوبار کلیک کنید و مشخص کنید چه کسی آن را داشت. وقتی هر قلم کسی را داشته باشد، «انجام شد» فعال می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-double-click ang bawat item at i-check kung sino ang may nakuha. Magagamit ang Tapos na kapag may kasama na ang bawat item."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-clique sur chaque article et coche qui l’a pris. Terminé se débloque quand chaque article a quelqu’un."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר ללחוץ לחיצה כפולה על כל פריט ולסמן מי לקח אותו. סיום יהיה זמין כשלכל פריט יש מישהו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम पर डबल-क्लिक करें और चुनें कि किसने लिया। हर आइटम में कोई होने पर हो गया चालू होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvaput klikni svaku stavku i označi tko ju je imao. Gotovo se otključava kad svaka stavka ima nekoga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattints duplán az egyes tételekre, és jelöld be, ki fogyasztotta. A Kész akkor válik elérhetővé, ha minden tételhez tartozik valaki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua kali setiap item dan centang siapa yang mengambilnya. Selesai aktif begitu setiap item punya orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su ogni voce e seleziona chi l’ha presa. Fine si sblocca quando ogni voce ha qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品目をダブルクリックして、誰の分かチェックしてください。すべての品目に誰かが入ると「完了」が押せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목을 더블 클릭하고 누구 몫인지 선택하세요. 모든 항목에 사람이 있어야 완료할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua kali setiap item dan tandakan siapa yang mengambilnya. Selesai akan dibuka apabila setiap item ada orangnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklik op elk item en vink aan wie het had. Gereed werkt zodra elk item iemand heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij dwukrotnie każdą pozycję i zaznacz, kto ją miał. „Gotowe” odblokuje się, gdy każda pozycja będzie mieć kogoś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique duas vezes em cada item e marque quem consumiu. Pronto libera quando todos tiverem dono."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clica duas vezes em cada item e marca quem consumiu. Pronto fica disponível quando todos tiverem dono."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă dublu clic pe fiecare produs și bifează cine l-a avut. Gata se activează când fiecare produs are pe cineva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды кликни на каждую позицию и отметь, кто её брал. «Готово» станет доступно, когда у каждой позиции будет кто-то."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvakrát klikni na každú položku a označ, kto ju mal. Hotovo sa odomkne, keď bude mať každá položka niekoho."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvaput klikni svaku stavku i označi ko ju je imao. Gotovo se otključava kad svaka stavka ima nekoga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklicka på varje artikel och markera vem som hade den. Klar blir tillgängligt när varje artikel har någon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு பொருளையும் இருமுறை கிளிக் செய்து, அதை யார் எடுத்தார்கள் என்று தேர்வு செய்யுங்கள். ஒவ்வொரு பொருளுக்கும் யாராவது இருந்தால் முடிந்தது இயக்கப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดับเบิลคลิกแต่ละรายการแล้วเลือกว่าใครสั่ง ปุ่มเสร็จสิ้นจะกดได้เมื่อทุกรายการมีคนแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kaleme çift tıkla ve kimin aldığını işaretle. Her kalemde biri olunca Bitti açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі клацни кожну позицію й познач, хто її брав. «Готово» стане доступним, коли в кожної позиції буде хтось."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر آئٹم پر ڈبل کلک کریں اور نشان لگائیں کہ کس نے لیا۔ ہر آئٹم کے ساتھ کوئی ہونے پر ہو گیا فعال ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp đúp vào từng món và đánh dấu ai đã dùng. Nút Xong sẽ mở khi mỗi món đều có người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击每个项目，勾选有谁。每个项目都有人后才能点“完成”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按兩下每個項目，勾選誰消費了它。每個項目都有人後才能按一下「完成」。"
          }
        }
      }
    },
