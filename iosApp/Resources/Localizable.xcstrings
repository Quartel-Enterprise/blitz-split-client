        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гість без застосунку. Він(вона) дізнається про це лише з цього повідомлення, тож у ньому вже сказано, що увійшло в рахунок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مہمان ہیں جن کے پاس ایپ نہیں۔ انہیں اس کا پتا صرف اسی پیغام سے چلے گا، اس لیے اس میں پہلے ہی بتایا گیا ہے کہ خرچ میں کیا شامل تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là khách và không dùng ứng dụng. Họ chỉ biết về khoản này qua tin nhắn này, nên tin nhắn đã ghi rõ những gì có trong khoản chi."
