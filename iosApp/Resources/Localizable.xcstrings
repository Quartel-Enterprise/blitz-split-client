    "This is a Lightning invoice (lnbc…): it pays once and expires. Paste a Lightning Address or an LNURL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine Lightning-Rechnung (lnbc…): Sie zahlt einmal und läuft ab. Füge eine Lightning-Adresse oder eine LNURL ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es una factura Lightning (lnbc…): sirve para un solo pago y caduca. Pega una Lightning Address o un LNURL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une facture Lightning (lnbc…) : elle ne paie qu’une fois et expire. Colle une adresse Lightning ou un LNURL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una fattura Lightning (lnbc…): si paga una volta e scade. Incolla un Lightning Address o un LNURL."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest faktura Lightning (lnbc…): płaci się ją raz i wygasa. Wklej Lightning Address lub LNURL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é uma fatura Lightning (lnbc…): vale para um pagamento só e expira. Cole um Lightning Address ou um LNURL."
          }
        }
      }
    },
