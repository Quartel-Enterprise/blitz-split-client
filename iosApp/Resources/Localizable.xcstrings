    "The last saved edit wins: if you save now, your edit replaces that change." : {
      "comment" : "Conflict banner of Edit bill, after who changed it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zuletzt gespeicherte Änderung gewinnt: Wenn du jetzt speicherst, ersetzt deine Änderung diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la última edición guardada: si guardas ahora, tu edición reemplaza ese cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière modification enregistrée l’emporte : si tu enregistres maintenant, ta modification remplace ce changement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vince l’ultima modifica salvata: se salvi ora, la tua modifica sostituisce quella."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygrywa ostatnia zapisana edycja: jeśli zapiszesz teraz, twoja edycja zastąpi tę zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a última edição salva: se você salvar agora, a sua edição substitui essa mudança."
          }
        }
      }
    },
