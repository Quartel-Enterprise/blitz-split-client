    "Your groups and anyone with your profile link see your name and photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترى مجموعاتك وكل من لديه رابط ملفك الشخصي اسمك وصورتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоите групи и всеки с линка към профила ти виждат името и снимката ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার গ্রুপের সদস্যরা এবং আপনার প্রোফাইল লিংক যাঁদের কাছে আছে তাঁরা আপনার নাম ও ছবি দেখতে পান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje skupiny a kdokoli s odkazem na tvůj profil vidí tvoje jméno a fotku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen und alle mit dem Link zu deinem Profil sehen deinen Namen und dein Foto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ομάδες σου και όποιος έχει τον σύνδεσμο του προφίλ σου βλέπουν το όνομα και τη φωτογραφία σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos y quien tenga el enlace de tu perfil ven tu nombre y tu foto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌های شما و هر کسی که لینک پروفایل شما را دارد نام و عکس شما را می‌بینند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga grupo mo at sinumang may profile link mo ay nakikita ang pangalan at larawan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes groupes et toute personne ayant le lien de ton profil voient ton nom et ta photo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבוצות שלך וכל מי שיש לו את קישור הפרופיל שלך רואים את השם והתמונה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके ग्रुप और जिनके पास आपकी प्रोफ़ाइल का लिंक है, वे आपका नाम और फ़ोटो देखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje grupe i svi s poveznicom na tvoj profil vide tvoje ime i fotografiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
