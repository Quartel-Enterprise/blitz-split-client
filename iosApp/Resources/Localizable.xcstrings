    "Everyone sees it in Activity. You can turn it off anytime." : {
      "comment" : "Simplify debts: the foot when nothing drops",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرى الجميع ذلك في «النشاط». يمكنك الإيقاف في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sehen es in Aktivität. Du kannst es jederzeit ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos lo ven en Actividad. Puedes desactivarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde le voit dans Activité. Tu peux le désactiver quand tu veux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כולם יראו את זה בפעילות. אפשר לכבות בכל רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गतिविधि में सबको दिखता है। आप इसे कभी भी बंद कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang melihatnya di Aktivitas. Kamu bisa mematikannya kapan saja."
          }
        },
