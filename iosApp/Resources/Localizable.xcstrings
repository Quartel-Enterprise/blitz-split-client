    "Whoever is hidden stays in the groups. They come back to the list by themselves if they join a new bill with you." : {
      "comment" : "Under the hidden contacts",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من تُخفيه يبقى في المجموعات، ويعود إلى القائمة تلقائيًا عند الانضمام إلى فاتورة جديدة معك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скритите остават в групите. Връщат се в списъка сами, ако участват в нов разход с теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাঁদের লুকানো হয়েছে তাঁরা গ্রুপে থেকে যাবেন। আপনার সঙ্গে নতুন কোনো বিলে যুক্ত হলে তাঁরা নিজে থেকেই তালিকায় ফিরে আসবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui està amagat continua als grups. Torna a la llista sol si entra en una despesa nova amb tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrytí lidé zůstávají ve skupinách. Do seznamu se vrátí sami, pokud s tebou budou v novém výdaji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der er skjult, bliver i grupperne. Vedkommende kommer selv tilbage på listen ved at blive en del af en ny udgift med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Personen bleiben in den Gruppen. Sie kommen von selbst in die Liste zurück, wenn ihr gemeinsam bei einer neuen Ausgabe dabei seid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσοι είναι κρυφοί μένουν στις ομάδες. Επιστρέφουν αυτόματα στη λίστα αν μπουν σε νέο έξοδο μαζί σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien está oculto sigue en los grupos. Vuelve a la lista automáticamente si se une a un gasto nuevo contigo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peidetud inimesed jäävad gruppidesse. Nad tulevad nimekirja ise tagasi, kui nad osalevad sinuga uues kulus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افراد پنهان در گروه‌ها می‌مانند. اگر با شما به هزینه جدیدی بپیوندند، خودبه‌خود به فهرست برمی‌گردند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilotetut pysyvät ryhmissä. He palaavat listalle itsestään, jos he tulevat mukaan uuteen kuluun kanssasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nananatili sa mga grupo ang itinago. Kusa silang babalik sa listahan kung sasali sila sa bagong bill kasama mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes masquées restent dans les groupes. Elles reviennent dans la liste toutes seules si elles rejoignent une nouvelle dépense avec toi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "છુપાયેલા લોકો ગ્રુપમાં રહે છે. જો તેઓ તમારી સાથે કોઈ નવા ખર્ચમાં જોડાય, તો તેઓ આપમેળે યાદીમાં પાછા આવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שמוסתר נשאר בקבוצות. הוא חוזר לרשימה מעצמו אם מצטרף לחשבון חדש איתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो छिपे हैं वे ग्रुप में बने रहते हैं। अगर वे आपके साथ किसी नए खर्च में जुड़ते हैं, तो अपने आप सूची में वापस आ जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriveni ostaju u grupama. Sami se vraćaju na popis ako s tobom uđu u novi trošak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akit elrejtesz, a csoportokban marad. Magától visszakerül a listára, ha veled együtt egy új számlában szerepel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang disembunyikan tetap ada di grup. Mereka kembali ke daftar dengan sendirinya kalau ikut tagihan baru bersamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi è nascosto resta nei gruppi. Torna nella lista da sé se partecipa a una nuova spesa con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示にした人もグループには残ります。あなたと一緒に新しい支出に加わると、自動的にリストに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨긴 사람은 그룹에 그대로 있어요. 나와 함께 새 지출에 참여하면 자동으로 목록에 다시 나타나요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslėpti žmonės lieka grupėse. Jie patys grįš į sąrašą, jei prisijungs prie naujos išlaidos kartu su tavimi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslēptās personas paliek grupās. Tās pašas atgriežas sarakstā, ja piedalās jaunā rēķinā kopā ar tevi."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लपवलेले लोक ग्रुपमध्ये राहतात. तुमच्यासोबत नवीन खर्चात सामील झाल्यावर ते आपोआप यादीत परत येतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang disembunyikan kekal dalam kumpulan. Mereka kembali ke senarai dengan sendirinya jika menyertai bil baharu dengan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De som er skjult, blir værende i gruppene. De kommer tilbake i listen av seg selv hvis de er med på en ny utgift sammen med deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie verborgen is, blijft in de groepen. Ze komen vanzelf terug in de lijst als ze met jou in een nieuwe uitgave zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryte osoby zostają w grupach. Wrócą na listę samoczynnie, jeśli dołączą z tobą do nowego wydatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem está oculto continua nos grupos. Volta para a lista sozinho se entrar numa conta nova com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem está oculto continua nos grupos. Volta sozinho para a lista se entrar numa conta nova contigo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cei ascunși rămân în grupuri. Revin singuri în listă dacă intră cu tine într-o cheltuială nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые остаются в группах. Они сами вернутся в список, если присоединятся к новому счёту вместе с тобой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto je skrytý, zostáva v skupinách. Do zoznamu sa vráti sám, ak sa s tebou zapojí do nového výdavku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdor je skrit, ostane v skupinah. Na seznam se vrne sam, če se s teboj pridruži novemu strošku."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakriveni ostaju u grupama. Sami se vraćaju na listu ako se pridruže novom računu sa tobom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som är dold finns kvar i grupperna. Personen kommer tillbaka till listan av sig själv om hen går med i en ny utgift med dig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliyefichwa anabaki kwenye vikundi. Anarudi kwenye orodha mwenyewe akijiunga na gharama mpya pamoja nawe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மறைக்கப்பட்டவர்கள் குழுக்களில் தொடர்ந்து இருப்பார்கள். உங்களுடன் ஒரு புதிய செலவில் சேர்ந்தால் அவர்களாகவே பட்டியலுக்குத் திரும்புவார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దాచినవారు గ్రూప్‌లలోనే ఉంటారు. వారు మీతో కలిసి కొత్త ఖర్చులో చేరితే జాబితాలోకి తమంతట తామే తిరిగి వస్తారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ถูกซ่อนยังอยู่ในกลุ่ม และจะกลับมาในรายการเองหากเข้าร่วมบิลใหม่กับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlenen kişiler gruplarda kalır. Seninle yeni bir harcamaya katılırsa listeye kendiliğinden geri döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховані залишаються в групах. Вони самі повернуться до списку, якщо приєднаються з тобою до нового рахунку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو چھپائے گئے ہیں وہ گروپوں میں رہتے ہیں۔ اگر وہ آپ کے ساتھ کسی نئے خرچ میں شامل ہوں تو خود ہی فہرست میں واپس آ جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
