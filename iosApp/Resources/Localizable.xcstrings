    "We kept the link. As soon as the device connects, the invite opens by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben den Link behalten. Sobald das Gerät verbunden ist, öffnet sich die Einladung von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos el enlace. En cuanto el dispositivo se conecte, la invitación se abre sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a gardé le lien. Dès que l’appareil se connecte, l’invitation s’ouvre toute seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo conservato il link. Appena il dispositivo si connette, l’invito si apre da solo."
          }
