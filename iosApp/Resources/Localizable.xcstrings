          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaber celú účtenku. Vyplníme sumu, dátum a popis; pred uložením ich skontroluješ."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uokviri ceo fiskalni račun. Popunjavamo iznos, datum i opis; ti ih proveravaš pre čuvanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rama in hela kvittot. Vi fyller i belopp, datum och beskrivning; du kontrollerar dem innan du sparar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழு ரசீதையும் சட்டகத்துக்குள் வையுங்கள். தொகை, தேதி, விளக்கத்தை நாங்கள் நிரப்புவோம்; சேமிப்பதற்கு முன் நீங்கள் சரிபார்க்கலாம்."
          }
