    "%@ leaves your Contacts. They stay in %@ and come back by themselves if they join a new bill with you. You can show them again in Hidden." : {
      "comment" : "Hide a contact?; the first %@ is them, the second their groups",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخرج %@ من جهات اتصالك. يبقى في %@ ويعود تلقائيًا إذا انضم إلى فاتورة جديدة معك. يمكنك إظهاره مرة أخرى في «المخفية»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ излиза от Контакти. Остава в %@ и се връща сам(а), ако участва в нов разход с теб. Можеш да го покажеш отново в Скрити."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ আপনার কন্টাক্ট থেকে সরে যাবেন। তিনি এখানে থেকে যাবেন: %@, এবং আপনার সঙ্গে কোনো নতুন বিলে যুক্ত হলে নিজে থেকেই ফিরে আসবেন। “লুকানো” অংশ থেকে তাঁকে আবার দেখাতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ surt dels teus Contactes. Continua a %@ i hi torna automàticament si comparteix una despesa nova amb tu. Pots tornar a mostrar aquest contacte a Amagats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zmizí z tvých Kontaktů. Zůstane ve skupinách %@ a vrátí se sám/sama, pokud se s tebou připojí k novému výdaji. Znovu ho/ji můžeš zobrazit ve Skrytých."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forsvinder fra dine kontakter. Vedkommende bliver i %@ og kommer tilbage af sig selv, hvis I kommer med i en ny udgift sammen. Du kan vise vedkommende igen under Skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verschwindet aus deinen Kontakten. Bleibt aber in %2$@ und kommt von selbst zurück, wenn ihr gemeinsam bei einer neuen Ausgabe dabei seid. Unter „Ausgeblendet“ kannst du die Person wieder einblenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ φεύγει από τις Επαφές σου. Παραμένει σε %@ και επιστρέφει αυτόματα αν μπει σε νέο έξοδο μαζί σου. Μπορείς να εμφανίσεις ξανά την επαφή στις Κρυφές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sale de tu lista de Contactos. Se mantiene en %2$@ y vuelve automáticamente si se une a un gasto nuevo contigo. Puedes mostrarlo de nuevo en Ocultos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kaob sinu kontaktidest. Ta jääb gruppidesse %@ ja tuleb ise tagasi, kui liitub sinuga uue kuluga. Saad ta uuesti kuvada jaotises Peidetud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ از مخاطبان شما حذف می‌شود. در %@ می‌ماند و اگر در هزینه جدیدی با شما باشد خودش برمی‌گردد. می‌توانید دوباره او را در «پنهان‌شده‌ها» نمایش دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poistuu Yhteystiedoistasi. Hän pysyy ryhmissä %@ ja palaa itsestään, jos hän liittyy kanssasi uuteen kuluun. Voit näyttää hänet uudelleen kohdassa Piilotetut."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalis si %@ sa Mga contact mo. Mananatili sila sa %@ at kusang babalik kung sasali sila sa bagong bill kasama ka. Puwede mo silang ipakita ulit sa Hidden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quitte tes Contacts. La personne reste dans %2$@ et revient toute seule si elle rejoint une nouvelle dépense avec toi. Tu peux l’afficher de nouveau dans Masqués."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ તમારા સંપર્કોમાંથી નીકળી જાય છે. તેઓ %@ માં રહે છે અને તમારી સાથે નવા ખર્ચમાં જોડાય તો આપમેળે પાછા આવે છે. તમે તેમને “છુપાવેલા” માં ફરી બતાવી શકો છો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההסתרה מוציאה את %@ מאנשי הקשר. השם נשאר ב-%@ וחוזר לבד בהצטרפות לחשבון חדש איתך. אפשר להציג שוב ב\"מוסתרים\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपके संपर्कों से हट जाएंगे। वे %@ में बने रहेंगे और अगर वे आपके साथ किसी नए खर्च में शामिल होते हैं तो अपने आप वापस आ जाएंगे। आप उन्हें छिपे हुए में से फिर से दिखा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nestaje iz tvojih Kontakata. Ostaje u grupama %@ i vraća se sam/sama ako s tobom uđe u novi trošak. Možeš ga/je ponovno prikazati pod Skriveni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kikerül a Névjegyeid közül. Ezekben marad: %@, és magától visszatér, ha új számlába kerül veled. A Rejtett résznél újra megjelenítheted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hilang dari Kontakmu. Dia tetap ada di %@ dan kembali dengan sendirinya jika ikut tagihan baru bersamamu. Kamu bisa menampilkannya lagi di Tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ esce dai tuoi Contatti. Resta in %@ e ricompare da sé se partecipa a una nuova spesa con te. Puoi mostrare di nuovo questo contatto in Nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は連絡先から外れます。%@には残り、あなたと一緒に新しい支出に加わると自動で戻ります。「非表示」から再表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 님이 연락처에서 사라져요. %2$@ 그룹에는 남아 있고, 나와 새 지출에 함께하면 자동으로 돌아와요. 숨김에서 다시 표시할 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dingsta iš tavo kontaktų. Lieka grupėse %@ ir sugrįš savaime, jei kartu su tavimi dalyvaus naujoje išlaidoje. Vėl parodyti gali skiltyje „Paslėpti“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pazūd no tavas sadaļas Kontakti. Persona paliek grupās %@ un atgriezīsies pati, ja pievienosies jaunam rēķinam kopā ar tevi. To var atkal parādīt sadaļā Paslēptie."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तुमच्या संपर्कांमधून निघून जातील. ते या ग्रुपमध्ये राहतील: %@, आणि तुमच्यासोबत नवीन खर्चात सामील झाल्यास आपोआप परत येतील. तुम्ही त्यांना ‘लपवलेले’ मध्ये पुन्हा दाखवू शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan hilang daripada Kenalan anda. Dia kekal dalam %@ dan kembali dengan sendirinya jika menyertai bil baharu bersama anda. Anda boleh memaparkannya semula dalam Disembunyikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forsvinner fra Kontakter. Vedkommende blir værende i %@ og kommer tilbake av seg selv hvis vedkommende blir med i en ny utgift med deg. Du kan vise vedkommende igjen i Skjulte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verdwijnt uit je Contacten. Diegene blijft in %2$@ en komt vanzelf terug bij een nieuwe uitgave met jou. Je kunt diegene weer tonen bij Verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ znika z twoich Kontaktów. Zostaje w: %2$@ i wróci samoczynnie, jeśli dołączy z tobą do nowego wydatku. Możesz pokazać tę osobę ponownie w sekcji Ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sai da lista de Contatos. Continua em %2$@ e volta sozinho se entrar numa conta nova com você. Dá para mostrar de novo em Ocultos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sai da lista de Contactos. Continua em %2$@ e volta sozinho se entrar numa conta nova contigo. Podes mostrar de novo em Ocultos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dispare din Contacte. Rămâne în %@ și revine de la sine dacă intră într-o cheltuială nouă cu tine. Poți afișa persoana din nou în Ascunse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уходит из твоих Контактов. Контакт останется в %@ и вернётся сам, если присоединится к новому счёту вместе с тобой. Его можно снова показать в «Скрытых»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zmizne z tvojich Kontaktov. Zostane v %@ a vráti sa automaticky, ak sa s tebou zapojí do nového výdavku. Znova ho môžeš zobraziť v Skrytých."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ izgine iz tvojih Stikov. Ostane v %@ in se sam(a) vrne, če se s tabo pridruži novemu strošku. Osebo lahko znova prikažeš v Skritih."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nestaje iz tvojih kontakata. Ostaje u: %@ i vraća se sam/a ako se pridruži novom računu sa tobom. Možeš ponovo da ga/je prikažeš u Skrivenima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ försvinner från dina Kontakter. Hen finns kvar i %@ och kommer tillbaka av sig själv om hen är med i en ny utgift med dig. Du kan visa hen igen under Dolda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ anaondoka kwenye Waasiliani wako. Anabaki katika %@ na anarudi mwenyewe akijiunga na gharama mpya pamoja nawe. Unaweza kumwonyesha tena katika Waliofichwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ உங்கள் தொடர்புகளிலிருந்து நீங்குவார். அவர் இந்தக் குழுக்களில் தொடர்வார்: %@. உங்களுடன் புதிய செலவில் சேர்ந்தால் தானாகவே திரும்ப வருவார். மறைக்கப்பட்டவை பகுதியில் அவரை மீண்டும் காட்டலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ మీ కాంటాక్ట్‌ల నుండి తొలగిపోతారు. వారు ఈ గ్రూప్‌లలో కొనసాగుతారు: %@. మీతో కొత్త ఖర్చులో చేరితే ఆటోమేటిక్‌గా తిరిగి వస్తారు. దాచినవి విభాగంలో వారిని మళ్లీ చూపించవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ จะหายไปจากรายชื่อติดต่อของคุณ แต่ยังอยู่ใน %2$@ และจะกลับมาเองถ้าเข้าร่วมบิลใหม่กับคุณ คุณแสดงอีกครั้งได้ในที่ซ่อนไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kişiler'inden çıkar. %@ içinde kalır ve seninle yeni bir harcamaya katılırsa kendiliğinden geri gelir. Onu Gizli'de yeniden gösterebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зникає з твоїх Контактів. Він(вона) залишається в %@ і повернеться сам(-а), якщо приєднається з тобою до нового рахунку. Ти можеш знову показати його(її) в Прихованих."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ آپ کے رابطوں سے ہٹ جائیں گے۔ وہ %@ میں باقی رہیں گے اور اگر وہ آپ کے ساتھ کسی نئے خرچ میں شامل ہوں تو خود بخود واپس آ جائیں گے۔ آپ انہیں پوشیدہ میں سے دوبارہ دکھا سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ rời khỏi Danh bạ của bạn. Họ vẫn ở trong %@ và tự quay lại nếu tham gia một khoản chi mới với bạn. Bạn có thể hiện lại họ trong mục Đã ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将从你的联系人中移除。对方仍会保留在%@中，如果和你一起参与新账单会自动回来。你可以在“已隐藏”中重新显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@將從你的聯絡人中移除。對方仍會保留在%@中，如果和你一起參與新帳單會自動回來。你可以在「已隱藏」中重新顯示。"
          }
        }
      }
    },
