    "Name and photo came from your %@ account. Changing them here only applies to Blitz Split and doesn't change your %@ account." : {
      "comment" : "Both %@ are the account: Google or Apple",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسم والصورة من حساب %@ الخاص بك. تغييرهما هنا يسري على Blitz Split فقط ولا يغيّر حساب %@ الخاص بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Името и снимката идват от акаунта ти в %@. Промяната им тук важи само за Blitz Split и не променя акаунта ти в %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নাম ও ছবি আপনার %@ অ্যাকাউন্ট থেকে এসেছে। এখানে বদলালে তা শুধু Blitz Split-এ কার্যকর হবে, আপনার %@ অ্যাকাউন্টে কোনো পরিবর্তন হবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jméno a fotka pochází z tvého účtu %@. Když je tady změníš, platí to jen pro Blitz Split a tvůj účet %@ se nezmění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name und Foto stammen aus deinem %1$@-Konto. Änderungen hier gelten nur für Blitz Split und ändern dein %2$@-Konto nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα και η φωτογραφία προέρχονται από τον λογαριασμό σου %@. Αν τα αλλάξεις εδώ, ισχύουν μόνο στο Blitz Split και δεν αλλάζουν τον λογαριασμό σου %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre y la foto vinieron de tu cuenta de %1$@. Cambiarlos aquí solo vale en Blitz Split y no modifica tu cuenta de %2$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام و عکس از حساب %@ شما آمده‌اند. تغییر آن‌ها در اینجا فقط در Blitz Split اعمال می‌شود و حساب %@ شما را تغییر نمی‌دهد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galing sa %@ account mo ang pangalan at larawan. Sa Blitz Split lang magkakaepekto ang pagbabago dito at hindi nito babaguhin ang %@ account mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom et la photo viennent de ton compte %1$@. Les changer ici ne s’applique qu’à Blitz Split et ne modifie pas ton compte %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השם והתמונה הגיעו מחשבון ה-%@ שלך. שינוי שלהם כאן חל רק על Blitz Split ולא משנה את חשבון ה-%@ שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम और फ़ोटो आपके %@ अकाउंट से आए हैं। यहां बदलने से ये सिर्फ़ Blitz Split में बदलते हैं, आपका %@ अकाउंट नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ime i fotografija preuzeti su s tvog računa %@. Promjena ovdje vrijedi samo za Blitz Split i ne mijenja tvoj račun %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A neved és a fotód ebből a fiókodból származik: %1$@. Ha itt módosítod őket, az csak a Blitz Splitre vonatkozik, a fiókodat nem változtatja meg (%2$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama dan foto berasal dari akun %@ kamu. Mengubahnya di sini hanya berlaku di Blitz Split dan tidak mengubah akun %@ kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome e foto provengono dal tuo account %@. Cambiarli qui vale solo per Blitz Split e non modifica il tuo account %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前と写真は%@アカウントから取得したものです。ここで変更してもBlitz Splitにのみ反映され、%@アカウントは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름과 사진은 %@ 계정에서 가져왔어요. 여기서 바꾸면 Blitz Split에만 적용되고 %@ 계정은 바뀌지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama dan foto diambil daripada akaun %@ anda. Menukarnya di sini hanya berkesan pada Blitz Split dan tidak mengubah akaun %@ anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naam en foto komen van je %@-account. Als je ze hier wijzigt, geldt dat alleen voor Blitz Split en verandert je %@-account niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imię i zdjęcie pochodzą z twojego konta %1$@. Zmiana tutaj dotyczy tylko Blitz Split i nie zmienia twojego konta %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome e foto vieram da sua conta %1$@. Mudar aqui vale só no Bora Rachar e não altera sua conta %2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome e foto vieram da tua conta %1$@. Alterar aqui só vale no Blitz Split e não altera a tua conta %2$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele și fotografia provin din contul tău %@. Dacă le schimbi aici, se aplică doar în Blitz Split și nu modifică contul tău %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя и фото взяты из твоего аккаунта %@. Если изменить их здесь, это коснётся только Blitz Split и не изменит твой аккаунт %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno a fotka pochádzajú z tvojho účtu %@. Ak ich zmeníš tu, zmena platí len v Blitz Split a tvoj účet %@ sa nezmení."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ime i fotografija potiču sa tvog %@ naloga. Ako ih ovde promeniš, menjaju se samo u aplikaciji Blitz Split, a tvoj %@ nalog ostaje isti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namn och foto kom från ditt %@-konto. Om du ändrar dem här gäller det bara Blitz Split och ditt %@-konto påverkas inte."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெயரும் புகைப்படமும் உங்கள் %@ அக்கவுண்ட்டிலிருந்து வந்தவை. இங்கே மாற்றுவது Blitz Split-க்கு மட்டுமே பொருந்தும், உங்கள் %@ அக்கவுண்ட்டை மாற்றாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อและรูปภาพมาจากบัญชี %@ ของคุณ การเปลี่ยนที่นี่มีผลแค่ใน Blitz Split และไม่เปลี่ยนบัญชี %@ ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad ve fotoğraf %@ hesabından geldi. Burada değiştirmek yalnızca Blitz Split'te geçerli olur, %@ hesabını değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ім'я та фото взято з твого облікового запису %@. Зміни тут діють лише в Blitz Split і не змінюють твій обліковий запис %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام اور تصویر آپ کے %@ اکاؤنٹ سے آئے ہیں۔ انہیں یہاں بدلنا صرف Blitz Split پر لاگو ہوتا ہے اور آپ کا %@ اکاؤنٹ نہیں بدلتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên và ảnh được lấy từ tài khoản %@ của bạn. Thay đổi ở đây chỉ áp dụng cho Blitz Split và không thay đổi tài khoản %@ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名字和照片来自你的%@账号。在这里修改只对Blitz Split生效，不会更改你的%@账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名字和照片來自你的%@帳號。在這裡修改只對Blitz Split生效，不會更改你的%@帳號。"
          }
        }
      }
    },
