    "People who owe you won't see it when settling up anymore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يراه من عليهم لك عند التسوية بعد الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die dir etwas schulden, sehen ihn beim Begleichen nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes te deben dejarán de ver esta clave al saldar cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes qui te doivent ne la verront plus au moment de régler."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שחייב לך כסף כבר לא יראה אותו בסגירת החשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन पर आपका बकाया है, उन्हें हिसाब चुकाते समय यह अब नहीं दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang berutang ke kamu tidak akan melihatnya lagi saat melunasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che ti devono non la vedranno più quando saldano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに支払う必要がある人が精算するとき、これは表示されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나에게 줄 돈이 있는 사람은 정산할 때 더 이상 이 정보를 보지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen die jou iets schuldig zijn, zien hem niet meer bij het verrekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby, które mają ci oddać, nie zobaczą go już przy rozliczaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem te deve deixa de ver esta chave no acerto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, кто тебе должен, больше не увидят его при расчёте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ค้างคุณจะไม่เห็นคีย์นี้ตอนเคลียร์ยอดอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana borcu olanlar hesaplaşırken bunu artık görmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ті, хто тобі винен, більше не бачитимуть його під час розрахунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người nợ bạn sẽ không còn thấy khóa này khi thanh toán nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欠你钱的人在结清时将不再看到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欠你錢的人在結清時將不再看到它。"
          }
        }
      }
    },
