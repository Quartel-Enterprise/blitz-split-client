          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ödeme yapan kişi CPF'nin tamamını görür. Paylaşmak istemiyorsan telefon, e-posta veya rastgele anahtar kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той, хто тобі платить, бачить твій повний CPF. Якщо не хочеш ним ділитися, використай телефон, email або випадковий ключ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو آپ کو ادائیگی کرتا ہے وہ آپ کا پورا CPF دیکھتا ہے۔ اگر آپ اسے شیئر نہیں کرنا چاہتے تو فون، ای میل یا رینڈم کلید استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người trả tiền cho bạn sẽ thấy đầy đủ số CPF của bạn. Nếu không muốn chia sẻ, hãy dùng khóa điện thoại, email hoặc khóa ngẫu nhiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向你付款的人会看到你完整的CPF。如果不想公开，请使用手机号、邮箱或随机密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向你付款的人會看到你完整的CPF。如果不想公開，請使用手機號碼、電子郵件或隨機金鑰。"
          }
        }
      }
    },
    "Whole numbers only. The leftover cents go to whoever paid." : {
      "comment" : "Hint of the split by percentage",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعداد صحيحة فقط. تذهب الكسور المتبقية إلى الدافع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само цели числа. Останалите стотинки отиват при платилия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু পূর্ণসংখ্যা। বাকি পয়সা যিনি পরিশোধ করেছেন তাঁর ভাগে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
