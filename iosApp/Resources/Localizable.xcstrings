    "Use shares when someone has more, like who brought a plus-one." : {
      "comment" : "Hint of the split by shares",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الحصص عندما يكون لأحد نصيب أكبر، كمن أحضر مرافقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвай дялове, когато някой има повече, например ако е довел придружител."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কারও ভাগে বেশি পড়লে অংশ ব্যবহার করুন, যেমন যিনি সঙ্গে একজন অতিথি এনেছেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir parts quan algú en té més, com qui ha portat un acompanyant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podíly použij, když má někdo víc, třeba kdo přivedl doprovod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug andele, når nogen har mere, f.eks. hvis de havde en gæst med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Anteile, wenn jemand mehr hat, etwa wer eine Begleitung mitgebracht hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποίησε μερίδια όταν κάποιος έχει περισσότερα, όπως όποιος έφερε συνοδό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa partes cuando alguien consume más, como quien llevó acompañante."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasuta osasid, kui kellelgi on rohkem, näiteks kes võttis kaaslase kaasa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کسی بیشتر سهم دارد، مثلاً کسی که همراه آورده، از سهم استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä osuuksia, kun jollakulla on enemmän, esimerkiksi sillä, joka toi seuralaisen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng mga bahagi kapag may mas marami, tulad ng may kasamang plus-one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les parts quand quelqu’un a plus, comme quelqu’un venu avec un invité."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈનો ભાગ વધુ હોય ત્યારે શેર વાપરો, જેમ કે જે કોઈ સાથે મહેમાન લાવ્યું હોય."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי להשתמש בחלקים כשלמישהו יש יותר, למשל למי שהגיע עם מלווה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब किसी का हिस्सा ज़्यादा हो, जैसे जो किसी मेहमान को साथ लाया हो, तब हिस्से इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upotrijebi udjele kad netko ima više, npr. tko je doveo pratnju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használj arányokat, ha valakire több jut, például aki kísérőt hozott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakai bagian saat seseorang punya lebih banyak, seperti yang membawa teman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le quote quando qualcuno ha di più, come chi ha portato un accompagnatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同伴者を連れてきた人など、多めに負担する人がいるときは口数を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 더 많이 쓴 경우 비율을 사용하세요. 예: 동반자를 데려온 사람."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudok dalis, kai kam nors tenka daugiau, pavyzdžiui, kas atsivedė draugą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmanto daļas, ja kādam ir vairāk, piemēram, tam, kurš atveda līdzi pavadoni."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एखाद्याचा भाग जास्त असेल तेव्हा वाटे वापरा, जसे सोबत पाहुणा आणणारे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan bahagian apabila seseorang mendapat lebih, seperti yang membawa teman."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk andeler når noen har mer, for eksempel den som tok med seg en ledsager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik aandelen als iemand meer heeft, zoals wie iemand meeneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj udziałów, gdy komuś przypada więcej, np. przy osobie towarzyszącej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use partes quando alguém consome mais, como quem levou acompanhante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa partes quando alguém consome mais, como quem levou acompanhante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește părți când cineva are mai mult, de exemplu cine a venit cu un însoțitor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй доли, когда у кого-то больше, например у того, кто пришёл с гостем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podiely použi, keď má niekto viac, napríklad keď si niekto priviedol partnera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleže uporabi, ko ima nekdo več, na primer kdo je pripeljal spremljevalca."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi udele kada neko ima više, na primer kada je doveo pratnju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd andelar när någon har mer, till exempel den som tog med en extra gäst."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumia hisa mtu anapokuwa na zaidi, kama aliyeleta mgeni."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒருவருக்கு அதிகம் இருக்கும்போது பங்குகளைப் பயன்படுத்துங்கள், உதாரணமாக கூடுதல் விருந்தினரை அழைத்து வந்தவர்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎవరికైనా ఎక్కువ ఉన్నప్పుడు వాటాలను ఉపయోగించండి, ఉదాహరణకు తమతో ఇంకొకరిని తెచ్చినవారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้แบบส่วนเมื่อบางคนมีมากกว่า เช่น คนที่พาเพื่อนมาด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birinin payı daha fazlaysa pay kullan, örneğin yanında birini getirdiyse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуй частки, коли в когось більше, наприклад хто прийшов з парою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کسی کا حصہ زیادہ ہو تو حصے استعمال کریں، جیسے جو کسی مہمان کو ساتھ لایا ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng phần khi ai đó dùng nhiều hơn, như người dẫn thêm bạn đi cùng."
          }
