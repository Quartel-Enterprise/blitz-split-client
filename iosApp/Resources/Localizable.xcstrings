        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઇન્ટરનેટ નથી: નવી વહેંચણી હમણાં આ %@ પર લાગુ છે અને ફરી કનેક્ટ થતાં બીજાઓ સુધી પહોંચશે."
          }
        },
        "he" : {
