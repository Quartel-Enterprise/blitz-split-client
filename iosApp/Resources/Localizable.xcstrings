    "Hi %@! By the Blitz Split math, you owe me %@ from %@." : {
      "comment" : "A Request message: %1$@ is the person, %2$@ the amount, %3$@ the group or groups",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@! Laut Blitz Split schuldest du mir %2$@ aus %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %1$@! Según las cuentas de Blitz Split, me debes %2$@ %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! D’après le calcul de Blitz Split, tu me dois %2$@ pour %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Menurut hitungan Blitz Split, kamu berutang %@ ke aku dari %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Secondo i conti di Blitz Split, mi devi %@ per %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、こんにちは！Blitz Splitの計算では、%3$@の分として私に%2$@の支払いがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %@! Volgens de berekening van Blitz Split ben je me %@ schuldig van %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %1$@! Według rachunków Blitz Split masz mi oddać %2$@ z %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, %1$@! Pelas contas do Bora Rachar, ficou %2$@ %3$@ para você me pagar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selam %@! Blitz Split hesabına göre bana %@ borçlusun (%@)."
          }
        }
      }
    },
    "Hi %@! You owe me %@ from %@: your part of %@, minus the %@ you already paid." : {
      "comment" : "A Request message to a guest: the person, the amount, the groups, the bills and what they already paid",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@! Du schuldest mir %2$@ aus %3$@: dein Anteil an %4$@, abzüglich der %5$@, die du schon gezahlt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %1$@! Me debes %2$@ %3$@: tu parte de %4$@, menos los %5$@ que ya pagaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! Tu me dois %2$@ pour %3$@ : ta part de %4$@, moins les %5$@ que tu as déjà payés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Kamu berutang %@ ke aku dari %@: bagianmu dari %@, dikurangi %@ yang sudah kamu bayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Mi devi %@ per %@: la tua parte di %@, meno i %@ che hai già pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、こんにちは！%3$@の分として、私に%2$@の支払いがあります：%4$@のあなたの負担分から、支払い済みの%5$@を引いた額です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %@! Je bent me %@ schuldig van %@: jouw deel van %@, min de %@ die je al hebt betaald."
          }
