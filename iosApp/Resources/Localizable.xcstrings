          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema aplikaciju: obavesti tu osobu preko opcije Zatraži uplatu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har inte appen: meddela personen med Begär betalning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவரிடம் ஆப் இல்லை: ‘பணம் கேட்கவும்’ மூலம் தெரியப்படுத்துங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีแอป: แจ้งเขาด้วยขอเงิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulaması yok: İste ile haber ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не має застосунку: повідом через «Нагадати про оплату»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کے پاس ایپ نہیں ہے: “رقم مانگیں” سے انہیں بتائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có ứng dụng: hãy báo cho họ bằng Yêu cầu trả tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方没有应用：用“请求付款”告知对方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方沒有App：用「請求付款」告知對方。"
          }
        }
      }
    },
    "You have %lld payments in the queue. The simplification counts them; if they change, the suggested payments adjust by themselves." : {
      "comment" : "Simplify debts: several payments recorded here and not up yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك دفعات في قائمة الانتظار عددها %lld. يحتسبها التبسيط؛ وإن تغيّرت، تتعدّل الدفعات المقترحة تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имаш плащания в опашката: %lld. Опростяването ги отчита; ако се променят, предложените плащания се нагласят сами."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারিতে আপনার %lld টি পেমেন্ট আছে। সহজ করার সময় এগুলো গণনা করা হয়; এগুলো বদলালে প্রস্তাবিত পেমেন্ট নিজে থেকেই ঠিক হয়ে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet plateb ve frontě: %lld. Zjednodušení s nimi počítá; pokud se změní, navrhované platby se upraví samy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %lld Zahlungen in der Warteschlange. Die Vereinfachung berücksichtigt sie; ändern sie sich, passen sich die vorgeschlagenen Zahlungen von selbst an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις %lld πληρωμές στην ουρά. Η απλοποίηση τις λαμβάνει υπόψη. Αν αλλάξουν, οι προτεινόμενες πληρωμές προσαρμόζονται αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld pagos en la cola. La simplificación los cuenta; si cambian, los pagos sugeridos se ajustan solos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld پرداخت در صف دارید. ساده‌سازی آن‌ها را حساب می‌کند؛ اگر تغییر کنند، پرداخت‌های پیشنهادی خودبه‌خود تنظیم می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May %lld bayad ka sa pila. Binibilang ito ng pagpapasimple; kung magbago ang mga ito, kusang aayusin ang mga iminumungkahing bayad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld paiements dans la file. La simplification les compte ; s’ils changent, les paiements suggérés s’ajustent tout seuls."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך %lld תשלומים בתור. הפישוט מתחשב בהם; אם הם משתנים, התשלומים המוצעים מתעדכנים מעצמם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कतार में आपके %lld भुगतान हैं। सरल करने में ये गिने जाते हैं; अगर ये बदलें, तो सुझाए गए भुगतान अपने आप बदल जाएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaš %lld uplata u redu čekanja. Pojednostavljenje ih uzima u obzir; ako se promijene, predložene uplate same se prilagođavaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fizetésed vár a sorban. Az egyszerűsítés beszámítja őket; ha változnak, a javasolt fizetések maguktól igazodnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu punya %lld pembayaran dalam antrean. Penyederhanaan ikut menghitungnya; kalau berubah, saran pembayaran menyesuaikan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %lld pagamenti in coda. La semplificazione li conta; se cambiano, i pagamenti suggeriti si adattano da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューに%lld件の支払いがあります。シンプル化にはそれも含まれ、変わった場合は提案される支払いが自動で調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열에 송금 %lld건이 있어요. 간소화에 포함되며, 바뀌면 추천 송금도 자동으로 조정돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mempunyai %lld bayaran dalam baris gilir. Pemudahan mengambil kiranya; jika berubah, bayaran yang dicadangkan akan dilaraskan dengan sendirinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt %lld betalingen in de wachtrij. De vereenvoudiging telt ze mee; als ze veranderen, passen de voorgestelde betalingen zich vanzelf aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności w kolejce: %lld. Uproszczenie je uwzględnia; jeśli się zmienią, sugerowane płatności dostosują się same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %lld pagamentos na fila. A simplificação conta com eles; se mudarem, os pagamentos sugeridos se ajustam sozinhos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens %lld pagamentos na fila. A simplificação conta com eles; se mudarem, os pagamentos sugeridos ajustam-se sozinhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai %lld plăți în așteptare. Simplificarea le ia în calcul; dacă se schimbă, plățile sugerate se ajustează singure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежей в очереди: %lld. Упрощение их учитывает; если они изменятся, предлагаемые платежи подстроятся сами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vo fronte máš %lld platieb. Zjednodušenie ich započíta; ak sa zmenia, navrhované platby sa upravia samy."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaš uplata u redu čekanja: %lld. Pojednostavljenje ih uzima u obzir; ako se promene, predložene uplate se same prilagođavaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %lld betalningar i kö. Förenklingen räknar med dem; om de ändras anpassas de föreslagna betalningarna av sig själva."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரிசையில் உங்களுக்கு %lld பேமெண்ட்டுகள் உள்ளன. எளிதாக்கல் அவற்றைக் கணக்கில் எடுக்கும்; அவை மாறினால், பரிந்துரைக்கப்பட்ட பேமெண்ட்டுகள் தானாகவே சரியாகும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณมีการจ่ายเงิน %lld รายการในคิว การลดความซับซ้อนนับรวมไว้แล้ว ถ้ามีการเปลี่ยนแปลง การจ่ายเงินที่แนะนำจะปรับเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada %lld ödemen var. Sadeleştirme bunları hesaba katar; değişirlerse önerilen ödemeler kendiliğinden ayarlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебе в черзі платежів: %lld. Спрощення їх враховує; якщо вони зміняться, пропоновані платежі скоригуються самі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قطار میں آپ کی %lld ادائیگیاں ہیں۔ آسان کرنا انہیں شمار کرتا ہے؛ اگر وہ بدلیں تو تجویز کردہ ادائیگیاں خود ہی بدل جائیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có %lld khoản thanh toán trong hàng chờ. Việc đơn giản hóa có tính đến chúng; nếu chúng thay đổi, các khoản thanh toán đề xuất sẽ tự điều chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有%lld笔付款在排队。简化时已将其计算在内；如果有变化，建议的付款会自动调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有%lld筆付款在排隊。簡化時已將其計算在內；如果有變化，建議的付款會自動調整。"
          }
        }
      }
    },
