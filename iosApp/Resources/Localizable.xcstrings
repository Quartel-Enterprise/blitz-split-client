    "You'll be taken to the App Store to install the new version." : {
      "comment" : "Update available sheet: what the button does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقلك إلى App Store لتثبيت الإصدار الجديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще бъдеш пренасочен(а) към App Store, за да инсталираш новата версия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন সংস্করণ ইনস্টল করতে আপনাকে App Store-এ নিয়ে যাওয়া হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejdeš do App Storu, kde novou verzi nainstaluješ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst zum App Store weitergeleitet, um die neue Version zu installieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα μεταφερθείς στο App Store για να εγκαταστήσεις τη νέα έκδοση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te llevaremos a la App Store para instalar la nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نصب نسخه جدید به App Store منتقل می‌شوید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadalhin ka sa App Store para i-install ang bagong bersyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu seras redirigé vers l’App Store pour installer la nouvelle version."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המעבר יהיה ל-App Store להתקנת הגרסה החדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया वर्शन इंस्टॉल करने के लिए आपको App Store पर ले जाया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorit će se App Store za instalaciju nove verzije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az App Store-ba jutsz, ahol telepítheted az új verziót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan dibawa ke App Store untuk memasang versi baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store si aprirà per installare la nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeに移動して新しいバージョンをインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store로 이동해 새 버전을 설치해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan dibawa ke App Store untuk memasang versi baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaat naar de App Store om de nieuwe versie te installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdziesz do App Store, aby zainstalować nową wersję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você será levado à App Store para instalar a nova versão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vais ser levado à App Store para instalar a nova versão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vei fi dus în App Store ca să instalezi versiunea nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты перейдёшь в App Store, чтобы установить новую версию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presmerujeme ťa do App Store, kde nainštaluješ novú verziu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoriće se App Store da instaliraš novu verziju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skickas till App Store för att installera den nya versionen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புதிய பதிப்பை நிறுவ App Store-க்கு அழைத்துச் செல்லப்படுவீர்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะถูกพาไปที่ App Store เพื่อติดตั้งเวอร์ชันใหม่"
          }
        },
        "tr" : {
