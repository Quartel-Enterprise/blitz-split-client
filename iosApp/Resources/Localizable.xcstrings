    "No internet: the bill is saved on this device and counts in the balances now. It syncs when you reconnect." : {
      "comment" : "Under a new bill while offline",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Die Ausgabe ist auf diesem Gerät gespeichert und zählt schon in den Salden. Sie wird synchronisiert, wenn du wieder verbunden bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: el gasto queda guardado en el dispositivo y cuenta en los saldos ahora. Se sincroniza al reconectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : la dépense est enregistrée sur cet appareil et compte dans les soldes dès maintenant. Elle se synchronise à la reconnexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada internet: tagihan tersimpan di perangkat ini dan sudah dihitung di saldo. Akan disinkronkan saat kamu terhubung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: la spesa è salvata su questo dispositivo e conta già nei saldi. Si sincronizza quando ti riconnetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続がありません：支出はこのデバイスに保存され、すでに残高に反映されています。再接続すると同期されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internet: de uitgave is op dit apparaat bewaard en telt nu al mee in de saldi. Hij wordt gesynchroniseerd zodra je weer verbinding hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: wydatek jest zapisany na tym urządzeniu i już liczy się w saldach. Zsynchronizuje się po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: a conta fica salva no aparelho e entra nos saldos agora. Sincroniza ao reconectar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet yok: harcama bu cihaza kaydedildi ve şimdiden bakiyelere sayılıyor. Bağlantı gelince eşitlenir."
          }
        }
      }
    },
