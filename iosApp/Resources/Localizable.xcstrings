    "Sees it without signing in. To comment, they sign in with an account, even outside the group." : {
      "comment" : "Share bill: what anyone with the link can do",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراها دون تسجيل الدخول. للتعليق، يلزم تسجيل الدخول بحساب، حتى من خارج المجموعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht sie ohne Anmeldung. Zum Kommentieren meldet man sich mit einem Konto an, auch außerhalb der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo ve sin iniciar sesión. Para comentar, inicia sesión con una cuenta, aunque no esté en el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit la dépense sans se connecter. Pour commenter, la personne se connecte avec un compte, même hors du groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפייה בלי התחברות. כדי להגיב צריך להתחבר עם חשבון משתמש, גם מחוץ לקבוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन किए बिना देख सकते हैं। टिप्पणी करने के लिए उन्हें किसी अकाउंट से साइन इन करना होगा, ग्रुप से बाहर होने पर भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa melihatnya tanpa masuk. Untuk berkomentar, mereka masuk dengan akun, meski di luar grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vede senza accedere. Per commentare accede con un account, anche fuori dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインせずに見られます。コメントするには、グループ外の人でもアカウントでログインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하지 않아도 볼 수 있어요. 댓글을 달려면 그룹 밖의 사람이라도 계정으로 로그인해야 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziet hem zonder in te loggen. Om te reageren logt diegene in met een account, ook van buiten de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można go zobaczyć bez logowania. Aby komentować, trzeba zalogować się na konto, nawet spoza grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê sem entrar. Para comentar, entra com uma conta, mesmo sem estar no grupo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê sem iniciar sessão. Para comentar, inicia sessão com uma conta, mesmo sem estar no grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видит его без входа. Чтобы комментировать, нужно войти в аккаунт, даже не будучи в группе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูได้โดยไม่ต้องลงชื่อเข้าใช้ หากต้องการแสดงความคิดเห็น ต้องลงชื่อเข้าใช้ด้วยบัญชี แม้จะไม่ได้อยู่ในกลุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapmadan görür. Yorum yapmak için, gruptan olmasa bile bir hesapla giriş yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бачить його без входу. Щоб коментувати, треба увійти в обліковий запис, навіть поза групою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem được mà không cần đăng nhập. Để bình luận, họ cần đăng nhập bằng một tài khoản, kể cả khi ở ngoài nhóm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需登录即可查看。如需评论，需要登录账号，群组外的人也可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需登入即可查看。如需留言，需要登入帳號，群組外的人也可以。"
          }
        }
      }
    },
