    "%@ by the word “%@” in your map. Tap the icon to change it." : {
      "comment" : "Under a bill's description: its category, chosen by a word of the map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بحسب الكلمة «%@» في خريطتك. اضغط على الأيقونة لتغييرها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ по думата „%@“ в твоята карта. Докосни иконата, за да я смениш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: আপনার ম্যাপের “%@” শব্দ অনুযায়ী। বদলাতে আইকনে ট্যাপ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podle slova „%@“ ve tvé mapě. Klepnutím na ikonu ji změníš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ über das Wort „%2$@“ in deiner Zuordnung. Tippe auf das Symbol, um sie zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ από τη λέξη «%@» στον χάρτη σου. Πάτα το εικονίδιο για να την αλλάξεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ por la palabra “%2$@” de tu mapa. Toca el ícono para cambiar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ por la palabra “%2$@” de tu mapa. Toca el icono para cambiar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ با واژه «%@» در نقشه شما. برای تغییر، روی نماد بزنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ batay sa salitang “%@” sa mapa mo. I-tap ang icon para palitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ d’après le mot « %2$@ » de ta carte. Touche l’icône pour la changer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לפי המילה \"%@\" במפה שלך. אפשר להקיש על הסמל כדי לשנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके मैप के शब्द “%2$@” से ‘%1$@’ श्रेणी चुनी गई। बदलने के लिए आइकन पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prema riječi „%@“ iz tvoje mape. Dodirni ikonu da je promijeniš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – a kategóriatérképed „%@” szava alapján. Koppints az ikonra a módosításhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berdasarkan kata “%@” di petamu. Ketuk ikon untuk mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dalla parola «%@» nella tua mappa. Tocca l’icona per cambiarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（マップの単語「%@」による）。アイコンをタップして変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 키워드 “%2$@” 기준으로 ‘%1$@’ 카테고리가 됐어요. 아이콘을 탭해서 바꾸세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berdasarkan perkataan “%@” dalam peta anda. Ketik ikon untuk menukarnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ door het woord “%2$@” op je kaart. Tik op het icoon om het te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategoria %1$@ ze słowa „%2$@” w twojej mapie kategorii. Stuknij ikonę, aby ją zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pela palavra “%2$@” do seu mapa. Toque no ícone para trocar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pela palavra “%2$@” do teu mapa. Toca no ícone para trocar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ după cuvântul „%@” din harta ta. Atinge pictograma ca s-o schimbi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ по слову «%@» из твоей карты. Нажми на значок, чтобы изменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podľa slova „%@“ v tvojej mape. Ťukni na ikonu a zmeň to."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ po reči „%@“ u tvojoj mapi. Dodirni ikonu da je promeniš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ via ordet ”%@” i din karta. Tryck på ikonen för att ändra."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: உங்கள் வரைபடத்தில் உள்ள “%@” என்ற சொல்லால் தேர்வானது. மாற்ற ஐகானைத் தட்டுங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ จากคำว่า “%2$@” ในแผนที่ของคุณ แตะไอคอนเพื่อเปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, haritandaki “%@” kelimesiyle seçildi. Değiştirmek için simgeye dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ за словом «%@» у твоїй мапі. Торкнись значка, щоб змінити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے میپ کے لفظ “%2$@” سے ‘%1$@’ کیٹیگری چنی گئی۔ بدلنے کے لیے آئیکن پر ٹیپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ theo từ “%@” trong bản đồ của bạn. Chạm vào biểu tượng để đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你映射中的词“%2$@”归为%1$@。点按图标可更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據你對照表中的詞「%2$@」歸為%1$@。點一下圖示可更改。"
          }
        }
      }
    },
