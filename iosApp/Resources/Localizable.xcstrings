    "Couldn't leave the group. Check your connection and try again." : {
      "comment" : "Leaving the group failed: no sync or no answer from the server",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت مغادرة المجموعة. تحقّق من الاتصال وأعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групата не можа да се напусне. Провери връзката си и опитай отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপ ছাড়া যায়নি। আপনার সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut sortir del grup. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupinu se nepodařilo opustit. Zkontroluj připojení a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke forlade gruppen. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppe konnte nicht verlassen werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποχώρηση από την ομάδα. Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo salir del grupo. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupist ei õnnestunud lahkuda. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترک گروه انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmästä poistuminen epäonnistui. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakaalis sa grupo. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de quitter le groupe. Vérifie ta connexion et réessaie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ગ્રુપ છોડી ન શકાયું. તમારું કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לצאת מהקבוצה. כדאי לבדוק את החיבור ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप नहीं छोड़ा जा सका। अपना कनेक्शन जांचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napuštanje grupe nije uspjelo. Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült kilépni a csoportból. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal keluar dari grup. Periksa koneksimu dan coba lagi."
