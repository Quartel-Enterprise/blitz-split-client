    "Create a group for the trip, the house or the barbecue. You can start even without internet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعة للرحلة أو المنزل أو الشواء. يمكنك البدء حتى دون إنترنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създай група за пътуването, за дома или за барбекюто. Можеш да започнеш дори без интернет."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণ, বাসা বা বারবিকিউর জন্য একটি গ্রুপ তৈরি করুন। ইন্টারনেট ছাড়াও শুরু করতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoř skupinu na výlet, do bytu nebo na grilovačku. Začít můžeš i bez internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Gruppe für die Reise, die WG oder das Grillen. Du kannst sogar ohne Internet starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
