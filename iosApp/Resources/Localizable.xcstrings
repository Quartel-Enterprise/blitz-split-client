        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 고르세요. 상대가 요청을 받고 수락해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
