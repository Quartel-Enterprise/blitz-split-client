    "It belongs to all of %@: anyone in the group can use, edit and delete it." : {
      "comment" : "New category",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي إلى كل أعضاء %@: يمكن لأي عضو في المجموعة استخدامها وتعديلها وحذفها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принадлежи на цялата група „%@“: всеки в групата може да я използва, редактира и изтрива."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি পুরো %@ গ্রুপের: গ্রুপের যে কেউ এটি ব্যবহার, সম্পাদনা ও মুছতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patří celé skupině %@: kdokoli ve skupině ji může používat, upravovat a smazat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehört ganz %@: Alle in der Gruppe können sie nutzen, bearbeiten und löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανήκει σε όλη την ομάδα %@: οποιοδήποτε μέλος μπορεί να τη χρησιμοποιήσει, να την επεξεργαστεί και να τη διαγράψει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es de todo el grupo %@: cualquier persona del grupo puede usarla, editarla y eliminarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متعلق به همه اعضای %@ است: هر کسی در گروه می‌تواند از آن استفاده کند، آن را ویرایش یا حذف کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pag-aari ito ng buong %@: puwedeng gamitin, i-edit at burahin ito ng sinuman sa grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle appartient à tout %@ : n’importe qui dans le groupe peut l’utiliser, la modifier et la supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היא שייכת לכל חברי %@: כולם יכולים להשתמש בה, לערוך אותה ולמחוק אותה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पूरे %@ की है: ग्रुप में कोई भी इसे इस्तेमाल कर सकता है, बदल सकता है और हटा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripada cijeloj grupi „%@“: svatko u grupi može je koristiti, uređivati i brisati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egész csoporté (%@): a csoportban bárki használhatja, szerkesztheti és törölheti."
          }
