    "Week, Month and Year show up in periods longer than a week." : {
      "comment" : "The group statistics: why Week, Month and Year are off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الأسبوع والشهر والسنة في الفترات الأطول من أسبوع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Седмица, Месец и Година се появяват при периоди, по-дълги от седмица."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“সপ্তাহ”, “মাস” ও “বছর” এক সপ্তাহের বেশি সময়কালে দেখা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setmana, Mes i Any apareixen en períodes de més d’una setmana."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týden, Měsíc a Rok se zobrazí u období delších než týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uge, Måned og År vises i perioder, der er længere end en uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Woche“, „Monat“ und „Jahr“ erscheinen bei Zeiträumen länger als eine Woche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Εβδομάδα, ο Μήνας και το Έτος εμφανίζονται σε περιόδους μεγαλύτερες από μία εβδομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana, Mes y Año aparecen en períodos de más de una semana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nädal, Kuu ja Aasta ilmuvad perioodides, mis on pikemad kui nädal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هفته، ماه و سال در بازه‌های طولانی‌تر از یک هفته نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viikko, Kuukausi ja Vuosi näkyvät yli viikon pituisilla ajanjaksoilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumalabas ang Linggo, Buwan at Taon sa mga panahong mas mahaba sa isang linggo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaine, Mois et Année apparaissent pour les périodes de plus d’une semaine."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“અઠવાડિયું”, “મહિનો” અને “વર્ષ” એક અઠવાડિયાથી લાંબા સમયગાળામાં દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"שבוע\", \"חודש\" ו\"שנה\" מופיעים בתקופות ארוכות משבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हफ़्ता, महीना और साल एक हफ़्ते से लंबी अवधि में दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjedan, Mjesec i Godina pojavljuju se za razdoblja dulja od tjedan dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Hét, a Hónap és az Év egy hétnél hosszabb időszakoknál jelenik meg."
