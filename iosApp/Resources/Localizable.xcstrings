    "By %% among %lld" : {
      "comment" : "Header of a bill's split by percentage; %lld is how many people are in it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسب %% بين %lld"
