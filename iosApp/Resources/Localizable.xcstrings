        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하려면 퍼센트를 조정해 합계를 맞추세요: %@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad galėtum išsaugoti, pakoreguok procentus, kad jų suma būtų %@."
