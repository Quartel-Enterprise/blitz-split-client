    "Fills in the amount, date and description from the photo." : {
      "comment" : "Split a bill: under Scan receipt",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ المبلغ والتاريخ والوصف من الصورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt Betrag, Datum und Beschreibung aus dem Foto aus."
          }
        },
