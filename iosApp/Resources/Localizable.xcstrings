    "Hi %@! By the Blitz Split math, you owe me %@ from %@." : {
      "comment" : "A Request message: %1$@ is the person, %2$@ the amount, %3$@ the group or groups",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@! Laut Blitz Split schuldest du mir %2$@ aus %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %1$@! Según las cuentas de Blitz Split, me debes %2$@ %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! D’après le calcul de Blitz Split, tu me dois %2$@ pour %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Secondo i conti di Blitz Split, mi devi %@ per %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %1$@! Według rachunków Blitz Split masz mi oddać %2$@ z %3$@."
