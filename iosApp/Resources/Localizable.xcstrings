    "Your groups and anyone with your profile link see your name and photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترى مجموعاتك وكل من لديه رابط ملفك الشخصي اسمك وصورتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоите групи и всеки с линка към профила ти виждат името и снимката ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার গ্রুপের সদস্যরা এবং আপনার প্রোফাইল লিংক যাঁদের কাছে আছে তাঁরা আপনার নাম ও ছবি দেখতে পান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus grups i qualsevol persona amb l’enllaç del teu perfil veuen el teu nom i la teva foto."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje skupiny a kdokoli s odkazem na tvůj profil vidí tvoje jméno a fotku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine grupper og alle med dit profillink kan se dit navn og billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen und alle mit dem Link zu deinem Profil sehen deinen Namen und dein Foto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ομάδες σου και όποιος έχει τον σύνδεσμο του προφίλ σου βλέπουν το όνομα και τη φωτογραφία σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos y quien tenga el enlace de tu perfil ven tu nombre y tu foto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu grupid ja kõik, kellel on sinu profiili link, näevad sinu nime ja fotot."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌های شما و هر کسی که لینک پروفایل شما را دارد نام و عکس شما را می‌بینند."
          }
        },
        "fi" : {
