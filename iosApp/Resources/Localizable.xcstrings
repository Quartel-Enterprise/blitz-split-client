    "Bills already saved don't change. You can undo it in the Category map." : {
      "comment" : "Teach the map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفواتير المحفوظة بالفعل لا تتغير. يمكنك التراجع عن ذلك في خريطة الفئات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits gespeicherte Ausgaben ändern sich nicht. Du kannst es in der Kategorienzuordnung rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos ya guardados no cambian. Puedes deshacerlo en el Mapa de categorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses déjà enregistrées ne changent pas. Tu peux annuler dans la Carte des catégories."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות שכבר נשמרו לא משתנים. אפשר לבטל את זה במפת הקטגוריות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से सहेजे गए खर्च नहीं बदलते। आप इसे श्रेणी मैप में पहले जैसा कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan yang sudah disimpan tidak berubah. Kamu bisa membatalkannya di Peta kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese già salvate non cambiano. Puoi annullarlo nella Mappa delle categorie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの支出は変わりません。カテゴリマップで元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 저장된 지출은 바뀌지 않아요. 카테고리 키워드에서 되돌릴 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al opgeslagen uitgaven veranderen niet. Je kunt het ongedaan maken in de categoriekaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane już wydatki się nie zmienią. Możesz to cofnąć w Mapie kategorii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas já salvas não mudam. Dá para desfazer no Mapa de categorias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas já guardadas não mudam. Podes desfazer no Mapa de categorias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже сохранённые счета не изменятся. Это можно отменить в Карте категорий."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลที่บันทึกไว้แล้วจะไม่เปลี่ยน คุณเลิกทำได้ในแผนที่หมวดหมู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı harcamalar değişmez. Bunu Kategori haritası'ndan geri alabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже збережені рахунки не зміняться. Це можна скасувати в Мапі категорій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản chi đã lưu không thay đổi. Bạn có thể hoàn tác trong Bản đồ danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的账单不会改变。你可以在类别映射中撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的帳單不會改變。你可以在類別對照表中復原。"
          }
        }
      }
    },
    "Bills of this category split another way." : {
      "comment" : "Exception by category",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فواتير هذه الفئة تُقسَّم بطريقة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben dieser Kategorie werden anders aufgeteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos de esta categoría se dividen de otra forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses de cette catégorie se répartissent autrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות בקטגוריה הזו מתחלקים בדרך אחרת."
          }
