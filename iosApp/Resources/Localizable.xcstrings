    "Whoever owed %@ in the group still owes %@. Only where the money goes changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Gruppe %1$@ geschuldet hat, schuldet weiterhin %2$@. Nur wohin das Geld geht, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien debía %1$@ en el grupo sigue debiendo %2$@. Solo cambia a quién va el dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui devait %1$@ dans le groupe doit toujours %2$@. Seul change où va l’argent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang berutang %@ di grup tetap berutang %@. Hanya tujuan uangnya yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi doveva %@ nel gruppo deve ancora %@. Cambia solo dove vanno i soldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループで%@を支払う必要があった人は、引き続き%@を支払います。お金の行き先だけが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹에서 줄 돈이 %@ 있던 사람은 여전히 %@ 줘야 해요. 돈이 가는 곳만 바뀌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie %@ schuldig was in de groep, is nog steeds %@ schuldig. Alleen waar het geld heen gaat, verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto miał w grupie do oddania %1$@, nadal ma do oddania %2$@. Zmienia się tylko, dokąd trafiają pieniądze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem devia %1$@ no grupo continua devendo %2$@. Só muda para quem vai o dinheiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem devia %1$@ no grupo continua a dever %2$@. Só muda para quem vai o dinheiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто был должен %@ в группе, по-прежнему должен %@. Меняется только, куда идут деньги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupta %@ borcu olan hâlâ %@ borçludur. Yalnızca paranın gittiği yer değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хто був винен %@ у групі, і далі винен %@. Змінюється лише те, куди йдуть гроші."
          }
        }
      }
    },
    "You may owe someone you never split a bill with" : {
