    "No internet: the new split holds on this %@ now and reaches the others once it reconnects." : {
      "comment" : "Default split offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إنترنت: يسري التقسيم الجديد على هذا الـ %@ الآن ويصل إلى الآخرين عند عودة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Die neue Aufteilung gilt jetzt auf diesem %@ und erreicht die anderen, sobald die Verbindung zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: la nueva división vale en este %@ ahora y llega a los demás cuando se reconecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : la nouvelle répartition est prise en compte sur ton %@ et arrive sur les autres dès la reconnexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אינטרנט: החלוקה החדשה תקפה ב-%@ הזה כבר עכשיו ותגיע לאחרים כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नहीं है: नया बंटवारा अभी इस %@ पर लागू है और दोबारा कनेक्ट होने पर दूसरों तक पहुंचेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada internet: pembagian baru berlaku di %@ ini sekarang dan sampai ke yang lain begitu terhubung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: la nuova divisione vale subito su questo %@ e arriva agli altri quando si riconnette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続がありません：新しい分け方は今はこの%@で有効になり、再接続すると他のメンバーにも反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결 없음: 새 분담은 지금 이 %@ 기기에 적용되고, 다시 연결되면 다른 사람들에게도 반영돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internet: de nieuwe verdeling geldt nu op deze %@ en bereikt de anderen zodra er weer verbinding is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: nowy podział obowiązuje już na tym urządzeniu (%@) i trafi do innych po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
