    "%@ Everyone sees it in Activity, and whoever changes gets a notification." : {
      "comment" : "Simplify debts: the foot turning it off; %@ is how many more people change",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يرى الجميع ذلك في «النشاط»، ويتلقى كل من يتغير وضعه إشعارًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Всички го виждат в Активност и всеки засегнат получава известие."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ সবাই এটি অ্যাক্টিভিটিতে দেখতে পাবেন, এবং যাঁদের পরিবর্তন হবে তাঁরা নোটিফিকেশন পাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Všichni to uvidí v Aktivitě a kdo se změní, dostane oznámení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Alle sehen es in Aktivität, und wer betroffen ist, bekommt eine Mitteilung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Όλοι το βλέπουν στη Δραστηριότητα και όσοι αλλάζουν λαμβάνουν ειδοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Todos lo ven en Actividad, y quien cambia recibe una notificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ همه آن را در فعالیت می‌بینند و هر کسی که تغییر کند اعلان دریافت می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Makikita ito ng lahat sa Aktibidad, at makakatanggap ng notipikasyon ang sinumang magbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tout le monde le voit dans Activité, et qui change reçoit une notification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ כולם רואים את זה בפעילות, ומי שמושפע מקבל התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ गतिविधि में सबको दिखता है, और जिनके लिए बदलता है उन्हें नोटिफ़िकेशन मिलता है।"
