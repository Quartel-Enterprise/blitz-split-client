        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jede Person damals bezahlt hat. Die Differenz zwischen Bezahltem und Verbrauchtem wird zu einem Saldo in „Salden“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι πλήρωσε ο καθένας εκείνη τη στιγμή. Η διαφορά ανάμεσα σε όσα πλήρωσε και όσα κατανάλωσε γίνεται υπόλοιπο, στα Υπόλοιπα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que pagó cada persona en el momento. La diferencia entre lo que pagó y lo que consumió se convierte en saldo, en Saldos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آنچه هر کس در آن زمان پرداخت کرد. تفاوت میان آنچه پرداخت کرده و آنچه مصرف کرده، در ترازها به تراز تبدیل می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
