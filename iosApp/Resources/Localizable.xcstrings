    "The last 90 days stay on this %@. Older ones load when the internet is back." : {
      "comment" : "The end of Activity offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten 90 Tage bleiben auf diesem %@. Ältere werden geladen, wenn das Internet zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los últimos 90 días quedan en este %@. Los más antiguos se cargan cuando vuelva internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 90 derniers jours restent sur ton %@. Les plus anciens se chargent quand internet revient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ultimi 90 giorni restano su questo %@. Quelli più vecchi si caricano quando torna internet."
          }
