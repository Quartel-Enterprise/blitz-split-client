    "Enter each one's net income, after taxes." : {
      "comment" : "Default split's By income: under the incomes, which income to type, the net one",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخِل صافي دخل كل شخص بعد الضرائب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведи нетния доход на всеки, след данъци."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "করের পরে প্রত্যেকের নিট আয় লিখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadej čistý příjem každého, po zdanění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib das Nettoeinkommen jeder Person an, nach Steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε το καθαρό εισόδημα του καθενός, μετά τους φόρους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon los ingresos netos de cada uno, después de impuestos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درآمد خالص هر کس را، پس از کسر مالیات، وارد کنید."
