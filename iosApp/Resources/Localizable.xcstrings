          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अभी-अभी किसी दूसरे डिवाइस से जुड़े"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
