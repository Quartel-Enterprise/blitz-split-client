            "value" : "Gruplarına kimin katıldığı veya ayrıldığı ve gruplarda neyin değiştiği"
          }
        }
      }
    },
    "Without an account, the app on iPhone starts empty. Connect an Apple or Google account in Settings to take your groups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Konto startet die App auf dem iPhone leer. Verbinde in den Einstellungen einen Apple- oder Google-Account, um deine Gruppen mitzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, la app en el iPhone empieza vacía. Conecta una cuenta de Apple o Google en Ajustes para llevar tus grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans compte, l’app sur iPhone démarre vide. Connecte un compte Apple ou Google dans les Réglages pour emporter tes groupes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akun, aplikasi di iPhone mulai kosong. Hubungkan akun Apple atau Google di Pengaturan untuk membawa grupmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un account, l’app sull’iPhone parte vuota. Collega un account Apple o Google nelle Impostazioni per portare i tuoi gruppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントがないと、iPhoneのアプリは空の状態で始まります。グループを移すには、設定でAppleまたはGoogleアカウントを連携してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder account begint de app op iPhone leeg. Koppel een Apple- of Google-account in Instellingen om je groepen mee te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta aplikacja na iPhonie startuje pusta. Połącz konto Apple lub Google w Ustawieniach, aby przenieść swoje grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, o app no iPhone começa vazio. Conecte uma conta Apple ou Google em Ajustes para levar seus grupos."
