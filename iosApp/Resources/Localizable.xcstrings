        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo je ve skupině, otevře ho přes svůj účet, aby ho viděl a mohl komentovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der er i gruppen, åbner det med sin egen konto for at se og kommentere."
          }
