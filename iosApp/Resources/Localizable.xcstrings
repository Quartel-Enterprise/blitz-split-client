    "Consumed is each one's share of the expenses, as each bill was split." : {
      "comment" : "The group statistics: under By person with Consumed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Verbraucht“ ist der Anteil jeder Person an den Ausgaben, so wie jede Ausgabe aufgeteilt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consumo es la parte de cada persona en los gastos, según se dividió cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consommé est la part de chacun dans les dépenses, selon la répartition de chaque dépense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consumato è la parte di spese di ciascuno, secondo come è stata divisa ogni spesa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zużyte to udział każdej osoby w wydatkach, zgodnie z podziałem każdego wydatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consumo é a parte de cada um nas despesas, como foi dividida em cada conta."
          }
        }
      }
    },
    "What each one paid at the time. The difference between what they paid and what they consumed becomes a balance, in Balances." : {
      "comment" : "The group statistics: under By person with Paid",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jede Person damals bezahlt hat. Die Differenz zwischen Bezahltem und Verbrauchtem wird zu einem Saldo in „Salden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que pagó cada persona en el momento. La diferencia entre lo que pagó y lo que consumió se convierte en saldo, en Saldos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que chacun a payé sur le moment. La différence entre ce qui a été payé et ce qui a été consommé devient un solde, dans Soldes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto ha pagato ciascuno al momento. La differenza tra quanto ha pagato e quanto ha consumato diventa un saldo, in Saldi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile każda osoba zapłaciła w danym momencie. Różnica między tym, co zapłaciła, a tym, co zużyła, staje się saldem w Saldach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto cada um pagou na hora. A diferença entre o que pagou e o que consumiu vira saldo, em Saldos."
          }
        }
      }
    },
