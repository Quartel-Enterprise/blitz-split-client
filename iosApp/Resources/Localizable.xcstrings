    "You join as a new member. Expenses added before don't include you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانضمام سيكون كعضو جديد. المصروفات المضافة سابقًا لا تشملك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присъединяваш се като нов член. Разходите, добавени преди това, не те включват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি নতুন সদস্য হিসেবে যোগ দেবেন। আগে যোগ করা খরচে আপনি অন্তর্ভুক্ত থাকবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojíš se jako nový člen. Dříve přidané výdaje tě nezahrnují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trittst als neues Mitglied bei. Vorher hinzugefügte Ausgaben schließen dich nicht ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπαίνεις ως νέο μέλος. Τα έξοδα που προστέθηκαν πριν δεν σε περιλαμβάνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras como miembro nuevo. Los gastos agregados antes no te incluyen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras como miembro nuevo. Los gastos añadidos antes no te incluyen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به عنوان عضو جدید می‌پیوندید. هزینه‌هایی که قبلاً اضافه شده‌اند شامل شما نمی‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasali ka bilang bagong miyembro. Hindi ka kasama sa mga gastos na naidagdag dati."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rejoins comme nouveau membre. Les dépenses ajoutées avant ne t’incluent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההצטרפות היא בשם חדש. הוצאות שנוספו קודם לא כוללות אותך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप नए सदस्य के रूप में जुड़ेंगे। पहले जोड़े गए खर्चों में आप शामिल नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulaziš kao novi član. Troškovi dodani prije ne uključuju tebe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új tagként csatlakozol. A korábban hozzáadott kiadásokban nem szerepelsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bergabung sebagai anggota baru. Pengeluaran yang ditambahkan sebelumnya tidak termasuk kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entri come nuovo membro. Le spese aggiunte prima non ti includono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいメンバーとして参加します。それ以前に追加された支出にはあなたは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 멤버로 참여해요. 전에 추가된 지출에는 포함되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menyertai sebagai ahli baharu. Perbelanjaan yang ditambah sebelum ini tidak termasuk anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je doet mee als nieuw lid. Eerder toegevoegde uitgaven tellen jou niet mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączasz jako nowa osoba. Wcześniej dodane wydatki cię nie obejmują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entra como um membro novo. Os gastos lançados antes não incluem você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras como um membro novo. As despesas registadas antes não te incluem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intri ca membru nou. Cheltuielile adăugate înainte nu te includ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты присоединишься как новый участник. Расходы, добавленные раньше, тебя не включают."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstúpiš ako nový člen. Výdavky pridané predtým ťa nezahŕňajú."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridružuješ se kao novi član. Ranije dodati troškovi ne uključuju tebe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du går med som ny medlem. Utgifter som lagts till tidigare inkluderar inte dig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் புதிய உறுப்பினராகச் சேர்வீர்கள். முன்பு சேர்க்கப்பட்ட செலவுகளில் நீங்கள் இருக்க மாட்டீர்கள்."
          }
