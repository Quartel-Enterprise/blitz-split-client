        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 لوگوں کے ساتھ یہ پہلے ہی ایک ادائیگی ہے۔ تیسرے شخص کے شامل ہوتے ہی دستیاب ہوگا۔"
