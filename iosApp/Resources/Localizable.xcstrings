    "Anyone in the group can edit or delete it." : {
      "comment" : "Under the form of Edit bill",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي عضو في المجموعة تعديلها أو حذفها."
          }
        },
        "de" : {
          "stringUnit" : {
