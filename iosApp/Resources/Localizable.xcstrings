    "Up to 30 letters. It can't repeat inside the same category." : {
      "comment" : "New category: the name's rules",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 30 Buchstaben. Darf sich in derselben Kategorie nicht wiederholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta 30 letras. No puede repetirse dentro de la misma categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 lettres maximum. Il ne peut pas se répéter dans la même catégorie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal 30 huruf. Tidak boleh sama di dalam kategori yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a 30 lettere. Non può ripetersi nella stessa categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30文字まで。同じカテゴリ内で重複はできません。"
