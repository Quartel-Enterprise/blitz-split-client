          }
        }
      }
    },
    "Without terms, the category doesn't come from the title: you pick it on each bill." : {
      "comment" : "Category map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Begriffe kommt die Kategorie nicht aus dem Titel: Du wählst sie bei jeder Ausgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin términos, la categoría no sale del título: la eliges en cada gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans termes, la catégorie ne vient pas du titre : tu la choisis sur chaque dépense."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa kata, kategori tidak diambil dari judul: kamu memilihnya di setiap tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza termini, la categoria non deriva dal titolo: la scegli in ogni spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語がないと、カテゴリはタイトルから決まりません。支出ごとに選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드가 없으면 카테고리가 제목으로 정해지지 않아요. 지출마다 직접 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder termen komt de categorie niet uit de titel: je kiest hem bij elke uitgave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez słów kategoria nie wynika z tytułu: wybierasz ją przy każdym wydatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
