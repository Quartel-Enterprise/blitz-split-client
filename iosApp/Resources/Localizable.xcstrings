    "Simplify debts is unavailable with fewer than 3 people. It becomes available once the group has at least 3 people." : {
      "comment" : "Edit group: tapping the disabled Simplify debts switch of a group of two",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبسيط الديون غير متاح مع أقل من 3 أشخاص. يصبح متاحًا عندما تضم المجموعة 3 أشخاص على الأقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schulden vereinfachen ist mit weniger als 3 Personen nicht verfügbar. Es wird verfügbar, sobald die Gruppe mindestens 3 Personen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificar deudas no está disponible con menos de 3 personas. Estará disponible en cuanto el grupo tenga al menos 3 personas."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificar deudas no está disponible con menos de 3 personas. Estará disponible en cuanto el grupo tenga, como mínimo, 3 personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplifier les dettes n’est pas disponible à moins de 3 personnes. Cela le devient dès que le groupe compte au moins 3 personnes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פישוט חובות לא זמין בקבוצה של פחות מ-3 אנשים. הוא יהיה זמין כשיהיו בקבוצה לפחות 3 אנשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 से कम लोगों वाले ग्रुप में “कर्ज़ सरल करें” उपलब्ध नहीं है। ग्रुप में कम से कम 3 लोग होते ही यह उपलब्ध हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sederhanakan utang tidak tersedia untuk grup dengan kurang dari 3 orang. Fitur ini tersedia setelah grup memiliki minimal 3 orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semplifica debiti non è disponibile con meno di 3 persone. Diventa disponibile quando il gruppo ha almeno 3 persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3人未満のグループでは「精算をシンプルに」は使えません。グループが3人以上になると使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3명 미만인 그룹에서는 정산 간소화를 사용할 수 없어요. 그룹이 3명 이상이 되면 사용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schulden vereenvoudigen is niet beschikbaar met minder dan 3 personen. Het wordt beschikbaar zodra de groep minstens 3 personen heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprość długi nie jest dostępne przy mniej niż 3 osobach. Będzie dostępne, gdy w grupie będą co najmniej 3 osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificar dívidas não está disponível com menos de 3 pessoas. Fica disponível assim que o grupo tiver pelo menos 3 pessoas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificar dívidas não está disponível em grupos com menos de 3 pessoas. Fica disponível a partir do momento em que o grupo tiver, pelo menos, 3 pessoas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Упростить долги» недоступно, пока в группе меньше 3 человек. Станет доступно, когда в группе будет не меньше 3 человек."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลดความซับซ้อนของหนี้ใช้ไม่ได้เมื่อมีน้อยกว่า 3 คน จะใช้ได้เมื่อกลุ่มมีอย่างน้อย 3 คน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 kişiden az olan grupta Borçları sadeleştir kullanılamaz. Grupta en az 3 kişi olunca kullanılabilir hale gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Спростити борги» недоступно, поки в групі менше 3 людей. Стане доступно, коли в групі буде щонайменше 3 людей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đơn giản hóa nợ không khả dụng khi nhóm có ít hơn 3 người. Tính năng sẽ khả dụng khi nhóm có ít nhất 3 người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群组不足3人时无法使用简化债务。群组达到3人后即可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群組不足3人時無法使用簡化債務。群組達到3人後即可使用。"
          }
        }
      }
    },
    "Carla owes Elisa %@, and Elisa owes Bruno %@." : {
      "comment" : "How it works: the example, before",
      "localizations" : {
        "ar" : {
