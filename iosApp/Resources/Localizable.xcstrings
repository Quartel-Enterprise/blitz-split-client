    "%@ is a guest without the app. Click to note what they paid you; they get no notice." : {
      "comment" : "Home on the Mac: a guest's hover; %@ is their name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Klicke, um festzuhalten, was dir gezahlt wurde; der Gast wird nicht benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Haz clic para anotar lo que te pagó; no recibe aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. Clique pour noter ce que cette personne t’a payé ; elle ne reçoit aucun avis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Fai clic per annotare quanto ti ha pagato; non riceve alcun avviso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to gość bez aplikacji. Kliknij, aby zapisać płatność od tej osoby. Nie dostanie powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem o app. Clique para anotar o que ele te pagou; ele não recebe aviso."
          }
        }
      }
    },
    "%@ is a guest without the app. Click to note what you paid them; they get no notice." : {
      "comment" : "Home on the Mac: the hover of a guest this device's user owes; %@ is their name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Klicke, um festzuhalten, was du gezahlt hast; der Gast wird nicht benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Haz clic para anotar lo que le pagaste; no recibe aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. Clique pour noter ce que tu lui as payé ; aucun avis n’est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Fai clic per annotare quanto hai pagato; non riceve alcun avviso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to gość bez aplikacji. Kliknij, aby zapisać swoją płatność dla tej osoby. Nie dostanie powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem o app. Clique para anotar o que você pagou; ele não recebe aviso."
          }
        }
      }
    },
    "%@ is a guest without the app. Tap to note what they paid you; they get no notice." : {
      "comment" : "Home: a guest's long press; %@ is their name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Tippe, um festzuhalten, was dir gezahlt wurde; der Gast wird nicht benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Toca para anotar lo que te pagó; no recibe aviso."
