        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton nom, ta photo et tes clés de paiement ne s’affichent qu’aux personnes de tes groupes. Qui ne partage aucun groupe avec toi ne voit rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo nome, la tua foto e le tue chiavi di pagamento si vedono solo dalle persone dei tuoi gruppi. Chi non condivide alcun gruppo con te non vede nulla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje imię, zdjęcie i klucze płatności widzą tylko osoby z twoich grup. Kto nie ma z tobą wspólnej grupy, nie widzi nic."
