    "Offline. Comments and photos wait in the queue and go up once you're back online." : {
      "comment" : "The bill's offline banner",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون اتصال. تنتظر التعليقات والصور في قائمة الانتظار وتُرفع عند عودة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Kommentare und Fotos warten in der Warteschlange und werden hochgeladen, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. Los comentarios y las fotos esperan en la cola y se envían cuando vuelvas a conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors ligne. Les commentaires et les photos attendent dans la file et partent dès que tu es de nouveau en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אופליין. תגובות ותמונות ממתינות בתור ויעלו כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन। टिप्पणियां और फ़ोटो कतार में इंतज़ार करती हैं और ऑनलाइन होते ही अपलोड हो जाएंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentar dan foto menunggu di antrean dan terkirim saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Commenti e foto aspettano in coda e vengono caricati quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。コメントと写真は送信待ちになり、オンラインに戻るとアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인이에요. 댓글과 사진은 대기열에 있다가 다시 온라인이 되면 업로드돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Reacties en foto’s wachten in de wachtrij en gaan omhoog zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentarze i zdjęcia czekają w kolejce i zostaną wysłane, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Comentários e fotos ficam na fila e saem ao reconectar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Comentários e fotografias ficam na fila e saem ao voltar a ter ligação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Комментарии и фото ждут в очереди и отправятся, когда снова будет интернет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออฟไลน์ ความคิดเห็นและรูปภาพจะรออยู่ในคิว และอัปโหลดเมื่อกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısın. Yorumlar ve fotoğraflar sırada bekler, tekrar çevrimiçi olunca yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Коментарі й фото чекають у черзі й надійдуть, щойно ти знову будеш онлайн."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoại tuyến. Bình luận và ảnh sẽ chờ trong hàng đợi và được tải lên khi bạn có mạng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线中。评论和照片会排队等待，恢复联网后上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線中。留言和照片會排隊等待，恢復連線後上傳。"
          }
        }
      }
    },
