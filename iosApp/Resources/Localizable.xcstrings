    "Blitz Split notifications are turned off in System Settings. The bell keeps working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen von Blitz Split sind in den Systemeinstellungen deaktiviert. Die Glocke funktioniert weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Blitz Split están desactivadas en Ajustes del Sistema. La campana sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de Blitz Split sont désactivées dans les Réglages Système. La cloche continue de fonctionner."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi Blitz Split dinonaktifkan di Pengaturan Sistem. Lonceng tetap berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche di Blitz Split sono disattivate nelle Impostazioni di Sistema. La campanella continua a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Splitの通知はシステム設定でオフになっています。ベルは引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 Blitz Split 알림이 꺼져 있어요. 앱 안의 알림 벨은 계속 작동해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
