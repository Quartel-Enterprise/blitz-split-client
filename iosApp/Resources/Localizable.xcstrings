    "Get notified when someone adds a bill with you or marks a payment to you." : {
      "comment" : "Home's notification card, while never asked",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات عندما يضيف أحد فاتورة معك أو يسجّل دفعة لك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получавай известие, когато някой добави разход с теб или отбележи плащане към теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ আপনাকে নিয়ে বিল যোগ করলে বা আপনাকে করা পেমেন্ট চিহ্নিত করলে নোটিফিকেশন পান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaň oznámení, když někdo přidá výdaj s tebou nebo označí platbu pro tebe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werde benachrichtigt, wenn jemand eine Ausgabe mit dir hinzufügt oder eine Zahlung an dich vermerkt."
          }
        },
        "el" : {
