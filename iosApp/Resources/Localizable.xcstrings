    "%@ picks their name on the list or joins as a new member." : {
      "comment" : "An invite for someone of the agenda",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار %@ اسمه من القائمة أو ينضم كعضو جديد."
          }
        },
        "de" : {
