    "“%@” already picks %@. Each term has one category." : {
      "comment" : "New term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» يختار بالفعل %@. لكل مصطلح فئة واحدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ вече избира %@. Всеки термин има една категория."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” আগে থেকেই এই ক্যাটাগরিতে আছে: %@। প্রতিটি শব্দের একটিই ক্যাটাগরি থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výraz „%@“ už patří do kategorie %@. Každý výraz má jednu kategorii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wählt schon %2$@. Jeder Begriff hat eine Kategorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο όρος «%@» επιλέγει ήδη την κατηγορία %@. Κάθε όρος έχει μία κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ya elige %2$@. Cada término tiene una sola categoría."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» از قبل %@ را انتخاب می‌کند. هر واژه یک دسته‌بندی دارد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinipili na ng “%@” ang %@. Isang kategorya lang ang bawat termino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » choisit déjà %2$@. Chaque terme a une seule catégorie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" כבר משויך ל-%2$@. לכל מונח יש קטגוריה אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” पहले से %@ चुनता है। हर शब्द की एक ही श्रेणी होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ već bira kategoriju %@. Svaki pojam ima jednu kategoriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” már ezt választja: %@. Minden kifejezéshez egy kategória tartozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sudah memilih %@. Setiap istilah punya satu kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sceglie già %@. Ogni termine ha una sola categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでに%@に設定されています。各キーワードのカテゴリは1つです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
