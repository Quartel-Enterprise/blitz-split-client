    "This bill is from the group %@. Whoever is in the group also sees their own part and the history." : {
      "comment" : "Over a bill opened from its link; %@ is the group's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ausgabe gehört zur Gruppe %@. Wer in der Gruppe ist, sieht auch den eigenen Anteil und den Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gasto es del grupo %@. Quien esté en el grupo también ve su propia parte y el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette dépense vient du groupe %@. Les membres du groupe voient aussi leur propre part et l’historique."
