          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui te paie voit cette clé au moment de régler. Quel type de clé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ti paga vede questa chiave al momento di saldare. Che tipo di chiave?"
