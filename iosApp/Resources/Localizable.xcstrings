          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καθαρό ποσό συμψηφίζει ήδη τις ομάδες: τα «Ζήτησε πληρωμή» και «Πληρώθηκα» χρησιμοποιούν %@. Η εφαρμογή καταγράφει μια πληρωμή σε κάθε ομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El saldo neto ya compensa los grupos: Cobrar y Recibido usan %@. La app registra un pago en cada grupo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netosumma tasaarveldab juba grupid: „Küsi raha“ ja „Sain raha“ kasutavad summat %@. Rakendus registreerib makse igas grupis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خالص از قبل گروه‌ها را جبران می‌کند: «درخواست» و «دریافت شد» از %@ استفاده می‌کنند. برنامه در هر گروه یک پرداخت ثبت می‌کند."
          }
        },
        "fi" : {
