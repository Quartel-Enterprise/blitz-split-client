    "No connection. The photo didn't reach the reader: try again once you're back online, or fill it in by hand." : {
      "comment" : "Split a bill: the connection dropped while the receipt was read",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا اتصال. لم تصل الصورة إلى القارئ: يمكنك المحاولة عند عودة الاتصال، أو الإدخال يدويًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма връзка. Снимката не стигна до четеца: опитай отново, когато си онлайн, или попълни ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগ নেই। ছবিটি রিডারে পৌঁছায়নি: আবার অনলাইনে এলে চেষ্টা করুন, অথবা নিজে পূরণ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense connexió. La foto no ha arribat al lector: torna-ho a provar quan tornis a tenir connexió, o omple-ho a mà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez připojení. Fotka se ke čtečce nedostala: zkus to znovu, až budeš online, nebo to vyplň ručně."
