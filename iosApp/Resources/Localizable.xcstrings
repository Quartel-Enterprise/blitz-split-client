    "When a bill's title has one of these words, its category comes by itself. “Uber home” becomes Transport." : {
      "comment" : "Category map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat der Titel einer Ausgabe eines dieser Wörter, kommt ihre Kategorie von selbst. „Uber nach Hause“ wird zu Verkehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el título de un gasto tiene una de estas palabras, la categoría llega sola. “Uber a casa” pasa a ser Transporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le titre d’une dépense contient un de ces mots, sa catégorie vient toute seule. « Uber maison » devient Transports."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika judul tagihan memuat salah satu kata ini, kategorinya terisi sendiri. “Uber pulang” jadi Transportasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il titolo di una spesa contiene una di queste parole, la categoria arriva da sola. «Uber casa» diventa Trasporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出のタイトルにこれらの単語があると、カテゴリが自動で付きます。「Uberで帰宅」は交通になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de titel van een uitgave een van deze woorden bevat, komt de categorie vanzelf. “Uber naar huis” wordt Vervoer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy tytuł wydatku zawiera jedno z tych słów, kategoria dobiera się sama. „Uber do domu” trafia do kategorii Transport."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o título da conta tem uma destas palavras, a categoria vem sozinha. “Uber para casa” vira Transporte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir harcamanın başlığında bu kelimelerden biri olduğunda kategorisi kendiliğinden gelir. “Uber eve” Ulaşım olur."
          }
        }
      }
    },
    "When two terms match a title, the longest one wins." : {
      "comment" : "Category map search",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen zwei Begriffe auf einen Titel, gewinnt der längere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando dos términos coinciden con un título, gana el más largo."
          }
        },
        "fr" : {
