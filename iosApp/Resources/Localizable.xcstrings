          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre palette est pleine : appuyez longuement sur une de vos couleurs pour la supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפלטה שלך מלאה: לחיצה ארוכה על אחד הצבעים שלך מוחקת אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पैलेट भर गया है: किसी रंग को हटाने के लिए उसे देर तक दबाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja paleta je puna: dugo pritisni jednu od svojih boja da je izbrišeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palettád megtelt: tartsd lenyomva valamelyik színedet a törléséhez."
