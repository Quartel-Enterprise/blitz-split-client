    "You're offline. Your data stays on this %@ until the sync finishes. Once everything is uploaded, we sign out and erase the local copy." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Deine Daten bleiben auf diesem %@, bis die Synchronisierung fertig ist. Sobald alles hochgeladen ist, melden wir dich ab und löschen die lokale Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Tus datos se quedan en este %@ hasta que termine la sincronización. En cuanto todo se suba, cerramos sesión y borramos la copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es hors ligne. Tes données restent sur ton %@ jusqu’à la fin de la synchronisation. Une fois tout envoyé, on te déconnecte et on efface la copie locale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. I tuoi dati restano su questo %@ finché la sincronizzazione non finisce. Quando tutto è stato caricato, ti disconnettiamo e cancelliamo la copia locale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś offline. Twoje dane zostają na tym urządzeniu (%@) do końca synchronizacji. Gdy wszystko zostanie wysłane, wylogujemy cię i wymażemy kopię lokalną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está sem internet. Seus dados ficam neste %@ até a sincronização terminar. Assim que tudo subir, saímos e apagamos a cópia local."
          }
        }
      }
    },
