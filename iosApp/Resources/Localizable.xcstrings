    "You owe nothing and nobody owes you. New groups and bills show up here on their own." : {
      "comment" : "Apple Watch Balances (15.3b)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء عليك ولا أحد عليه لك. تظهر المجموعات والفواتير الجديدة هنا تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не дължиш нищо и никой не ти дължи. Новите групи и разходи се появяват тук сами."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ আপনাকে কিছু দেবেন না, আপনিও কাউকে কিছু দেবেন না। নতুন গ্রুপ ও বিল এখানে নিজেই দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No deus res i ningú no et deu res. Els grups i les despeses nous apareixen aquí sols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikomu nic nedlužíš a nikdo nedluží tobě. Nové skupiny a výdaje se tu objeví samy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skylder intet, og ingen skylder dig. Nye grupper og udgifter vises her af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schuldest nichts und niemand schuldet dir etwas. Neue Gruppen und Ausgaben erscheinen hier von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρωστάς τίποτα και κανείς δεν σου χρωστάει. Νέες ομάδες και έξοδα εμφανίζονται εδώ μόνα τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No debes nada y nadie te debe. Los grupos y gastos nuevos aparecen aquí solos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei võlgne midagi ja keegi ei võlgne sulle. Uued grupid ja kulud ilmuvad siia iseenesest."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نه شما به کسی بدهکارید و نه کسی به شما. گروه‌ها و هزینه‌های جدید خودبه‌خود اینجا نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ole velkaa mitään, eikä kukaan ole sinulle velkaa. Uudet ryhmät ja kulut näkyvät täällä itsestään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala kang utang at walang may utang sa iyo. Kusang lalabas dito ang mga bagong grupo at bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne dois rien et personne ne te doit rien. Les nouveaux groupes et dépenses apparaissent ici tout seuls."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારે કંઈ આપવાનું નથી અને કોઈએ તમને કંઈ આપવાનું નથી. નવા ગ્રુપ અને ખર્ચ અહીં આપમેળે દેખાશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאף אחד אין חוב אליך ואין לך חובות. קבוצות וחשבונות חדשים יופיעו כאן לבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न किसी पर आपका बकाया है, न आप पर किसी का। नए ग्रुप और खर्च यहां अपने आप दिखेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne duguješ ništa i nitko ne duguje tebi. Nove grupe i troškovi ovdje se pojavljuju sami."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem tartozol senkinek, és neked sem tartozik senki. Az új csoportok és számlák maguktól megjelennek itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak berutang dan tidak ada yang berutang ke kamu. Grup dan tagihan baru muncul di sini sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non devi nulla e nessuno ti deve nulla. Nuovi gruppi e spese compaiono qui da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貸し借りはありません。新しいグループや支出は自動でここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받을 돈도 줄 돈도 없어요. 새 그룹과 지출은 여기에 알아서 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieko neturi grąžinti ir niekas neturi tau grąžinti. Naujos grupės ir išlaidos atsiras čia savaime."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nevienam neko neesi parādā, un neviens nav parādā tev. Jaunas grupas un rēķini šeit parādīsies paši."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला काहीही द्यायचे नाही आणि तुम्हाला कोणाकडूनही येणे नाही. नवीन ग्रुप आणि खर्च इथे आपोआप दिसतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak berhutang dan tiada sesiapa berhutang kepada anda. Kumpulan dan bil baharu muncul di sini sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skylder ingenting, og ingen skylder deg. Nye grupper og utgifter dukker opp her av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent niemand iets schuldig en niemand jou. Nieuwe groepen en uitgaven verschijnen hier vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie ma ci nic do oddania, a ty nikomu. Nowe grupy i wydatki pojawią się tu same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não deve nada e ninguém te deve. Novos grupos e contas aparecem aqui sozinhos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deves nada e ninguém te deve. Novos grupos e contas aparecem aqui sozinhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu datorezi nimic și nimeni nu-ți datorează. Grupurile și cheltuielile noi apar aici singure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никто не должен тебе, и ты никому не должен(-на). Новые группы и счета появятся здесь сами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nič nedlžíš a nikto ti nedlží. Nové skupiny a výdavky sa tu zobrazia samy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nič ne dolguješ in nihče ne dolguje tebi. Nove skupine in stroški se prikažejo tukaj sami."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne duguješ ništa i niko ne duguje tebi. Nove grupe i računi pojavljuju se ovde sami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är inte skyldig något och ingen är skyldig dig. Nya grupper och utgifter dyker upp här av sig själva."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hudaiwi chochote na hakuna anayedaiwa na wewe. Vikundi na gharama mpya vinaonekana hapa vyenyewe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் யாருக்கும் தர வேண்டியதில்லை, உங்களுக்கும் யாரும் தர வேண்டியதில்லை. புதிய குழுக்களும் செலவுகளும் இங்கே தானாகவே தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఎవరికీ ఇవ్వాల్సింది లేదు, మీకు ఎవరూ ఇవ్వాల్సింది లేదు. కొత్త గ్రూప్‌లు, ఖర్చులు ఇక్కడ వాటంతట అవే కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครค้างคุณ และคุณก็ไม่ได้ค้างใคร กลุ่มและบิลใหม่จะแสดงที่นี่เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimseye borcun yok, kimsenin de sana borcu yok. Yeni gruplar ve harcamalar burada kendiliğinden görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніхто не винен тобі, і ти нікому не винен(-на). Нові групи й рахунки з'являться тут самі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نہ آپ نے کسی کو کچھ دینا ہے اور نہ کسی نے آپ کو۔ نئے گروپ اور خرچ یہاں خود ہی نظر آئیں گے۔"
          }
