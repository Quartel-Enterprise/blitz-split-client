    "Bills already saved don't change. You can undo it in the Category map." : {
      "comment" : "Teach the map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits gespeicherte Ausgaben ändern sich nicht. Du kannst es in der Kategorienzuordnung rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos ya guardados no cambian. Puedes deshacerlo en el Mapa de categorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses déjà enregistrées ne changent pas. Tu peux annuler dans la Carte des catégories."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan yang sudah disimpan tidak berubah. Kamu bisa membatalkannya di Peta kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese già salvate non cambiano. Puoi annullarlo nella Mappa delle categorie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの支出は変わりません。カテゴリマップで元に戻せます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al opgeslagen uitgaven veranderen niet. Je kunt het ongedaan maken in de categoriekaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane już wydatki się nie zmienią. Możesz to cofnąć w Mapie kategorii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas já salvas não mudam. Dá para desfazer no Mapa de categorias."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı harcamalar değişmez. Bunu Kategori haritası'ndan geri alabilirsin."
