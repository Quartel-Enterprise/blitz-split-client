    "Add bills right away, wherever you are" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben sofort erfassen, wo immer du bist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega gastos al instante, estés donde estés"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade gastos al instante, estés donde estés"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des dépenses tout de suite, où que tu sois"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tagihan langsung, di mana pun kamu berada"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi spese subito, ovunque tu sia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでもすぐに支出を追加"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg meteen uitgaven toe, waar je ook bent"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj wydatki od razu, gdziekolwiek jesteś"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance na hora, onde estiver"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamaları hemen ekle, nerede olursan ol"
          }
        }
      }
    },
    "Add bills right away, wherever you are, even offline. And get payment notices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben sofort erfassen, wo immer du bist, sogar offline. Und Zahlungshinweise erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega gastos al instante, estés donde estés, incluso sin conexión. Y recibe avisos de pago."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade gastos al instante, estés donde estés, incluso sin conexión. Y recibe avisos de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des dépenses tout de suite, où que tu sois, même hors ligne. Et reçois les avis de paiement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tagihan langsung, di mana pun kamu berada, bahkan offline. Dan dapatkan pemberitahuan pembayaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi spese subito, ovunque tu sia, anche offline. E ricevi gli avvisi di pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでもすぐに支出を追加できます。オフラインでも大丈夫。支払いの通知も届きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg meteen uitgaven toe, waar je ook bent, zelfs offline. En krijg betaalmeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj wydatki od razu, gdziekolwiek jesteś, nawet offline. I otrzymuj powiadomienia o płatnościach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance na hora, onde estiver, mesmo sem internet. E receba avisos de pagamento."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamaları hemen ekle, nerede olursan ol, çevrimdışı bile. Ödeme bildirimleri de al."
          }
        }
      }
    },
