        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa do grupo pode mudar o nome, o ícone, o tipo e Simplificar dívidas. A Atividade mostra quem mudou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой в группе может изменить название, значок, тип и упрощение долгов. В Активности видно, кто это изменил."
