        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रांगेतील सर्व पाठवल्यानंतर त्याचा डेटा मिटवला जातो. तुमचा iPhone साइन इन राहतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
