    "%@ is a guest without the app. Click to note what they paid you; they get no notice." : {
      "comment" : "Home on the Mac: a guest's hover; %@ is their name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Klicke, um festzuhalten, was dir gezahlt wurde; der Gast wird nicht benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Haz clic para anotar lo que te pagó; no recibe aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. Clique pour noter ce que cette personne t’a payé ; elle ne reçoit aucun avis."
          }
