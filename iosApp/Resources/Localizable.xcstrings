    "You picked %@. By the map it would be %@ (“%@”)." : {
      "comment" : "Under a bill's description: the category picked by hand differs from the map's",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخترت %@. بحسب الخريطة ستكون %@ («%@»)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избра %@. По картата щеше да е %@ („%@“)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি %@ বেছে নিয়েছেন। ম্যাপ অনুযায়ী এটি হতো %@ (“%@”)।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybral(a) jsi %@. Podle mapy by to byla %@ („%@“)."
