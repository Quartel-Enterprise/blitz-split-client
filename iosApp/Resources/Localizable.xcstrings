    "Your account isn't in this bill's group. Ask whoever shared it to invite you." : {
      "comment" : "Under a bill's link only its group opens, signed in with an account that isn't in the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسابك ليس في مجموعة هذه الفاتورة. اطلب الدعوة ممن شاركها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
