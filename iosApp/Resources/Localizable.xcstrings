            "value" : "이름을 해제하지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de naam niet vrijgeven. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zwolnić imienia. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu para liberar o nome. Confira a internet e tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível libertar o nome. Verifica a internet e tenta de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось освободить имя. Проверь подключение и попробуй ещё раз."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปล่อยชื่อไม่สำเร็จ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad serbest bırakılamadı. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося звільнити ім'я. Перевір з'єднання й спробуй ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể giải phóng tên. Hãy kiểm tra kết nối và thử lại."
