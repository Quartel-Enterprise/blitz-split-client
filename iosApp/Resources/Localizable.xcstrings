    "Payments go back to being between whoever split each bill. Totals don't change." : {
      "comment" : "Simplify debts: what turning it off does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الدفعات لتكون بين من قسّموا كل فاتورة. الإجماليات لا تتغير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащанията отново са между тези, които са разделили всеки разход. Общите суми не се променят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট আবার যাঁরা প্রতিটি বিল ভাগ করেছেন তাঁদের মধ্যেই হবে। মোট পরিমাণ বদলাবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby budou zase mezi těmi, kdo si každý výdaj rozdělili. Celkové částky se nemění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen laufen wieder zwischen denen, die die jeweilige Ausgabe geteilt haben. Die Summen ändern sich nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πληρωμές επιστρέφουν ανάμεσα σε όσους μοιράστηκαν κάθε έξοδο. Τα σύνολα δεν αλλάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos vuelven a ser entre quienes dividieron cada gasto. Los totales no cambian."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت‌ها دوباره بین کسانی خواهد بود که هر هزینه را تقسیم کرده‌اند. مجموع‌ها تغییر نمی‌کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babalik ang mga bayad sa pagitan ng mga naghati sa bawat bill. Hindi magbabago ang mga total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements redeviennent ceux entre les personnes qui ont partagé chaque dépense. Les totaux ne changent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלומים חוזרים להיות בין מי שפיצלו כל חשבון. הסכומים הכוללים לא משתנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान फिर से उन्हीं लोगों के बीच होंगे जिन्होंने हर खर्च बांटा। कुल नहीं बदलते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju između onih koji su dijelili svaki trošak. Ukupni iznosi se ne mijenjaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetések újra azok között lesznek, akik az egyes számlákat felosztották. Az összegek nem változnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran kembali terjadi di antara orang yang membagi setiap tagihan. Totalnya tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti tornano a essere tra chi ha diviso ogni spesa. I totali non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いは各支出を割り勘した人同士に戻ります。合計は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 다시 각 지출을 나눈 사람끼리 이뤄져요. 합계는 바뀌지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayaran kembali antara orang yang berkongsi setiap bil. Jumlah tidak berubah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen gaan weer tussen wie elke uitgave heeft verdeeld. De totalen veranderen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności znów odbywają się między osobami, które dzieliły dany wydatek. Sumy się nie zmieniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Os totais não mudam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plățile revin între cei care au împărțit fiecare cheltuială. Totalurile nu se schimbă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежи снова будут между теми, кто делил каждый счёт. Итоги не меняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby sa vrátia medzi tých, ktorí si rozdelili jednotlivé výdavky. Celkové sumy sa nezmenia."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju na one između osoba koje su podelile svaki račun. Ukupni iznosi se ne menjaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalningarna går tillbaka till att vara mellan dem som delade varje utgift. Totalerna ändras inte."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு செலவையும் பிரித்தவர்களுக்கு இடையேயே பேமெண்ட்டுகள் மீண்டும் நடக்கும். மொத்தங்கள் மாறாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจ่ายเงินจะกลับไปเป็นระหว่างคนที่หารแต่ละบิล ยอดรวมไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemeler yeniden her harcamayı bölenler arasında olur. Toplamlar değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежі знову будуть між тими, хто ділив кожен рахунок. Підсумки не змінюються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادائیگیاں پھر سے ان کے درمیان ہوں گی جنہوں نے ہر خرچ بانٹا۔ کل رقمیں نہیں بدلتیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản thanh toán sẽ quay lại giữa những người đã chia từng khoản chi. Tổng không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款会恢复为在共同分摊每笔账单的人之间进行。总额不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款會恢復為在共同分攤每筆帳單的人之間進行。總額不變。"
          }
        }
      }
    },
    "%@ already has the fewest payments. Turn it on anyway and the next bills come in simplified." : {
      "comment" : "Simplify debts: the confirmation when nothing drops; %@ is the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الدفعات في %@ في حده الأدنى بالفعل. يمكنك التفعيل على أي حال لتأتي الفواتير التالية مبسّطة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вече има най-малко плащания. Включи го все пак и следващите разходи ще идват опростени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ গ্রুপে পেমেন্টের সংখ্যা ইতিমধ্যে সবচেয়ে কম। তবুও চালু করলে পরের বিলগুলো সহজ হয়ে আসবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už má nejméně plateb. Zapni to i tak a další výdaje přijdou zjednodušené."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat schon die wenigsten Zahlungen. Schalte es trotzdem ein, und die nächsten Ausgaben kommen vereinfacht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ομάδα %@ έχει ήδη τις λιγότερες πληρωμές. Ενεργοποίησέ την ούτως ή άλλως και τα επόμενα έξοδα θα απλοποιούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene el mínimo de pagos. Actívalo de todos modos y los próximos gastos entrarán simplificados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ از قبل کمترین تعداد پرداخت را دارد. اگر با این حال روشنش کنید، هزینه‌های بعدی ساده‌شده می‌آیند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinakakaunti na ang mga bayad sa %@. I-on pa rin ito at ang mga susunod na bill ay darating na pinasimple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a déjà le minimum de paiements. Active-le quand même et les prochaines dépenses arriveront simplifiées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-%@ כבר יש הכי מעט תשלומים. אפשר להפעיל בכל זאת, והחשבונות הבאים ייכנסו מפושטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ में पहले से सबसे कम भुगतान हैं। फिर भी चालू करें, तो अगले खर्च सरल होकर आएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa „%@“ već ima najmanje uplata. Uključi ipak i sljedeći troškovi stižu pojednostavljeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a csoportban már a legkevesebb a fizetés: %@. Kapcsold be mégis, és a következő számlák már egyszerűsítve érkeznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah punya pembayaran paling sedikit. Aktifkan saja dan tagihan berikutnya akan langsung disederhanakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha già il minor numero di pagamenti. Attivalo comunque e le prossime spese arriveranno semplificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに支払い回数が最少です。それでもオンにすると、次の支出からシンプルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 그룹은 이미 송금 횟수가 최소예요. 그래도 켜면 다음 지출부터 간소화돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah mempunyai bilangan bayaran paling sedikit. Hidupkan juga dan bil seterusnya akan dipermudahkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft al het minste aantal betalingen. Zet het toch aan, dan komen de volgende uitgaven vereenvoudigd binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %@ ma już najmniej płatności. Włącz mimo to, a kolejne wydatki będą upraszczane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está no mínimo. Ligue mesmo assim, e as próximas contas já entram simplificadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está no mínimo. Liga mesmo assim, e as próximas contas já entram simplificadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ are deja cele mai puține plăți. Activează oricum și următoarele cheltuieli vin simplificate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В группе %@ уже минимум платежей. Включи всё равно, и следующие счета будут упрощаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už má najmenej platieb. Zapni to aj tak a ďalšie výdavky prídu zjednodušené."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U grupi %@ već je najmanji broj uplata. Ako ipak uključiš, sledeći računi stižu pojednostavljeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har redan så få betalningar som möjligt. Slå på det ändå så kommer nästa utgifter förenklade."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் குழுவில் ஏற்கனவே மிகக் குறைந்த பேமெண்ட்டுகள் உள்ளன: %@. இருந்தாலும் இயக்கினால், அடுத்த செலவுகள் எளிதாக்கப்பட்டு வரும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” มีจำนวนการจ่ายเงินน้อยที่สุดแล้ว ถ้าเปิดอยู่ดี บิลถัดไปจะเข้ามาแบบลดความซับซ้อนแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubunda zaten en az ödeme var. Yine de açarsan sonraki harcamalar sadeleştirilmiş gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У групі %@ уже найменше платежів. Увімкни все одно, і наступні рахунки надходитимуть спрощеними."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ میں پہلے ہی کم سے کم ادائیگیاں ہیں۔ پھر بھی آن کریں تو اگلے خرچ آسان ہو کر آئیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã có ít khoản thanh toán nhất. Nếu vẫn bật, các khoản chi tiếp theo sẽ được đơn giản hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的付款笔数已是最少。仍然开启的话，之后的账单会以简化后的方式计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」的付款筆數已是最少。仍然開啟的話，之後的帳單會以簡化後的方式計入。"
          }
        }
      }
    },
    "Everyone keeps paying or receiving the same total. Only who pays whom changes." : {
      "comment" : "Simplify debts: what turning it on does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى إجمالي ما يدفعه أو يستلمه كل شخص كما هو. يتغير فقط من يدفع لمن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки продължава да плаща или получава същата обща сума. Променя се само кой на кого плаща."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবাই আগের মতোই মোট একই পরিমাণ দেবেন বা পাবেন। শুধু কে কাকে দেবেন তা বদলাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý dál platí nebo dostává stejnou celkovou částku. Mění se jen to, kdo platí komu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zahlen oder bekommen weiter dieselbe Summe. Nur wer wen bezahlt, ändert sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι συνεχίζουν να πληρώνουν ή να λαμβάνουν το ίδιο σύνολο. Αλλάζει μόνο ποιος πληρώνει ποιον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada persona sigue pagando o recibiendo el mismo total. Solo cambia quién le paga a quién."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه همان مجموع را می‌پردازند یا دریافت می‌کنند. فقط اینکه چه کسی به چه کسی می‌پردازد تغییر می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareho pa rin ang kabuuang babayaran o matatanggap ng bawat isa. Ang magbabago lang ay kung sino ang nagbabayad kanino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun continue de payer ou de recevoir le même total. Seul change qui paie qui."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל אחד ממשיך לשלם או לקבל אותו סכום כולל. רק מי משלם למי משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कोई उतना ही कुल देता या पाता रहेगा। सिर्फ़ यह बदलेगा कि कौन किसे भुगतान करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko i dalje plaća ili prima isti ukupni iznos. Mijenja se samo tko kome plaća."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindenki ugyanannyit fizet vagy kap összesen. Csak az változik, ki kinek fizet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua tetap membayar atau menerima total yang sama. Hanya siapa membayar ke siapa yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno continua a pagare o ricevere lo stesso totale. Cambia solo chi paga chi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が支払う・受け取る合計額は変わりません。誰が誰に支払うかだけが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 같은 합계를 계속 내거나 받아요. 누가 누구에게 내는지만 바뀌어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang terus membayar atau menerima jumlah yang sama. Hanya siapa membayar siapa yang berubah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen blijft hetzelfde totaal betalen of ontvangen. Alleen wie wie betaalt, verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy nadal płaci lub otrzymuje tę samą sumę. Zmienia się tylko, kto komu płaci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pessoa continua pagando ou recebendo o mesmo total. Só muda quem paga a quem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pessoa continua a pagar ou a receber o mesmo total. Só muda quem paga a quem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare continuă să plătească sau să primească același total. Se schimbă doar cine cui plătește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый продолжает платить или получать ту же сумму. Меняется только, кто кому платит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý naďalej zaplatí alebo dostane rovnakú celkovú sumu. Mení sa len to, kto platí komu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako i dalje plaća ili prima isti ukupan iznos. Menja se samo ko kome plaća."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla fortsätter att betala eller få samma totalbelopp. Bara vem som betalar vem ändras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எல்லோரும் அதே மொத்தத்தைத் தொடர்ந்து செலுத்துவார்கள் அல்லது பெறுவார்கள். யார் யாருக்குச் செலுத்துகிறார்கள் என்பது மட்டுமே மாறும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนยังจ่ายหรือได้รับยอดรวมเท่าเดิม แค่เปลี่ยนว่าใครจ่ายให้ใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkes aynı toplamı ödemeye ya da almaya devam eder. Yalnızca kimin kime ödediği değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен і далі платить чи отримує ту саму загальну суму. Змінюється лише те, хто кому платить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سب اتنا ہی کل ادا یا وصول کرتے رہیں گے۔ صرف یہ بدلتا ہے کہ کون کس کو ادا کرے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người vẫn trả hoặc nhận cùng một tổng số. Chỉ thay đổi ai trả cho ai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个人要付或要收的总额不变，只改变谁付给谁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個人要付或要收的總額不變，只改變誰付給誰。"
          }
        }
      }
    },
