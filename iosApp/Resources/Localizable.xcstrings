          "stringUnit" : {
            "state" : "translated",
            "value" : "Få veta när någon registrerar en betalning eller ber dig betala."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "யாராவது பேமெண்ட்டைப் பதிவு செய்தால் அல்லது உங்களைச் செலுத்தச் சொன்னால் தெரிந்துகொள்ளுங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ทันทีเมื่อมีคนบันทึกการจ่ายเงินหรือขอเงินจากคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri ödeme kaydettiğinde veya senden ödeme istediğinde haberin olsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дізнавайся, коли хтось записує платіж або просить тебе заплатити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کوئی ادائیگی درج کرے یا آپ سے ادائیگی مانگے تو جانیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết khi ai đó ghi nhận thanh toán hoặc yêu cầu bạn trả tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
