    "Whoever is in the group opens it with their own account to see and comment." : {
      "comment" : "Share bill: who opens a members-only link, when nobody else joined",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتحه أعضاء المجموعة بحساباتهم لرؤيته والتعليق عليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки в групата го отваря със своя акаунт, за да го види и коментира."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপে যাঁরা আছেন, তাঁরা নিজের অ্যাকাউন্ট দিয়ে এটি খুলে দেখতে ও মন্তব্য করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui sigui al grup l’obre amb el seu compte per veure i comentar."
          }
