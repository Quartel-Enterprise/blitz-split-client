    "If you already sent the money, mark it as paid anyway: the app redoes the math." : {
      "comment" : "Record payment, 13.5c: what to do if the money already went",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كان المال قد أُرسل بالفعل، فيمكنك تسجيله كمدفوع على أي حال: يعيد التطبيق الحساب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако вече си изпратил(а) парите, отбележи го като платено все пак: приложението преизчислява сметките."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টাকা আগেই পাঠিয়ে থাকলে তবুও এটি পরিশোধিত হিসেবে চিহ্নিত করুন: অ্যাপ আবার হিসাব করে নেবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ja has enviat els diners, marca’l com a pagat igualment: l’app torna a fer els comptes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi peníze už poslal(a), stejně to označ jako zaplacené: aplikace to přepočítá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du allerede har sendt pengene, så markér det som betalt alligevel: appen regner det om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das Geld schon geschickt hast, markier es trotzdem als bezahlt: Die App rechnet neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έχεις ήδη στείλει τα χρήματα, σημείωσέ το ως πληρωμένο ούτως ή άλλως: η εφαρμογή ξανακάνει τους υπολογισμούς."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you already sent the money, mark it as paid anyway: the app redoes the maths."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you already sent the money, mark it as paid anyway: the app redoes the maths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya enviaste el dinero, márcalo como pagado de todos modos: la app rehace la cuenta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui saatsid raha juba ära, märgi see ikkagi makstuks: rakendus arvutab uuesti."
