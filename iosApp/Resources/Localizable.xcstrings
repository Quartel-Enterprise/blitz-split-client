    "Pick the account; they get the request and accept." : {
      "comment" : "Merging a guest: a request to an account",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختيار الحساب؛ يتلقى صاحبه الطلب ويقبله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избери акаунта; той получава заявката и я приема."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্টটি বেছে নিন; তিনি অনুরোধ পেয়ে তা গ্রহণ করবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber účet; dostane žádost a přijme ji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl das Konto; die Person bekommt die Anfrage und nimmt sie an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε τον λογαριασμό: το άτομο θα λάβει το αίτημα και θα το αποδεχτεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la cuenta; esa persona recibe la solicitud y acepta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب کاربری را انتخاب کنید؛ او درخواست را دریافت و قبول می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang account; matatanggap nila ang request at tatanggapin nila ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis le compte ; la personne reçoit la demande et accepte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור את חשבון המשתמש; הבקשה תגיע אליו לאישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट चुनें; उन्हें अनुरोध मिलेगा और वे स्वीकार करेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberi račun; osoba dobiva zahtjev i prihvaća ga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki a fiókot; megkapja a kérést, és elfogadja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih akunnya; mereka menerima permintaan lalu menyetujuinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l’account; riceve la richiesta e accetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを選んでください。相手にリクエストが届き、承認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 고르세요. 상대가 요청을 받고 수락해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih akaun; mereka akan menerima permintaan dan menyetujuinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het account; die krijgt het verzoek en accepteert het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz konto; ta osoba otrzyma prośbę i ją zaakceptuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a conta; a pessoa recebe o pedido e aceita."
          }
        },
