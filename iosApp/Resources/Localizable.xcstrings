    "New bills you pay start with it." : {
      "comment" : "Under the payment method form's default switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفواتير الجديدة التي تدفعها تبدأ بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Ausgaben, die du bezahlst, starten damit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos gastos que pagues empiezan con él."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos gastos que pagues empiezan con este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles dépenses que vous payez le reprennent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות חדשים שמשולמים על ידך מתחילים איתו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नए खर्च इसी से शुरू होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan baru yang kamu bayar langsung memakai metode ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove spese che paghi partono con questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが支払う新しい支出は、この方法から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 결제하는 새 지출에 기본으로 선택돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe uitgaven die jij betaalt beginnen hiermee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe wydatki, za które płacisz, zaczynają od niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas contas que você pagar já vêm com ela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas contas que pagares já vêm com ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые счета, которые ты оплачиваешь, начинаются с него."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลใหม่ที่คุณจ่ายจะเริ่มด้วยช่องทางนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödediğin yeni harcamalar bununla başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові рахунки, які ти сплачуєш, починаються з нього."
          }
        },
