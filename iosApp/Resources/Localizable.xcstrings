        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link escolhe quem é na lista: %@. Não precisa criar conta."
          }
        }
      }
    },
    "Whoever opens this link joins straight in as %@, without picking from the list. It works once." : {
