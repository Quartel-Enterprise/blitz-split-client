        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقشه آفلاین کار می‌کند: تغییرات همان لحظه در این دستگاه اعمال می‌شوند و وقتی دوباره آنلاین شوید به دستگاه‌های دیگرتان می‌رسند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana offline ang mapa: agad na nagkakabisa ang mga pagbabago sa device na ito at makakarating sa iba mo pang device pagbalik mo online."
