    "push.debts_simplified_to_you" : {
      "comment" : "Push notification: someone turned on Simplify debts and someone now pays you. 1: who, 2: the payer, 3: the amount",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: تبسيط الديون. الآن على %2$@ لك %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Schulden vereinfacht. Jetzt zahlt dir %2$@ %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplified the debts. Now %2$@ pays you %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó las deudas. Ahora %2$@ te paga %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a simplifié les dettes. Maintenant %2$@ te paie %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: פישוט החובות. עכשיו מגיע לך %3$@ מ-%2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने कर्ज़ सरल किए। अब %2$@ आपको %3$@ देंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menyederhanakan utang. Sekarang %2$@ membayarmu %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha semplificato i debiti. Ora %2$@ ti paga %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が精算をシンプルにしました。今後は%2$@があなたに%3$@を支払います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 님이 정산을 간소화했어요. 이제 %2$@ 님이 나에게 %3$@ 송금해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de schulden vereenvoudigd. Nu betaalt %2$@ je %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uprościł(a) długi. Teraz %2$@ płaci ci %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificou as dívidas. Agora %2$@ te paga %3$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificou as dívidas. Agora %2$@ paga-te %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ упростил(а) долги. Теперь %2$@ платит тебе %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ลดความซับซ้อนของหนี้ ตอนนี้ %2$@ จ่ายให้คุณ %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ borçları sadeleştirdi. Artık %2$@ sana %3$@ ödüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ спростив(-ла) борги. Тепер %2$@ платить тобі %3$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã đơn giản hóa nợ. Giờ %2$@ trả cho bạn %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@简化了债务。现在%2$@付给你%3$@。"
          }
