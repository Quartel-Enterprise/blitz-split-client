    "%@ simplified its debts, so instead of paying %@ you pay me directly; your total didn't change." : {
      "comment" : "Request's message: %1$@ is the group, %2$@ whom they would pay by the bills",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Schulden vereinfacht, daher zahlst du mir direkt statt an %2$@; deine Summe hat sich nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó sus deudas, así que en vez de pagar %2$@ me pagas directamente a mí; tu total no cambió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a simplifié ses dettes, donc au lieu de payer %2$@ tu me paies directement ; ton total n’a pas changé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menyederhanakan utangnya, jadi daripada membayar %@ kamu langsung membayar ke aku; totalmu tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha semplificato i debiti, quindi invece di pagare %@ paghi direttamente me; il tuo totale non è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で精算がシンプルになったので、%@に支払う代わりに私に直接支払ってください。あなたの合計は変わりません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de schulden vereenvoudigd, dus in plaats van %@ te betalen, betaal je mij rechtstreeks; je totaal is niet veranderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %1$@ uprościła długi, więc zamiast płacić osobie %2$@, płacisz bezpośrednio mnie; twoja suma się nie zmieniła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ simplificou as dívidas, então em vez de pagar %2$@ você paga direto para mim; o seu total não mudou."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubu borçlarını sadeleştirdi; bu yüzden %@ kişisine ödemek yerine doğrudan bana ödüyorsun. Toplamın değişmedi."
          }
        }
      }
    },
