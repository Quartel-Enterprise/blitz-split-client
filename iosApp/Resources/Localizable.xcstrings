    "We saw you on your phone. Your groups are already there, and the invite to download the app won't show again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dich auf deinem Handy gesehen. Deine Gruppen sind schon dort, und die Einladung, die App zu laden, erscheint nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vimos en tu celular. Tus grupos ya están ahí, y la invitación para descargar la app no volverá a aparecer."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vimos en tu móvil. Tus grupos ya están ahí, y la invitación para descargar la app no volverá a aparecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On t’a vu sur ton téléphone. Tes groupes y sont déjà, et l’invitation à télécharger l’app ne s’affichera plus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami melihatmu di ponsel. Grupmu sudah ada di sana, dan ajakan untuk mengunduh aplikasi tidak akan tampil lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti abbiamo visto sul telefono. I tuoi gruppi sono già lì e l’invito a scaricare l’app non comparirà più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンでの利用を確認しました。グループはすでにそちらにあり、アプリのダウンロード案内は今後表示されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zagen je op je telefoon. Je groepen staan er al, en de uitnodiging om de app te downloaden verschijnt niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzimy, że masz aplikację na telefonie. Twoje grupy już tam są, a zaproszenie do pobrania aplikacji nie pojawi się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vimos você no celular. Seus grupos já estão lá, e o convite para baixar o app não aparece mais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni telefonunda gördük. Grupların zaten orada ve uygulamayı indirme daveti bir daha gösterilmeyecek."
          }
        }
      }
    },
