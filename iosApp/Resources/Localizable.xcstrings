    "Bills you marked with it will no longer show it." : {
      "comment" : "Asks before deleting a payment method",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفواتير التي وسمتها بها لن تعرضها بعد الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разходите, маркирани с него, вече няма да го показват."
