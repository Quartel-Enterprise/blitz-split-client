    "Your palette is full: long press one of your colors to delete it." : {
      "comment" : "Category color picker: the person's own colors",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Palette ist voll: Halte eine deiner Farben gedrückt, um sie zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu paleta está llena: mantén presionado uno de tus colores para eliminarlo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu paleta está llena: mantén pulsado uno de tus colores para eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre palette est pleine : appuyez longuement sur une de vos couleurs pour la supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palet kamu penuh: tekan lama salah satu warnamu untuk menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua tavolozza è piena: tieni premuto uno dei tuoi colori per eliminarlo."
