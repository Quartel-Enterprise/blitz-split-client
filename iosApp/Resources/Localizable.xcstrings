        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप बदलें में। गतिविधि में दिखता है कि किसने बदला, और जो अब किसी और को भुगतान करेगा या किसी और से पाएगा, उसे नोटिफ़िकेशन मिलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U Uredi grupu. Aktivnost pokazuje tko je to promijenio, a tko sada plaća nekome drugome ili prima od nekoga drugoga, dobiva obavijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Csoport szerkesztése alatt. A Tevékenységben látszik, ki módosította, és aki mostantól másnak fizet vagy mástól kap, értesítést kap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Edit grup. Aktivitas menunjukkan siapa yang mengubahnya, dan yang sekarang membayar atau menerima dari orang lain mendapat notifikasi."
