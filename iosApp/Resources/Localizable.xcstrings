    "Blitz Split · recovery code\n\n%@\n\nUse it in \"I've used it on another device\" to bring your data back.\n" : {
      "comment" : "The text file the recovery code sheet's Download saves: the app name, the 12 numbered words and how to use them",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · رمز الاسترداد\n\n%@\n\nاستخدمه في «استخدمته على جهاز آخر» لاستعادة بياناتك.\n"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · код за възстановяване\n\n%@\n\nИзползвай го в „Използвах го на друго устройство“, за да върнеш данните си.\n"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · রিকভারি কোড\n\n%@\n\nআপনার ডেটা ফিরিয়ে আনতে “আমি অন্য ডিভাইসে ব্যবহার করেছি” অংশে এটি ব্যবহার করুন।\n"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · obnovovací kód\n\n%@\n\nPoužij ho v „Už jsem ho použil(a) na jiném zařízení“, abys získal(a) svá data zpět.\n"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · Wiederherstellungscode\n\n%@\n\nGib ihn unter „Ich habe sie auf einem anderen Gerät genutzt“ ein, um deine Daten zurückzuholen.\n"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · κωδικός ανάκτησης\n\n%@\n\nΧρησιμοποίησέ τον στην επιλογή «Τον έχω χρησιμοποιήσει σε άλλη συσκευή» για να επαναφέρεις τα δεδομένα σου.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · código de recuperación\n\n%@\n\nÚsalo en \"Ya lo usé en otro dispositivo\" para recuperar tus datos.\n"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · کد بازیابی\n\n%@\n\nبرای بازگرداندن داده‌هایتان، از آن در «در دستگاه دیگری از آن استفاده کرده‌ام» استفاده کنید.\n"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · recovery code\n\n%@\n\nGamitin ito sa \"Nagamit ko na ito sa ibang device\" para maibalik ang data mo.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · code de récupération\n\n%@\n\nUtilise-le dans « Je l’ai utilisé sur un autre appareil » pour retrouver tes données.\n"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · קוד שחזור\n\n%@\n\nאפשר להשתמש בו ב-\"השתמשתי בה במכשיר אחר\" כדי להחזיר את הנתונים שלך.\n"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · रिकवरी कोड\n\n%@\n\nअपना डेटा वापस लाने के लिए इसे “मैंने इसे किसी दूसरे डिवाइस पर इस्तेमाल किया है” में डालें।\n"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kod za oporavak\n\n%@\n\nUnesi ga pod „Već ga koristim na drugom uređaju“ da vratiš svoje podatke.\n"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · helyreállító kód\n\n%@\n\nHasználd a „Már használtam egy másik eszközön” lehetőségnél, hogy visszakapd az adataidat.\n"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kode pemulihan\n\n%@\n\nPakai di “Sudah kupakai di perangkat lain” untuk mengembalikan datamu.\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · codice di recupero\n\n%@\n\nUsalo in «L’ho usata su un altro dispositivo» per recuperare i tuoi dati.\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · 復元コード\n\n%@\n\n「別のデバイスで使用しました」で入力すると、データを復元できます。\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · 복구 코드\n\n%@\n\n“다른 기기에서 사용했어요”에 입력하면 데이터를 되찾을 수 있어요.\n"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kod pemulihan\n\n%@\n\nGunakannya di \"Saya pernah menggunakannya pada peranti lain\" untuk mendapatkan semula data anda.\n"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · herstelcode\n\n%@\n\nGebruik hem bij “Ik heb hem op een ander apparaat gebruikt” om je gegevens terug te halen.\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kod odzyskiwania\n\n%@\n\nUżyj go w „Mam aplikację na innym urządzeniu”, aby odzyskać swoje dane.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bora Rachar · código de recuperação\n\n%@\n\nUse em \"Já usei em outro aparelho\" para trazer seus dados.\n"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · código de recuperação\n\n%@\n\nUsa em \"Já usei noutro aparelho\" para trazer os teus dados.\n"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · cod de recuperare\n\n%@\n\nFolosește-l în „Am folosit aplicația pe alt dispozitiv” ca să-ți recuperezi datele.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · код восстановления\n\n%@\n\nВведи его в «Я уже пользовался(-ась) на другом устройстве», чтобы вернуть свои данные.\n"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kód na obnovenie\n\n%@\n\nPoužij ho v „Už som ho použil(a) na inom zariadení“ a získaj späť svoje údaje.\n"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kod za oporavak\n\n%@\n\nUnesi ga u „Koristio/la sam ga na drugom uređaju“ da vratiš svoje podatke.\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · återställningskod\n\n%@\n\nAnvänd den i ”Jag har använt den på en annan enhet” för att få tillbaka dina data.\n"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · மீட்புக் குறியீடு\n\n%@\n\nஉங்கள் தரவைத் திரும்பப் பெற, \"இதை வேறொரு சாதனத்தில் பயன்படுத்தியுள்ளேன்\" என்பதில் இதைப் பயன்படுத்துங்கள்.\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · รหัสกู้คืน\n\n%@\n\nใช้รหัสนี้ใน \"ฉันเคยใช้บนอุปกรณ์อื่นแล้ว\" เพื่อนำข้อมูลของคุณกลับมา\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · kurtarma kodu\n\n%@\n\nVerilerini geri getirmek için “Başka bir cihazda kullandım” seçeneğinde kullan.\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · код відновлення\n\n%@\n\nВикористай його в «Я користувався(-лася) ним на іншому пристрої», щоб повернути свої дані.\n"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · ریکوری کوڈ\n\n%@\n\nاپنا ڈیٹا واپس لانے کے لیے اسے “میں نے اسے کسی دوسری ڈیوائس پر استعمال کیا ہے” میں استعمال کریں۔\n"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · mã khôi phục\n\n%@\n\nNhập mã vào “Tôi đã dùng trên thiết bị khác” để lấy lại dữ liệu của bạn.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · 恢复码\n\n%@\n\n在“我在其他设备上用过”中使用它即可找回你的数据。\n"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blitz Split · 復原碼\n\n%@\n\n在「我在其他裝置上用過」中使用它即可找回你的資料。\n"
          }
        }
      }
    },
