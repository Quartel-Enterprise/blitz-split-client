    "We kept the link. As soon as the device connects, the invite opens by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben den Link behalten. Sobald das Gerät verbunden ist, öffnet sich die Einladung von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos el enlace. En cuanto el dispositivo se conecte, la invitación se abre sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a gardé le lien. Dès que l’appareil se connecte, l’invitation s’ouvre toute seule."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautannya kami simpan. Begitu perangkat terhubung, undangan akan terbuka sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo conservato il link. Appena il dispositivo si connette, l’invito si apre da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクは保持しています。デバイスが接続されると、招待が自動で開きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben de link bewaard. Zodra het apparaat verbinding heeft, opent de uitnodiging vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaliśmy link. Gdy tylko urządzenie połączy się z siecią, zaproszenie otworzy się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos o link. Assim que o aparelho conectar, o convite abre sozinho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı sakladık. Cihaz bağlanır bağlanmaz davet kendiliğinden açılır."
          }
        }
      }
    },
    "What do your friends call you?" : {
      "localizations" : {
