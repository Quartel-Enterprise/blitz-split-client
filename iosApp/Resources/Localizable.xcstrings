    "Apple or Google only keep you from losing anything when you switch devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple أو Google يضمنان فقط ألا تفقد شيئًا عند تغيير الأجهزة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple или Google само те пазят да не загубиш нищо, когато смениш устройството."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple বা Google শুধু ডিভাইস বদলানোর সময় কিছু হারানো থেকে আপনাকে বাঁচায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple o Google només serveixen perquè no perdis res quan canviïs de dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple nebo Google jen zajistí, že při změně zařízení o nic nepřijdeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple eller Google sørger kun for, at du ikke mister noget, når du skifter enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple oder Google sorgen nur dafür, dass du beim Gerätewechsel nichts verlierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Apple ή το Google απλώς σε προστατεύουν από απώλεια δεδομένων όταν αλλάζεις συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple o Google solo sirven para no perder nada al cambiar de dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple või Google hoiavad ainult ära, et sa seadet vahetades midagi ei kaotaks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple یا Google فقط باعث می‌شوند هنگام تعویض دستگاه چیزی از دست ندهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple tai Google vain varmistavat, ettet menetä mitään, kun vaihdat laitetta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Apple o Google ay para lang hindi ka mawalan ng anuman kapag nagpalit ka ng device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ou Google servent seulement à ne rien perdre quand tu changes d’appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple અથવા Google ફક્ત એટલું જ કરે છે કે તમે ડિવાઇસ બદલો ત્યારે કંઈ ગુમાવો નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple או Google רק מבטיחים ששום דבר לא יאבד בהחלפת מכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple या Google सिर्फ़ इसलिए हैं कि डिवाइस बदलते समय आपका कुछ न खोए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ili Google samo te štite od gubitka podataka kad promijeniš uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple vagy a Google csak azt biztosítja, hogy eszközváltáskor ne veszíts el semmit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple atau Google hanya menjaga agar tidak ada yang hilang saat kamu ganti perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple o Google servono solo a non perdere nulla quando cambi dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleやGoogleは、デバイスを買い替えたときに何も失わないようにするためだけのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 또는 Google 계정은 기기를 바꿀 때 아무것도 잃지 않게 해 줄 뿐이에요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Apple“ arba „Google“ tik apsaugo, kad nieko neprarastum keisdamas (-a) įrenginį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple vai Google tikai pasargā tevi no datu zaudēšanas, kad maini ierīci."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple किंवा Google चा उपयोग फक्त एवढाच: डिव्हाइस बदलताना तुमचे काहीही हरवत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple atau Google hanya memastikan anda tidak kehilangan apa-apa apabila menukar peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple eller Google sørger bare for at du ikke mister noe når du bytter enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple of Google zorgen er alleen voor dat je niets kwijtraakt als je van apparaat wisselt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lub Google tylko chronią przed utratą danych przy zmianie urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ou Google só servem para não perder nada ao trocar de aparelho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ou Google só servem para não perderes nada ao mudar de aparelho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sau Google te ajută doar să nu pierzi nimic când schimbi dispozitivul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple или Google просто не дают ничего потерять при смене устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple alebo Google len zabránia tomu, aby si niečo stratil(a), keď zmeníš zariadenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ali Google samo poskrbita, da ob menjavi naprave ne izgubiš ničesar."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ili Google nalog samo sprečava da išta izgubiš kad promeniš uređaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple eller Google ser bara till att du inte förlorar något när du byter enhet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple au Google zinakusaidia tu usipoteze chochote unapobadilisha kifaa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சாதனத்தை மாற்றும்போது எதையும் இழக்காமல் இருக்க மட்டுமே Apple அல்லது Google உதவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పరికరం మారినప్పుడు ఏదీ కోల్పోకుండా Apple లేదా Google మాత్రమే కాపాడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple หรือ Google แค่ช่วยไม่ให้คุณทำอะไรหายเมื่อเปลี่ยนอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple veya Google yalnızca cihaz değiştirdiğinde hiçbir şey kaybetmemeni sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple чи Google лише гарантують, що ти нічого не втратиш, коли зміниш пристрій."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple یا Google بس اس لیے ہیں کہ ڈیوائس بدلتے وقت آپ کچھ نہ کھوئیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hoặc Google chỉ giúp bạn không mất gì khi đổi thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple或Google只是为了让你在更换设备时不丢失任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple或Google只是為了讓你在更換裝置時不遺失任何內容。"
          }
        }
      }
    },
