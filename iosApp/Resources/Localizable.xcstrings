        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーブルにいるうちに支出を追加できます。オフラインでも大丈夫。オンラインに戻ると同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 식사 자리에 있을 때 지출을 추가하세요. 오프라인에서도 돼요. 다시 온라인이 되면 동기화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de uitgave toe terwijl je nog aan tafel zit, zelfs offline. Hij synchroniseert zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj wydatek, jeszcze siedząc przy stole, nawet offline. Zsynchronizuje się, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance a conta ainda na mesa, mesmo sem internet. Sincroniza quando a internet voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista a conta ainda à mesa, mesmo sem internet. Sincroniza quando a internet voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь счёт, пока ещё сидишь за столом, даже офлайн. Он синхронизируется, когда снова будет интернет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamayı daha masadayken ekle, çevrimdışı bile. Tekrar çevrimiçi olunca eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай рахунок, поки ще сидиш за столом, навіть офлайн. Він синхронізується, щойно ти знову будеш онлайн."
          }
        }
      }
    },
