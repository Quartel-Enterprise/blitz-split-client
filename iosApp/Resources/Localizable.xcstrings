    "“%@” already picks %@. Each term has one category." : {
      "comment" : "New term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» يختار بالفعل %@. لكل مصطلح فئة واحدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ вече избира %@. Всеки термин има една категория."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” আগে থেকেই এই ক্যাটাগরিতে আছে: %@। প্রতিটি শব্দের একটিই ক্যাটাগরি থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ja té assignada la categoria %@. Cada terme té una sola categoria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výraz „%@“ už patří do kategorie %@. Každý výraz má jednu kategorii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« vælger allerede %@. Hvert ord har én kategori."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wählt schon %2$@. Jeder Begriff hat eine Kategorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο όρος «%@» επιλέγει ήδη την κατηγορία %@. Κάθε όρος έχει μία κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ya elige %2$@. Cada término tiene una sola categoría."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ valib juba kategooria %@. Igal terminil on üks kategooria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» از قبل %@ را انتخاب می‌کند. هر واژه یک دسته‌بندی دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” valitsee jo luokan %@. Jokaisella termillä on yksi luokka."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinipili na ng “%@” ang %@. Isang kategorya lang ang bawat termino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » choisit déjà %2$@. Chaque terme a une seule catégorie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” પહેલેથી %@ પસંદ કરે છે. દરેક શબ્દની એક જ કેટેગરી હોય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" כבר משויך ל-%2$@. לכל מונח יש קטגוריה אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” पहले से %@ चुनता है। हर शब्द की एक ही श्रेणी होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ već bira kategoriju %@. Svaki pojam ima jednu kategoriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” már ezt választja: %@. Minden kifejezéshez egy kategória tartozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sudah memilih %@. Setiap istilah punya satu kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sceglie già %@. Ogni termine ha una sola categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでに%@に設定されています。各キーワードのカテゴリは1つです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 키워드는 이미 ‘%@’ 카테고리에 연결되어 있어요. 키워드마다 카테고리는 하나예요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ jau priskirta kategorijai %@. Kiekvienas žodis turi vieną kategoriją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” jau norāda uz kategoriju %@. Katram atslēgvārdam ir viena kategorija."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” हा शब्द आधीच या कॅटेगरीत आहे: %2$@. प्रत्येक शब्दाची एकच कॅटेगरी असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sudah memilih %@. Setiap istilah mempunyai satu kategori."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» velger allerede %@. Hvert begrep har én kategori."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” valt al onder %@. Elke term heeft één categorie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” już wybiera kategorię %2$@. Każde słowo ma jedną kategorię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” já escolhe %2$@. Cada termo tem uma categoria só."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” alege deja %@. Fiecare termen are o singură categorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже выбирает «%@». У каждого слова одна категория."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ už patrí do kategórie %@. Každý výraz má jednu kategóriu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ že izbere kategorijo %@. Vsak izraz ima eno kategorijo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ već bira %@. Svaki pojam ima jednu kategoriju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” väljer redan %@. Varje term har en kategori."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tayari inachagua %@. Kila neno lina aina moja."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ஏற்கெனவே இந்த வகையைத் தேர்ந்தெடுக்கிறது: %2$@. ஒவ்வொரு சொல்லுக்கும் ஒரே ஒரு வகை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ఇప్పటికే ఈ కేటగిరీని ఎంచుకుంటుంది: %2$@. ప్రతి పదానికి ఒకే కేటగిరీ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” เลือก %@ อยู่แล้ว แต่ละคำมีได้หมวดหมู่เดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” zaten şunu seçiyor: %@. Her terimin tek bir kategorisi olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже обирає %@. Кожен термін має одну категорію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” پہلے سے %@ میں جاتا ہے۔ ہر لفظ کی صرف ایک کیٹیگری ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đã thuộc danh mục %@. Mỗi từ khóa chỉ có một danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已对应%@。每个关键词只能对应一个类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已對應%@。每個關鍵字只能對應一個類別。"
          }
        }
      }
    },
    "“%@” can only be deleted once everyone has settled up." : {
      "comment" : "Why the group can't be deleted yet; %@ is the group's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حذف «%@» إلا بعد تسوية الجميع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групата „%@“ може да бъде изтрита само след като всички уредят сметките си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবার হিসাব মেটানোর পরেই “%@” মুছে ফেলা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» només es pot suprimir quan tothom hagi liquidat comptes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupinu „%@“ jde smazat, až se všichni vyrovnají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« kan først slettes, når alle har gjort op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann erst gelöscht werden, wenn alle beglichen haben."
          }
        },
        "el" : {
