    "When someone owes, just pick here who paid." : {
      "comment" : "Who paid whom?: no open pair",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand etwas schuldet, wähl hier einfach, wer bezahlt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien deba, solo elige aquí quién pagó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu’un doit, choisis simplement ici qui a payé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ada yang berutang, cukup pilih di sini siapa yang bayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando qualcuno deve, scegli qui chi ha pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かに未精算があれば、ここで支払った人を選ぶだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 줄 돈이 생기면 여기서 누가 냈는지 고르기만 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als iemand iets schuldig is, kies je hier wie heeft betaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ktoś ma coś do oddania, wybierz tu, kto zapłacił."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando alguém dever, é só escolher aqui quem pagou."
          }
        },
        "ru" : {
