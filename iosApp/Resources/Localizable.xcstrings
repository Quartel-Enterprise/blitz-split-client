    "Offline: the category can already be used on this %@ and reaches the group once back online." : {
      "comment" : "New category offline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون اتصال: يمكن استخدام الفئة على %@ هذا بالفعل، وتصل إلى المجموعة عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн: категорията вече може да се използва на този %@ и стига до групата, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফলাইন: ক্যাটাগরিটি এই %@ ডিভাইসে এখনই ব্যবহার করা যাবে এবং আবার অনলাইনে এলে গ্রুপে পৌঁছে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: kategorii už můžeš používat na zařízení %@ a do skupiny se dostane, až budeš zase online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: Die Kategorie lässt sich auf diesem %@ schon nutzen und erreicht die Gruppe, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός σύνδεσης: η κατηγορία μπορεί ήδη να χρησιμοποιηθεί σε αυτό το %@ και θα φτάσει στην ομάδα μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión: la categoría ya se puede usar en este %@ y llega al grupo cuando vuelva internet."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفلاین: دسته‌بندی از همین حالا روی این %@ قابل استفاده است و وقتی دوباره آنلاین شوید به گروه می‌رسد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: magagamit na ang kategorya sa %@ na ito at makakarating sa grupo pagbalik mo online."
          }
