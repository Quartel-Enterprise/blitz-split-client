        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién ve tu perfil"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem vê seu perfil"
          }
        }
      }
    },
    "Who's in" : {
      "comment" : "Header of the new group's members",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién participa"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem participa"
          }
        }
      }
    },
    "Whoever is left at %@ is out of the bill." : {
      "comment" : "Hint of the split by amount; %@ is zero in the currency",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se queda con %@ sale del gasto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem fica com %@ sai da conta."
          }
        }
      }
    },
    "Whoever joined as %@ leaves the group. %@'s name, color and bills stay, and %@ can be picked again through the group's link." : {
      "comment" : "The same member's name, three times",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se unió como %1$@ sale del grupo. El nombre, el color y los gastos de %2$@ se quedan, y se puede elegir a %3$@ de nuevo con el enlace del grupo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem entrou como %1$@ sai do grupo. O nome, a cor e as contas de %2$@ ficam, e dá para escolher %3$@ de novo pelo link do grupo."
          }
        }
      }
    },
    "Whoever opens the link joins the group. No account needed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra el enlace se une al grupo. No hace falta una cuenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link entra no grupo. Não precisa criar conta."
          }
        }
      }
    },
    "Whoever opens the link picks who they are on the list: %@. No account needed." : {
      "comment" : "%@ is the names of the members who haven't joined, in bold: \"Ana, Bruno or Carla\"",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra el enlace elige quién es en la lista: %@. No hace falta una cuenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link escolhe quem é na lista: %@. Não precisa criar conta."
          }
        }
      }
    },
    "Whoever opens this link joins straight in as %@, without picking from the list. It works once." : {
      "comment" : "Explains a member's personal invite link; %@ is the member",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra este enlace entra directo como %@, sin elegir de la lista. Funciona una sola vez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir este link entra direto como %@, sem escolher na lista. Ele vale uma vez."
          }
        }
      }
    },
    "Whoever owes you sees your default key when settling up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien te deba ve tu clave predeterminada al saldar cuentas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem te deve vê a chave padrão na hora do acerto."
          }
        }
      }
    },
    "Whoever pays you sees this key when settling up. Which type of key?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve esta clave al saldar cuentas. ¿Qué tipo de clave?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem for te pagar vê esta chave no acerto. Qual tipo de chave?"
          }
        }
      }
    },
    "Whoever pays you sees your full CPF. If you'd rather not share it, use a phone, email or random key." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa celular, correo o clave aleatoria."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vaya a pagarte ve tu CPF completo. Si prefieres no exponerlo, usa móvil, correo o clave aleatoria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem for te pagar vê o CPF completo. Se preferir não expor, use celular, e-mail ou chave aleatória."
          }
        }
      }
    },
    "Whole numbers only. The leftover cents go to whoever paid." : {
      "comment" : "Hint of the split by percentage",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo números enteros. Los centavos que sobran se quedan con quien pagó."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só números inteiros. Os centavos que sobram ficam com quem pagou."
          }
        }
      }
    },
    "Works offline" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona sin internet"
