    "%@ turned it on after you. The last change counts: Simplify debts is on." : {
      "comment" : "Simplify debts: someone changed it after this device; %@ is who",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: التفعيل بعدك. آخر تغيير هو المعتمد: «تبسيط الديون» مفعّل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ го включи след теб. Важи последната промяна: Опростяване на дълговете е включено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ আপনার পরে এটি চালু করেছেন। শেষ পরিবর্তনটিই গণ্য: “দেনা সহজ করুন” চালু আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to po tobě zapnul(a). Platí poslední změna: Zjednodušit dluhy je zapnuto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat es nach dir eingeschaltet. Die letzte Änderung zählt: „Schulden vereinfachen“ ist an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ την ενεργοποίησε μετά από σένα. Ισχύει η τελευταία αλλαγή: η Απλοποίηση χρεών είναι ενεργή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo activó después de ti. Vale el último cambio: Simplificar deudas está activado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پس از شما آن را روشن کرد. آخرین تغییر ملاک است: ساده‌سازی بدهی‌ها روشن است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-on ito ni %@ pagkatapos mo. Ang huling pagbabago ang masusunod: naka-on ang Pasimplehin ang utang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’a activé après toi. Le dernier changement compte : Simplifier les dettes est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: הפעלה אחריך. השינוי האחרון קובע: פישוט חובות פעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने आपके बाद इसे चालू किया। आखिरी बदलाव ही मान्य है: “कर्ज़ सरल करें” चालू है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ga je uključio/la nakon tebe. Vrijedi zadnja promjena: Pojednostavi dugove je uključeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bekapcsolta utánad. Az utolsó módosítás számít: az Adósságok egyszerűsítése be van kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengaktifkannya setelah kamu. Perubahan terakhir yang berlaku: Sederhanakan utang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’ha attivato dopo di te. Vale l’ultima modifica: Semplifica debiti è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの後に%@がオンにしました。最後の変更が優先されます：精算をシンプルにはオンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 나보다 나중에 켰어요. 마지막 변경이 적용돼요: 정산 간소화가 켜져 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghidupkannya selepas anda. Perubahan terakhir yang dikira: Permudahkan hutang dihidupkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft het na jou aangezet. De laatste wijziging telt: Schulden vereenvoudigen staat aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ włączył(a) to po tobie. Liczy się ostatnia zmiana: „Uprość długi” jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligou depois de você. Vale a última mudança: Simplificar dívidas está ligado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligou depois de ti. Vale a última alteração: Simplificar dívidas está ligado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a activat-o după tine. Contează ultima modificare: Simplifică datoriile e activată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ включил(а) его после тебя. Действует последнее изменение: упрощение долгов включено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to aktivoval(a) po tebe. Platí posledná zmena: Zjednodušiť dlhy je zapnuté."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ga je uključio/la posle tebe. Važi poslednja izmena: Pojednostavi dugove je uključeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slog på det efter dig. Den senaste ändringen gäller: Förenkla skulder är på."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ உங்களுக்குப் பிறகு இதை இயக்கினார். கடைசி மாற்றமே செல்லும்: கடன்களை எளிதாக்கு இயக்கத்தில் உள்ளது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เปิดหลังจากคุณ การเปลี่ยนแปลงล่าสุดจะถูกใช้: ลดความซับซ้อนของหนี้เปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ senden sonra açtı. Son değişiklik geçerli: Borçları sadeleştir açık."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ увімкнув(-ла) це після тебе. Діє остання зміна: «Спростити борги» увімкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے آپ کے بعد اسے آن کیا۔ آخری تبدیلی شمار ہوتی ہے: قرض آسان کریں آن ہے۔"
