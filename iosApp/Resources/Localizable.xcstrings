          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprla se bo trgovina App Store, kjer namestiš novo različico."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoriće se App Store da instaliraš novu verziju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skickas till App Store för att installera den nya versionen."
