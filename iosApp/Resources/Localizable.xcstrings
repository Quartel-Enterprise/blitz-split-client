        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون حساب کاربری، برنامه در iPhone خالی شروع می‌شود. برای بردن گروه‌هایتان، یک حساب Apple یا Google را در تنظیمات متصل کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
