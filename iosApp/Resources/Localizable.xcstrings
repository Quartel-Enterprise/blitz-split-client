    "It leaves the bill for everyone. Its replies stay." : {
      "comment" : "The message of Delete comment?",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُزال من الفاتورة للجميع. تبقى الردود عليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изчезва от разхода за всички. Отговорите към него остават."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সবার জন্য বিল থেকে সরে যাবে। এর উত্তরগুলো থেকে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’elimina de la despesa per a tothom. Les respostes es queden."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmizí z výdaje pro všechny. Odpovědi na něj zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinder fra udgiften for alle. Svarene bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verschwindet für alle aus der Ausgabe. Die Antworten bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρείται από το έξοδο για όλους. Οι απαντήσεις του παραμένουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece del gasto para todos. Las respuestas se quedan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
