    "When someone owes, just pick here who paid." : {
      "comment" : "Who paid whom?: no open pair",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون على أحد دين، اختر هنا فقط من دفع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато някой дължи, просто избери тук кой плати."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কারও দেনা থাকলে এখানে শুধু বেছে নিন কে পরিশোধ করেছেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když někdo dluží, stačí tady vybrat, kdo platil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand etwas schuldet, wähl hier einfach, wer bezahlt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν κάποιος χρωστάει, απλώς διάλεξε εδώ ποιος πλήρωσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien deba, solo elige aquí quién pagó."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کسی بدهکار است، فقط اینجا انتخاب کنید چه کسی پرداخت کرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag may may utang, piliin lang dito kung sino ang nagbayad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu’un doit, choisis simplement ici qui a payé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשיש חוב, פשוט בוחרים כאן מי שילם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब किसी पर बकाया हो, तो बस यहां चुनें कि किसने भुगतान किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad netko duguje, ovdje samo odaberi tko je platio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha valaki tartozik, itt csak válaszd ki, ki fizetett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ada yang berutang, cukup pilih di sini siapa yang bayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando qualcuno deve, scegli qui chi ha pagato."
          }
        },
        "ja" : {
