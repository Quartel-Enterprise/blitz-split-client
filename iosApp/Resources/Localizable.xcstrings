        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot ce ține de %@ (cheltuieli, plăți și soldul de %@) trece în contul tău, în toate grupurile, iar invitatul dispare. Acțiunea nu poate fi anulată."
