          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noklusējums atrodas sadaļā Rediģēt grupu › Noklusējuma sadalījums. Jau pievienotie rēķini nemainās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डीफॉल्ट वाटणी ग्रुप संपादित करा › डीफॉल्ट वाटणी येथे आहे. आधी जोडलेले खर्च बदलत नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapan lalai ada di Edit kumpulan › Pembahagian lalai. Bil yang sudah ditambah tidak berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standarden finnes i Rediger gruppe › Standarddeling. Utgifter som allerede er lagt til, endres ikke."
