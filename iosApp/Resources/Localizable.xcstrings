    "Couldn't leave the group. Check your connection and try again." : {
      "comment" : "Leaving the group failed: no sync or no answer from the server",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت مغادرة المجموعة. تحقّق من الاتصال وأعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групата не можа да се напусне. Провери връзката си и опитай отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপ ছাড়া যায়নি। আপনার সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupinu se nepodařilo opustit. Zkontroluj připojení a zkus to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppe konnte nicht verlassen werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποχώρηση από την ομάδα. Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo salir del grupo. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترک گروه انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakaalis sa grupo. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de quitter le groupe. Vérifie ta connexion et réessaie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לצאת מהקבוצה. כדאי לבדוק את החיבור ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप नहीं छोड़ा जा सका। अपना कनेक्शन जांचें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napuštanje grupe nije uspjelo. Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült kilépni a csoportból. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal keluar dari grup. Periksa koneksimu dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile lasciare il gruppo. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループから退出できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹에서 나가지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat meninggalkan kumpulan. Semak sambungan internet anda dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de groep niet verlaten. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się opuścić grupy. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu para sair do grupo. Confira a conexão e tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível sair do grupo. Verifica a ligação e tenta de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut părăsi grupul. Verifică conexiunea și reîncearcă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выйти из группы. Проверь подключение и попробуй ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupinu sa nepodarilo opustiť. Skontroluj pripojenie a skús znova."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije uspelo napuštanje grupe. Proveri vezu i pokušaj ponovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att lämna gruppen. Kontrollera anslutningen och försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "குழுவிலிருந்து வெளியேற முடியவில்லை. உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயலுங்கள்."
