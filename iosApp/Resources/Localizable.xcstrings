        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois de toda a gente acertar. Nada ficou pendente, e o grupo sai da tua lista."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a șters „%@” după ce toți au achitat datoriile. Nu a rămas nimic deschis, iar grupul dispare din lista ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ удалил(а) «%@» после того, как все рассчитались. Ничего не осталось открытым, и группа уходит из твоего списка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ odstránil(a) „%@“, keď sa všetci vyrovnali. Nič nezostalo otvorené a skupina zmizne z tvojho zoznamu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je izbrisal(a) „%@“, ko so vsi poravnali. Nič ni ostalo odprto in skupina izgine s tvojega seznama."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je obrisao/la „%@“ nakon što su se svi izmirili. Ništa nije ostalo otvoreno, a grupa nestaje sa tvoje liste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ raderade ”%@” efter att alla gjort upp. Inget var öppet, och gruppen försvinner från din lista."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ amefuta “%@” baada ya madeni yote kulipwa. Hakuna kilichobaki wazi, na kikundi kinaondoka kwenye orodha yako."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ அனைவருக்கும் கணக்கு தீர்ந்த பிறகு குழுவை நீக்கினார்: “%@”. எதுவும் நிலுவையில் இல்லை, குழு உங்கள் பட்டியலிலிருந்து நீங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అందరి లెక్క సెటిల్ అయిన తర్వాత %@ “%@” గ్రూప్‌ను తొలగించారు. ఏదీ బాకీ లేదు, గ్రూప్ మీ జాబితా నుండి తొలగిపోతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ลบ “%2$@” หลังจากทุกคนเคลียร์ยอดแล้ว ไม่มียอดค้าง และกลุ่มจะหายไปจากรายการของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, herkes hesaplaştıktan sonra “%@” grubunu sildi. Açık bir şey kalmadı ve grup listenden çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ видалив(-ла) «%@» після того, як усі розрахувалися. Нічого не залишилося відкритим, і група зникає з твого списку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے سب کا حساب برابر ہونے کے بعد “%@” حذف کر دیا۔ کچھ بھی باقی نہیں تھا، اور گروپ آپ کی فہرست سے ہٹ جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã xóa “%@” sau khi mọi người thanh toán xong. Không còn gì chưa trả, và nhóm sẽ rời khỏi danh sách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人结清后，%@删除了“%@”。没有未结清的款项，群组将从你的列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人結清後，%@刪除了「%@」。沒有未結清的款項，群組將從你的清單中移除。"
          }
        }
      }
