        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử lại với nhiều ánh sáng hơn và chụp trọn hóa đơn, hoặc tự nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
