    "Whoever owed %@ in the group still owes %@. Only where the money goes changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من كان عليه %@ في المجموعة يبقى عليه %@. يتغير فقط إلى أين يذهب المال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Който е дължал %@ в групата, пак дължи %@. Променя се само накъде отиват парите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপে যিনি %@ দিতেন তিনি এখনও %@ দেবেন। শুধু টাকা কোথায় যাবে তা বদলায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui devia %@ al grup encara deu %@. Només canvia cap a on van els diners."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo ve skupině dlužil %@, dluží pořád %@. Mění se jen to, kam peníze jdou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der skyldte %@ i gruppen, skylder stadig %@. Kun hvor pengene går hen, ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Gruppe %1$@ geschuldet hat, schuldet weiterhin %2$@. Nur wohin das Geld geht, ändert sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος χρωστούσε %@ στην ομάδα εξακολουθεί να χρωστάει %@. Αλλάζει μόνο πού πάνε τα χρήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien debía %1$@ en el grupo sigue debiendo %2$@. Solo cambia a quién va el dinero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kes võlgnes grupis %@, võlgneb endiselt %@. Muutub ainult see, kuhu raha liigub."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی در گروه %@ بدهکار بود، همچنان %@ بدهکار است. فقط مسیر پول تغییر می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, joka oli ryhmässä velkaa %@, on edelleen velkaa %@. Vain rahan kulkureitti muuttuu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang may utang na %@ sa grupo ay may utang pa rin na %@. Ang pinupuntahan lang ng pera ang nagbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
