            "value" : "אפשר להפעיל אותן בהגדרות המערכת כדי לדעת מתי מישהו מוסיף חשבון איתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई आपके साथ खर्च जोड़े, यह जानने के लिए इन्हें सिस्टम सेटिंग में चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključi ih u Postavkama sustava da saznaš kad netko doda trošak s tobom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be őket a Rendszerbeállításokban, hogy tudd, ha valaki hozzáad egy számlát veled."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan di Pengaturan Sistem agar tahu saat seseorang menambahkan tagihan bersamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivale nelle Impostazioni di Sistema per sapere quando qualcuno aggiunge una spesa con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがあなたを含む支出を追加したときに知るには、システム設定でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 나와 함께 지출을 추가하면 알 수 있도록 시스템 설정에서 알림을 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įjunk juos sistemos nustatymuose, kad žinotum, kai kas nors prideda išlaidą su tavimi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieslēdz tos sistēmas iestatījumos, lai uzzinātu, kad kāds pievieno rēķinu ar tevi."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोणी तुमच्यासोबत खर्च जोडल्यावर कळण्यासाठी System Settings मध्ये त्या चालू करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidupkan dalam Tetapan Sistem untuk mengetahui apabila seseorang menambah bil bersama anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dem på i Systeminnstillinger for å få vite når noen legger til en utgift sammen med deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ze aan in Systeeminstellingen om te weten wanneer iemand een uitgave met je toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz je w Ustawieniach systemowych, aby wiedzieć, gdy ktoś doda wydatek z twoim udziałem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative nos Ajustes do Sistema para saber quando alguém adicionar uma conta com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
