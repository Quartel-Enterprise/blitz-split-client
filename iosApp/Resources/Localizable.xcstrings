    "Allow the camera to scan the receipt, or choose a photo of it from Photos." : {
      "comment" : "Receipt camera: access refused",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff, um den Beleg zu scannen, oder wähl ein Foto davon aus Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la cámara para escanear el recibo, o elige una foto de él en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’appareil photo à scanner le reçu, ou choisis-en une photo dans Photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan kamera untuk memindai struk, atau pilih fotonya dari Foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la fotocamera per scansionare lo scontrino, o scegline una foto da Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートをスキャンするにはカメラを許可するか、写真からレシートの写真を選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef toegang tot de camera om het bonnetje te scannen, of kies een foto ervan in Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do aparatu, aby zeskanować paragon, albo wybierz jego zdjęcie ze Zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a câmera para ler o cupom, ou escolha uma foto dele nas fotos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fişi taramak için kameraya izin ver ya da Fotoğraflar'dan fişin fotoğrafını seç."
          }
        }
      }
    },
    "The camera isn't available. Choose a photo of the receipt from Photos." : {
      "comment" : "Receipt camera: no camera",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera ist nicht verfügbar. Wähl ein Foto des Belegs aus Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara no está disponible. Elige una foto del recibo en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo n’est pas disponible. Choisis une photo du reçu dans Photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera tidak tersedia. Pilih foto struk dari Foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera non è disponibile. Scegli una foto dello scontrino da Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラを使用できません。写真からレシートの写真を選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera is niet beschikbaar. Kies een foto van het bonnetje in Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat jest niedostępny. Wybierz zdjęcie paragonu ze Zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera não está disponível. Escolha uma foto do cupom nas fotos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera kullanılamıyor. Fotoğraflar'dan fişin fotoğrafını seç."
          }
        }
      }
    },
    "Frame the whole receipt. We fill in the amount, the date and the description; you check them before saving." : {
      "comment" : "Receipt camera",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm den ganzen Beleg ins Bild. Wir füllen Betrag, Datum und Beschreibung aus; du prüfst sie vor dem Speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra todo el recibo. Completamos el monto, la fecha y la descripción; tú los revisas antes de guardar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra todo el recibo. Completamos el importe, la fecha y la descripción; tú los revisas antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadre tout le reçu. On remplit le montant, la date et la description ; tu les vérifies avant d’enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan seluruh struk ke dalam bingkai. Kami isi nominal, tanggal, dan deskripsinya; kamu memeriksanya sebelum menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra lo scontrino intero. Compiliamo importo, data e descrizione; tu li controlli prima di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシート全体を枠に収めてください。金額、日付、内容を入力するので、保存前に確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het hele bonnetje in beeld. Wij vullen het bedrag, de datum en de omschrijving in; jij controleert ze voor het opslaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujmij cały paragon. Uzupełnimy kwotę, datę i opis; sprawdzisz je przed zapisaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquadre o cupom inteiro. A gente preenche o valor, a data e a descrição; você confere antes de salvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fişin tamamını kadraja al. Tutarı, tarihi ve açıklamayı biz doldururuz; kaydetmeden önce sen kontrol edersin."
          }
        }
      }
    },
    "The receipt reader didn't answer. It isn't your photo: try again in a moment, or fill it in by hand." : {
      "comment" : "Split a bill: the server's receipt reader didn't answer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Belegleser hat nicht geantwortet. Es liegt nicht an deinem Foto: Versuch es gleich noch mal, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lector de recibos no respondió. No es tu foto: inténtalo de nuevo en un momento o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur de reçus n’a pas répondu. Ce n’est pas ta photo : réessaie dans un instant, ou remplis à la main."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaca struk tidak merespons. Bukan karena fotomu: coba lagi sebentar lagi, atau isi manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lettore di scontrini non ha risposto. Non è colpa della tua foto: riprova tra un attimo, o compila a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートリーダーが応答しませんでした。写真の問題ではありません：少ししてからもう一度試すか、手動で入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bonnetjeslezer reageerde niet. Het ligt niet aan je foto: probeer het zo opnieuw, of vul het met de hand in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytnik paragonów nie odpowiedział. To nie wina twojego zdjęcia: spróbuj ponownie za chwilę albo wpisz dane ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O leitor de cupom não respondeu. Não é a sua foto: tente de novo daqui a pouco ou preencha à mão."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiş okuyucu yanıt vermedi. Sorun fotoğrafında değil: biraz sonra tekrar dene ya da elle doldur."
          }
        }
      }
    },
    "You've read 30 receipts in the last 24 hours. Fill it in by hand, or read it again tomorrow." : {
      "comment" : "Split a bill: the account reached the receipt reads of the day",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast in den letzten 24 Stunden 30 Belege gelesen. Füll es von Hand aus oder lies ihn morgen erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya escaneaste 30 recibos en las últimas 24 horas. Complétalo a mano o vuelve a escanear mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as lu 30 reçus ces dernières 24 heures. Remplis à la main, ou relis-le demain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sudah membaca 30 struk dalam 24 jam terakhir. Isi manual, atau baca lagi besok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai letto 30 scontrini nelle ultime 24 ore. Compila a mano, o leggilo di nuovo domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去24時間に30枚のレシートを読み取りました。手動で入力するか、明日もう一度読み取ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt in de afgelopen 24 uur 30 bonnetjes gelezen. Vul het met de hand in, of lees het morgen opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytano już 30 paragonów w ciągu ostatnich 24 godzin. Wpisz dane ręcznie lub odczytaj paragon jutro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já leu 30 cupons nas últimas 24 horas. Preencha à mão ou leia de novo amanhã."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 24 saatte 30 fiş okuttun. Elle doldur ya da yarın tekrar okut."
          }
        }
      }
    },
    "No connection. The photo didn't reach the reader: try again once you're back online, or fill it in by hand." : {
      "comment" : "Split a bill: the connection dropped while the receipt was read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung. Das Foto hat den Leser nicht erreicht: Versuch es erneut, wenn du wieder online bist, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. La foto no llegó al lector: inténtalo de nuevo cuando te reconectes, o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de connexion. La photo n’a pas atteint le lecteur : réessaie une fois de nouveau en ligne, ou remplis à la main."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada koneksi. Foto tidak sampai ke pembaca: coba lagi saat kamu online, atau isi manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione. La foto non è arrivata al lettore: riprova quando torni online, o compila a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続がありません。写真がリーダーに届きませんでした：オンラインに戻ってからもう一度試すか、手動で入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen verbinding. De foto heeft de lezer niet bereikt: probeer het opnieuw zodra je weer online bent, of vul het met de hand in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia. Zdjęcie nie dotarło do czytnika: spróbuj ponownie po powrocie do sieci albo wpisz dane ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conexão. A foto não chegou ao leitor: tente de novo quando reconectar, ou preencha à mão."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı yok. Fotoğraf okuyucuya ulaşmadı: internete dönünce tekrar dene ya da elle doldur."
          }
        }
      }
    },
