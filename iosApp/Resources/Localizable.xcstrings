    "You have %lld payments in the queue. The simplification counts them; if they change, the suggested payments adjust by themselves." : {
      "comment" : "Simplify debts: several payments recorded here and not up yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %lld Zahlungen in der Warteschlange. Die Vereinfachung berücksichtigt sie; ändern sie sich, passen sich die vorgeschlagenen Zahlungen von selbst an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld pagos en la cola. La simplificación los cuenta; si cambian, los pagos sugeridos se ajustan solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld paiements dans la file. La simplification les compte ; s’ils changent, les paiements suggérés s’ajustent tout seuls."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %lld pagamenti in coda. La semplificazione li conta; se cambiano, i pagamenti suggeriti si adattano da soli."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności w kolejce: %lld. Uproszczenie je uwzględnia; jeśli się zmienią, sugerowane płatności dostosują się same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %lld pagamentos na fila. A simplificação conta com eles; se mudarem, os pagamentos sugeridos se ajustam sozinhos."
          }
        }
      }
    },
