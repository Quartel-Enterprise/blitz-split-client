            "value" : "%@ stängde av Förenkla skulder nyss. Du är inte längre skyldig %@ något i %@."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ இப்போதுதான் கடன்களை எளிதாக்கு அம்சத்தை அணைத்தார். %3$@ குழுவில் நீங்கள் இனி இவருக்குத் தர வேண்டியதில்லை: %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เพิ่งปิดลดความซับซ้อนของหนี้ คุณไม่ได้ค้าง %@ ใน “%@” แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ az önce Borçları sadeleştir'i kapattı. %3$@ grubunda artık %2$@ kişisine borçlu değilsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ щойно вимкнув(-ла) «Спростити борги». Ти більше не винен(-на) учаснику %@ у групі %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ نے ابھی قرض آسان کریں بند کیا۔ اب %3$@ میں آپ نے %2$@ کو کچھ نہیں دینا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vừa tắt Đơn giản hóa nợ. Bạn không còn nợ %@ trong %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@刚刚关闭了简化债务。你在“%3$@”中不再欠%2$@了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@剛剛關閉了簡化債務。你在「%3$@」中不再欠%2$@了。"
          }
        }
      }
    },
