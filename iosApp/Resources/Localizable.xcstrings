          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem partilhar um grupo contigo aparece aqui, com o saldo de cada um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся все, с кем у тебя есть общая группа, с балансом каждого."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครที่อยู่ในกลุ่มเดียวกับคุณจะแสดงที่นี่ พร้อมยอดคงเหลือของแต่ละคน"
          }
