        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα και η φωτογραφία προέρχονται από τον λογαριασμό σου %@. Αν τα αλλάξεις εδώ, ισχύουν μόνο στο Blitz Split και δεν αλλάζουν τον λογαριασμό σου %@."
          }
        },
        "es" : {
          "stringUnit" : {
