        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskusi znova z več svetlobe in celotnim potrdilom na fotografiji ali pa ga izpolni ročno."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušaj ponovo uz više svetla i ceo fiskalni račun na fotografiji ili popuni ručno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök igen med mer ljus och hela kvittot på fotot, eller fyll i det för hand."
