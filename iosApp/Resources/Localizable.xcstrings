    "Remind members to settle up" : {
      "comment" : "Switch of the group's reminder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير الأعضاء بالتسوية"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напомняй на членовете да уредят сметките"
          }
