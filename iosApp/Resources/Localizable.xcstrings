    "The %lld bills with %@ move to %@. The category goes for all of %@." : {
      "comment" : "Delete category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$lld Ausgaben mit %2$@ wandern zu %3$@. Die Kategorie verschwindet für ganz %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %1$lld gastos con %2$@ pasan a %3$@. La categoría desaparece para todo el grupo %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$lld dépenses avec %2$@ passent dans %3$@. La catégorie vaut pour tout %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le %lld spese con %@ passano a %@. La categoria sparisce per tutto %@."
          }
        },
        "pl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld wydatek z kategorii %2$@ przechodzi do kategorii %3$@. Kategoria znika dla całej grupy %4$@."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld wydatki z kategorii %2$@ przechodzą do kategorii %3$@. Kategoria znika dla całej grupy %4$@."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld wydatków z kategorii %2$@ przechodzi do kategorii %3$@. Kategoria znika dla całej grupy %4$@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld wydatku z kategorii %2$@ przechodzi do kategorii %3$@. Kategoria znika dla całej grupy %4$@."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As %1$lld contas com %2$@ passam para %3$@. A categoria some para todo o %4$@."
          }
        }
      }
    },
    "The %lld terms you created stay." : {
