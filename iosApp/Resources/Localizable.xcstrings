        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savaitė, Mėnuo ir Metai rodomi ilgesniems nei savaitės laikotarpiams."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedēļa, Mēnesis un Gads parādās periodiem, kas garāki par nedēļu."
