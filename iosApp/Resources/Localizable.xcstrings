    "push.debts_simplified_to_you" : {
      "comment" : "Push notification: someone turned on Simplify debts and someone now pays you. 1: who, 2: the payer, 3: the amount",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Schulden vereinfacht. Jetzt zahlt dir %2$@ %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplified the debts. Now %2$@ pays you %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó las deudas. Ahora %2$@ te paga %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a simplifié les dettes. Maintenant %2$@ te paie %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menyederhanakan utang. Sekarang %2$@ membayarmu %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha semplificato i debiti. Ora %2$@ ti paga %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が精算をシンプルにしました。今後は%2$@があなたに%3$@を支払います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de schulden vereenvoudigd. Nu betaalt %2$@ je %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uprościł(a) długi. Teraz %2$@ płaci ci %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificou as dívidas. Agora %2$@ te paga %3$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ borçları sadeleştirdi. Artık %2$@ sana %3$@ ödüyor."
          }
        }
      }
    },
