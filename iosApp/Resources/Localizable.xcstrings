        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ обирає своє ім'я у списку або приєднується як новий учасник."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ فہرست میں اپنا نام منتخب کرے گا یا نئے ممبر کے طور پر شامل ہو گا۔"
