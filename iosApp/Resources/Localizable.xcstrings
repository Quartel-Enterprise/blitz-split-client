    "Single-use link. %@ joins and becomes themselves right away." : {
      "comment" : "Merging a guest: the single-use link",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابط للاستخدام مرة واحدة. عند الانضمام، يُربط %@ بالاسم نفسه فورًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линк за еднократна употреба. %@ се присъединява и веднага става себе си."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একবার ব্যবহারযোগ্য লিংক। %@ যোগ দিলেই সঙ্গে সঙ্গে নিজের নামের সদস্য হয়ে যাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorázový odkaz. %@ se připojí a hned převezme své místo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal-Link. %@ tritt bei und ist sofort als sich selbst dabei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύνδεσμος μίας χρήσης. Μπαίνει αμέσως ως %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlace de un solo uso. Cuando %@ entre, queda como su propia cuenta de inmediato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینک یک‌بار مصرف. %@ می‌پیوندد و بلافاصله خودش می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isang beses lang magagamit ang link. Sasali si %@ at agad na magiging sarili niya."
