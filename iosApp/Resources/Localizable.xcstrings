    "Whoever joined as %@ leaves the group. %@'s name, color and bills stay, and %@ can be picked again through the group's link." : {
      "comment" : "The same member's name, three times",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من انضم باسم %@ سيغادر المجموعة. تبقى بيانات %@ (الاسم واللون والفواتير)، ويمكن اختيار %@ مجددًا عبر رابط المجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присъединилият се като %@ напуска групата. Името, цветът и разходите на %@ остават и %@ може да бъде избран(а) отново чрез линка на групата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ হিসেবে যিনি যোগ দিয়েছেন তিনি গ্রুপ ছেড়ে যাবেন। সদস্য %@ নাম, রং ও বিলসহ থেকে যাবেন, এবং গ্রুপের লিংক দিয়ে %@-কে আবার বেছে নেওয়া যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo se připojil jako %@, opustí skupinu. Jméno, barva a výdaje osoby %@ zůstanou a %@ jde znovu vybrat přes odkaz skupiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer als %1$@ beigetreten ist, verlässt die Gruppe. Name, Farbe und Ausgaben von %2$@ bleiben, und %3$@ kann über den Link der Gruppe wieder gewählt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος μπήκε ως %@ φεύγει από την ομάδα. Το όνομα, το χρώμα και τα έξοδα του μέλους %@ μένουν, και το μέλος %@ μπορεί να επιλεγεί ξανά μέσω του συνδέσμου της ομάδας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se unió como %1$@ sale del grupo. El nombre, el color y los gastos de %2$@ se quedan, y se puede elegir a %3$@ de nuevo con el enlace del grupo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی که به عنوان %@ پیوسته بود گروه را ترک می‌کند. نام، رنگ و هزینه‌های %@ می‌مانند و %@ را می‌توان دوباره از طریق لینک گروه انتخاب کرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalis sa grupo ang sumali bilang %@. Mananatili ang pangalan, kulay at mga bill ni %@, at puwedeng piliin ulit si %@ gamit ang link ng grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne entrée comme %1$@ quitte le groupe. Le nom, la couleur et les dépenses de %2$@ restent, et %3$@ peut être choisi à nouveau via le lien du groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שהצטרף בתור %@ יוצא מהקבוצה. השם, הצבע והחשבונות של %@ נשארים, ואפשר לבחור שוב ב-%@ דרך הקישור של הקבוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो %@ के रूप में जुड़ा था, वह ग्रुप छोड़ देगा। %@ का नाम, रंग और खर्च बने रहेंगे, और ग्रुप के लिंक से %@ को फिर से चुना जा सकता है।"
