    "Tap a term to change its category or remove it. It matches the whole word, ignoring accents and case." : {
      "comment" : "Category map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على مصطلح لتغيير فئته أو إزالته. يطابق الكلمة كاملة، مع تجاهل التشكيل وحالة الأحرف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни термин, за да смениш категорията му или да го премахнеш. Съвпада с цялата дума, без значение от ударения и главни букви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যাটাগরি বদলাতে বা সরাতে কোনো শব্দে ট্যাপ করুন। এটি পুরো শব্দ মেলায়, অ্যাকসেন্ট ও বড়-ছোট হাতের অক্ষর উপেক্ষা করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un terme per canviar-ne la categoria o treure’l. Coincideix amb la paraula sencera, sense tenir en compte accents ni majúscules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na výraz změníš jeho kategorii nebo ho odebereš. Hledá celé slovo, bez ohledu na diakritiku a velikost písmen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et ord for at ændre dets kategori eller fjerne det. Det matcher hele ordet uden hensyn til accenter og store/små bogstaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Begriff, um seine Kategorie zu ändern oder ihn zu entfernen. Er passt auf das ganze Wort, Akzente und Groß-/Kleinschreibung egal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα έναν όρο για να αλλάξεις την κατηγορία του ή να τον αφαιρέσεις. Ταιριάζει με ολόκληρη τη λέξη, αγνοώντας τόνους και πεζά-κεφαλαία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un término para cambiar su categoría o quitarlo. Coincide con la palabra completa, sin importar acentos ni mayúsculas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta märksõna, et muuta selle kategooriat või see eemaldada. See sobitab terve sõna, arvestamata täpitähti ja suurtähti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک واژه بزنید تا دسته‌بندی آن را تغییر دهید یا حذفش کنید. با کل واژه مطابقت دارد، بدون توجه به اِعراب و حروف بزرگ و کوچک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta sanaa vaihtaaksesi sen luokan tai poistaaksesi sen. Se vastaa koko sanaa, aksenteista ja kirjainkoosta välittämättä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang termino para palitan ang kategorya nito o alisin ito. Tumutugma ito sa buong salita, hindi pinapansin ang accent at laki ng titik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche un terme pour changer sa catégorie ou le retirer. Il correspond au mot entier, sans tenir compte des accents ni de la casse."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શબ્દની કેટેગરી બદલવા કે તેને દૂર કરવા માટે તેના પર ટૅપ કરો. તે ઉચ્ચાર-ચિહ્નો અને કેપિટલ-સ્મોલ અક્ષરોને અવગણીને, આખો શબ્દ મેળવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להקיש על מונח כדי לשנות את הקטגוריה שלו או להסיר אותו. ההתאמה היא למילה שלמה, בלי תלות בסימנים דיאקריטיים או בגודל האותיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी शब्द की श्रेणी बदलने या उसे हटाने के लिए उस पर टैप करें। यह पूरे शब्द से मेल खाता है, मात्राओं और बड़े-छोटे अक्षरों को अनदेखा करते हुए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni pojam da mu promijeniš kategoriju ili ga ukloniš. Podudara se cijela riječ, bez obzira na dijakritičke znakove i velika slova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints egy kifejezésre a kategóriája módosításához vagy eltávolításához. Az egész szóra illeszkedik, az ékezeteket és a kis- és nagybetűket figyelmen kívül hagyva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk kata untuk mengubah kategorinya atau menghapusnya. Kata dicocokkan utuh, mengabaikan aksen dan huruf besar/kecil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un termine per cambiarne la categoria o rimuoverlo. Corrisponde alla parola intera, ignorando accenti e maiuscole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語をタップすると、カテゴリを変更したり削除したりできます。単語全体に一致し、アクセントや大文字・小文字は区別しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드를 탭해서 카테고리를 바꾸거나 삭제하세요. 단어 전체가 일치해야 하며, 악센트와 대소문자는 무시해요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paliesk raktažodį, kad pakeistum jo kategoriją arba jį pašalintum. Jis atitinka visą žodį, nepaisant kirčio ženklų ir raidžių dydžio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskaries vārdam, lai mainītu tā kategoriju vai to noņemtu. Tas atbilst visam vārdam, neņemot vērā diakritiskās zīmes un reģistru."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दाची कॅटेगरी बदलण्यासाठी किंवा तो काढून टाकण्यासाठी त्यावर टॅप करा. तो संपूर्ण शब्द जुळवतो, ॲक्सेंट आणि लहान-मोठी अक्षरे विचारात न घेता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik istilah untuk menukar kategorinya atau mengalih keluarnya. Ia memadankan keseluruhan perkataan, tanpa mengira aksen dan huruf besar atau kecil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på et ord for å endre kategorien eller fjerne det. Det treffer hele ordet, uavhengig av aksenter og store og små bokstaver."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een term om de categorie te wijzigen of hem te verwijderen. Hij komt overeen met het hele woord, ongeacht accenten en hoofdletters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij słowo, aby zmienić jego kategorię lub je usunąć. Dopasowuje całe słowo, bez względu na akcenty i wielkość liter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num termo para mudar a categoria ou remover. Casa com a palavra inteira, sem ligar para acento ou maiúscula."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num termo para alterar a categoria ou remover. Corresponde à palavra inteira, sem distinguir acentos nem maiúsculas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge un termen ca să-i schimbi categoria sau să-l elimini. Se potrivește cu tot cuvântul, ignorând diacriticele și majusculele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми на слово, чтобы изменить его категорию или удалить его. Совпадает целое слово, без учёта ударений и регистра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťukni na výraz a zmeň jeho kategóriu alebo ho odstráň. Zhoduje sa s celým slovom, bez ohľadu na diakritiku a veľké písmená."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapni izraz, da mu spremeniš kategorijo ali ga odstraniš. Ujema se s celo besedo, ne glede na naglasna znamenja in velike ali male črke."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni pojam da promeniš njegovu kategoriju ili da ga ukloniš. Poklapa se sa celom rečju, bez obzira na akcente i veličinu slova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ett ord för att ändra dess kategori eller ta bort det. Det matchar hela ordet, oavsett accenter och versaler."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa neno ili kubadilisha aina yake au kuliondoa. Linalingana na neno zima, bila kujali lafudhi wala herufi kubwa au ndogo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு சொல்லின் வகையை மாற்ற அல்லது அதை நீக்க அதைத் தட்டுங்கள். அது முழுச் சொல்லுடன் பொருந்தும், உச்சரிப்புக் குறிகளையும் எழுத்து அளவையும் பொருட்படுத்தாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక పదం కేటగిరీని మార్చడానికి లేదా దాన్ని తీసేయడానికి దానిపై నొక్కండి. ఇది యాసలు, పెద్ద-చిన్న అక్షరాలు పట్టించుకోకుండా మొత్తం పదంతో సరిపోలుస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะคำเพื่อเปลี่ยนหมวดหมู่หรือลบออก โดยจะตรงกับทั้งคำ ไม่สนใจวรรณยุกต์และตัวพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorisini değiştirmek veya kaldırmak için bir terime dokun. Aksan ve büyük/küçük harf fark etmeksizin tüm kelimeyle eşleşir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкнись терміна, щоб змінити його категорію або видалити його. Збігається ціле слово, без урахування наголосів і регістру."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی لفظ کی کیٹیگری بدلنے یا اسے ہٹانے کے لیے اس پر ٹیپ کریں۔ یہ پورے لفظ سے میل کھاتا ہے، اعراب اور چھوٹے بڑے حروف کو نظرانداز کرتے ہوئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một từ khóa để đổi danh mục hoặc xóa nó. Từ khóa khớp cả từ, bỏ qua dấu và chữ hoa/thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按关键词可更改其类别或将其移除。按完整词语匹配，不区分重音和大小写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下關鍵字可更改其類別或將其移除。以完整詞語比對，不區分重音和大小寫。"
          }
        }
      }
    },
