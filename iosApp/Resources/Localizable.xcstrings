    "%@ simplified the debts just now. You no longer owe %@ in %@." : {
      "comment" : "Record payment, 13.5c: who turned Simplify debts on, the receiver, the group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat gerade die Schulden vereinfacht. Du schuldest %2$@ in %3$@ nichts mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó las deudas hace un momento. Ya no le debes %2$@ a %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vient de simplifier les dettes. Tu ne dois plus rien à %2$@ dans %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ baru saja menyederhanakan utang. Kamu tidak lagi berutang ke %@ di %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha appena semplificato i debiti. Non devi più niente a %@ in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たった今%1$@が精算をシンプルにしました。%3$@で%2$@に支払う必要はなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 님이 방금 정산을 간소화했어요. 이제 ‘%3$@’ 그룹에서 %2$@ 님에게 줄 돈이 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de schulden zojuist vereenvoudigd. Je bent %@ niets meer schuldig in %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ właśnie uprościł(a) długi. Nie masz już długu wobec osoby %2$@ w grupie %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificou as dívidas agora há pouco. Você não deve mais a %2$@ na %3$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificou as dívidas agora mesmo. Já não deves a %2$@ na %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ только что упростил(а) долги. Ты больше не должен(-на) участнику %@ в группе %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ az önce borçları sadeleştirdi. %3$@ grubunda artık %2$@ kişisine borçlu değilsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ щойно спростив(-ла) борги. Ти більше не винен(-на) учаснику %@ у групі %@."
