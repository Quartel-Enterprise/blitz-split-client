        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O leitor de cupom não respondeu. Não é a sua foto: tente de novo daqui a pouco ou preencha à mão."
          }
        }
      }
    },
    "You've read 30 receipts in the last 24 hours. Fill it in by hand, or read it again tomorrow." : {
