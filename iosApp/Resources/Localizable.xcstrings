          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе буде перенаправлено в App Store, щоб установити нову версію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
