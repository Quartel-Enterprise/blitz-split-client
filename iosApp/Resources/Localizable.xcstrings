    "Your palette is full: long press one of your colors to delete it." : {
      "comment" : "Category color picker: the person's own colors",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوحة ألوانك ممتلئة: اضغط مطولًا على أحد ألوانك لحذفه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Палитрата ти е пълна: задръж върху един от цветовете си, за да го изтриеш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্যালেট পূর্ণ: মুছতে আপনার কোনো রঙে দীর্ঘক্ষণ চাপ দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje paleta je plná: dlouhým podržením některé ze svých barev ji smažeš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Palette ist voll: Halte eine deiner Farben gedrückt, um sie zu löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παλέτα σου είναι γεμάτη: πάτα παρατεταμένα ένα από τα χρώματά σου για να το διαγράψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu paleta está llena: mantén presionado uno de tus colores para eliminarlo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu paleta está llena: mantén pulsado uno de tus colores para eliminarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پالت شما پر است: برای حذف یکی از رنگ‌هایتان، آن را لمس کرده و نگه دارید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
