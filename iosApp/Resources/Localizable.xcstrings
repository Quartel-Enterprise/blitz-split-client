            "value" : "Dahil değilsin"
          }
        }
      }
    },
    "You're using it without an account. This code brings your groups back if you switch or lose your %@." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt die App ohne Konto. Dieser Code bringt deine Gruppen bei Wechsel oder Verlust deines %@ zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás usando la app sin cuenta. Este código recupera tus grupos si cambias o pierdes tu %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu l’utilises sans compte. Ce code te rend tes groupes si tu changes ou perds ton %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memakainya tanpa akun. Kode ini mengembalikan grupmu kalau kamu mengganti atau kehilangan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai usando l’app senza account. Questo codice riporta i tuoi gruppi se cambi o perdi il tuo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
