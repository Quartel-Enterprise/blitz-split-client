    "Your groups are only on this Mac. Connect an Apple or Google account to see them on iPhone; without an account, the app on iPhone starts empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen sind nur auf diesem Mac. Verbinde einen Apple- oder Google-Account, um sie auf dem iPhone zu sehen; ohne Konto startet die App auf dem iPhone leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos están solo en este Mac. Conecta una cuenta de Apple o Google para verlos en el iPhone; sin cuenta, la app en el iPhone empieza vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes groupes sont seulement sur ce Mac. Connecte un compte Apple ou Google pour les voir sur iPhone ; sans compte, l’app sur iPhone démarre vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi gruppi sono solo su questo Mac. Collega un account Apple o Google per vederli sull’iPhone; senza account, l’app sull’iPhone parte vuota."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje grupy są tylko na tym Macu. Połącz konto Apple lub Google, aby widzieć je na iPhonie; bez konta aplikacja na iPhonie startuje pusta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus grupos estão só neste Mac. Conecte uma conta Apple ou Google para vê-los no iPhone; sem conta, o app no iPhone começa vazio."
          }
        }
      }
    },
