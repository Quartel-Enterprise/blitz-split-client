{
  "sourceLanguage" : "en",
  "strings" : {
    "I am %@" : {
      "comment" : "A guest's merge sheet: the person using the app is this guest",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin %@"
          }
        },
        "es" : {
