    "Your data stays on this %@ until the sync finishes. Once everything is uploaded, we sign out and erase the local copy." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى بياناتك على هذا الـ %@ حتى تكتمل المزامنة. بعد رفع كل شيء، نسجّل خروجك ونمحو النسخة المحلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните ти остават на този %@, докато синхронизирането приключи. Щом всичко бъде качено, излизаме и изтриваме локалното копие."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক শেষ না হওয়া পর্যন্ত আপনার ডেটা এই %@ ডিভাইসে থাকবে। সবকিছু আপলোড হলে আমরা সাইন আউট করে লোকাল কপি মুছে ফেলব।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje data zůstanou v zařízení %@, dokud nedoběhne synchronizace. Jakmile se vše nahraje, odhlásíme tě a smažeme místní kopii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem %@, bis die Synchronisierung fertig ist. Sobald alles hochgeladen ist, melden wir dich ab und löschen die lokale Kopie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα σου μένουν σε αυτό το %@ μέχρι να ολοκληρωθεί ο συγχρονισμός. Μόλις ανέβουν όλα, σε αποσυνδέουμε και διαγράφουμε το τοπικό αντίγραφο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este %@ hasta que termine la sincronización. En cuanto todo se suba, cerramos sesión y borramos la copia local."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داده‌های شما تا پایان همگام‌سازی روی این %@ می‌ماند. وقتی همه چیز بارگذاری شد، خارج می‌شویم و نسخه محلی را پاک می‌کنیم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatili ang data mo sa %@ na ito hanggang matapos ang sync. Kapag na-upload na ang lahat, magsa-sign out kami at buburahin ang lokal na kopya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données restent sur ton %@ jusqu’à la fin de la synchronisation. Une fois tout envoyé, on te déconnecte et on efface la copie locale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנתונים נשארים ב-%@ הזה עד שהסנכרון יסתיים. ברגע שהכול יועלה, ננתק את החשבון ונמחק את העותק המקומי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक पूरा होने तक आपका डेटा इस %@ पर रहेगा। सब कुछ अपलोड होते ही हम साइन आउट करके लोकल कॉपी मिटा देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji podaci ostaju na uređaju %@ dok sinkronizacija ne završi. Kad se sve prenese, odjavljujemo te i brišemo lokalnu kopiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adataid ezen az eszközön maradnak, amíg a szinkronizálás be nem fejeződik: %@. Ha minden feltöltődött, kijelentkeztetünk, és töröljük a helyi másolatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamu tetap di %@ ini sampai sinkronisasi selesai. Begitu semuanya terunggah, kami keluarkan kamu dan menghapus salinan lokalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati restano su questo %@ finché la sincronizzazione non finisce. Quando tutto è stato caricato, ti disconnettiamo e cancelliamo la copia locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が終わるまでデータはこの%@に残ります。すべてアップロードされたら、ログアウトしてローカルのコピーを消去します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 끝날 때까지 데이터는 이 %@ 기기에 남아 있어요. 모두 업로드되면 로그아웃하고 이 기기의 사본을 지워요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data anda kekal pada %@ ini sehingga penyegerakan selesai. Setelah semuanya dimuat naik, kami akan log keluar dan memadam salinan setempat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens blijven op deze %@ tot de synchronisatie klaar is. Zodra alles is geüpload, loggen we uit en wissen we de lokale kopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje dane zostają na tym urządzeniu (%@) do końca synchronizacji. Gdy wszystko zostanie wysłane, wylogujemy cię i wymażemy kopię lokalną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
