        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रकार की आपकी सिर्फ़ एक Pix कुंजी हो सकती है, इसलिए यह वही है जो आपने सहेजी थी। चाहें तो इसे यहां बदलें।"
