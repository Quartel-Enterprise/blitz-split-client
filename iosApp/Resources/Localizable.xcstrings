        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебе в черзі 1 платіж: %@. Спрощення його враховує; якщо він зміниться, пропоновані платежі скоригуються самі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قطار میں آپ کی 1 ادائیگی ہے: %@۔ آسان کرنا اسے شمار کرتا ہے؛ اگر یہ بدلے تو تجویز کردہ ادائیگیاں خود ہی بدل جائیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có 1 khoản thanh toán trong hàng chờ: %@. Việc đơn giản hóa có tính đến nó; nếu nó thay đổi, các khoản thanh toán đề xuất sẽ tự điều chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
