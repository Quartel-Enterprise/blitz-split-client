    "%@ open it with their own account to see and comment." : {
      "comment" : "Share bill: who opens a members-only link; %@ is a list of names, “Ana, Bruno and Carla”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتحه %@ بحساباتهم لرؤيته والتعليق عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ öffnen die Ausgabe mit dem eigenen Konto, um sie anzusehen und zu kommentieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entran con su propia cuenta para ver y comentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’ouvrent avec leur propre compte pour voir et commenter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: פתיחה עם חשבון המשתמש האישי, לצפייה ולתגובות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अपने-अपने अकाउंट से इसे खोलकर देख और टिप्पणी कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ membukanya dengan akun masing-masing untuk melihat dan berkomentar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ la aprono con il proprio account per vedere e commentare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は自分のアカウントで開くと、閲覧やコメントができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 각자 자기 계정으로 열어서 보고 댓글을 달 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ openen hem met hun eigen account om te bekijken en te reageren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ otwierają go na swoich kontach, żeby oglądać i komentować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entram com a própria conta para ver e comentar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ открывают её в своём аккаунте, чтобы смотреть и комментировать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ต้องเปิดด้วยบัญชีของตัวเองเพื่อดูและแสดงความคิดเห็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ görmek ve yorum yapmak için kendi hesaplarıyla açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ відкривають його у своєму обліковому записі, щоб переглядати й коментувати."
