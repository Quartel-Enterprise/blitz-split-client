        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכול נשמר ב-%@ שלך ומסתנכרן מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ आपके %@ पर रहता है और बाद में सिंक होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap ada di %@-mu dan disinkronkan nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta sul tuo %@ e si sincronizza più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてこの%@に保存され、あとで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 내용이 %@에 남아 있다가 나중에 동기화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft op je %@ en synchroniseert later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zostaje na twoim urządzeniu (%@) i zsynchronizuje się później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no %@ e sincroniza depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся на твоём %@ и синхронизируется позже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างอยู่บน %@ ของคุณ และจะซิงค์ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey %@ üzerinde kalır ve daha sonra eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе залишається на цьому пристрої (%@) і синхронізується пізніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ được giữ trên %@ của bạn và đồng bộ sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有内容都保存在你的%@上，稍后同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
