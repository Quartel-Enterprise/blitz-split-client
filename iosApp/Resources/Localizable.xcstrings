    "It came this way. Changing it here only counts for this bill." : {
      "comment" : "Split: the bill opened with the group's default split",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هكذا جاء. تغييره هنا يسري على هذه الفاتورة فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дойде така. Промяната тук важи само за този разход."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি এভাবেই এসেছে। এখানে বদলালে শুধু এই বিলে প্রযোজ্য হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha vingut així. Si la canvies aquí, només compta per a aquesta despesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přišlo to takhle. Změna tady platí jen pro tento výdaj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kom sådan. Ændrer du den her, gælder det kun for denne udgift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So war es voreingestellt. Eine Änderung hier gilt nur für diese Ausgabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ήρθε έτσι. Αν το αλλάξεις εδώ, ισχύει μόνο για αυτό το έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya venía así. Cambiarlo aquí solo vale para este gasto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See tuli nii. Siin muutmine kehtib ainult selle kulu kohta."
