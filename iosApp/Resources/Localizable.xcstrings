    "Simplified, Carla pays Bruno %@ directly, and Elisa pays nothing." : {
      "comment" : "How it works: the example, after",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد التبسيط، دفعة مباشرة من Carla إلى Bruno بقيمة %@، ولا شيء على Elisa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereinfacht zahlt Carla Bruno %@ direkt, und Elisa zahlt nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificado, Carla le paga %@ directamente a Bruno, y Elisa no paga nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplifié, Carla paie %@ directement à Bruno, et Elisa ne paie rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי הפישוט, תשלום ישיר מ-Carla ל-Bruno של %@, ול-Elisa אין תשלום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सरल करने पर Carla सीधे Bruno को %@ देती हैं, और Elisa कुछ नहीं देतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah disederhanakan, Carla langsung membayar Bruno %@, dan Elisa tidak membayar apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la semplificazione, Carla paga %@ direttamente a Bruno ed Elisa non paga niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプル化すると、CarlaがBrunoに直接%@を支払い、Elisaは何も支払いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간소화하면 Carla 님이 Bruno 님에게 바로 %@ 송금하고, Elisa 님은 아무것도 내지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereenvoudigd betaalt Carla Bruno %@ rechtstreeks, en betaalt Elisa niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po uproszczeniu Carla płaci Brunowi %@ bezpośrednio, a Elisa nie płaci nic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificado, Carla paga %@ direto a Bruno, e Elisa não paga nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplificado, a Carla paga %@ diretamente a Bruno, e a Elisa não paga nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После упрощения Карла платит Бруно %@ напрямую, а Элиза ничего не платит."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังลดความซับซ้อน Carla จ่ายให้ Bruno %@ โดยตรง และ Elisa ไม่ต้องจ่ายอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadeleştirince Carla Bruno'ya doğrudan %@ öder, Elisa hiçbir şey ödemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після спрощення Карла платить Бруно %@ напряму, а Еліза нічого не платить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đơn giản hóa, Carla trả thẳng cho Bruno %@, và Elisa không phải trả gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简化后，Carla直接付给Bruno %@，Elisa无需付款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡化後，Carla直接付給Bruno %@，Elisa無需付款。"
          }
        }
      }
    }
