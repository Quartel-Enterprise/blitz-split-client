          "stringUnit" : {
            "state" : "translated",
            "value" : "Сплати у своєму гаманці й повернись, щоб позначити як сплачене."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے والٹ میں ادائیگی کریں اور ادا شدہ نشان زد کرنے کے لیے واپس آئیں۔"
