        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Усі побачать це в Активності, а ті, в кого щось зміниться, отримають сповіщення."
          }
        }
      }
    },
    "Everyone sees it in Activity. You can turn it off anytime." : {
      "comment" : "Simplify debts: the foot when nothing drops",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sehen es in Aktivität. Du kannst es jederzeit ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos lo ven en Actividad. Puedes desactivarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde le voit dans Activité. Tu peux le désactiver quand tu veux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang melihatnya di Aktivitas. Kamu bisa mematikannya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti lo vedono in Attività. Puoi disattivarlo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティで全員に表示されます。いつでもオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두가 활동에서 볼 수 있어요. 언제든 끌 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen ziet het bij Activiteit. Je kunt het altijd weer uitzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszyscy zobaczą to w Aktywności. Możesz to wyłączyć w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo mundo vê na Atividade. Dá para desligar quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda a gente vê na Atividade. Podes desligar quando quiseres."
          }
        },
        "ru" : {
          "stringUnit" : {
