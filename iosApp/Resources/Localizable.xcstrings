        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup ku kontaktom bol zamietnutý. Ak chceš pozývať z kontaktov, povoľ Kontakty v Nastaveniach. Odkaz s pozvánkou funguje aj bez toho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop do stikov je bil zavrnjen. Da povabiš iz stikov, dovoli Stike v Nastavitvah. Povezava za povabilo deluje tudi brez tega."
          }
