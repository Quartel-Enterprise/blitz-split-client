    "This bill is from the group %@. Whoever is in the group also sees their own part and the history." : {
      "comment" : "Over a bill opened from its link; %@ is the group's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الفاتورة من المجموعة %@. كل من في المجموعة يرى أيضًا حصته والسجل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този разход е от групата %@. Членовете на групата виждат и своята част, и историята."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বিলটি %@ গ্রুপের। গ্রুপের সদস্যরা নিজেদের অংশ ও ইতিহাসও দেখতে পান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta despesa és del grup «%@». Qui és al grup també veu la seva part i l’historial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento výdaj je ze skupiny %@. Kdo je ve skupině, vidí také svou část a historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne udgift er fra gruppen %@. Dem, der er i gruppen, ser også deres egen del og historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ausgabe gehört zur Gruppe %@. Wer in der Gruppe ist, sieht auch den eigenen Anteil und den Verlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το έξοδο είναι από την ομάδα %@. Όσοι είναι στην ομάδα βλέπουν επίσης το δικό τους μερίδιο και το ιστορικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gasto es del grupo %@. Quien esté en el grupo también ve su propia parte y el historial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kulu on grupist %@. Grupi liikmed näevad ka oma osa ja ajalugu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این هزینه از گروه %@ است. هر کسی که در گروه است سهم خود و سابقه را هم می‌بیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kulu on ryhmästä %@. Ryhmän jäsenet näkevät myös oman osuutensa ja historian."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bill na ito ay mula sa grupong %@. Nakikita rin ng sinumang nasa grupo ang sarili nilang bahagi at ang history."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette dépense vient du groupe %@. Les membres du groupe voient aussi leur propre part et l’historique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ખર્ચ ‘%@’ ગ્રુપનો છે. ગ્રુપમાં જે કોઈ હોય તેને પોતાનો ભાગ અને ઇતિહાસ પણ દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון הזה שייך לקבוצה %@. חברי הקבוצה רואים גם את החלק האישי שלהם ואת ההיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह खर्च %@ ग्रुप का है। ग्रुप में जो भी है, वह अपना हिस्सा और इतिहास भी देखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj trošak je iz grupe „%@“. Tko je u grupi, vidi i svoj dio i povijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a számla ebből a csoportból van: %@. Aki a csoportban van, a saját részét és az előzményeket is látja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan ini dari grup %@. Siapa pun di grup juga melihat bagiannya sendiri dan riwayatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa spesa è del gruppo %@. Chi è nel gruppo vede anche la propria parte e la cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支出はグループ「%@」のものです。グループのメンバーは、自分の分と履歴も見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지출은 ‘%@’ 그룹의 지출이에요. 그룹에 있는 사람은 자기 몫과 기록도 볼 수 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ši išlaida yra iš grupės %@. Grupės nariai taip pat mato savo dalį ir istoriją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis rēķins ir no grupas %@. Grupas dalībnieki redz arī savu daļu un vēsturi."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा खर्च ‘%@’ ग्रुपमधील आहे. ग्रुपमधील लोकांना त्यांचा स्वतःचा वाटा आणि इतिहासही दिसतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil ini daripada kumpulan %@. Sesiapa dalam kumpulan juga dapat melihat bahagian mereka sendiri dan sejarahnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne utgiften er fra gruppen %@. De som er med i gruppen, ser også sin egen del og historikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze uitgave is van de groep %@. Wie in de groep zit, ziet ook het eigen deel en de geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten wydatek pochodzi z grupy %@. Osoby z grupy widzą też swój udział i historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta é do grupo %@. Quem está no grupo vê também a própria parte e o histórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cheltuială este din grupul %@. Cei din grup își văd și propria parte și istoricul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот счёт из группы %@. Участники группы также видят свою долю и историю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento výdavok je zo skupiny %@. Kto je v skupine, vidí aj svoj podiel a históriu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta strošek je iz skupine %@. Kdor je v skupini, vidi tudi svoj del in zgodovino."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj račun je iz grupe %@. Ko je u grupi vidi i svoj deo i istoriju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här utgiften är från gruppen %@. Den som är med i gruppen ser också sin egen del och historiken."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gharama hii ni ya kikundi %@. Walio kwenye kikundi wanaona pia sehemu yao na historia."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் செலவு இந்தக் குழுவைச் சேர்ந்தது: %@. குழுவில் உள்ளவர்கள் தங்கள் பங்கையும் வரலாற்றையும் பார்ப்பார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ ఖర్చు ‘%@’ గ్రూప్‌కి చెందినది. గ్రూప్‌లో ఉన్నవారు తమ వాటాను, చరిత్రను కూడా చూస్తారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลนี้มาจากกลุ่ม “%@” ใครที่อยู่ในกลุ่มจะเห็นส่วนของตัวเองและประวัติด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu harcama %@ grubuna ait. Gruptaki herkes kendi payını ve geçmişi de görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
