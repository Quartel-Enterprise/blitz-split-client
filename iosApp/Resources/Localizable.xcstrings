        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちの内容が送られた後、データは消去されます。iPhoneはログインしたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 변경 사항이 전송되면 데이터가 삭제돼요. iPhone은 로그인 상태로 유지돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo duomenys bus ištrinti, kai bus išsiųsta tai, kas laukia eilėje. Tavo iPhone liks prisijungęs."
