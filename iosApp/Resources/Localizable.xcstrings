    "The last 90 days stay on this %@. Older ones load when the internet is back." : {
      "comment" : "The end of Activity offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
