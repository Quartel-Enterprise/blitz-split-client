            "value" : "على Carla لـ Elisa %1$@، وعلى Elisa لـ Bruno %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carla schuldet Elisa %1$@, und Elisa schuldet Bruno %2$@."
          }
