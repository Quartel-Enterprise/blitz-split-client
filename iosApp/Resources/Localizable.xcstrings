            "value" : "Plati u svom novčaniku pa se vrati da označiš kao plaćeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala i din plånbok och kom tillbaka för att markera som betald."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipa kwenye pochi yako kisha urudi kuweka alama kuwa imelipwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வாலட்டில் செலுத்திவிட்டுத் திரும்ப வந்து செலுத்தியதாகக் குறியுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ వాలెట్‌లో చెల్లించి, తిరిగి వచ్చి చెల్లించినట్లు గుర్తించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
