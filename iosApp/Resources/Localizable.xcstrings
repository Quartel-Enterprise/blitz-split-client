    "It becomes a payment in the group: it shows in Expenses and can be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zu einer Zahlung in der Gruppe: Sie erscheint in „Ausgaben“ und lässt sich rückgängig machen."
          }
        },
        "es" : {
