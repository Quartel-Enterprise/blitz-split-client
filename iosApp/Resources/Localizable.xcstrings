        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуй ще раз при кращому освітленні й з усім чеком у кадрі або заповни вручну."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیادہ روشنی میں اور پوری رسید تصویر میں لے کر دوبارہ کوشش کریں، یا خود بھریں۔"
