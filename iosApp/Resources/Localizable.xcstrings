        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors ligne : la catégorie peut déjà être utilisée sur ton %@ et arrive dans le groupe dès le retour en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אופליין: אפשר כבר להשתמש בקטגוריה ב-%@ הזה, והיא תגיע לקבוצה כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
