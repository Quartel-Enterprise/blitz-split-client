    "Turn them on in Settings to know when someone adds a bill with you." : {
      "comment" : "Home's notification card once refused, on iPhone and iPad",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تفعيلها في الإعدادات لمعرفة متى يضيف أحد فاتورة معك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включи ги в Настройки, за да разбираш, когато някой добави разход с теб."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ আপনাকে নিয়ে বিল যোগ করলে জানতে সেটিংসে এগুলো চালু করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa-les a la Configuració per saber quan algú afegeix una despesa amb tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
