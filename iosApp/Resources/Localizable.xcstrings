    "You join as a new member. Expenses added before don't include you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانضمام سيكون كعضو جديد. المصروفات المضافة سابقًا لا تشملك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присъединяваш се като нов член. Разходите, добавени преди това, не те включват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি নতুন সদস্য হিসেবে যোগ দেবেন। আগে যোগ করা খরচে আপনি অন্তর্ভুক্ত থাকবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entres com a membre nou. Les despeses afegides abans no t’inclouen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojíš se jako nový člen. Dříve přidané výdaje tě nezahrnují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver medlem som nyt medlem. Udgifter, der er tilføjet før, omfatter ikke dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trittst als neues Mitglied bei. Vorher hinzugefügte Ausgaben schließen dich nicht ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπαίνεις ως νέο μέλος. Τα έξοδα που προστέθηκαν πριν δεν σε περιλαμβάνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras como miembro nuevo. Los gastos agregados antes no te incluyen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entras como miembro nuevo. Los gastos añadidos antes no te incluyen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitud uue liikmena. Varem lisatud kulud sind ei hõlma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به عنوان عضو جدید می‌پیوندید. هزینه‌هایی که قبلاً اضافه شده‌اند شامل شما نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liityt uutena jäsenenä. Aiemmin lisätyt kulut eivät koske sinua."
