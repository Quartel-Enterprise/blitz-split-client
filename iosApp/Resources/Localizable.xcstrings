    "Bill saved in %@, not in %@, which the map suggested. Teach the map?" : {
      "comment" : "Despesas, after saving",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ الفاتورة في %@، وليس في %@ التي اقترحتها الخريطة. تعليم الخريطة؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разходът е запазен в %@, а не в %@, която предложи картата. Да се научи ли картата?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিলটি %@ ক্যাটাগরিতে সংরক্ষণ হয়েছে, ম্যাপের প্রস্তাবিত %@ ক্যাটাগরিতে নয়। ম্যাপকে শেখাবেন?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdaj uložen v kategorii %@, ne v %@, kterou navrhla mapa. Naučit mapu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabe in %1$@ gespeichert, nicht in %2$@, wie die Zuordnung vorschlug. Zuordnung anlernen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το έξοδο αποθηκεύτηκε σε %@, όχι σε %@ που πρότεινε ο χάρτης. Να το μάθει ο χάρτης;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasto guardado en %1$@, y no en %2$@, que sugirió el mapa. ¿Enseñárselo al mapa?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه در %@ ذخیره شد، نه در %@ که نقشه پیشنهاد داده بود. به نقشه یاد بدهیم؟"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-save ang bill sa %@, hindi sa %@ na iminungkahi ng mapa. Turuan ang mapa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépense enregistrée dans %1$@, et non dans %2$@, que la carte proposait. Apprendre à la carte ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון נשמר ב-%@, ולא ב-%@ שהמפה הציעה. ללמד את המפה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्च %@ में सहेजा गया, %@ में नहीं, जो मैप ने सुझाया था। मैप को सिखाएं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trošak spremljen u kategoriju %@, a ne u %@, koju je predložila mapa. Naučiti mapu?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számla ide került: %@, nem ide: %@, amit a térkép javasolt. Megtanítod a térképet?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan disimpan di %@, bukan di %@ yang disarankan peta. Ajari peta?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesa salvata in %@, non in %@ come suggeriva la mappa. Vuoi insegnarlo alla mappa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出は%@に保存されました（マップの提案は%@）。マップに覚えさせますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출을 키워드가 제안한 ‘%2$@’ 카테고리 대신 ‘%1$@’ 카테고리에 저장했어요. 키워드를 알려 줄까요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil disimpan dalam %@, bukan %@ yang dicadangkan oleh peta. Ajar peta?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgave opgeslagen in %1$@, niet in %2$@, wat de kaart voorstelde. De kaart iets leren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydatek zapisano w kategorii %1$@ zamiast sugerowanej przez mapę: %2$@. Nauczyć mapę?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta salva em %1$@, e não em %2$@, que o mapa sugeriu. Ensinar ao mapa?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta guardada em %1$@, e não em %2$@, que o mapa sugeriu. Ensinar o mapa?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuială salvată în %@, nu în %@, cum sugera harta. Înveți harta?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счёт сохранён в категории «%@», а не «%@», как предлагала карта. Научить карту?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdavok uložený v kategórii %@, nie v kategórii %@, ktorú navrhla mapa. Naučiť mapu?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun je sačuvan u kategoriji %@, a ne u %@, što je mapa predložila. Naučiti mapu?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgiften sparades i %@, inte i %@ som kartan föreslog. Lära kartan?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செலவு %@ வகையில் சேமிக்கப்பட்டது, வரைபடம் பரிந்துரைத்த %@ வகையில் அல்ல. வரைபடத்துக்குக் கற்றுக்கொடுக்கவா?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
