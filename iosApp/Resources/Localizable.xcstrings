    "Week, Month and Year show up in periods longer than a week." : {
      "comment" : "The group statistics: why Week, Month and Year are off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الأسبوع والشهر والسنة في الفترات الأطول من أسبوع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Woche“, „Monat“ und „Jahr“ erscheinen bei Zeiträumen länger als eine Woche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana, Mes y Año aparecen en períodos de más de una semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaine, Mois et Année apparaissent pour les périodes de plus d’une semaine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"שבוע\", \"חודש\" ו\"שנה\" מופיעים בתקופות ארוכות משבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हफ़्ता, महीना और साल एक हफ़्ते से लंबी अवधि में दिखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minggu, Bulan, dan Tahun muncul di periode lebih dari seminggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settimana, Mese e Anno compaiono in periodi più lunghi di una settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「週」「月」「年」は1週間より長い期間で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주, 월, 연 단위는 일주일보다 긴 기간에서 보여요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Week, Maand en Jaar verschijnen bij periodes langer dan een week."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tydzień, Miesiąc i Rok pojawiają się w okresach dłuższych niż tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana, Mês e Ano aparecem em períodos mais longos que uma semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Неделя», «Месяц» и «Год» появляются в периодах длиннее недели."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัปดาห์ เดือน และปีจะแสดงในช่วงเวลาที่ยาวกว่าหนึ่งสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafta, Ay ve Yıl bir haftadan uzun dönemlerde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Тиждень», «Місяць» і «Рік» з'являються в періодах, довших за тиждень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuần, Tháng và Năm hiển thị với khoảng thời gian dài hơn một tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期间超过一周时，会显示“周”“月”和“年”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間超過一週時，會顯示「週」「月」和「年」。"
          }
        }
      }
    },
