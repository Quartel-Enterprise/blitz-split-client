    "Couldn't read the receipt. Try again with more light and the whole receipt in the photo, or fill it in by hand." : {
      "comment" : "Split a bill: the receipt couldn't be read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleg konnte nicht gelesen werden. Versuch es mit mehr Licht und dem ganzen Beleg im Foto erneut, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el recibo. Inténtalo de nuevo con más luz y el recibo completo en la foto, o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le reçu. Réessaie avec plus de lumière et tout le reçu dans la photo, ou remplis-le à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere lo scontrino. Riprova con più luce e lo scontrino intero nella foto, o compila a mano."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
