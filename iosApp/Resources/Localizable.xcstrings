          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без облікового запису твої дані буде видалено після 30 днів без використання. Підключи Google чи Apple пізніше в Профілі, щоб зберегти їх."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکاؤنٹ کے بغیر، 30 دن استعمال نہ ہونے پر آپ کا ڈیٹا حذف ہو جاتا ہے۔ اسے رکھنے کے لیے بعد میں پروفائل میں Google یا Apple کنیکٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có tài khoản, dữ liệu của bạn sẽ bị xóa sau 30 ngày không sử dụng. Hãy kết nối Google hoặc Apple sau, trong Hồ sơ, để giữ dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
