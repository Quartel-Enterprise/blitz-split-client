    "Nobody owes anything right now" : {
      "comment" : "Who paid whom?: no open pair",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ديون على أحد حاليًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
