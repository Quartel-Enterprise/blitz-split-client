          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo está sincronizado con tu cuenta de %1$@. Al cerrar sesión, borramos la copia de este %2$@. Tus grupos vuelven cuando inicies sesión de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está tudo sincronizado com sua conta %1$@. Ao sair, apagamos a cópia deste %2$@. Seus grupos voltam quando você entrar de novo."
          }
        }
