    "Incomes stay on this %@ only. The group sees only the percentages." : {
      "comment" : "Default split, By income: %@ is iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einkommen bleiben nur auf diesem %@. Die Gruppe sieht nur die Prozente."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ingresos quedan solo en este %@. El grupo solo ve los porcentajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les revenus restent sur ton %@ uniquement. Le groupe ne voit que les pourcentages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I redditi restano solo su questo %@. Il gruppo vede solo le percentuali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dochody zostają tylko na tym urządzeniu (%@). Grupa widzi tylko procenty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rendas ficam só neste %@. O grupo vê só as porcentagens."
          }
        }
      }
    },
    "No internet: the new split holds on this %@ now and reaches the others once it reconnects." : {
      "comment" : "Default split offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Die neue Aufteilung gilt jetzt auf diesem %@ und erreicht die anderen, sobald die Verbindung zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: la nueva división vale en este %@ ahora y llega a los demás cuando se reconecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : la nouvelle répartition est prise en compte sur ton %@ et arrive sur les autres dès la reconnexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: la nuova divisione vale subito su questo %@ e arriva agli altri quando si riconnette."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: nowy podział obowiązuje już na tym urządzeniu (%@) i trafi do innych po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: a divisão nova vale neste %@ agora e chega aos outros quando ele reconectar."
          }
        }
      }
    },
    "Counts for new expenses. Each expense can change it on the spot. Expenses already added don't change." : {
      "comment" : "Default split: what it changes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neue Ausgaben. Jede Ausgabe kann sie direkt ändern. Bereits hinzugefügte Ausgaben ändern sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para los gastos nuevos. En cada gasto se puede cambiar al momento. Los gastos ya agregados no cambian."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para los gastos nuevos. En cada gasto se puede cambiar al momento. Los gastos ya añadidos no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaut pour les nouvelles dépenses. Chaque dépense peut la changer sur le moment. Les dépenses déjà ajoutées ne changent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per le nuove spese. Ogni spesa può cambiarla sul momento. Le spese già aggiunte non cambiano."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy nowych wydatków. Każdy wydatek może go zmienić na miejscu. Dodane już wydatki się nie zmieniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para as despesas novas. Em cada despesa dá para mudar na hora. As despesas já lançadas não mudam."
          }
        }
      }
    },
