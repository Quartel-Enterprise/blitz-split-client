        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen, die du bezahlt hast oder an denen du beteiligt bist, aus allen Gruppen, erscheinen hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα έξοδα που πλήρωσες ή στα οποία συμμετέχεις, σε οποιαδήποτε ομάδα, εμφανίζονται εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas que pagaste o en las que participas, en cualquier grupo, aparecen aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siin on näha kulud, mille sa maksid või milles osaled, mis tahes grupis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه‌هایی که در هر گروهی پرداخت کرده‌اید یا در آن‌ها سهم دارید، اینجا نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täällä näkyvät kulut, jotka olet maksanut tai joissa olet mukana, missä tahansa ryhmässä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dito lalabas ang mga bill na binayaran mo o kasali ka, sa anumang grupo."
