          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplata napušta grupu i dug se vraća u salda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetés kikerül a csoportból, és a tartozás visszakerül az egyenlegekbe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
