            "value" : "%@ యాప్ లేని అతిథి. మీరు వారికి చెల్లించినదాన్ని నమోదు చేయడానికి నొక్కండి; వారికి ఎలాంటి నోటీసు వెళ్లదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เป็นแขกที่ไม่มีแอป แตะเพื่อบันทึกสิ่งที่คุณจ่ายให้เขา เขาจะไม่ได้รับการแจ้งเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, uygulaması olmayan bir misafir. Ona ne ödediğini not etmek için dokun; bildirim almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гість без застосунку. Торкнись, щоб записати, що ти сплатив(-ла); сповіщення не надійде."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ایپ کے بغیر مہمان ہیں۔ آپ نے انہیں جو ادائیگی کی، اسے درج کرنے کے لیے ٹیپ کریں؛ انہیں کوئی اطلاع نہیں ملے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là khách không dùng ứng dụng. Chạm để ghi lại số tiền bạn đã trả họ; họ sẽ không nhận được thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是没有应用的访客。点按可记录你付给对方的款项；对方不会收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是沒有App的訪客。點一下可記錄你付給對方的款項；對方不會收到通知。"
          }
        }
      }
    },
