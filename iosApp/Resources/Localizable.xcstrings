        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni harcamalar için geçerlidir. Her harcama bunu anında değiştirebilir. Önceden eklenen harcamalar değişmez."
          }
        }
      }
