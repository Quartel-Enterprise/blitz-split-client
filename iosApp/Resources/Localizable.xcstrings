    "If it was you, ask %@ to release the name in Members." : {
      "comment" : "The group's creator, who can release a member taken by someone else on the Members screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, bitte %@, den Namen unter „Mitglieder“ freizugeben."
          }
        },
