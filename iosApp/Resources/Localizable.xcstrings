    "%@ is a guest without the app. They only learn about it from this message, so it already says what went into the bill." : {
      "comment" : "Request to a guest",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ضيف دون التطبيق. هذه الرسالة هي مصدر المعلومة الوحيد، لذا تذكر بالفعل ما دخل في الفاتورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е гост без приложението. Ще научи за това само от това съобщение, затова то вече казва какво влиза в разхода."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ অ্যাপ ব্যবহার না করা একজন অতিথি। তিনি শুধু এই মেসেজ থেকেই জানবেন, তাই বিলে কী কী ছিল তা এতে আগে থেকেই লেখা আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je host bez aplikace. Dozví se o tom jen z této zprávy, takže už v ní je, co šlo do výdaje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App und erfährt es nur aus dieser Nachricht, daher steht schon drin, was in die Ausgabe eingeflossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: επισκέπτης χωρίς την εφαρμογή. Θα το μάθει μόνο από αυτό το μήνυμα, οπότε αναφέρει ήδη τι μπήκε στο έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Solo se entera por este mensaje, así que ya incluye lo que entró en el gasto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مهمانی است که برنامه را ندارد. فقط از طریق این پیام باخبر می‌شود، پس پیام از قبل می‌گوید چه چیزهایی در هزینه بوده است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisita si %@ na walang app. Sa mensaheng ito lang niya malalaman, kaya nakasaad na rito kung ano ang kasama sa bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. La personne ne le saura que par ce message, qui précise donc déjà ce qui compose la dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: אורח בלי האפליקציה. ההודעה הזו היא הדרך היחידה לדעת על החוב, ולכן היא כבר מפרטת מה נכלל בחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना ऐप वाले मेहमान हैं। उन्हें इसके बारे में सिर्फ़ इसी मैसेज से पता चलेगा, इसलिए इसमें पहले से लिखा है कि खर्च में क्या-क्या शामिल था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je gost bez aplikacije. Za ovo će saznati samo iz ove poruke pa ona već navodi što je ušlo u trošak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vendég, nincs meg neki az app. Csak ebből az üzenetből értesül róla, ezért az üzenet már leírja, mi került a számlába."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Dia hanya tahu dari pesan ini, jadi pesannya sudah menjelaskan isi tagihannya."
