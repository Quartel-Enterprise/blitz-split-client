    "Edit freely: it stays saved on this %@ and goes up when the connection is back." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّل بحرية: يبقى محفوظًا على %@ هذا ويُرفع عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактирай спокойно: остава запазено на този %@ и се качва, когато връзката се върне."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিন্তে সম্পাদনা করুন: এটি এই %@ ডিভাইসে সংরক্ষিত থাকবে এবং সংযোগ ফিরলে আপলোড হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita sense por: es queda desat en aquest %@ i es puja quan torni la connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprav, co chceš: zůstane uložené na zařízení %@ a nahraje se, až bude zase připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigér frit: det forbliver gemt på denne %@ og sendes, når forbindelsen er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite nach Belieben: Es bleibt auf diesem %@ gespeichert und wird hochgeladen, wenn die Verbindung zurück ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργάσου ελεύθερα: μένει αποθηκευμένο σε αυτό το %@ και ανεβαίνει όταν επιστρέψει η σύνδεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita con libertad: queda guardado en este %@ y se sube cuando vuelva la conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuda vabalt: see jääb seadmesse %@ salvestatuks ja laaditakse üles, kui ühendus on tagasi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آزادانه ویرایش کنید: روی این %@ ذخیره می‌ماند و وقتی اتصال برگردد ارسال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokkaa vapaasti: se pysyy tallennettuna laitteella %@ ja lähtee, kun yhteys palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-edit nang malaya: mananatili itong naka-save sa %@ na ito at maa-upload kapag bumalik ang koneksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie librement : tout reste enregistré sur ton %@ et part quand la connexion revient."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિશ્ચિંત થઈને એડિટ કરો: તે આ %@ પર સેવ રહે છે અને કનેક્શન પાછું આવે ત્યારે અપલોડ થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לערוך בחופשיות: הכול נשמר ב-%@ הזה ויעלה כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
