    },
    "No internet: it's saved on this device and syncs when you reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Sie ist auf diesem Gerät gespeichert und wird synchronisiert, wenn du wieder verbunden bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: queda guardado en el dispositivo y se sincroniza al reconectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : c’est enregistré sur cet appareil et se synchronise à la reconnexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: è salvato su questo dispositivo e si sincronizza quando ti riconnetti."
          }
        },
        "pl" : {
          "stringUnit" : {
