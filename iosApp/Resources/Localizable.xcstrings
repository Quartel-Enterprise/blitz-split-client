    "Changing the name or the place counts for all of %@ and for the %lld bills that already use %@." : {
      "comment" : "Edit category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name oder Ort zu ändern gilt für ganz %1$@ und für die %2$lld Ausgaben, die %3$@ schon nutzen."
          }
        },
