    "%@ Everyone sees it in Activity, and whoever changes gets a notification." : {
      "comment" : "Simplify debts: the foot turning it off; %@ is how many more people change",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يرى الجميع ذلك في «النشاط»، ويتلقى كل من يتغير وضعه إشعارًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Alle sehen es in Aktivität, und wer betroffen ist, bekommt eine Mitteilung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Todos lo ven en Actividad, y quien cambia recibe una notificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tout le monde le voit dans Activité, et qui change reçoit une notification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ כולם רואים את זה בפעילות, ומי שמושפע מקבל התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ गतिविधि में सबको दिखता है, और जिनके लिए बदलता है उन्हें नोटिफ़िकेशन मिलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Semua orang melihatnya di Aktivitas, dan yang berubah mendapat notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tutti lo vedono in Attività, e chi cambia riceve una notifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@アクティビティで全員に表示され、変わる人には通知が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모두가 활동에서 볼 수 있고, 바뀌는 사람은 알림을 받아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Iedereen ziet het bij Activiteit, en wie verandert krijgt een melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Wszyscy zobaczą to w Aktywności, a osoby, których to dotyczy, dostaną powiadomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Todo mundo vê na Atividade, e quem muda recebe um aviso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Toda a gente vê na Atividade, e quem altera recebe um aviso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Все увидят это в Активности, а те, кого это затронет, получат уведомление."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ทุกคนจะเห็นในกิจกรรม และคนที่เปลี่ยนจะได้รับการแจ้งเตือน"
          }
