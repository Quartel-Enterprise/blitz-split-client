          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie debe nada en este grupo. Si el viaje terminó, puedes eliminar el grupo para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne doit rien dans ce groupe. Si le voyage est fini, tu peux supprimer le groupe pour tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
