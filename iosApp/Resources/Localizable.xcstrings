    "%@ just joined from another device" : {
      "comment" : "Someone else joined as the member just picked",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضم %@ للتو من جهاز آخر"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade von einem anderen Gerät beigetreten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acaba de entrar desde otro dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vient de rejoindre depuis un autre appareil"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: הצטרפות ממכשיר אחר, ממש עכשיו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अभी-अभी किसी दूसरे डिवाइस से जुड़े"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
