    "Deleting your account needs an internet connection. Connect and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف حسابك يتطلب اتصالًا بالإنترنت. اتصل وأعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Löschen deines Kontos brauchst du eine Internetverbindung. Verbinde dich und versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
