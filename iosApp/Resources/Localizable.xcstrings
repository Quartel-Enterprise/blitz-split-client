    "To compare years, pick Year: the period becomes All time." : {
      "comment" : "The group statistics: what picking Year does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Jahre zu vergleichen, wähl „Jahr“: Der Zeitraum wird zu „Gesamter Zeitraum“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comparar años, elige Año: el período pasa a ser Todo el período."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour comparer les années, choisis Année : la période devient Depuis toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membandingkan tahun, pilih Tahun: periodenya menjadi Sepanjang waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per confrontare gli anni, scegli Anno: il periodo diventa Da sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年ごとに比較するには「年」を選んでください：期間は「全期間」になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Jaar om jaren te vergelijken: de periode wordt Altijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby porównać lata, wybierz Rok: okres zmieni się na Cały czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comparar anos, escolha Ano: o período vira Todo o período."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yılları karşılaştırmak için Yıl'ı seç: dönem Tüm zamanlar olur."
          }
        }
      }
    },
    "To compare years, pick Year: the period becomes The whole trip." : {
      "comment" : "The group statistics: what picking Year does in a trip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Jahre zu vergleichen, wähl „Jahr“: Der Zeitraum wird zu „Die ganze Reise“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comparar años, elige Año: el período pasa a ser Todo el viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour comparer les années, choisis Année : la période devient Tout le voyage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membandingkan tahun, pilih Tahun: periodenya menjadi Seluruh perjalanan."
