        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" (%2$@) יוצא מהחשבון והשירות מחושב מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (%@) खर्च से हट जाएगा और सर्विस फिर से गिनी जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (%@) keluar dari tagihan dan biaya layanan dihitung ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» (%@) esce dalla spesa e il servizio viene ricalcolato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」（%@）が支出から削除され、サービス料が再計算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 항목(%@)이 지출에서 빠지고 봉사료가 다시 계산돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (%@) verdwijnt uit de uitgave en de service wordt opnieuw berekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” (%2$@) zniknie z wydatku, a serwis zostanie przeliczony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) sai da conta e o serviço é refeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» (%@) уходит из счёта, и обслуживание пересчитывается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (%@) จะถูกนำออกจากบิล และค่าบริการจะคำนวณใหม่"
