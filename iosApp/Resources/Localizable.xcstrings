        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह खर्च से सभी के लिए हट जाएगी। इसके जवाब बने रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nestaje iz troška za sve. Odgovori ostaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindenkinél eltűnik a számláról. A válaszai megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentar ini hilang dari tagihan untuk semua orang. Balasannya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparisce dalla spesa per tutti. Le risposte restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支出から全員分削除されます。返信は残ります。"
