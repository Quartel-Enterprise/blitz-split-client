    "%@ deleted “%@” after everyone settled up. Nothing was left open, and the group leaves your list." : {
      "comment" : "Someone else deleted the group while it was open; the first %@ is who, the second the group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat „%2$@“ gelöscht, nachdem alle beglichen hatten. Nichts war mehr offen, und die Gruppe verschwindet aus deiner Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eliminó “%2$@” después de que todos saldaron cuentas. No quedó nada pendiente, y el grupo sale de tu lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a supprimé « %2$@ » après que tout le monde a réglé. Il ne restait rien d’ouvert, et le groupe quitte ta liste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghapus “%@” setelah semua lunas. Tidak ada yang tersisa, dan grup ini hilang dari daftarmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha eliminato «%@» dopo che tutti avevano saldato. Non era rimasto nulla in sospeso e il gruppo esce dalla tua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が精算した後、%@が「%@」を削除しました。未精算のものはなく、グループはリストから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 모두 정산한 뒤 ‘%@’ 그룹을 삭제했어요. 미정산 금액은 없었고, 그룹은 목록에서 사라져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft “%2$@” verwijderd nadat iedereen had verrekend. Er stond niets meer open en de groep verdwijnt uit je lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skasował(a) „%2$@” po pełnym rozliczeniu. Nic nie zostało otwarte, a grupa znika z twojej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois que todo mundo acertou. Nada ficou pendente, e o grupo sai da sua lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois de toda a gente acertar. Nada ficou pendente, e o grupo sai da tua lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ удалил(а) «%@» после того, как все рассчитались. Ничего не осталось открытым, и группа уходит из твоего списка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, herkes hesaplaştıktan sonra “%@” grubunu sildi. Açık bir şey kalmadı ve grup listenden çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ видалив(-ла) «%@» після того, як усі розрахувалися. Нічого не залишилося відкритим, і група зникає з твого списку."
          }
        }
      }
    },
