          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai 1 pagamento in coda: %@. La semplificazione lo conta; se cambia, i pagamenti suggeriti si adattano da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューに1件の支払いがあります：%@。シンプル化にはそれも含まれ、変わった場合は提案される支払いが自動で調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열에 송금 1건이 있어요: %@. 간소화에 포함되며, 바뀌면 추천 송금도 자동으로 조정돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mempunyai 1 bayaran dalam baris gilir: %@. Pemudahan mengambil kiranya; jika ia berubah, bayaran yang dicadangkan akan dilaraskan dengan sendirinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
