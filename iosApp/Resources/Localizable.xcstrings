          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «%@» пока никого нет: %@ вне разделения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ยังไม่มีใคร: %@ ไม่อยู่ในการหาร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kaleminde henüz kimse yok: %@ bölüşümün dışında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ще ні в кого: %@ поза розподілом."
          }
