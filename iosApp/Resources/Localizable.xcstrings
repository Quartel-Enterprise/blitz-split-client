          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 fizetésed vár a sorban: %@. Az egyszerűsítés beszámítja; ha változik, a javasolt fizetések maguktól igazodnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
