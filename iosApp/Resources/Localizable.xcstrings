    "The 12 words in order. Paste them all into one field to fill every field." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات الـ 12 بالترتيب. الصقها كلها في حقل واحد لملء كل الحقول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12-те думи по ред. Постави ги всички в едно поле, за да се попълнят всички полета."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্রম অনুযায়ী 12 টি শব্দ। সব ঘর পূরণ করতে সবগুলো একটি ঘরে পেস্ট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 12 paraules en ordre. Enganxa-les totes en un camp per omplir-los tots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 slov ve správném pořadí. Vlož je všechna do jednoho pole a vyplní se všechna pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 12 ord i rækkefølge. Indsæt dem alle i ét felt for at udfylde alle felterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 12 Wörter der Reihe nach. Füg alle in ein Feld ein, um alle Felder zu füllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι 12 λέξεις με τη σειρά. Επικόλλησέ τες όλες σε ένα πεδίο για να συμπληρωθούν όλα τα πεδία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las 12 palabras, en orden. Pégalas todas en un campo para llenarlos todos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 sõna õiges järjekorras. Kleebi kõik ühte välja, et täita kõik väljad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 واژه به ترتیب. همه را در یک فیلد الصاق کنید تا همه فیلدها پر شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 sanaa järjestyksessä. Liitä ne kaikki yhteen kenttään, niin jokainen kenttä täyttyy."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang 12 salita ayon sa ayos. I-paste ang lahat sa iisang field para mapunan ang bawat field."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 12 mots dans l’ordre. Colle-les tous dans un champ pour tout remplir."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ક્રમમાં 12 શબ્દો. બધાં ફીલ્ડ ભરવા માટે તે બધા એક ફીલ્ડમાં પેસ્ટ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 המילים לפי הסדר. הדבקה של כולן בשדה אחד ממלאת את כל השדות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रम से 12 शब्द। सभी फ़ील्ड भरने के लिए सभी को एक फ़ील्ड में पेस्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 riječi redom. Zalijepi ih sve u jedno polje da popuniš sva polja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 12 szó sorrendben. Ha mindet egyetlen mezőbe illeszted be, az összes mező kitöltődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 kata sesuai urutan. Tempel semuanya di satu kolom untuk mengisi semua kolom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le 12 parole in ordine. Incollale tutte in un campo per riempirli tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12個の単語を順番どおりに。まとめて1つの欄に貼り付けると、すべての欄に入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12개 단어를 순서대로 입력하세요. 한 칸에 모두 붙여 넣으면 모든 칸이 채워져요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 žodžių iš eilės. Įklijuok juos visus į vieną laukelį, kad užpildytum visus laukelius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 vārdi pareizā secībā. Ielīmē tos visus vienā laukā, lai aizpildītu visus laukus."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 शब्द क्रमाने. सर्व फील्ड भरण्यासाठी ते सर्व एकाच फील्डमध्ये पेस्ट करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 perkataan mengikut urutan. Tampal semuanya dalam satu medan untuk mengisi setiap medan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 12 ordene i rekkefølge. Lim inn alle i ett felt for å fylle ut alle feltene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 12 woorden op volgorde. Plak ze allemaal in één veld om alles in te vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 słów po kolei. Wklej wszystkie w jedno pole, aby wypełnić wszystkie."
