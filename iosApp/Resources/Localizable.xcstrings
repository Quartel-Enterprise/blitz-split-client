    "Hi %@! Let's split the bills of %@ on Blitz Split. Join with this link:" : {
      "comment" : "The message shared with an invite for someone named; the first %@ is them, the second the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا %@! لنقسّم فواتير %@ على Blitz Split. الانضمام عبر هذا الرابط:"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здрасти, %@! Хайде да разделим разходите на „%@“ в Blitz Split. Присъедини се с този линк:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হ্যালো %@! চলুন Blitz Split-এ %@ গ্রুপের বিল ভাগ করি। এই লিংক দিয়ে যোগ দিন:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahoj %@! Pojďme si v Blitz Split rozdělit výdaje skupiny %@. Připoj se přes tento odkaz:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@! Lass uns die Ausgaben von %2$@ mit Blitz Split aufteilen. Tritt über diesen Link bei:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γεια σου %@! Ας μοιράσουμε τα έξοδα της ομάδας %@ στο Blitz Split. Μπες με αυτόν τον σύνδεσμο:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %1$@! Vamos a dividir los gastos de %2$@ en Blitz Split. Únete con este enlace:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلام %@! بیایید هزینه‌های %@ را در Blitz Split تقسیم کنیم. با این لینک بپیوندید:"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %@! Hatiin natin ang mga bill ng %@ sa Blitz Split. Sumali gamit ang link na ito:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! On partage les dépenses de %2$@ sur Blitz Split. Rejoins avec ce lien :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היי %@! בואו נפצל את החשבונות של %@ ב-Blitz Split. אפשר להצטרף עם הקישור הזה:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते %@! चलिए Blitz Split पर %@ के खर्च बांटते हैं। इस लिंक से जुड़ें:"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bok, %@! Podijelimo troškove grupe „%@“ u aplikaciji Blitz Split. Uđi putem ove poveznice:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia, %@! Osszuk fel a számlákat a Blitz Splitben (%@). Csatlakozz ezzel a linkkel:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Yuk bagi tagihan %@ di Blitz Split. Bergabung lewat tautan ini:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Dividiamo le spese di %@ su Blitz Split. Entra con questo link:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、こんにちは！Blitz Splitで%@の支出を割り勘しましょう。このリンクから参加してください："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, %@ 님! Blitz Split에서 ‘%@’ 그룹의 지출을 나눠요. 이 링크로 참여하세요:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Jom bahagikan bil %@ di Blitz Split. Sertai dengan pautan ini:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %@! Laten we de uitgaven van %@ verdelen in Blitz Split. Doe mee via deze link:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %1$@! Podzielmy wydatki z grupy %2$@ w Blitz Split. Dołącz przez ten link:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, %1$@! Bora rachar as contas do grupo %2$@ no Bora Rachar? Entra pelo link:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, %1$@! Vamos dividir as contas do grupo %2$@ no Blitz Split? Entra pelo link:"
