    "This %@ hasn't synced yet, so only what you did on it shows here. Group activity arrives on the first connection, with or without an account." : {
      "comment" : "Activity on a device that never synced; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem %@ wurde noch nicht synchronisiert, daher siehst du hier nur, was du darauf gemacht hast. Die Gruppenaktivität kommt bei der ersten Verbindung, mit oder ohne Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ todavía no se ha sincronizado, así que aquí solo aparece lo que hiciste en él. La actividad de los grupos llega en la primera conexión, con o sin cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton %@ n’est pas encore synchronisé, donc seul ce que tu y as fait s’affiche ici. L’activité du groupe arrive à la première connexion, avec ou sans compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo %@ non si è ancora sincronizzato, quindi qui compare solo ciò che hai fatto su di esso. L’attività dei gruppi arriva alla prima connessione, con o senza account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie (%@) nie zostało jeszcze zsynchronizowane, więc widać tu tylko to, co zrobiono na nim. Aktywność grup dotrze przy pierwszym połączeniu, z kontem lub bez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ ainda não sincronizou, então aqui só aparece o que você fez nele. A atividade dos grupos chega na primeira conexão, com ou sem conta."
          }
        }
      }
    },
