        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere internet. Complétalo a mano o escanea el recibo cuando te reconectes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vajab internetti. Täida käsitsi või skanni tšekk, kui ühendus taastub."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به اینترنت نیاز دارد. آن را دستی پر کنید یا پس از اتصال دوباره رسید را اسکن کنید."
