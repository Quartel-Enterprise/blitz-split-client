        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slobodno menjaj: ostaje sačuvano na ovom uređaju (%@) i šalje se kad se veza vrati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
