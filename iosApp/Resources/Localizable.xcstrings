        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadaļā Rediģēt grupu. Aktivitātē redzams, kas to mainīja, un tie, kas tagad maksā vai saņem no kāda cita, saņem paziņojumu."
