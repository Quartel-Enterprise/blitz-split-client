          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On dirait un relevé de carte ou de banque, qui n’est pas lu comme une seule dépense. Remplis à la main."
          }
        },
        "he" : {
          "stringUnit" : {
