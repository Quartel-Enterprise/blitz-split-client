          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রত্যেকে তখন যা পরিশোধ করেছেন। যা পরিশোধ করেছেন আর যা নিজের অংশ, তার পার্থক্যই ব্যালেন্স, যা “ব্যালেন্স”-এ দেখা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co každý v danou chvíli zaplatil. Rozdíl mezi tím, co zaplatil a co spotřeboval, se stane zůstatkem v Zůstatcích."
