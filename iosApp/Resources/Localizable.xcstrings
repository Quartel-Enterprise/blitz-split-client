      }
    },
    "Expense" : {
      "comment" : "Column of the group's bills on the Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المصروف"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabe"
          }
        },
