    "New in the map. Titles with “%@” go to %@." : {
      "comment" : "Teach the map: a word",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جديد في الخريطة. العناوين التي تحتوي على «%@» تذهب إلى %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ново в картата. Заглавията с „%@“ отиват в %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ম্যাপে নতুন। “%@” থাকা শিরোনাম যাবে %@ ক্যাটাগরিতে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nou al mapa. Els títols amb «%@» van a %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové v mapě. Názvy s „%@“ půjdou do %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyt i kortet. Titler med »%@« går til %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in der Zuordnung. Titel mit „%1$@“ gehen zu %2$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νέος όρος στον χάρτη. Οι τίτλοι με «%@» πηγαίνουν σε %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva en el mapa. Los títulos con “%1$@” van a %2$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaardil uus. Pealkirjad sõnaga „%@“ lähevad kategooriasse %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدید در نقشه. عنوان‌های دارای «%@» به %@ می‌روند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi kartassa. Otsikot, joissa on ”%@”, menevät luokkaan %@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bago sa mapa. Ang mga pamagat na may “%@” ay mapupunta sa %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau dans la carte. Les titres avec « %1$@ » vont dans %2$@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મૅપમાં નવો. “%@” વાળાં શીર્ષકો ‘%@’ માં જાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חדשה במפה. כותרות עם \"%@\" עוברות ל-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैप में नया। “%@” वाले टाइटल %@ में जाएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novo u mapi. Naslovi s „%@“ idu u kategoriju %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új a térképen. Azok a címek, amelyekben szerepel „%@”, ide kerülnek: %@."
          }
        },
        "id" : {
          "stringUnit" : {
