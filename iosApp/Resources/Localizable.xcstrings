    "It isn't your photo. Try again in a moment, or fill it in by hand." : {
      "comment" : "Split a bill on the Mac: under \"The receipt reader didn't answer\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es liegt nicht an deinem Foto. Versuch es gleich noch mal, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es tu foto. Inténtalo de nuevo en un momento o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas ta photo. Réessaie dans un instant, ou remplis à la main."
