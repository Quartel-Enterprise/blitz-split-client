            "value" : "Spróbuj ponownie przy lepszym świetle i z całym paragonem na zdjęciu albo wpisz dane ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente de novo com mais luz e o cupom inteiro na foto, ou preencha à mão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenta de novo com mais luz e o talão inteiro na fotografia, ou preenche à mão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încearcă din nou cu mai multă lumină și tot bonul în fotografie sau completează manual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуй ещё раз при лучшем освещении и так, чтобы весь чек был в кадре, или заполни вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
