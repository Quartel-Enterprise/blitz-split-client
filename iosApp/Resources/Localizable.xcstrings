    "Combines the group's debts into fewer payments. Nobody pays or receives more." : {
      "comment" : "Edit group: what Simplify debts does, while off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع ديون المجموعة في دفعات أقل. لا أحد يدفع أو يستلم أكثر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обединява дълговете в групата в по-малко плащания. Никой не плаща и не получава повече."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপের দেনাগুলো একত্র করে পেমেন্টের সংখ্যা কমায়। কেউ বেশি দেবেন না বা বেশি পাবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojí dluhy skupiny do menšího počtu plateb. Nikdo nezaplatí ani nedostane víc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst die Schulden der Gruppe zu weniger Zahlungen zusammen. Niemand zahlt oder bekommt mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδυάζει τα χρέη της ομάδας σε λιγότερες πληρωμές. Κανείς δεν πληρώνει ούτε λαμβάνει περισσότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta las deudas del grupo en menos pagos. Nadie paga ni recibe de más."
          }
        },
