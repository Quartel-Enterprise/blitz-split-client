    "Access to contacts was denied. To invite from your contacts, allow Contacts in Settings. The invite link works without it." : {
      "comment" : "The agenda was refused, on iPhone and iPad",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf Kontakte wurde verweigert. Um aus deinen Kontakten einzuladen, erlaube „Kontakte“ in den Einstellungen. Der Einladungslink funktioniert auch ohne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se negó el acceso a los contactos. Para invitar desde tus contactos, permite Contactos en Ajustes. El enlace de invitación funciona sin esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux contacts a été refusé. Pour inviter depuis tes contacts, autorise Contacts dans les Réglages. Le lien d’invitation fonctionne sans cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso ai contatti è stato negato. Per invitare dai tuoi contatti, consenti Contatti nelle Impostazioni. Il link d’invito funziona anche senza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do kontaktów. Aby zapraszać z kontaktów, zezwól na dostęp do Kontaktów w Ustawieniach. Link z zaproszeniem działa bez tego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos contatos foi negado. Para convidar da agenda, libere Contatos em Ajustes. O link de convite funciona sem isso."
          }
        }
      }
    },
