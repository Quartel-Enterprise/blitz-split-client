    "New bills start in this currency; each bill can use another." : {
      "comment" : "Under the group's default currency, in New group and Edit group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ الفواتير الجديدة بهذه العملة؛ ويمكن لكل فاتورة استخدام عملة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новите разходи започват в тази валута; всеки разход може да използва друга."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
