        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক শেষ না হওয়া পর্যন্ত আপনার ডেটা এই %@ ডিভাইসে থাকবে। সবকিছু আপলোড হলে আমরা সাইন আউট করে লোকাল কপি মুছে ফেলব।"
