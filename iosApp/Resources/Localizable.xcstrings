    "Already the fewest payments. The next bills come in simplified." : {
      "comment" : "The group's Balances while Simplify debts is on and saves no payment",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon die wenigsten Zahlungen. Die nächsten Ausgaben kommen vereinfacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tiene el mínimo de pagos. Los próximos gastos entrarán simplificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà le minimum de paiements. Les prochaines dépenses arriveront simplifiées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah paling sedikit pembayaran. Tagihan berikutnya akan langsung disederhanakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già il minor numero di pagamenti. Le prossime spese arriveranno semplificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに支払い回数は最少です。次の支出からシンプルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 송금 횟수가 최소예요. 다음 지출부터 간소화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al het minste aantal betalingen. De volgende uitgaven komen vereenvoudigd binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już najmniej płatności. Kolejne wydatki będą upraszczane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está no mínimo de pagamentos. As próximas contas já entram simplificadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже минимум платежей. Следующие счета будут упрощаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten en az ödeme. Sonraki harcamalar sadeleştirilmiş gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежів уже найменше. Наступні рахунки надходитимуть спрощеними."
          }
        }
      }
    },
    "%@ instead of %lld. You may pay or receive from someone you never split a bill with." : {
      "comment" : "The group's Balances while Simplify debts is on; %1$@ is how many payments now",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ statt %2$lld. Du zahlst vielleicht an jemanden oder bekommst von jemandem, mit dem du nie eine Ausgabe geteilt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en lugar de %2$lld. Puede que pagues o recibas de alguien con quien nunca dividiste un gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ au lieu de %2$lld. Tu peux payer ou recevoir de quelqu’un avec qui tu n’as jamais partagé de dépense."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, bukan %lld. Kamu mungkin membayar atau menerima dari orang yang belum pernah berbagi tagihan denganmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ invece di %lld. Potresti pagare o ricevere da qualcuno con cui non hai mai diviso una spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（以前は%lld件）。一緒に割り勘したことのない人と支払いや受け取りをすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld건 대신 %1$@건. 함께 지출을 나눈 적 없는 사람에게 송금하거나 받을 수도 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in plaats van %lld. Je kunt betalen aan of ontvangen van iemand met wie je nooit een uitgave hebt verdeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zamiast %2$lld. Możesz płacić komuś lub otrzymywać od kogoś, z kim nie masz wspólnego wydatku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ em vez de %2$lld. Você pode pagar ou receber de quem não dividiu conta com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ em vez de %2$lld. Podes pagar ou receber de quem não dividiu conta contigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вместо %lld. Возможно, ты будешь платить тому или получать от того, с кем никогда не делил(а) счёт."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld yerine %1$@. Hiç harcama bölmediğin birine ödeyebilir ya da ondan alabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ замість %lld. Ти можеш платити чи отримувати від людини, з якою ніколи не ділив(-ла) рахунок."
          }
        }
      }
    },
