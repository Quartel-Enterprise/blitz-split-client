        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è stato eliminato dopo che tutti avevano saldato. Non era rimasto nulla in sospeso e il gruppo esce dalla tua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員の精算後に「%@」は削除されました。未精算のものはなく、グループはリストから消えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is verwijderd nadat iedereen alles had verrekend. Er stond niets meer open, en de groep verdwijnt uit je lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
