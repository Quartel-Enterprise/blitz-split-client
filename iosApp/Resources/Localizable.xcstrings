        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Herkes bunu Etkinlik'te görür ve değişenler bildirim alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Усі побачать це в Активності, а ті, в кого щось зміниться, отримають сповіщення."
          }
        },
        "vi" : {
          "stringUnit" : {
