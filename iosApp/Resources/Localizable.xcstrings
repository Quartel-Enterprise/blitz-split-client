    "Whoever is left at %@ is out of the bill." : {
      "comment" : "Hint of the split by amount; %@ is zero in the currency",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يبقى عند %@ يكون خارج الفاتورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Който остане на %@, е извън разхода."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাঁর অংশ %@ থাকবে তিনি বিল থেকে বাদ পড়বেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo zůstane na %@, je z výdaje vyřazen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer bei %@ bleibt, ist nicht in der Ausgabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος μείνει στο %@ μένει εκτός του εξόδου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se queda con %@ sale del gasto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی که روی %@ بماند از هزینه بیرون است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang matitira sa %@ ay hindi kasali sa bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque reste à %@ n’est pas dans la dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שנשאר על %@ לא נכלל בחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिसकी रकम %@ रहेगी, वह इस खर्च से बाहर रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tko ostane na %@, isključen je iz troška."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aki ennél marad (%@), kimarad a számlából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dibiarkan %@ tidak ikut tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi resta a %@ è fuori dalla spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のままの人は、この支出の対象外になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금액을 %@ 그대로 둔 사람은 지출에서 제외돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiapa yang kekal pada %@ tidak termasuk dalam bil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie op %@ blijft staan, doet niet mee met de uitgave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto zostanie z kwotą %@, będzie poza wydatkiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem fica com %@ sai da conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cine rămâne la %@ e exclus din cheltuială."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, у кого осталось %@, не участвуют в счёте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto zostane na %@, je z výdavku vynechaný."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko ostane na %@ nije u računu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som står på %@ är inte med i utgiften."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தொகையில் விடப்பட்டவர் செலவில் இல்லை: %@."
