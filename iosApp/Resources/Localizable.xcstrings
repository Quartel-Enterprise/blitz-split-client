            "value" : "Itt jelenik meg minden, amit neked adtak hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua yang ditambahkan untukmu muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che viene aggiunto per te compare qui."
          }
        },
        "ja" : {
