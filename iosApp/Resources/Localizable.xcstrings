    "%@ simplified its debts, so instead of paying %@ you pay me directly; your total didn't change." : {
      "comment" : "Request's message: %1$@ is the group, %2$@ whom they would pay by the bills",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تبسيط ديون %@، لذا بدلًا من الدفع لـ %@ يكون الدفع لي مباشرة؛ ولم يتغير إجماليك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ опрости дълговете си, така че вместо да плащаш на %@, плащаш директно на мен; общата ти сума не се промени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ গ্রুপের দেনা সহজ করা হয়েছে, তাই %2$@-কে দেওয়ার বদলে আপনি সরাসরি আমাকে দেবেন; আপনার মোট পরিমাণ বদলায়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina %@ zjednodušila dluhy, takže místo placení osobě %@ platíš přímo mně; tvoje celková částka se nezměnila."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Schulden vereinfacht, daher zahlst du mir direkt statt an %2$@; deine Summe hat sich nicht geändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ομάδα %@ απλοποίησε τα χρέη της, οπότε αντί να πληρώσεις σε %@ πληρώνεις απευθείας εμένα. Το σύνολό σου δεν άλλαξε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó sus deudas, así que en vez de pagar %2$@ me pagas directamente a mí; tu total no cambió."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه %@ بدهی‌ها را ساده کرد، پس به جای پرداخت به %@ مستقیماً به من می‌پردازید؛ مجموع شما تغییر نکرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinasimple ng %@ ang mga utang nito, kaya sa halip na magbayad ka ng %@, direkta kang magbabayad sa akin; hindi nagbago ang kabuuan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a simplifié ses dettes, donc au lieu de payer %2$@ tu me paies directement ; ton total n’a pas changé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקבוצה %1$@ היה פישוט חובות, אז במקום לשלם ל-%2$@, התשלום הוא ישירות אליי; הסכום הכולל שלך לא השתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने अपने कर्ज़ सरल कर दिए हैं, इसलिए %2$@ को भुगतान करने की जगह आप सीधे मुझे भुगतान करें; आपका कुल नहीं बदला।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa „%@“ pojednostavila je dugove pa umjesto da platiš članu %@, plaćaš izravno meni; tvoj ukupni iznos se nije promijenio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoport (%1$@) egyszerűsítette a tartozásokat, így ahelyett, hogy neki fizetnél (%2$@), közvetlenül nekem fizetsz; a teljes összeged nem változott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menyederhanakan utangnya, jadi daripada membayar %@ kamu langsung membayar ke aku; totalmu tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha semplificato i debiti, quindi invece di pagare %@ paghi direttamente me; il tuo totale non è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で精算がシンプルになったので、%@に支払う代わりに私に直接支払ってください。あなたの合計は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 그룹이 정산을 간소화해서 %2$@ 님에게 송금하는 대신 나에게 바로 송금하면 돼요. 총액은 바뀌지 않았어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ telah mempermudahkan hutangnya, jadi daripada membayar %@, anda membayar saya terus; jumlah anda tidak berubah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de schulden vereenvoudigd, dus in plaats van %@ te betalen, betaal je mij rechtstreeks; je totaal is niet veranderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %1$@ uprościła długi, więc zamiast płacić osobie %2$@, płacisz bezpośrednio mnie; twoja suma się nie zmieniła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ simplificou as dívidas, então em vez de pagar %2$@ você paga direto para mim; o seu total não mudou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ simplificou as dívidas, por isso em vez de pagares %2$@ pagas diretamente a mim; o teu total não mudou."
          }
