        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하면 [이용약관](legal:terms)에 동의하고 [개인정보 처리방침](legal:privacy)을 확인한 것으로 간주해요."
          }
        },
        "nl" : {
          "stringUnit" : {
