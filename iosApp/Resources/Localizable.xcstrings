    "This is a Lightning invoice (lnbc…): it pays once and expires. Paste a Lightning Address or an LNURL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine Lightning-Rechnung (lnbc…): Sie zahlt einmal und läuft ab. Füge eine Lightning-Adresse oder eine LNURL ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es una factura Lightning (lnbc…): sirve para un solo pago y caduca. Pega una Lightning Address o un LNURL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une facture Lightning (lnbc…) : elle ne paie qu’une fois et expire. Colle une adresse Lightning ou un LNURL."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini invoice Lightning (lnbc…): hanya bisa dibayar sekali dan kedaluwarsa. Tempel Lightning Address atau LNURL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una fattura Lightning (lnbc…): si paga una volta e scade. Incolla un Lightning Address o un LNURL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはLightningインボイス（lnbc…）です：1回だけ支払えて、期限切れになります。LightningアドレスまたはLNURLを貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightning 인보이스(lnbc…)예요: 한 번만 결제되고 만료돼요. Lightning 주소나 LNURL을 붙여넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een Lightning-factuur (lnbc…): die betaalt één keer en verloopt. Plak een Lightning Address of een LNURL."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest faktura Lightning (lnbc…): płaci się ją raz i wygasa. Wklej Lightning Address lub LNURL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é uma fatura Lightning (lnbc…): vale para um pagamento só e expira. Cole um Lightning Address ou um LNURL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это Lightning-счёт (lnbc…): он оплачивается один раз и истекает. Вставь Lightning Address или LNURL."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir Lightning faturası (lnbc…): bir kez öder ve süresi dolar. Bir Lightning Address veya LNURL yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це рахунок Lightning (lnbc…): його можна сплатити лише раз, і він спливає. Встав Lightning Address або LNURL."
          }
        }
      }
    },
