    "The %lld bills with %@ move to %@. The category goes for all of %@." : {
      "comment" : "Delete category",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورتان فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فواتير فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld فاتورة فيها %@ تنتقل إلى %@. تُحذف الفئة لكل أعضاء %@."
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$lld Ausgaben mit %2$@ wandern zu %3$@. Die Kategorie verschwindet für ganz %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %1$lld gastos con %2$@ pasan a %3$@. La categoría desaparece para todo el grupo %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$lld dépenses avec %2$@ passent dans %3$@. La catégorie vaut pour tout %4$@."
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבון עם %@ יעבור ל-%@. הקטגוריה תימחק עבור כל הקבוצה %@."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבונות עם %@ עוברים ל-%@. הקטגוריה נמחקת לכל חברי %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld חשבונות עם %@ עוברים ל-%@. הקטגוריה נמחקת לכל חברי %@."
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ वाले %1$lld खर्च %3$@ में चले जाएंगे। यह श्रेणी पूरे %4$@ से हट जाएगी।"
          }
        },
        "id" : {
