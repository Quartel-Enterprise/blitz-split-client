    "We searched the groups, people and expenses on this %@, settled groups included." : {
      "comment" : "The search found nothing; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحثنا في المجموعات والأشخاص والمصروفات على %@ هذا، بما فيها المجموعات التي تمت تسويتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потърсихме в групите, хората и разходите на този %@, включително уредените групи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা এই %@ ডিভাইসের গ্রুপ, ব্যক্তি ও খরচ খুঁজেছি, হিসাব মেটানো গ্রুপসহ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hem cercat els grups, les persones i les despeses d’aquest %@, inclosos els grups liquidats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohledali jsme skupiny, lidi a výdaje na zařízení %@, včetně vyrovnaných skupin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi søgte i grupper, personer og udgifter på denne %@, også grupper, der er gjort op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben die Gruppen, Personen und Ausgaben auf diesem %@ durchsucht, auch ausgeglichene Gruppen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήσαμε ομάδες, άτομα και έξοδα σε αυτό το %@, μαζί με τις εξοφλημένες ομάδες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscamos en los grupos, personas y gastos de este %@, incluidos los grupos saldados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsisime seadmes %@ olevaid gruppe, inimesi ja kulusid, ka arveldatud gruppe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌ها، افراد و هزینه‌های روی این %@ را جستجو کردیم، از جمله گروه‌های تسویه‌شده."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haimme ryhmiä, ihmisiä ja kuluja laitteelta %@, myös tasatuista ryhmistä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinanap namin ang mga grupo, tao at gastos sa %@ na ito, pati ang mga grupong bayad na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a cherché dans les groupes, personnes et dépenses de ton %@, groupes réglés compris."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
