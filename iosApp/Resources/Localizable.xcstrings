            "value" : "%@ väljer sitt namn i listan eller går med som ny medlem."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ anachagua jina lake kwenye orodha au anajiunga kama mshiriki mpya."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ பட்டியலில் தங்கள் பெயரைத் தேர்ந்தெடுப்பார் அல்லது புதிய உறுப்பினராகச் சேர்வார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ జాబితాలో తమ పేరును ఎంచుకుంటారు లేదా కొత్త సభ్యులుగా చేరతారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เลือกชื่อของตัวเองในรายการ หรือเข้าร่วมเป็นสมาชิกใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ listeden adını seçer veya yeni üye olarak katılır."
