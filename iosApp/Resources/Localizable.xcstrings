        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuidas sõbrad sind kutsuvad?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوستانتان شما را چه صدا می‌زنند؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millä nimellä ystäväsi kutsuvat sinua?"
          }
