    "Frame the whole receipt. We fill in the amount, the date and the description; you check them before saving." : {
      "comment" : "Receipt camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل الإيصال كاملًا داخل الإطار. نملأ المبلغ والتاريخ والوصف، وتراجعها قبل الحفظ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хвани цялата касова бележка в кадър. Попълваме сумата, датата и описанието; ти ги проверяваш преди запазване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরো রসিদটি ফ্রেমে আনুন। আমরা পরিমাণ, তারিখ ও বিবরণ পূরণ করব; সংরক্ষণের আগে আপনি সেগুলো যাচাই করে নেবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachyť celou účtenku. Vyplníme částku, datum a popis; před uložením je zkontroluješ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm den ganzen Beleg ins Bild. Wir füllen Betrag, Datum und Beschreibung aus; du prüfst sie vor dem Speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάδραρε ολόκληρη την απόδειξη. Συμπληρώνουμε το ποσό, την ημερομηνία και την περιγραφή και εσύ τα ελέγχεις πριν αποθηκεύσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra todo el recibo. Completamos el monto, la fecha y la descripción; tú los revisas antes de guardar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra todo el recibo. Completamos el importe, la fecha y la descripción; tú los revisas antes de guardar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کل رسید را در کادر قرار دهید. مبلغ، تاریخ و توضیحات را پر می‌کنیم؛ شما پیش از ذخیره آن‌ها را بررسی می‌کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipasok sa frame ang buong resibo. Pupunan namin ang halaga, petsa at deskripsyon; i-check mo ang mga ito bago mag-save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadre tout le reçu. On remplit le montant, la date et la description ; tu les vérifies avant d’enregistrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש למסגר את כל הקבלה. אנחנו ממלאים את הסכום, התאריך והתיאור; לפני השמירה כדאי לבדוק אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी रसीद फ़्रेम में लें। हम रकम, तारीख और विवरण भरते हैं; सहेजने से पहले आप उन्हें जांच लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uokviri cijeli račun. Ispunjavamo iznos, datum i opis; ti ih provjeravaš prije spremanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keretezd be a teljes nyugtát. Kitöltjük az összeget, a dátumot és a leírást; mentés előtt ellenőrizd őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan seluruh struk ke dalam bingkai. Kami isi nominal, tanggal, dan deskripsinya; kamu memeriksanya sebelum menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra lo scontrino intero. Compiliamo importo, data e descrizione; tu li controlli prima di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシート全体を枠に収めてください。金額、日付、内容を入力するので、保存前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증 전체가 화면에 들어오게 하세요. 금액, 날짜, 설명을 채워 드리고, 저장하기 전에 확인할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
