            "value" : "গ্রুপের যে কেউ এটি সম্পাদনা করতে বা মুছতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol persona del grup la pot editar o suprimir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli ze skupiny ho může upravit nebo smazat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle i gruppen kan redigere eller slette den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
