    "%@ deleted the group “%@”." : {
      "comment" : "A toast on the groups: someone else deleted a group; the first %@ is who, the second the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: حذف المجموعة «%@»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Gruppe „%2$@“ gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eliminó el grupo “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a supprimé le groupe « %2$@ »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: מחיקת הקבוצה \"%@\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने “%@” ग्रुप हटा दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghapus grup “%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha eliminato il gruppo «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がグループ「%@」を削除しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 ‘%@’ 그룹을 삭제했어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de groep “%2$@” verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skasował(a) grupę „%2$@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou o grupo “%2$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ удалил(а) группу «%@»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ลบกลุ่ม “%2$@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ “%@” grubunu sildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ видалив(-ла) групу «%@»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã xóa nhóm “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@删除了群组“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@刪除了群組「%@」。"
          }
        }
      }
    },
    "%@ deleted “%@” after everyone settled up. Nothing was left open, and the group leaves your list." : {
      "comment" : "Someone else deleted the group while it was open; the first %@ is who, the second the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: حذف «%@» بعد أن تمت التسوية بين الجميع. لم يبقَ شيء مفتوح، وتخرج المجموعة من قائمتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat „%2$@“ gelöscht, nachdem alle beglichen hatten. Nichts war mehr offen, und die Gruppe verschwindet aus deiner Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eliminó “%2$@” después de que todos saldaron cuentas. No quedó nada pendiente, y el grupo sale de tu lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a supprimé « %2$@ » après que tout le monde a réglé. Il ne restait rien d’ouvert, et le groupe quitte ta liste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: מחיקת \"%@\" אחרי שכולם סגרו חשבון. לא נשאר שום דבר פתוח, והקבוצה יוצאת מהרשימה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने सबका हिसाब बराबर होने के बाद “%@” हटा दिया। कुछ भी बाकी नहीं था, और ग्रुप आपकी सूची से हट जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghapus “%@” setelah semua lunas. Tidak ada yang tersisa, dan grup ini hilang dari daftarmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha eliminato «%@» dopo che tutti avevano saldato. Non era rimasto nulla in sospeso e il gruppo esce dalla tua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が精算した後、%@が「%@」を削除しました。未精算のものはなく、グループはリストから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 모두 정산한 뒤 ‘%@’ 그룹을 삭제했어요. 미정산 금액은 없었고, 그룹은 목록에서 사라져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft “%2$@” verwijderd nadat iedereen had verrekend. Er stond niets meer open en de groep verdwijnt uit je lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skasował(a) „%2$@” po pełnym rozliczeniu. Nic nie zostało otwarte, a grupa znika z twojej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois que todo mundo acertou. Nada ficou pendente, e o grupo sai da sua lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois de toda a gente acertar. Nada ficou pendente, e o grupo sai da tua lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ удалил(а) «%@» после того, как все рассчитались. Ничего не осталось открытым, и группа уходит из твоего списка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ลบ “%2$@” หลังจากทุกคนเคลียร์ยอดแล้ว ไม่มียอดค้าง และกลุ่มจะหายไปจากรายการของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, herkes hesaplaştıktan sonra “%@” grubunu sildi. Açık bir şey kalmadı ve grup listenden çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ видалив(-ла) «%@» після того, як усі розрахувалися. Нічого не залишилося відкритим, і група зникає з твого списку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã xóa “%@” sau khi mọi người thanh toán xong. Không còn gì chưa trả, và nhóm sẽ rời khỏi danh sách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人结清后，%@删除了“%@”。没有未结清的款项，群组将从你的列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人結清後，%@刪除了「%@」。沒有未結清的款項，群組將從你的清單中移除。"
          }
        }
      }
    },
