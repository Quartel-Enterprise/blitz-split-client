    "Friends join the group without creating an account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينضم الأصدقاء إلى المجموعة دون إنشاء حساب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятелите се присъединяват към групата, без да създават акаунт."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধুরা অ্যাকাউন্ট না খুলেই গ্রুপে যোগ দিতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelé se ke skupině připojí bez vytváření účtu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde treten der Gruppe bei, ohne ein Konto zu erstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι μπαίνουν στην ομάδα χωρίς να δημιουργήσουν λογαριασμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos entran al grupo sin crear una cuenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوستان بدون ایجاد حساب کاربری به گروه می‌پیوندند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumasali ang mga kaibigan sa grupo nang hindi gumagawa ng account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les amis rejoignent le groupe sans créer de compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חברים מצטרפים לקבוצה בלי ליצור חשבון משתמש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्त बिना अकाउंट बनाए ग्रुप से जुड़ते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijatelji ulaze u grupu bez stvaranja računa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barátok fiók létrehozása nélkül csatlakoznak a csoporthoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teman bergabung ke grup tanpa membuat akun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli amici entrano nel gruppo senza creare un account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達はアカウントを作成せずにグループに参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들은 계정을 만들지 않고도 그룹에 참여해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakan menyertai kumpulan tanpa mencipta akaun."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrienden doen mee met de groep zonder een account aan te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajomi dołączają do grupy bez zakładania konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os amigos entram no grupo sem criar conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prietenii intră în grup fără să-și creeze cont."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друзья присоединяются к группе без создания аккаунта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priatelia vstúpia do skupiny bez vytvárania účtu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijatelji se pridružuju grupi bez pravljenja naloga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänner går med i gruppen utan att skapa ett konto."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நண்பர்கள் அக்கவுண்ட் உருவாக்காமலேயே குழுவில் சேரலாம்."
          }
