    "Bills you paid or take part in, in any group, show up here." : {
      "comment" : "All expenses' empty state",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا الفواتير التي دفعتها أو تشارك فيها، في أي مجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разходите, които си платил(а) или в които участваш, във всяка група, се показват тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো গ্রুপে আপনি যেসব বিল পরিশোধ করেছেন বা যেগুলোতে আছেন, সেগুলো এখানে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí apareixen les despeses que has pagat o en què participes, de qualsevol grup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí se tu výdaje, které jsi zaplatil(a) nebo ve kterých jsi, v jakékoli skupině."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udgifter, du har betalt eller er med i, i enhver gruppe, vises her."
