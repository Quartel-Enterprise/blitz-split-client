    "The current link and QR code stop working, unused personal invites included. Whoever already joined stays in the group." : {
      "comment" : "Invite: the message of the alert before changing the link",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف الرابط ورمز QR الحاليان عن العمل، بما فيها الدعوات الشخصية غير المستخدمة. من انضم بالفعل يبقى في المجموعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Link und QR-Code funktionieren nicht mehr, auch nicht genutzte persönliche Einladungen. Wer schon beigetreten ist, bleibt in der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace y el código QR actuales dejan de funcionar, incluidas las invitaciones personales sin usar. Quienes ya se unieron siguen en el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien et le QR code actuels cessent de fonctionner, y compris les invitations personnelles non utilisées. Les personnes déjà entrées restent dans le groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישור וקוד ה-QR הנוכחיים יפסיקו לעבוד, כולל הזמנות אישיות שלא נוצלו. מי שכבר הצטרף נשאר בקבוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा लिंक और QR कोड काम करना बंद कर देंगे, बिना इस्तेमाल हुए निजी आमंत्रण भी। जो पहले से जुड़ चुके हैं, वे ग्रुप में बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan dan kode QR saat ini berhenti berfungsi, termasuk undangan pribadi yang belum dipakai. Yang sudah bergabung tetap di grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link e il codice QR attuali smettono di funzionare, compresi gli inviti personali non usati. Chi ha già aderito resta nel gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のリンクとQRコードは、未使用の個別招待も含めて使えなくなります。すでに参加している人はグループに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하지 않은 개인 초대를 포함해 현재 링크와 QR 코드가 더 이상 작동하지 않아요. 이미 참여한 사람은 그룹에 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige link en QR-code werken niet meer, ook ongebruikte persoonlijke uitnodigingen niet. Wie al lid is, blijft in de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecny link i kod QR przestaną działać, w tym niewykorzystane zaproszenia osobiste. Kto już dołączył, zostaje w grupie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link e o QR code atuais deixam de funcionar, inclusive os convites pessoais ainda não usados. Quem já entrou continua no grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая ссылка и QR-код перестанут работать, включая неиспользованные личные приглашения. Те, кто уже присоединился, останутся в группе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลิงก์และคิวอาร์โค้ดปัจจุบันจะใช้ไม่ได้ รวมถึงคำเชิญส่วนตัวที่ยังไม่ได้ใช้ คนที่เข้าร่วมแล้วยังอยู่ในกลุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut bağlantı ve QR kodu, kullanılmamış kişisel davetler dahil, çalışmayı durdurur. Zaten katılmış olanlar grupta kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточне посилання й QR-код перестануть працювати, разом з невикористаними особистими запрошеннями. Хто вже приєднався, залишиться в групі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết và mã QR hiện tại sẽ ngừng hoạt động, kể cả các lời mời riêng chưa dùng. Ai đã tham gia vẫn ở lại trong nhóm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前的链接和二维码将失效，包括尚未使用的专属邀请。已加入的人会留在群组中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的連結和QR Code將失效，包括尚未使用的專屬邀請。已加入的人會留在群組中。"
          }
        }
      }
    },
    "The group is gone for %@. This can't be undone." : {
      "comment" : "Deleting a group with no bills; %@ is “all 5 members”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختفي المجموعة لدى %@. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe verschwindet für %@. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grupo desaparece para %@. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le groupe disparaît pour %@. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבוצה תימחק עבור %@. אי אפשר לבטל את הפעולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रुप %@ के लिए हट जाएगा। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup ini hilang untuk %@. Ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gruppo sparisce per %@. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループは%@から削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 그룹이 사라져요. 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De groep verdwijnt voor %@. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa zniknie dla %@. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O grupo some para %@. Não dá para desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группа исчезнет для %@. Это нельзя отменить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มจะหายไปสำหรับ%@ ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup %@ için silinir. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Група зникне для %@. Це не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhóm sẽ biến mất với %@. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群组将对%@消失。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群組將對%@消失。此操作無法復原。"
          }
        }
      }
    },
