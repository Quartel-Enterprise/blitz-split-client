    "Edit freely: it stays saved on this %@ and goes up when the connection is back." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّل بحرية: يبقى محفوظًا على %@ هذا ويُرفع عند عودة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite nach Belieben: Es bleibt auf diesem %@ gespeichert und wird hochgeladen, wenn die Verbindung zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita con libertad: queda guardado en este %@ y se sube cuando vuelva la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie librement : tout reste enregistré sur ton %@ et part quand la connexion revient."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לערוך בחופשיות: הכול נשמר ב-%@ הזה ויעלה כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेझिझक बदलें: यह इस %@ पर सहेजा रहता है और कनेक्शन वापस आने पर अपलोड हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit sesukamu: tetap tersimpan di %@ ini dan terunggah saat koneksi kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica liberamente: resta salvato su questo %@ e viene caricato quando torna la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由に編集できます。この%@に保存され、接続が戻るとアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자유롭게 수정하세요. 이 %@에 저장되고, 연결이 돌아오면 업로드돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerk gerust: het blijft bewaard op deze %@ en gaat omhoog zodra de verbinding terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj śmiało: zmiany zostają zapisane na tym urządzeniu (%@) i zostaną wysłane, gdy wróci połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode editar à vontade: fica salvo neste %@ e sobe quando a conexão voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes editar à vontade: fica guardado neste %@ e é enviado quando a ligação voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняй спокойно: всё сохранится на этом %@ и отправится, когда вернётся подключение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แก้ไขได้ตามสบาย ข้อมูลจะบันทึกไว้บน %@ นี้ และอัปโหลดเมื่อกลับมาเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatça düzenle: bu %@ üzerinde kayıtlı kalır ve bağlantı gelince yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюй вільно: усе зберігається на цьому пристрої (%@) і надійде, коли повернеться з'єднання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cứ sửa thoải mái: thay đổi được lưu trên %@ này và được tải lên khi có kết nối trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放心编辑：更改会保存在这台%@上，恢复联网后上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放心編輯：更改會儲存在這台%@上，恢復連線後上傳。"
          }
        }
      }
    },
