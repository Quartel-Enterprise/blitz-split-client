        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email ở đây để bạn biết mình đang đăng nhập bằng tài khoản nào. Những người trong nhóm thấy tên và ảnh của bạn, không bao giờ thấy email."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示邮箱是为了让你知道自己登录的是哪个账号。群组里的人只能看到你的名字和照片，永远看不到你的邮箱。"
