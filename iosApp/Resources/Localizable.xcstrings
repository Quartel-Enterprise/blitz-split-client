        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chưa có ai: %@ nằm ngoài phần chia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@还没有人认领：%@未计入分摊。"
