    "Members who owe get a notification, on their own clock." : {
      "comment" : "Caption under the group's reminder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل إشعار إلى من عليهم مبالغ من الأعضاء، حسب توقيتهم المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder mit offenen Schulden erhalten eine Benachrichtigung, nach ihrer eigenen Uhr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien debe recibe una notificación, según su propia hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres qui doivent reçoivent une notification, à leur propre heure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שחייב מקבל התראה, לפי השעון שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन सदस्यों को पैसे देने हैं, उन्हें उनके अपने समय के हिसाब से नोटिफ़िकेशन मिलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anggota yang berutang menerima notifikasi sesuai jam mereka sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi deve riceve una notifica, secondo il proprio orario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いが残っているメンバーには、それぞれの時刻で通知が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빚이 있는 멤버는 각자의 시간에 맞춰 알림을 받아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leden die iets verschuldigd zijn krijgen een melding, op hun eigen tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Członkowie, którzy są winni, dostają powiadomienie według własnego zegara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem deve recebe uma notificação, no horário do próprio aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Участники с долгом получают уведомление по своим часам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมาชิกที่ค้างอยู่จะได้รับการแจ้งเตือนตามเวลาท้องถิ่นของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borcu olan üyeler, kendi saatlerine göre bildirim alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учасники з боргом отримують сповіщення за власним часом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành viên đang nợ sẽ nhận được thông báo, theo giờ của chính họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有欠款的成员会按各自的当地时间收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有欠款的成員會按各自的當地時間收到通知。"
          }
        }
      }
    },
