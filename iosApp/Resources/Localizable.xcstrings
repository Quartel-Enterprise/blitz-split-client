        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Află când cineva înregistrează o plată sau îți cere bani."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнавай, когда кто-то записывает платёж или просит тебя заплатить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozveď sa, keď niekto zaznamená platbu alebo ťa požiada o zaplatenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvedi, ko nekdo zabeleži plačilo ali te prosi za plačilo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saznaj kad neko zabeleži uplatu ili traži da platiš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få veta när någon registrerar en betalning eller ber dig betala."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jua mtu anaporekodi malipo au anapokuomba ulipe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "யாராவது பேமெண்ட்டைப் பதிவு செய்தால் அல்லது உங்களைச் செலுத்தச் சொன்னால் தெரிந்துகொள்ளுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎవరైనా చెల్లింపును నమోదు చేసినప్పుడు లేదా మిమ్మల్ని చెల్లించమని అడిగినప్పుడు తెలుసుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ทันทีเมื่อมีคนบันทึกการจ่ายเงินหรือขอเงินจากคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri ödeme kaydettiğinde veya senden ödeme istediğinde haberin olsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дізнавайся, коли хтось записує платіж або просить тебе заплатити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کوئی ادائیگی درج کرے یا آپ سے ادائیگی مانگے تو جانیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết khi ai đó ghi nhận thanh toán hoặc yêu cầu bạn trả tiền."
          }
        },
        "zh-Hans" : {
