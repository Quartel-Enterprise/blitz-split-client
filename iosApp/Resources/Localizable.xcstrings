            "value" : "Nessuna connessione: puoi comunque selezionare tutto. La spesa resta salvata su questo iPhone e si sincronizza quando ti riconnetti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: nadal możesz wszystko zaznaczyć. Wydatek zostaje zapisany na tym iPhonie i zsynchronizuje się po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: dá para marcar tudo. A conta fica salva neste iPhone e sincroniza ao reconectar."
          }
        }
      }
    },
