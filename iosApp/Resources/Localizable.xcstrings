    "If it was you, ask %@ to release the name in Members." : {
      "comment" : "The group's creator, who can release a member taken by someone else on the Members screen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كنت أنت، فاطلب من %@ تحرير الاسم في «الأعضاء»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако си бил(а) ти, помоли %@ да освободи името в Членове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি এটি আপনি হয়ে থাকেন, “সদস্য” অংশ থেকে নামটি ছেড়ে দিতে %@-কে বলুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi to byl(a) ty, požádej uživatele %@, aby uvolnil(a) jméno v Členech."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, bitte %@, den Namen unter „Mitglieder“ freizugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ήσουν εσύ, ζήτησε από %@ να αποδεσμεύσει το όνομα στα Μέλη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuiste tú, pide a %@ que libere el nombre en Miembros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر خودتان بودید، از %@ بخواهید نام را در بخش اعضا آزاد کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung ikaw ito, hilingin kay %@ na palayain ang pangalan sa Mga miyembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c’était toi, demande à %@ de libérer le nom dans Membres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ההצטרפות הייתה שלך, אפשר לבקש מ-%@ לשחרר את השם ב\"משתתפים\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह आप थे, तो %@ से सदस्य में जाकर नाम खाली करने के लिए कहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako si to bio/la ti, zamoli osobu %@ da oslobodi ime u Članovima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha te voltál, kérd meg, hogy szabadítsa fel a nevet a Tagoknál: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau itu kamu, minta %@ melepas nama itu di Anggota."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eri tu, chiedi a %@ di liberare il nome in Membri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身の場合は、%@に「メンバー」で名前を解放してもらってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인이라면 멤버 화면에서 이름을 해제해 달라고 %@ 님에게 요청하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika itu anda, minta %@ melepaskan nama itu dalam Ahli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jij het? Vraag %@ om de naam vrij te geven bij Leden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to ty, poproś twórcę grupy (%@) o zwolnienie imienia w Członkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se era você, peça para %@ liberar o nome em Membros."
