    "An app term. Restore default brings it back as it came." : {
      "comment" : "Edit term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصطلح من التطبيق. «استعادة الافتراضي» تعيده كما كان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Begriff der App. „Standard wiederherstellen“ bringt ihn wie ursprünglich zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un término de la app. Restaurar predeterminado lo devuelve como venía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terme de l’app. Rétablir par défaut le remet tel qu’il était."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מונח של האפליקציה. \"שחזור ברירת המחדל\" מחזיר אותו כמו שהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का शब्द। डिफ़ॉल्ट वापस लाएं इसे वैसे ही लौटा देता है जैसा यह आया था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata bawaan aplikasi. Pulihkan default mengembalikannya seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un termine dell’app. Ripristina predefinita lo riporta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの単語です。「デフォルトに戻す」で元の状態に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 기본 키워드예요. 기본값 복원을 누르면 원래대로 돌아와요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een term van de app. Standaard herstellen zet hem terug zoals hij was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowo z aplikacji. „Przywróć domyślne” przywraca je w pierwotnej postaci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termo do app. Restaurar padrão traz de volta como veio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termo da app. Restaurar predefinição traz-o de volta como veio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слово приложения. «Восстановить по умолчанию» вернёт его таким, каким оно было."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำของแอป คืนค่าเริ่มต้นจะนำกลับมาเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama terimi. Varsayılana dön, onu geldiği hâline getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін застосунку. «Відновити типове» повертає його таким, яким він був."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ khóa của ứng dụng. Khôi phục mặc định sẽ đưa nó về như ban đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用自带的关键词。“恢复默认”会将其还原为初始状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App內建的關鍵字。「還原預設」會將其還原為初始狀態。"
          }
        }
      }
    },
