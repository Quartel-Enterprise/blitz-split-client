        }
      }
    },
    "Payments go back to being between whoever split each bill. Totals don't change." : {
      "comment" : "Simplify debts: what turning it off does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الدفعات لتكون بين من قسّموا كل فاتورة. الإجماليات لا تتغير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen laufen wieder zwischen denen, die die jeweilige Ausgabe geteilt haben. Die Summen ändern sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos vuelven a ser entre quienes dividieron cada gasto. Los totales no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements redeviennent ceux entre les personnes qui ont partagé chaque dépense. Les totaux ne changent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלומים חוזרים להיות בין מי שפיצלו כל חשבון. הסכומים הכוללים לא משתנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान फिर से उन्हीं लोगों के बीच होंगे जिन्होंने हर खर्च बांटा। कुल नहीं बदलते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran kembali terjadi di antara orang yang membagi setiap tagihan. Totalnya tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti tornano a essere tra chi ha diviso ogni spesa. I totali non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いは各支出を割り勘した人同士に戻ります。合計は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 다시 각 지출을 나눈 사람끼리 이뤄져요. 합계는 바뀌지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen gaan weer tussen wie elke uitgave heeft verdeeld. De totalen veranderen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności znów odbywają się między osobami, które dzieliły dany wydatek. Sumy się nie zmieniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Os totais não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежи снова будут между теми, кто делил каждый счёт. Итоги не меняются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจ่ายเงินจะกลับไปเป็นระหว่างคนที่หารแต่ละบิล ยอดรวมไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemeler yeniden her harcamayı bölenler arasında olur. Toplamlar değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежі знову будуть між тими, хто ділив кожен рахунок. Підсумки не змінюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản thanh toán sẽ quay lại giữa những người đã chia từng khoản chi. Tổng không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款会恢复为在共同分摊每笔账单的人之间进行。总额不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款會恢復為在共同分攤每筆帳單的人之間進行。總額不變。"
          }
        }
      }
    },
    "%@ already has the fewest payments. Turn it on anyway and the next bills come in simplified." : {
      "comment" : "Simplify debts: the confirmation when nothing drops; %@ is the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الدفعات في %@ في حده الأدنى بالفعل. يمكنك التفعيل على أي حال لتأتي الفواتير التالية مبسّطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat schon die wenigsten Zahlungen. Schalte es trotzdem ein, und die nächsten Ausgaben kommen vereinfacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene el mínimo de pagos. Actívalo de todos modos y los próximos gastos entrarán simplificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a déjà le minimum de paiements. Active-le quand même et les prochaines dépenses arriveront simplifiées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-%@ כבר יש הכי מעט תשלומים. אפשר להפעיל בכל זאת, והחשבונות הבאים ייכנסו מפושטים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ में पहले से सबसे कम भुगतान हैं। फिर भी चालू करें, तो अगले खर्च सरल होकर आएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah punya pembayaran paling sedikit. Aktifkan saja dan tagihan berikutnya akan langsung disederhanakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha già il minor numero di pagamenti. Attivalo comunque e le prossime spese arriveranno semplificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに支払い回数が最少です。それでもオンにすると、次の支出からシンプルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 그룹은 이미 송금 횟수가 최소예요. 그래도 켜면 다음 지출부터 간소화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft al het minste aantal betalingen. Zet het toch aan, dan komen de volgende uitgaven vereenvoudigd binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %@ ma już najmniej płatności. Włącz mimo to, a kolejne wydatki będą upraszczane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está no mínimo. Ligue mesmo assim, e as próximas contas já entram simplificadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está no mínimo. Liga mesmo assim, e as próximas contas já entram simplificadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В группе %@ уже минимум платежей. Включи всё равно, и следующие счета будут упрощаться."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” มีจำนวนการจ่ายเงินน้อยที่สุดแล้ว ถ้าเปิดอยู่ดี บิลถัดไปจะเข้ามาแบบลดความซับซ้อนแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubunda zaten en az ödeme var. Yine de açarsan sonraki harcamalar sadeleştirilmiş gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У групі %@ уже найменше платежів. Увімкни все одно, і наступні рахунки надходитимуть спрощеними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã có ít khoản thanh toán nhất. Nếu vẫn bật, các khoản chi tiếp theo sẽ được đơn giản hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的付款笔数已是最少。仍然开启的话，之后的账单会以简化后的方式计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」的付款筆數已是最少。仍然開啟的話，之後的帳單會以簡化後的方式計入。"
          }
        }
      }
    },
    "Everyone keeps paying or receiving the same total. Only who pays whom changes." : {
      "comment" : "Simplify debts: what turning it on does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى إجمالي ما يدفعه أو يستلمه كل شخص كما هو. يتغير فقط من يدفع لمن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zahlen oder bekommen weiter dieselbe Summe. Nur wer wen bezahlt, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada persona sigue pagando o recibiendo el mismo total. Solo cambia quién le paga a quién."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun continue de payer ou de recevoir le même total. Seul change qui paie qui."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל אחד ממשיך לשלם או לקבל אותו סכום כולל. רק מי משלם למי משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कोई उतना ही कुल देता या पाता रहेगा। सिर्फ़ यह बदलेगा कि कौन किसे भुगतान करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua tetap membayar atau menerima total yang sama. Hanya siapa membayar ke siapa yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno continua a pagare o ricevere lo stesso totale. Cambia solo chi paga chi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が支払う・受け取る合計額は変わりません。誰が誰に支払うかだけが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 같은 합계를 계속 내거나 받아요. 누가 누구에게 내는지만 바뀌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen blijft hetzelfde totaal betalen of ontvangen. Alleen wie wie betaalt, verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy nadal płaci lub otrzymuje tę samą sumę. Zmienia się tylko, kto komu płaci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pessoa continua pagando ou recebendo o mesmo total. Só muda quem paga a quem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pessoa continua a pagar ou a receber o mesmo total. Só muda quem paga a quem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый продолжает платить или получать ту же сумму. Меняется только, кто кому платит."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนยังจ่ายหรือได้รับยอดรวมเท่าเดิม แค่เปลี่ยนว่าใครจ่ายให้ใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkes aynı toplamı ödemeye ya da almaya devam eder. Yalnızca kimin kime ödediği değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен і далі платить чи отримує ту саму загальну суму. Змінюється лише те, хто кому платить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người vẫn trả hoặc nhận cùng một tổng số. Chỉ thay đổi ai trả cho ai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个人要付或要收的总额不变，只改变谁付给谁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個人要付或要收的總額不變，只改變誰付給誰。"
          }
        }
      }
    },
