    "%@ is a guest without the app. They only learn about it from this message, so it already says what went into the bill." : {
      "comment" : "Request to a guest",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App und erfährt es nur aus dieser Nachricht, daher steht schon drin, was in die Ausgabe eingeflossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Solo se entera por este mensaje, así que ya incluye lo que entró en el gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. La personne ne le saura que par ce message, qui précise donc déjà ce qui compose la dépense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Lo saprà solo da questo messaggio, quindi spiega già cosa c’era nella spesa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to gość bez aplikacji. Dowie się o tym tylko z tej wiadomości, więc od razu wyjaśnia ona, z czego wynika kwota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem o app. Só fica sabendo por esta mensagem, então ela já leva o que entrou na conta."
