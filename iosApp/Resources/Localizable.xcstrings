        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধুরা আপনাকে কী নামে ডাকেন?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com et diuen els teus amics?"
          }
        },
        "cs" : {
