        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ choisit son nom dans la liste ou rejoint comme nouveau membre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: בחירת שם מהרשימה או הצטרפות כמשתתף חדש."
