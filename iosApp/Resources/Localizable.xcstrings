    "You picked %@. By the map it would be %@ (“%@”)." : {
      "comment" : "Under a bill's description: the category picked by hand differs from the map's",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt. Laut Zuordnung wäre es %2$@ („%3$@“)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegiste %1$@. Según el mapa sería %2$@ (“%3$@”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as choisi %1$@. D’après la carte, ce serait %2$@ (« %3$@ »)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memilih %@. Menurut peta, seharusnya %@ (“%@”)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto %@. Secondo la mappa sarebbe %@ («%@»)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選びました。マップでは%@（「%@」）になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je koos %1$@. Volgens de kaart zou het %2$@ zijn (“%3$@”)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano %1$@. Według mapy byłaby to kategoria %2$@ („%3$@”)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolheu %1$@. Pelo mapa seria %2$@ (“%3$@”)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin: %@. Haritaya göre %@ olurdu (“%@”)."
          }
        }
      }
    },
    "You picked %@. By the map it would be %@ (“%@”). On saving, we ask whether the map learns." : {
      "comment" : "Under a bill's description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt. Laut Zuordnung wäre es %2$@ („%3$@“). Beim Speichern fragen wir, ob die Zuordnung dazulernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegiste %1$@. Según el mapa sería %2$@ (“%3$@”). Al guardar, te preguntaremos si el mapa aprende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as choisi %1$@. D’après la carte, ce serait %2$@ (« %3$@ »). À l’enregistrement, on te demande si la carte apprend."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memilih %@. Menurut peta, seharusnya %@ (“%@”). Saat menyimpan, kami bertanya apakah peta perlu belajar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto %@. Secondo la mappa sarebbe %@ («%@»). Al salvataggio ti chiediamo se la mappa deve impararlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選びました。マップでは%@（「%@」）になります。保存するときに、マップに覚えさせるか確認します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je koos %1$@. Volgens de kaart zou het %2$@ zijn (“%3$@”). Bij het opslaan vragen we of de kaart dit leert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano %1$@. Według mapy byłaby to kategoria %2$@ („%3$@”). Przy zapisie zapytamy, czy mapa ma się tego nauczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolheu %1$@. Pelo mapa seria %2$@ (“%3$@”). Ao salvar, perguntamos se o mapa aprende."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin: %@. Haritaya göre %@ olurdu (“%@”). Kaydederken haritanın öğrenip öğrenmeyeceğini sorarız."
          }
        }
      }
    },
    "You've used the app on your phone since %@. This code always stays in Settings, for when you change iPhones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
