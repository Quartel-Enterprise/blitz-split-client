    "Whoever is in the group opens it with their own account to see and comment." : {
      "comment" : "Share bill: who opens a members-only link, when nobody else joined",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتحه أعضاء المجموعة بحساباتهم لرؤيته والتعليق عليه."
          }
        },
        "de" : {
          "stringUnit" : {
