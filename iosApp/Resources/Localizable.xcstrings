    "Whoever is in the group opens it with their own account to see and comment." : {
      "comment" : "Share bill: who opens a members-only link, when nobody else joined",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Gruppe ist, öffnet ihn mit dem eigenen Konto, um die Ausgabe anzusehen und zu kommentieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien está en el grupo entra con su propia cuenta para ver y comentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres du groupe l’ouvrent avec leur propre compte pour voir et commenter."
          }
        },
        "id" : {
          "stringUnit" : {
