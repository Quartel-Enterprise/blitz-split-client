    "Use shares when someone has more, like who brought a plus-one." : {
      "comment" : "Hint of the split by shares",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الحصص عندما يكون لأحد نصيب أكبر، كمن أحضر مرافقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Anteile, wenn jemand mehr hat, etwa wer eine Begleitung mitgebracht hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa partes cuando alguien consume más, como quien llevó acompañante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les parts quand quelqu’un a plus, comme quelqu’un venu avec un invité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי להשתמש בחלקים כשלמישהו יש יותר, למשל למי שהגיע עם מלווה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब किसी का हिस्सा ज़्यादा हो, जैसे जो किसी मेहमान को साथ लाया हो, तब हिस्से इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakai bagian saat seseorang punya lebih banyak, seperti yang membawa teman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le quote quando qualcuno ha di più, come chi ha portato un accompagnatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同伴者を連れてきた人など、多めに負担する人がいるときは口数を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 더 많이 쓴 경우 비율을 사용하세요. 예: 동반자를 데려온 사람."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik aandelen als iemand meer heeft, zoals wie iemand meeneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj udziałów, gdy komuś przypada więcej, np. przy osobie towarzyszącej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use partes quando alguém consome mais, como quem levou acompanhante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa partes quando alguém consome mais, como quem levou acompanhante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй доли, когда у кого-то больше, например у того, кто пришёл с гостем."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้แบบส่วนเมื่อบางคนมีมากกว่า เช่น คนที่พาเพื่อนมาด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birinin payı daha fazlaysa pay kullan, örneğin yanında birini getirdiyse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуй частки, коли в когось більше, наприклад хто прийшов з парою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng phần khi ai đó dùng nhiều hơn, như người dẫn thêm bạn đi cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人分摊得更多时用份数，比如带了朋友来的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人分攤得更多時用份數，例如帶了朋友來的人。"
          }
        }
      }
    },
