    "Your groups and anyone with your profile link see your name and photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترى مجموعاتك وكل من لديه رابط ملفك الشخصي اسمك وصورتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen und alle mit dem Link zu deinem Profil sehen deinen Namen und dein Foto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grupos y quien tenga el enlace de tu perfil ven tu nombre y tu foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes groupes et toute personne ayant le lien de ton profil voient ton nom et ta photo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבוצות שלך וכל מי שיש לו את קישור הפרופיל שלך רואים את השם והתמונה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके ग्रुप और जिनके पास आपकी प्रोफ़ाइल का लिंक है, वे आपका नाम और फ़ोटो देखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupmu dan siapa pun yang punya tautan profilmu melihat nama dan fotomu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi gruppi e chiunque abbia il link del tuo profilo vedono il tuo nome e la tua foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループのメンバーと、プロフィールのリンクを持っている人には、名前と写真が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 그룹 사람들과 내 프로필 링크가 있는 사람은 내 이름과 사진을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je groepen en iedereen met de link naar je profiel zien je naam en foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje grupy i każdy, kto ma link do twojego profilu, widzą twoje imię i zdjęcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus grupos e quem tiver o link do seu perfil veem seu nome e sua foto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus grupos e quem tiver o link do teu perfil veem o teu nome e a tua fotografia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои группы и все, у кого есть ссылка на твой профиль, видят твоё имя и фото."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มของคุณและทุกคนที่มีลิงก์โปรไฟล์ของคุณจะเห็นชื่อและรูปภาพของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupların ve profil bağlantına sahip olan herkes adını ve fotoğrafını görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої групи й усі, хто має посилання на твій профіль, бачать твоє ім'я та фото."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nhóm của bạn và bất kỳ ai có liên kết hồ sơ của bạn đều thấy tên và ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的群组成员以及拥有你个人资料链接的人都能看到你的名字和照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的群組成員以及擁有你個人資料連結的人都能看到你的名字和照片。"
          }
        }
      }
    },
