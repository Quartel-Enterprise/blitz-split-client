    "Doesn't have the app: let them know with Request." : {
      "comment" : "Simplify debts: a guest whose payments change",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون التطبيق: يمكنك الإبلاغ عبر «طلب الدفع»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма приложението: уведоми го с Поискай."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তাঁর অ্যাপ নেই: “টাকা চান” দিয়ে তাঁকে জানান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemá aplikaci: dej vědět přes Požádat o platbu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat die App nicht: Sag Bescheid mit „Anfordern“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει την εφαρμογή: ενημέρωσε το άτομο με το «Ζήτησε πληρωμή»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene la app: avísale con Cobrar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه را ندارد: با «درخواست» به او خبر دهید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang app: ipaalam sa kanila gamit ang Hilingin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’a pas l’app : préviens cette personne avec Demander."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי האפליקציה: אפשר לעדכן עם \"בקשת תשלום\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनके पास ऐप नहीं है: “पैसे मांगें” से इन्हें बताएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema aplikaciju: obavijesti ga putem Zatraži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs meg neki az app: szólj neki a Kéréssel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak punya aplikasinya: beri tahu lewat Tagih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha l’app: avvisalo con Richiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを使っていません：「請求」で知らせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 없어요: 요청으로 알려 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada aplikasi: maklumkan kepada mereka dengan Minta bayaran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft de app niet: laat het weten met Vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma aplikacji: powiadom tę osobę przez „Poproś o zwrot”."
          }
