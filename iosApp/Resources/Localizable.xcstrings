          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてこの%@に保存され、あとで同期されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft op je %@ en synchroniseert later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zostaje na twoim urządzeniu (%@) i zsynchronizuje się później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no %@ e sincroniza depois."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey %@ üzerinde kalır ve daha sonra eşitlenir."
          }
        }
