    "The link was changed or the group was deleted. Ask whoever invited you for a new link." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير الرابط أو حذف المجموعة. اطلب رابطًا جديدًا ممن دعاك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линкът беше променен или групата беше изтрита. Помоли поканилия те за нов линк."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লিংকটি বদলে গেছে অথবা গ্রুপটি মুছে ফেলা হয়েছে। যিনি আমন্ত্রণ জানিয়েছেন তাঁর কাছে নতুন লিংক চান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enllaç s’ha canviat o el grup s’ha suprimit. Demana un enllaç nou a qui t’ha convidat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz byl změněn nebo skupina smazána. Požádej toho, kdo tě pozval, o nový odkaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linket er blevet ændret, eller gruppen er slettet. Bed den, der inviterede dig, om et nyt link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link wurde geändert oder die Gruppe gelöscht. Bitte die Person, die dich eingeladen hat, um einen neuen Link."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο σύνδεσμος άλλαξε ή η ομάδα διαγράφηκε. Ζήτησε νέο σύνδεσμο από αυτόν που σε προσκάλεσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace se cambió o el grupo fue eliminado. Pide un enlace nuevo a quien te invitó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linki on muudetud või grupp on kustutatud. Palu kutsujalt uus link."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینک تغییر کرده یا گروه حذف شده است. از کسی که شما را دعوت کرده یک لینک جدید بخواهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkkiä on muutettu tai ryhmä on poistettu. Pyydä kutsujalta uusi linkki."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabago ang link o nabura ang grupo. Humingi ng bagong link sa nag-imbita sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien a été changé ou le groupe a été supprimé. Demande un nouveau lien à la personne qui t’a invité."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "લિંક બદલાઈ ગઈ છે અથવા ગ્રુપ ડિલીટ થઈ ગયું છે. જેમણે તમને આમંત્રણ આપ્યું હોય તેમની પાસે નવી લિંક માગો."
