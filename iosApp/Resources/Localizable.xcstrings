    "Changing the total later rescales the amounts." : {
      "comment" : "Hint of the split by amount",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الإجمالي لاحقًا يعيد ضبط المبالغ بالتناسب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако по-късно промениш общата сума, сумите се преизчисляват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরে মোট বদলালে পরিমাণগুলো সেই অনুপাতে বদলে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozdější změna celkové částky částky poměrně přepočítá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Summe später änderst, werden die Beträge angepasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αλλάξεις το σύνολο αργότερα, τα ποσά προσαρμόζονται αναλογικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el total después reajusta los montos proporcionalmente."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el total después reajusta los importes proporcionalmente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییر مجموع در آینده، مبالغ را به همان نسبت تغییر می‌دهد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag pinalitan ang kabuuan mamaya, mababago ang sukat ng mga halaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer le total plus tard redimensionne les montants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינוי הסה״כ בהמשך משנה את הסכומים באופן יחסי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाद में कुल बदलने पर रकमें उसी अनुपात में बदल जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasnija promjena ukupnog iznosa proporcionalno mijenja iznose."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha később módosítod a végösszeget, az összegek arányosan változnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah total nanti akan menyesuaikan nominalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cambi il totale in seguito, gli importi vengono riproporzionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで合計を変更すると、金額は比例して調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 총액을 바꾸면 금액이 비례해서 조정돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menukar jumlah keseluruhan kemudian akan melaraskan semula amaun."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je het totaal later wijzigt, worden de bedragen herschaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Późniejsza zmiana sumy przeskaluje kwoty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o total depois refaz os valores proporcionalmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă schimbi totalul mai târziu, sumele se ajustează proporțional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если позже изменить сумму, суммы участников пересчитаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neskoršia zmena celkovej sumy pomerne upraví sumy."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako kasnije promeniš ukupan iznos, iznosi se prilagođavaju srazmerno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du ändrar totalen senare skalas beloppen om."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பின்னர் மொத்தத்தை மாற்றினால், தொகைகள் விகிதப்படி மாறும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนยอดรวมภายหลังจะปรับจำนวนเงินตามสัดส่วน"
