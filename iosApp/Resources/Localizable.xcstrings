    "Payments go back to being between whoever split each bill. No bill or recorded payment changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الدفعات لتكون بين من قسّموا كل فاتورة. لا تتغير أي فاتورة أو دفعة مسجّلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащанията отново са между тези, които са разделили всеки разход. Никой разход или записано плащане не се променя."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট আবার যাঁরা প্রতিটি বিল ভাগ করেছেন তাঁদের মধ্যেই হবে। কোনো বিল বা রেকর্ড করা পেমেন্ট বদলায় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els pagaments tornen a ser entre els qui han dividit cada despesa. No canvia cap despesa ni cap pagament registrat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby budou zase mezi těmi, kdo si každý výdaj rozdělili. Žádný výdaj ani zaznamenaná platba se nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingerne går tilbage til at være mellem dem, der delte hver udgift. Ingen udgift eller registreret betaling ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen laufen wieder zwischen denen, die die jeweilige Ausgabe geteilt haben. Keine Ausgabe und keine erfasste Zahlung ändert sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πληρωμές επιστρέφουν ανάμεσα σε όσους μοιράστηκαν κάθε έξοδο. Κανένα έξοδο ή καταγεγραμμένη πληρωμή δεν αλλάζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos vuelven a ser entre quienes dividieron cada gasto. Ningún gasto ni pago registrado cambia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksed lähevad tagasi nende vahele, kes iga kulu jagasid. Ükski kulu ega registreeritud makse ei muutu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت‌ها دوباره بین کسانی خواهد بود که هر هزینه را تقسیم کرده‌اند. هیچ هزینه یا پرداخت ثبت‌شده‌ای تغییر نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksut palaavat kunkin kulun jakaneiden välisiksi. Mikään kulu tai kirjattu maksu ei muutu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babalik ang mga bayad sa pagitan ng mga naghati sa bawat bill. Walang bill o naitalang bayad na magbabago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements redeviennent ceux entre les personnes qui ont partagé chaque dépense. Aucune dépense ni aucun paiement enregistré ne change."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચુકવણીઓ ફરી દરેક ખર્ચ વહેંચનારા લોકો વચ્ચે થશે. કોઈ ખર્ચ કે નોંધાયેલી ચુકવણી બદલાતી નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלומים חוזרים להיות בין מי שפיצלו כל חשבון. אף חשבון או תשלום רשום לא משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान फिर से उन्हीं लोगों के बीच होंगे जिन्होंने हर खर्च बांटा। कोई खर्च या दर्ज भुगतान नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju između onih koji su dijelili svaki trošak. Nijedan trošak ni zabilježena uplata se ne mijenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetések újra azok között lesznek, akik az egyes számlákat felosztották. Egyetlen számla vagy rögzített fizetés sem változik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran kembali terjadi di antara orang yang membagi setiap tagihan. Tidak ada tagihan atau pembayaran tercatat yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti tornano a essere tra chi ha diviso ogni spesa. Nessuna spesa né pagamento registrato cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いは各支出を割り勘した人同士に戻ります。支出や記録済みの支払いは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 다시 각 지출을 나눈 사람끼리 이뤄져요. 지출이나 기록된 송금은 바뀌지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokėjimai vėl vyksta tarp tų, kurie dalijosi kiekviena išlaida. Nė viena išlaida ar užregistruotas mokėjimas nesikeičia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksājumi atkal notiek starp tiem, kas sadalīja katru rēķinu. Neviens rēķins vai reģistrēts maksājums nemainās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेमेंट पुन्हा प्रत्येक खर्च ज्यांनी वाटला त्यांच्यामध्ये होतील. कोणताही खर्च किंवा नोंदवलेले पेमेंट बदलत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayaran kembali antara orang yang berkongsi setiap bil. Tiada bil atau bayaran yang direkodkan berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingene går tilbake til å være mellom dem som delte hver utgift. Ingen utgift eller registrert betaling endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen gaan weer tussen wie elke uitgave heeft verdeeld. Geen enkele uitgave of geregistreerde betaling verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności znów odbywają się między osobami, które dzieliły dany wydatek. Żaden wydatek ani zapisana płatność się nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Nenhuma despesa nem pagamento registrado muda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Nenhuma despesa nem pagamento registado muda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plățile revin între cei care au împărțit fiecare cheltuială. Nicio cheltuială sau plată înregistrată nu se schimbă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежи снова будут между теми, кто делил каждый счёт. Ни счета, ни записанные платежи не меняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby sa vrátia medzi tých, ktorí si rozdelili jednotlivé výdavky. Žiadny výdavok ani zaznamenaná platba sa nezmení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plačila so spet med tistimi, ki so si razdelili posamezen strošek. Noben strošek ali zabeleženo plačilo se ne spremeni."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplate se vraćaju na one između osoba koje su podelile svaki račun. Nijedan račun ni zabeležena uplata se ne menja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalningarna går tillbaka till att vara mellan dem som delade varje utgift. Inga utgifter eller registrerade betalningar ändras."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malipo yanarudi kuwa kati ya waliogawanya kila gharama. Hakuna gharama wala malipo yaliyorekodiwa yanayobadilika."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு செலவையும் பிரித்தவர்களுக்கு இடையேயே பேமெண்ட்டுகள் மீண்டும் நடக்கும். எந்தச் செலவும் பதிவு செய்யப்பட்ட பேமெண்ட்டும் மாறாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చెల్లింపులు మళ్లీ ప్రతి ఖర్చును పంచుకున్నవారి మధ్యే ఉంటాయి. ఏ ఖర్చూ, నమోదైన ఏ చెల్లింపూ మారదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจ่ายเงินจะกลับไปเป็นระหว่างคนที่หารแต่ละบิล ไม่มีบิลหรือการจ่ายเงินที่บันทึกไว้เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemeler yeniden her harcamayı bölenler arasında olur. Hiçbir harcama ya da kayıtlı ödeme değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежі знову будуть між тими, хто ділив кожен рахунок. Жоден рахунок чи записаний платіж не змінюється."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادائیگیاں پھر سے ان کے درمیان ہوں گی جنہوں نے ہر خرچ بانٹا۔ کوئی خرچ یا درج شدہ ادائیگی نہیں بدلتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản thanh toán sẽ quay lại giữa những người đã chia từng khoản chi. Không khoản chi hay khoản thanh toán đã ghi nhận nào bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款会恢复为在共同分摊每笔账单的人之间进行。账单和已记录的付款都不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款會恢復為在共同分攤每筆帳單的人之間進行。帳單和已記錄的付款都不會改變。"
          }
        }
      }
