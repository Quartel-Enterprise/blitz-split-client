        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng internet. Punan ito nang mano-mano o i-scan ang resibo kapag nakakonekta ka ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite internet. Remplis à la main ou scanne le reçu à la reconnexion."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઇન્ટરનેટ જોઈએ. જાતે ભરો અથવા ફરી કનેક્ટ થાઓ ત્યારે રસીદ સ્કૅન કરો."
