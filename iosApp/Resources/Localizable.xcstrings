    "%@ uses this color. Change its color first, then delete it." : {
      "comment" : "Category color picker: the person's own colors",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تستخدم هذا اللون. غيّر لونها أولًا، ثم احذفه."
          }
        },
        "bg" : {
          "stringUnit" : {
