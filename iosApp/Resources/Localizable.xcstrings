    "Offline. Comments and photos wait in the queue and go up once you're back online." : {
      "comment" : "The bill's offline banner",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون اتصال. تنتظر التعليقات والصور في قائمة الانتظار وتُرفع عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Коментарите и снимките чакат на опашка и се качват, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফলাইন। মন্তব্য ও ছবি অপেক্ষায় থাকবে এবং আবার অনলাইনে এলে আপলোড হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense connexió. Els comentaris i les fotos esperen a la cua i es pugen quan tornes a tenir connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentáře a fotky čekají ve frontě a nahrají se, až budeš zase online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Kommentarer og billeder venter i køen og sendes, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Kommentare und Fotos warten in der Warteschlange und werden hochgeladen, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός σύνδεσης. Τα σχόλια και οι φωτογραφίες περιμένουν στην ουρά και ανεβαίνουν μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. Los comentarios y las fotos esperan en la cola y se envían cuando vuelvas a conectarte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võrguühendus puudub. Kommentaarid ja fotod ootavad järjekorras ning laaditakse üles, kui oled taas võrgus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفلاین. نظرها و عکس‌ها در صف می‌مانند و وقتی دوباره آنلاین شوید ارسال می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline-tilassa. Kommentit ja kuvat odottavat jonossa ja lähtevät, kun olet taas verkossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Naghihintay sa pila ang mga comment at larawan at ia-upload kapag online ka na ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors ligne. Les commentaires et les photos attendent dans la file et partent dès que tu es de nouveau en ligne."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઑફલાઇન. કોમેન્ટ અને ફોટા કતારમાં રાહ જુએ છે અને તમે ફરી ઑનલાઇન થાઓ ત્યારે અપલોડ થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אופליין. תגובות ותמונות ממתינות בתור ויעלו כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन। टिप्पणियां और फ़ोटो कतार में इंतज़ार करती हैं और ऑनलाइन होते ही अपलोड हो जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvanmrežno. Komentari i fotografije čekaju u redu i šalju se čim ponovno budeš na mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. A hozzászólások és fotók sorban várnak, és feltöltődnek, amint újra online vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentar dan foto menunggu di antrean dan terkirim saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Commenti e foto aspettano in coda e vengono caricati quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。コメントと写真は送信待ちになり、オンラインに戻るとアップロードされます。"
