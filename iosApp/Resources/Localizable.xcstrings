          }
        }
      }
    },
    "Nobody owes anybody anything here." : {
      "comment" : "The balance card when the whole group is settled up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier schuldet niemand jemandem etwas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí nadie le debe nada a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne doit rien à personne ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui nessuno deve niente a nessuno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj nikt nikomu nic nie jest winien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém deve nada a ninguém aqui."
          }
        }
      }
    },
    "Nobody owes anything in this group. If the trip is over, you can delete the group for everyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
