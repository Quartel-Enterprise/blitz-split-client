    "Bills you paid or take part in, in any group, show up here." : {
      "comment" : "All expenses' empty state",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا الفواتير التي دفعتها أو تشارك فيها، في أي مجموعة."
