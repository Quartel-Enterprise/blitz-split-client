    "The map works offline: changes count right away on this device and reach your others once back online." : {
      "comment" : "Category map offline",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuordnung funktioniert offline: Änderungen gelten sofort auf diesem Gerät und erreichen deine anderen, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa funciona sin conexión: los cambios valen al instante en este dispositivo y llegan a los demás cuando vuelva internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte fonctionne hors ligne : les changements comptent tout de suite sur cet appareil et arrivent sur tes autres dès le retour en ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peta bekerja offline: perubahan langsung berlaku di perangkat ini dan sampai ke perangkatmu yang lain saat kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa funziona offline: le modifiche valgono subito su questo dispositivo e arrivano agli altri quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップはオフラインでも使えます。変更はこのデバイスですぐに反映され、オンラインに戻るとほかのデバイスにも届きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart werkt offline: wijzigingen gelden meteen op dit apparaat en bereiken je andere apparaten zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa działa offline: zmiany obowiązują od razu na tym urządzeniu i trafią na pozostałe po powrocie do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa funciona sem internet: as mudanças valem na hora neste aparelho e vão para os outros quando reconectar."
          }
        },
        "tr" : {
          "stringUnit" : {
