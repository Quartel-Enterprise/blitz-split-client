    "Merge %@ into your account?" : {
      "comment" : "Asks before the guest is merged into the user's own account",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mit deinem Konto zusammenführen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Fusionar a %@ con tu cuenta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionner %@ avec ton compte ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabungkan %@ ke akunmu?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unire %@ al tuo account?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をあなたのアカウントに統合しますか？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ samenvoegen met je account?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączyć gościa %@ z twoim kontem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juntar %@ com a sua conta?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hesabınla birleştirilsin mi?"
          }
        }
      }
    },
    "Everything in %@'s name (bills, payments and the balance of %@) moves to your account, in every group, and the guest goes away. This can't be undone." : {
      "comment" : "The warning before the user claims a guest",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles unter dem Namen %@ (Ausgaben, Zahlungen und der Saldo von %@) wandert in allen Gruppen auf dein Konto, und der Gast verschwindet. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que está a nombre de %@ (gastos, pagos y el saldo de %@) pasa a tu cuenta, en todos los grupos, y el invitado desaparece. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui est au nom de %@ (dépenses, paiements et le solde de %@) passe sur ton compte, dans tous les groupes, et l’invité disparaît. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua atas nama %@ (tagihan, pembayaran, dan saldo %@) pindah ke akunmu, di semua grup, dan tamu itu dihapus. Ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che è a nome di %@ (spese, pagamenti e il saldo di %@) passa al tuo account, in ogni gruppo, e l’ospite scompare. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の名義のすべて（支出、支払い、残高%@）が、すべてのグループであなたのアカウントに移り、ゲストは削除されます。この操作は取り消せません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op naam van %1$@ (uitgaven, betalingen en het saldo van %2$@) gaat naar je account, in elke groep, en de gast verdwijnt. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zapisane na gościa %1$@ (wydatki, płatności i saldo w wysokości %2$@) przejdzie na twoje konto we wszystkich grupach, a gość zniknie. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que está no nome de %@ (contas, pagamentos e o saldo de %@) passa para a sua conta, em todos os grupos, e o convidado some. Não dá para desfazer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adına olan her şey (harcamalar, ödemeler ve %@ tutarındaki bakiye) her grupta hesabına taşınır ve misafir kaldırılır. Bu işlem geri alınamaz."
          }
        }
      }
    },
