    "Give at least one person a share to split %@." : {
      "comment" : "The split by shares has no share given; %@ is the total",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح شخصًا واحدًا على الأقل حصة لتقسيم %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай дял поне на един човек, за да разделиш %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ভাগ করতে অন্তত একজনকে একটি অংশ দিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej aspoň jedné osobě podíl, abys rozdělil(a) %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens einer Person einen Anteil, um %@ aufzuteilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε μερίδιο σε τουλάχιστον ένα άτομο για να μοιράσεις %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale al menos una parte a alguien para dividir %@."
          }
