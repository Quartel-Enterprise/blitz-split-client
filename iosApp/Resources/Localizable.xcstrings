          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नहीं है: आप फिर भी सब कुछ चुन सकते हैं। खर्च इस Mac पर सहेजा रहेगा और दोबारा कनेक्ट होने पर सिंक होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema interneta: i dalje možeš sve označiti. Trošak ostaje spremljen na ovom Macu i sinkronizira se kad se ponovno povežeš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
