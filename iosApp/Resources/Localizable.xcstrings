    "%lld of %lld groups. You can use the app meanwhile: what has arrived shows below." : {
      "comment" : "Groups: the first download's card, the groups that came down of those coming",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld من %lld مجموعات. يمكنك استخدام التطبيق في الأثناء: ما وصل يظهر أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld от %lld групи. Междувременно можеш да ползваш приложението: пристигналото се показва по-долу."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld টি গ্রুপের মধ্যে %1$lld টি এসেছে। এর মধ্যেই অ্যাপটি ব্যবহার করতে পারেন: যা এসেছে তা নিচে দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld z %lld skupin. Mezitím můžeš aplikaci používat: co už dorazilo, vidíš níže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld von %lld Gruppen. Du kannst die App solange nutzen: Was schon da ist, siehst du unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld από %lld ομάδες. Μπορείς να χρησιμοποιείς την εφαρμογή στο μεταξύ: ό,τι έχει φτάσει εμφανίζεται παρακάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld grupos. Puedes usar la app mientras tanto: lo que ya llegó aparece abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld از %lld گروه. در این مدت می‌توانید از برنامه استفاده کنید: آنچه رسیده در پایین نمایش داده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sa %lld na grupo. Magagamit mo na ang app habang hinihintay: lalabas sa ibaba ang mga dumating na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld groupes sur %lld. Tu peux utiliser l’app en attendant : ce qui est arrivé s’affiche ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld מתוך %lld קבוצות. אפשר להשתמש באפליקציה בינתיים: מה שכבר הגיע מופיע למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld ग्रुप। इस बीच आप ऐप इस्तेमाल कर सकते हैं: जो आ चुका है वह नीचे दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld od %lld grupa. Aplikaciju možeš koristiti u međuvremenu: ono što je stiglo prikazuje se ispod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld csoport. Közben is használhatod az appot: ami már megérkezett, lent látható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dari %lld grup. Sementara itu kamu bisa memakai aplikasi: yang sudah tiba tampil di bawah."
