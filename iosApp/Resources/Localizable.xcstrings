    "Offline. Comments and photos wait in the queue and go up once you're back online." : {
      "comment" : "The bill's offline banner",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون اتصال. تنتظر التعليقات والصور في قائمة الانتظار وتُرفع عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Коментарите и снимките чакат на опашка и се качват, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফলাইন। মন্তব্য ও ছবি অপেক্ষায় থাকবে এবং আবার অনলাইনে এলে আপলোড হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentáře a fotky čekají ve frontě a nahrají se, až budeš zase online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Kommentare und Fotos warten in der Warteschlange und werden hochgeladen, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός σύνδεσης. Τα σχόλια και οι φωτογραφίες περιμένουν στην ουρά και ανεβαίνουν μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. Los comentarios y las fotos esperan en la cola y se envían cuando vuelvas a conectarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفلاین. نظرها و عکس‌ها در صف می‌مانند و وقتی دوباره آنلاین شوید ارسال می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Naghihintay sa pila ang mga comment at larawan at ia-upload kapag online ka na ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors ligne. Les commentaires et les photos attendent dans la file et partent dès que tu es de nouveau en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אופליין. תגובות ותמונות ממתינות בתור ויעלו כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन। टिप्पणियां और फ़ोटो कतार में इंतज़ार करती हैं और ऑनलाइन होते ही अपलोड हो जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvanmrežno. Komentari i fotografije čekaju u redu i šalju se čim ponovno budeš na mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. A hozzászólások és fotók sorban várnak, és feltöltődnek, amint újra online vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentar dan foto menunggu di antrean dan terkirim saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Commenti e foto aspettano in coda e vengono caricati quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。コメントと写真は送信待ちになり、オンラインに戻るとアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인이에요. 댓글과 사진은 대기열에 있다가 다시 온라인이 되면 업로드돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luar talian. Komen dan foto menunggu dalam baris gilir dan akan dimuat naik apabila anda kembali dalam talian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Reacties en foto’s wachten in de wachtrij en gaan omhoog zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentarze i zdjęcia czekają w kolejce i zostaną wysłane, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Comentários e fotos ficam na fila e saem ao reconectar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Comentários e fotografias ficam na fila e saem ao voltar a ter ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Comentariile și fotografiile așteaptă în coadă și se încarcă când revii online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Комментарии и фото ждут в очереди и отправятся, когда снова будет интернет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Komentáre a fotky čakajú vo fronte a odošlú sa, keď budeš znova online."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van mreže. Komentari i fotografije čekaju u redu i šalju se čim se vratiš na mrežu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Kommentarer och foton väntar i kön och laddas upp när du är online igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆஃப்லைன். கருத்துகளும் புகைப்படங்களும் வரிசையில் காத்திருந்து, மீண்டும் ஆன்லைனுக்கு வந்ததும் பதிவேறும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออฟไลน์ ความคิดเห็นและรูปภาพจะรออยู่ในคิว และอัปโหลดเมื่อกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısın. Yorumlar ve fotoğraflar sırada bekler, tekrar çevrimiçi olunca yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн. Коментарі й фото чекають у черзі й надійдуть, щойно ти знову будеш онлайн."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آف لائن۔ تبصرے اور تصاویر قطار میں انتظار کرتے ہیں اور آن لائن ہوتے ہی اپ لوڈ ہو جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoại tuyến. Bình luận và ảnh sẽ chờ trong hàng đợi và được tải lên khi bạn có mạng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线中。评论和照片会排队等待，恢复联网后上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線中。留言和照片會排隊等待，恢復連線後上傳。"
          }
        }
      }
