    "Counts for new expenses. Each expense can change it on the spot. Expenses already added don't change." : {
      "comment" : "Default split: what it changes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسري على المصروفات الجديدة. يمكن تغييره في كل مصروف على حدة. المصروفات المضافة سابقًا لا تتغير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важи за нови разходи. Всеки разход може да го промени на място. Вече добавените разходи не се променят."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন খরচের জন্য প্রযোজ্য। প্রতিটি খরচে সঙ্গে সঙ্গে এটি বদলানো যায়। আগে যোগ করা খরচ বদলাবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro nové výdaje. Každý výdaj ho může na místě změnit. Už přidané výdaje se nemění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neue Ausgaben. Jede Ausgabe kann sie direkt ändern. Bereits hinzugefügte Ausgaben ändern sich nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για τα νέα έξοδα. Κάθε έξοδο μπορεί να την αλλάξει επιτόπου. Τα έξοδα που έχουν ήδη προστεθεί δεν αλλάζουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para los gastos nuevos. En cada gasto se puede cambiar al momento. Los gastos ya agregados no cambian."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para los gastos nuevos. En cada gasto se puede cambiar al momento. Los gastos ya añadidos no cambian."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای هزینه‌های جدید اعمال می‌شود. هر هزینه می‌تواند همان‌جا آن را تغییر دهد. هزینه‌هایی که قبلاً اضافه شده‌اند تغییر نمی‌کنند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa mga bagong gastos. Puwedeng baguhin ng bawat gastos ito agad. Hindi nagbabago ang mga gastos na naidagdag na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaut pour les nouvelles dépenses. Chaque dépense peut la changer sur le moment. Les dépenses déjà ajoutées ne changent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלה על הוצאות חדשות. בכל הוצאה אפשר לשנות אותה במקום. הוצאות שכבר נוספו לא משתנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए खर्चों पर लागू होता है। हर खर्च में इसे वहीं बदला जा सकता है। पहले जोड़े गए खर्च नहीं बदलते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijedi za nove troškove. Svaki trošak može je promijeniti na licu mjesta. Već dodani troškovi se ne mijenjaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új kiadásokra vonatkozik. Minden kiadásnál helyben módosítható. A már hozzáadott kiadások nem változnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
