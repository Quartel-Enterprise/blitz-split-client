        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Važi poslednja sačuvana izmena: ako sačuvaš sada, tvoja izmena zamenjuje tu promenu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den senast sparade ändringen gäller: om du sparar nu ersätter din ändring den ändringen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badiliko la mwisho kuhifadhiwa ndilo linashinda: ukihifadhi sasa, badiliko lako litachukua nafasi ya badiliko hilo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசியாகச் சேமிக்கப்பட்ட திருத்தமே நிலைக்கும்: இப்போது சேமித்தால், உங்கள் திருத்தம் அந்த மாற்றத்தை மாற்றிவிடும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చివరిగా సేవ్ చేసిన మార్పే నిలుస్తుంది: మీరు ఇప్పుడు సేవ్ చేస్తే, మీ మార్పు ఆ మార్పును భర్తీ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแก้ไขที่บันทึกล่าสุดจะถูกใช้: ถ้าคุณบันทึกตอนนี้ การแก้ไขของคุณจะแทนที่การเปลี่ยนแปลงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son kaydedilen düzenleme geçerli olur: şimdi kaydedersen senin düzenlemen o değişikliğin yerine geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемагає остання збережена зміна: якщо зберегти зараз, твоя зміна замінить ту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری محفوظ کی گئی ترمیم مؤثر ہوتی ہے: اگر آپ ابھی محفوظ کریں تو آپ کی ترمیم اس تبدیلی کی جگہ لے لے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần sửa được lưu sau cùng sẽ được giữ: nếu bạn lưu bây giờ, nội dung bạn sửa sẽ thay thế thay đổi đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
