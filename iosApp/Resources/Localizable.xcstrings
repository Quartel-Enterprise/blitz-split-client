          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan melanjutkan, kamu menerima [Ketentuan Layanan](legal:terms) dan menyatakan telah membaca [Kebijakan Privasi](legal:privacy)."
