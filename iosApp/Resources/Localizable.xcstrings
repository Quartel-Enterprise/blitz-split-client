        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає інтернету: рахунок збережено на цьому пристрої, і він уже враховується в балансах. Він синхронізується, коли з'явиться з'єднання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انٹرنیٹ نہیں: خرچ اس ڈیوائس پر محفوظ ہے اور ابھی سے بیلنس میں شمار ہوتا ہے۔ دوبارہ کنیکٹ ہونے پر یہ سنک ہو جائے گا۔"
          }
