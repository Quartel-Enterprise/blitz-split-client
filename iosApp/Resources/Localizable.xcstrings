          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے میپ کا کوئی لفظ نہیں ملا۔ خرچ دیگر میں رہے گا؛ کوئی کیٹیگری منتخب کرنے کے لیے آئیکن پر ٹیپ کریں۔"
