            "value" : "Ninguém marcado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никто не отмечен"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้เลือกใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimse işaretlenmedi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нікого не позначено"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa đánh dấu ai"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无人勾选"
