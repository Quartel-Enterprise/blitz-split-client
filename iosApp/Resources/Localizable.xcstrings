    "Pick your name. You'll see the expenses already added for that person." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر اسمك. سترى المصروفات المضافة بالفعل لهذا الشخص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избери името си. Ще видиш разходите, вече добавени за този човек."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নাম বেছে নিন। সেই ব্যক্তির নামে আগে যোগ করা খরচগুলো আপনি দেখতে পাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber své jméno. Uvidíš výdaje, které už byly pro tuto osobu přidány."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl deinen Namen. Du siehst die Ausgaben, die für diese Person schon hinzugefügt wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε το όνομά σου. Θα δεις τα έξοδα που έχουν ήδη προστεθεί για αυτό το άτομο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se agregeron para esa persona."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se añadieron para esa persona."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام خود را انتخاب کنید. هزینه‌هایی را که از قبل برای آن شخص اضافه شده‌اند خواهید دید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang pangalan mo. Makikita mo ang mga gastos na naidagdag na para sa taong iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis ton nom. Tu verras les dépenses déjà ajoutées pour cette personne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבחור את השם שלך. יוצגו ההוצאות שכבר נוספו עבור השם הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना नाम चुनें। उस व्यक्ति के लिए पहले से जोड़े गए खर्च आपको दिखेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberi svoje ime. Vidjet ćeš troškove koji su već dodani za tu osobu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki a neved. Látni fogod az illetőnek már hozzáadott kiadásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih namamu. Kamu akan melihat pengeluaran yang sudah ditambahkan untuk orang itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il tuo nome. Vedrai le spese già aggiunte per quella persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の名前を選んでください。その人の分としてすでに追加された支出が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 이름을 고르세요. 그 사람 앞으로 이미 추가된 지출을 볼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih nama anda. Anda akan melihat perbelanjaan yang sudah ditambah untuk orang itu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies je naam. Je ziet de uitgaven die al voor die persoon zijn toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz swoje imię. Zobaczysz wydatki już dodane dla tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha seu nome. Você vai ver os gastos que já foram lançados para essa pessoa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o teu nome. Vais ver as despesas já registadas para essa pessoa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege-ți numele. Vei vedea cheltuielile deja adăugate pentru acea persoană."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери своё имя. Ты увидишь расходы, уже добавленные для этого человека."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber svoje meno. Uvidíš výdavky, ktoré už boli pre tú osobu pridané."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaberi svoje ime. Videćeš troškove koji su već dodati za tu osobu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ditt namn. Du ser utgifterna som redan lagts till för den personen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் பெயரைத் தேர்ந்தெடுங்கள். அந்த நபருக்காக ஏற்கெனவே சேர்க்கப்பட்ட செலவுகளைப் பார்ப்பீர்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกชื่อของคุณ คุณจะเห็นบิลที่เพิ่มไว้แล้วสำหรับคนนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsmini seç. O kişi için önceden eklenen harcamaları görürsün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обери своє ім'я. Ти побачиш витрати, уже додані для цієї людини."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا نام منتخب کریں۔ آپ اس شخص کے لیے پہلے سے شامل کیے گئے خرچ دیکھیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tên của bạn. Bạn sẽ thấy các khoản chi đã được thêm cho người đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你的名字。你会看到已经为这个人添加的账单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你的名字。你會看到已經為這個人新增的帳單。"
          }
        }
      }
    },
