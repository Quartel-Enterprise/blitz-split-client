        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu masih punya saldo yang belum lunas di “%@”. Keluar sekarang akan membuatnya belum lunas bagi yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ancora un saldo aperto in «%@». Uscire ora lo lascerebbe in sospeso per gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にまだ未精算の残高があります。今退出すると、ほかのメンバーにとって未精算のままになります。"
