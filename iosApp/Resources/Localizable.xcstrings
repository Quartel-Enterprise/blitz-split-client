    "Pick your name. You'll see the expenses already added for that person." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر اسمك. سترى المصروفات المضافة بالفعل لهذا الشخص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl deinen Namen. Du siehst die Ausgaben, die für diese Person schon hinzugefügt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se agregeron para esa persona."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se añadieron para esa persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis ton nom. Tu verras les dépenses déjà ajoutées pour cette personne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבחור את השם שלך. יוצגו ההוצאות שכבר נוספו עבור השם הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना नाम चुनें। उस व्यक्ति के लिए पहले से जोड़े गए खर्च आपको दिखेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih namamu. Kamu akan melihat pengeluaran yang sudah ditambahkan untuk orang itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il tuo nome. Vedrai le spese già aggiunte per quella persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の名前を選んでください。その人の分としてすでに追加された支出が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 이름을 고르세요. 그 사람 앞으로 이미 추가된 지출을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies je naam. Je ziet de uitgaven die al voor die persoon zijn toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz swoje imię. Zobaczysz wydatki już dodane dla tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha seu nome. Você vai ver os gastos que já foram lançados para essa pessoa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o teu nome. Vais ver as despesas já registadas para essa pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери своё имя. Ты увидишь расходы, уже добавленные для этого человека."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกชื่อของคุณ คุณจะเห็นบิลที่เพิ่มไว้แล้วสำหรับคนนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsmini seç. O kişi için önceden eklenen harcamaları görürsün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обери своє ім'я. Ти побачиш витрати, уже додані для цієї людини."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tên của bạn. Bạn sẽ thấy các khoản chi đã được thêm cho người đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你的名字。你会看到已经为这个人添加的账单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你的名字。你會看到已經為這個人新增的帳單。"
          }
        }
      }
    },
