        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt. Laut Zuordnung wäre es %2$@ („%3$@“)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξες %@. Σύμφωνα με τον χάρτη θα ήταν %@ («%@»)."
