    "New in the map. Titles with “%@” go to %@." : {
      "comment" : "Teach the map: a word",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جديد في الخريطة. العناوين التي تحتوي على «%@» تذهب إلى %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in der Zuordnung. Titel mit „%1$@“ gehen zu %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva en el mapa. Los títulos con “%1$@” van a %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau dans la carte. Les titres avec « %1$@ » vont dans %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חדשה במפה. כותרות עם \"%@\" עוברות ל-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैप में नया। “%@” वाले टाइटल %@ में जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baru di peta. Judul dengan “%@” masuk ke %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovo nella mappa. I titoli con «%@» vanno in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップに新規追加。「%@」を含むタイトルは%@になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드에 새로 추가돼요. “%@” 포함 제목은 ‘%@’ 카테고리로 가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuw in de kaart. Titels met “%1$@” gaan naar %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe w mapie. Tytuły z „%1$@” trafią do kategorii %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova no mapa. Títulos com “%1$@” vão para %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в карте. Названия со словом «%@» попадают в «%@»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใหม่ในแผนที่ ชื่อที่มี “%1$@” จะไปที่ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritada yeni. “%@” içeren başlıklar %@ kategorisine gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нове в мапі. Назви з «%@» підуть до %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mới trong bản đồ. Tiêu đề có “%@” sẽ vào %@."
