        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو آپ کو ادائیگی کرتا ہے وہ آپ کا پورا CPF دیکھتا ہے۔ اگر آپ اسے شیئر نہیں کرنا چاہتے تو فون، ای میل یا رینڈم کلید استعمال کریں۔"
