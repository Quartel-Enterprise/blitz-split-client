    "Your balance is settled. Nobody else in the group has joined, so it's deleted for good." : {
      "comment" : "Leaving a group nobody else with an account is in, which deletes it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت تسوية رصيدك. لم ينضم أحد آخر إلى المجموعة، لذا تُحذف نهائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балансът ти е уреден. Никой друг не се е присъединил към групата, затова тя се изтрива окончателно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ব্যালেন্স মিটে গেছে। গ্রুপে আর কেউ যোগ দেননি, তাই এটি চিরতরে মুছে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj zůstatek je vyrovnaný. Nikdo jiný se ke skupině nepřipojil, takže se nadobro smaže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Saldo ist beglichen. Sonst ist niemand der Gruppe beigetreten, daher wird sie endgültig gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το υπόλοιπό σου έχει εξοφληθεί. Κανένα άλλο άτομο δεν έχει μπει στην ομάδα, οπότε διαγράφεται οριστικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu saldo está saldado. Nadie más se ha unido al grupo, así que se elimina para siempre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تراز شما تسویه است. هیچ کس دیگری در گروه نپیوسته، پس گروه برای همیشه حذف می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayad na ang balanse mo. Walang ibang may account na sumali sa grupo, kaya buburahin ito nang tuluyan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton solde est réglé. Personne d’autre n’a rejoint le groupe, donc il est supprimé définitivement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היתרה שלך מאופסת. אף אחד אחר לא הצטרף לקבוצה, ולכן היא תימחק לצמיתות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका बैलेंस बराबर है। ग्रुप में कोई और नहीं जुड़ा है, इसलिए यह हमेशा के लिए हट जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj saldo je podmiren. Nitko drugi iz grupe nije ušao pa se ona trajno briše."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyenleged rendezve van. A csoportba senki más nem csatlakozott, ezért végleg törlődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldomu sudah lunas. Belum ada orang lain di grup yang bergabung, jadi grup ini dihapus permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo saldo è in pari. Nessun altro ha aderito al gruppo, quindi viene eliminato definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高は精算済みです。ほかに参加している人がいないため、グループは完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 잔액은 정산됐어요. 그룹에 참여한 다른 사람이 없어서 그룹이 영구적으로 삭제돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baki anda sudah selesai. Tiada orang lain menyertai kumpulan ini, jadi ia akan dipadam secara kekal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je saldo is verrekend. Niemand anders in de groep is lid geworden, dus hij wordt definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje saldo jest rozliczone. Nikt inny z grupy nie dołączył, więc zostanie ona usunięta na zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu saldo está quitado. Ninguém mais entrou no grupo, então ele some de vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu saldo está acertado. Mais ninguém entrou no grupo, por isso ele desaparece de vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldul tău este achitat. Nimeni altcineva din grup nu a intrat, așa că grupul se șterge definitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой баланс закрыт. Больше никто в группе не присоединился, поэтому она удаляется навсегда."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj zostatok je vyrovnaný. Nikto ďalší do skupiny nevstúpil, preto sa natrvalo odstráni."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje stanje je izmireno. Niko drugi u grupi se nije pridružio, pa se briše zauvek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt saldo är uppgjort. Ingen annan i gruppen har gått med, så den raderas för gott."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் பேலன்ஸ் தீர்ந்தது. குழுவில் வேறு யாரும் சேரவில்லை, அதனால் அது நிரந்தரமாக நீக்கப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยอดของคุณเคลียร์แล้ว ยังไม่มีใครอื่นเข้าร่วมกลุ่ม กลุ่มจึงถูกลบถาวร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakiyen kapandı. Grupta katılmış başka kimse yok, bu yüzden grup kalıcı olarak silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій баланс розраховано. Ніхто інший у групі не приєднався, тому її буде видалено назавжди."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا بیلنس برابر ہے۔ گروپ میں کوئی اور شامل نہیں ہوا، اس لیے یہ ہمیشہ کے لیے حذف ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dư của bạn đã thanh toán xong. Không ai khác trong nhóm đã tham gia, nên nhóm sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的余额已结清。群组里没有其他人加入，因此群组将被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的餘額已結清。群組裡沒有其他人加入，因此群組將被永久刪除。"
          }
        }
      }
    },
    "Your balance is settled. The group leaves this device and your expenses keep your name for the other %lld members. To come back, someone has to invite you again." : {
      "comment" : "What leaving a group does; %lld is how many other members it has",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمت تسوية رصيدك. تخرج المجموعة من هذا الجهاز وتحتفظ مصروفاتك باسمك لدى %lld عضو آخر. للعودة، يجب أن يدعوك أحدهم مرة أخرى."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمت تسوية رصيدك. تخرج المجموعة من هذا الجهاز وتحتفظ مصروفاتك باسمك لدى العضو الآخر. للعودة، يجب أن يدعوك أحدهم مرة أخرى."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمت تسوية رصيدك. تخرج المجموعة من هذا الجهاز وتحتفظ مصروفاتك باسمك لدى العضوين الآخرين (%lld). للعودة، يجب أن يدعوك أحدهم مرة أخرى."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمت تسوية رصيدك. تخرج المجموعة من هذا الجهاز وتحتفظ مصروفاتك باسمك لدى %lld أعضاء آخرين. للعودة، يجب أن يدعوك أحدهم مرة أخرى."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمت تسوية رصيدك. تخرج المجموعة من هذا الجهاز وتحتفظ مصروفاتك باسمك لدى %lld عضوًا آخر. للعودة، يجب أن يدعوك أحدهم مرة أخرى."
                }
              },
              "other" : {
