            "value" : "फ़ोटो पढ़ने वाले तक नहीं पहुंची। ऑनलाइन होने पर फिर से कोशिश करें, या खुद भरें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tidak sampai ke pembaca. Coba lagi saat kamu online, atau isi manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto non è arrivata al lettore. Riprova quando torni online, o compila a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真がリーダーに届きませんでした。オンラインに戻ってからもう一度試すか、手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진이 인식기에 전달되지 않았어요. 다시 온라인이 되면 시도하거나 직접 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto heeft de lezer niet bereikt. Probeer het opnieuw zodra je weer online bent, of vul het met de hand in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie nie dotarło do czytnika. Spróbuj ponownie po powrocie do sieci albo wpisz dane ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A foto não chegou ao leitor. Tente de novo quando reconectar, ou preencha à mão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fotografia não chegou ao leitor. Tenta de novo quando voltares a ter ligação, ou preenche à mão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не дошло до сервиса чтения. Попробуй ещё раз, когда появится интернет, или заполни вручную."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพไปไม่ถึงตัวอ่าน ลองอีกครั้งเมื่อกลับมาออนไลน์ หรือกรอกเอง"
