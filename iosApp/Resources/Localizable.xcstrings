    "%@ is a guest without the app. Click to note what they paid you; they get no notice." : {
      "comment" : "Home on the Mac: a guest's hover; %@ is their name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ضيف ليس لديه التطبيق. انقر لتسجيل ما دفعه لك؛ لن يصله أي إشعار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е гост без приложението. Кликни, за да отбележиш плащане от този човек; няма да получи известие."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ অ্যাপ ছাড়া একজন অতিথি। তিনি আপনাকে কত পরিশোধ করেছেন তা লিখে রাখতে ক্লিক করুন; তিনি কোনো নোটিশ পাবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je host bez aplikace. Kliknutím zaznamenáš, co ti host zaplatil; nedostane žádné oznámení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Klicke, um festzuhalten, was dir gezahlt wurde; der Gast wird nicht benachrichtigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: επισκέπτης χωρίς την εφαρμογή. Κάνε κλικ για να σημειώσεις τι σου πλήρωσε. Δεν λαμβάνει ειδοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Haz clic para anotar lo que te pagó; no recibe aviso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مهمانی بدون برنامه است. برای ثبت آنچه به شما پرداخت کرده کلیک کنید؛ اعلانی دریافت نمی‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ ay guest na walang app. I-click para itala ang binayad nila sa iyo; hindi sila makakatanggap ng abiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. Clique pour noter ce que cette personne t’a payé ; elle ne reçoit aucun avis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: אורח בלי האפליקציה. אפשר ללחוץ כדי לרשום תשלום שקיבלת; לא תישלח התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना ऐप वाले मेहमान हैं। उन्होंने आपको जो भुगतान किया, उसे दर्ज करने के लिए क्लिक करें; उन्हें कोई सूचना नहीं जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je gost bez aplikacije. Klikni da zabilježiš što ti je platio/la; ne dobiva obavijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vendég, nincs meg neki az app. Kattints, és jegyezd fel, mennyit fizetett neked; nem kap értesítést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Klik untuk mencatat yang dia bayar ke kamu; dia tidak mendapat pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Fai clic per annotare quanto ti ha pagato; non riceve alcun avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリを使っていないゲストです。クリックして、受け取った支払いを記録できます。相手に通知は届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 앱이 없는 게스트예요. 클릭해서 받은 금액을 기록하세요. 상대방에게는 알림이 가지 않아요."
