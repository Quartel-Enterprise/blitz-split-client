    "Turn them on in System Settings to know when someone adds a bill with you." : {
      "comment" : "Home's notification card once refused, on the Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere sie in den Systemeinstellungen, um zu erfahren, wenn jemand eine Ausgabe mit dir hinzufügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalas en Ajustes del Sistema para saber cuándo alguien agrega un gasto contigo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalas en Ajustes del Sistema para saber cuándo alguien añade un gasto contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active-les dans les Réglages Système pour savoir quand quelqu’un ajoute une dépense avec toi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan di Pengaturan Sistem agar tahu saat seseorang menambahkan tagihan bersamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivale nelle Impostazioni di Sistema per sapere quando qualcuno aggiunge una spesa con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがあなたを含む支出を追加したときに知るには、システム設定でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 나와 함께 지출을 추가하면 알 수 있도록 시스템 설정에서 알림을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ze aan in Systeeminstellingen om te weten wanneer iemand een uitgave met je toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz je w Ustawieniach systemowych, aby wiedzieć, gdy ktoś doda wydatek z twoim udziałem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative nos Ajustes do Sistema para saber quando alguém adicionar uma conta com você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa nas Definições do Sistema para saberes quando alguém adicionar uma conta contigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включи их в Системных настройках, чтобы знать, когда кто-то добавляет счёт с тобой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri seninle harcama eklediğinde haberin olması için Sistem Ayarları'ndan aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкни їх у Системних параметрах, щоб знати, коли хтось додає рахунок з тобою."
          }
        }
      }
    },
