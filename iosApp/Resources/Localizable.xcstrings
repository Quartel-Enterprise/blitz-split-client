          "stringUnit" : {
            "state" : "translated",
            "value" : "এই আইটেমটি কে কে নিয়েছেন তা চিহ্নিত করুন। কেউ থাকলে “সম্পন্ন” চালু হবে।"
          }
        },
        "ca" : {
