        }
      }
    },
    "This is a Lightning Address, so we switched to Lightning." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é um Lightning Address, então mudamos para Lightning."
          }
        }
      }
    },
    "This is a Lightning invoice (lnbc…): it pays once and expires. Paste a Lightning Address or an LNURL." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é uma fatura Lightning (lnbc…): vale para um pagamento só e expira. Cole um Lightning Address ou um LNURL."
          }
        }
      }
    },
    "This is a testnet address (tb1…). Only Bitcoin mainnet works here, with bc1… addresses." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
