    "When a bill's title has one of these words, its category comes by itself. “Uber home” becomes Transport." : {
      "comment" : "Category map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يحتوي عنوان الفاتورة على إحدى هذه الكلمات، تأتي فئتها تلقائيًا. «Uber إلى المنزل» تصبح «المواصلات»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat der Titel einer Ausgabe eines dieser Wörter, kommt ihre Kategorie von selbst. „Uber nach Hause“ wird zu Verkehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el título de un gasto tiene una de estas palabras, la categoría llega sola. “Uber a casa” pasa a ser Transporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le titre d’une dépense contient un de ces mots, sa catégorie vient toute seule. « Uber maison » devient Transports."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשבכותרת של חשבון יש אחת מהמילים האלה, הקטגוריה שלו נקבעת לבד. \"Uber הביתה\" נכנס לתחבורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब किसी खर्च के टाइटल में इनमें से कोई शब्द होता है, तो उसकी श्रेणी अपने आप आ जाती है। “Uber घर” यातायात बन जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika judul tagihan memuat salah satu kata ini, kategorinya terisi sendiri. “Uber pulang” jadi Transportasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il titolo di una spesa contiene una di queste parole, la categoria arriva da sola. «Uber casa» diventa Trasporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出のタイトルにこれらの単語があると、カテゴリが自動で付きます。「Uberで帰宅」は交通になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출 제목에 이 단어 중 하나가 있으면 카테고리가 자동으로 정해져요. “Uber 집으로”는 교통이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de titel van een uitgave een van deze woorden bevat, komt de categorie vanzelf. “Uber naar huis” wordt Vervoer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy tytuł wydatku zawiera jedno z tych słów, kategoria dobiera się sama. „Uber do domu” trafia do kategorii Transport."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o título da conta tem uma destas palavras, a categoria vem sozinha. “Uber para casa” vira Transporte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o título da conta tem uma destas palavras, a categoria vem sozinha. “Uber para casa” fica em Transporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда в названии счёта есть одно из этих слов, категория выбирается сама. «Uber домой» становится «Транспортом»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อชื่อบิลมีคำใดคำหนึ่งเหล่านี้ หมวดหมู่จะมาเอง “Uber กลับบ้าน” จะเป็นการเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir harcamanın başlığında bu kelimelerden biri olduğunda kategorisi kendiliğinden gelir. “Uber eve” Ulaşım olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли в назві рахунку є одне з цих слів, категорія з'являється сама. «Uber додому» стає Транспортом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tiêu đề khoản chi có một trong các từ này, danh mục sẽ tự có. “Uber về nhà” thành Đi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账单标题包含以下某个词时，会自动归入对应类别。“Uber回家”会归入“交通”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳單標題包含以下某個詞時，會自動歸入對應類別。「Uber回家」會歸入「交通」。"
          }
        }
      }
    },
    "When two terms match a title, the longest one wins." : {
      "comment" : "Category map search",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يطابق مصطلحان عنوانًا، يُعتمد الأطول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen zwei Begriffe auf einen Titel, gewinnt der längere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando dos términos coinciden con un título, gana el más largo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand deux termes correspondent à un titre, le plus long l’emporte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כששני מונחים מתאימים לכותרת, הארוך מביניהם קובע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दो शब्द किसी टाइटल से मेल खाते हैं, तो सबसे लंबा चुना जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dua kata cocok dengan satu judul, yang terpanjang menang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando due termini corrispondono a un titolo, vince il più lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのタイトルに2つの単語が一致した場合、長いほうが優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 키워드가 한 제목과 일치하면 더 긴 키워드가 우선해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als twee termen bij een titel passen, wint de langste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy do tytułu pasują dwa słowa, wygrywa dłuższe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando duas palavras casam num título, o termo mais longo ganha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando dois termos coincidem com um título, ganha o termo mais longo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда с названием совпадают два слова, побеждает самое длинное."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อมีสองคำตรงกับชื่อ คำที่ยาวที่สุดจะชนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki terim bir başlıkla eşleştiğinde en uzun olan kazanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли назві відповідають два терміни, перемагає найдовший."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi hai từ khóa cùng khớp một tiêu đề, từ dài nhất thắng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当两个关键词都匹配同一标题时，以较长的为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當兩個關鍵字都符合同一標題時，以較長的為準。"
          }
        }
      }
    },
    "Which word of “%@” should pick %@ on the next bills?" : {
      "comment" : "Teach the map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي كلمة من «%@» يجب أن تختار %@ في الفواتير القادمة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Wort aus „%1$@“ soll bei den nächsten Ausgaben %2$@ wählen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué palabra de “%1$@” debe elegir %2$@ en los próximos gastos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel mot de « %1$@ » doit choisir %2$@ sur les prochaines dépenses ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איזו מילה מתוך \"%@\" תבחר את %@ בחשבונות הבאים?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले खर्चों पर “%@” का कौन-सा शब्द %@ चुने?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata mana dari “%@” yang harus memilih %@ di tagihan berikutnya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale parola di «%@» dovrebbe scegliere %@ nelle prossime spese?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回からの支出で%2$@を選ぶ単語は、「%1$@」のどれにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” 제목의 어떤 단어로 다음 지출부터 ‘%2$@’ 카테고리를 정할까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welk woord van “%1$@” moet bij de volgende uitgaven %2$@ kiezen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Które słowo z „%1$@” ma wybierać kategorię %2$@ w kolejnych wydatkach?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual palavra de “%1$@” deve escolher %2$@ nas próximas contas?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какое слово из «%@» должно выбирать «%@» в следующих счетах?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำไหนใน “%1$@” ที่ควรเลือก %2$@ ในบิลครั้งต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki harcamalarda “%@” içindeki hangi kelime %@ kategorisini seçsin?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
