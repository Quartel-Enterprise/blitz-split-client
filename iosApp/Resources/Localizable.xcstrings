    "Whoever owed %@ in the group still owes %@. Only where the money goes changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Gruppe %1$@ geschuldet hat, schuldet weiterhin %2$@. Nur wohin das Geld geht, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien debía %1$@ en el grupo sigue debiendo %2$@. Solo cambia a quién va el dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui devait %1$@ dans le groupe doit toujours %2$@. Seul change où va l’argent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang berutang %@ di grup tetap berutang %@. Hanya tujuan uangnya yang berubah."
