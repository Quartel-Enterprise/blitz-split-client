    "Day works for periods of up to 3 months." : {
      "comment" : "The group statistics: why Day is off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار «يوم» متاح للفترات حتى 3 أشهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ден работи за периоди до 3 месеца."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“দিন” সর্বোচ্চ 3 মাসের সময়কালে কাজ করে।"
          }
