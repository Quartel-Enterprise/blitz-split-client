    "Sign in on iPhone with the same Apple account and your groups will be there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول على iPhone بحساب Apple نفسه وستجد مجموعاتك هناك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влез в iPhone със същия Apple акаунт и групите ти ще са там."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এ একই Apple অ্যাকাউন্ট দিয়ে সাইন ইন করুন, আপনার গ্রুপগুলো সেখানে পেয়ে যাবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la sessió a l’iPhone amb el mateix compte d’Apple i hi trobaràs els teus grups."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se na iPhonu stejným účtem Apple a tvoje skupiny tam budou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på iPhone med den samme Apple-konto, så er dine grupper der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich auf dem iPhone mit demselben Apple-Account an, und deine Gruppen sind da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου στο iPhone με τον ίδιο λογαριασμό Apple και οι ομάδες σου θα είναι εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en el iPhone con la misma cuenta de Apple y tus grupos estarán ahí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi iPhone’is sisse sama Apple’i kontoga ja sinu grupid on seal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در iPhone با همان حساب Apple وارد شوید تا گروه‌هایتان آنجا باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu iPhonella samalla Apple-tilillä, niin ryhmäsi ovat siellä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in sa iPhone gamit ang parehong Apple account at nandoon na ang mga grupo mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi sur iPhone avec le même compte Apple et tes groupes seront là."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ જ Apple એકાઉન્ટથી iPhone પર સાઇન ઇન કરો અને તમારા ગ્રુપ ત્યાં હશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להתחבר ב-iPhone עם אותו חשבון Apple, והקבוצות שלך יהיו שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone पर उसी Apple अकाउंट से साइन इन करें और आपके ग्रुप वहां होंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavi se na iPhoneu istim Apple računom i tvoje će grupe biti tamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezz be iPhone-on ugyanazzal az Apple-fiókkal, és ott lesznek a csoportjaid."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk di iPhone dengan akun Apple yang sama dan grupmu akan ada di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi sull’iPhone con lo stesso account Apple e i tuoi gruppi saranno lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで同じAppleアカウントでログインすると、グループがそのまま表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 같은 Apple 계정으로 로그인하면 그룹이 그대로 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijunk iPhone su ta pačia „Apple“ paskyra ir tavo grupės bus ten."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieraksties iPhone ierīcē ar to pašu Apple kontu, un tavas grupas būs tur."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्याच Apple अकाउंटने iPhone वर साइन इन करा, तुमचे ग्रुप तिथे असतील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk pada iPhone dengan akaun Apple yang sama dan kumpulan anda akan ada di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn på iPhone med den samme Apple-kontoen, så er gruppene dine der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log op je iPhone in met hetzelfde Apple-account en je groepen staan er."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się na iPhonie tym samym kontem Apple, a twoje grupy tam będą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a mesma conta Apple no iPhone e seus grupos estarão lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessão no iPhone com a mesma conta Apple e os teus grupos estarão lá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează-te pe iPhone cu același cont Apple și grupurile tale vor fi acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войди на iPhone с тем же аккаунтом Apple, и твои группы будут там."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlás sa na iPhone cez ten istý účet Apple a tvoje skupiny tam budú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavi se v iPhonu z istim računom Apple in tvoje skupine bodo tam."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavi se na iPhone-u istim Apple nalogom i tvoje grupe će biti tamo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på iPhone med samma Apple-konto så finns dina grupper där."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingia kwenye iPhone kwa akaunti ileile ya Apple na vikundi vyako vitakuwepo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதே Apple அக்கவுண்ட்டுடன் iPhone-இல் உள்நுழையுங்கள், உங்கள் குழுக்கள் அங்கே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అదే Apple అకౌంట్‌తో iPhoneలో సైన్ ఇన్ చేయండి, మీ గ్రూప్‌లు అక్కడ ఉంటాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าใช้บน iPhone ด้วยบัญชี Apple เดียวกัน แล้วกลุ่มของคุณจะอยู่ที่นั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'da aynı Apple hesabıyla giriş yap, grupların orada olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійди на iPhone з тим самим обліковим записом Apple, і твої групи будуть там."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone پر اسی Apple اکاؤنٹ سے سائن اِن کریں اور آپ کے گروپ وہاں ہوں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập trên iPhone bằng cùng tài khoản Apple và các nhóm của bạn sẽ có ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在iPhone上用同一个Apple账号登录，你的群组就在那里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在iPhone上用同一個Apple帳號登入，你的群組就在那裡。"
          }
        }
      }
    },
