    "Searches the groups, people and expenses on this %@, settled groups included, even without internet." : {
      "comment" : "The search before anything is typed; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث في المجموعات والأشخاص والمصروفات على %@ هذا، بما فيها المجموعات التي تمت تسويتها، حتى دون إنترنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търси в групите, хората и разходите на този %@, включително уредените групи, дори без интернет."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট ছাড়াও এই %@ ডিভাইসের গ্রুপ, ব্যক্তি ও খরচ খোঁজে, হিসাব মেটানো গ্রুপসহ।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohledá skupiny, lidi a výdaje na zařízení %@, včetně vyrovnaných skupin, i bez internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht die Gruppen, Personen und Ausgaben auf diesem %@, auch ausgeglichene Gruppen, sogar ohne Internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητά ομάδες, άτομα και έξοδα σε αυτό το %@, μαζί με τις εξοφλημένες ομάδες, ακόμα και χωρίς ίντερνετ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en los grupos, personas y gastos de este %@, incluidos los grupos saldados, incluso sin internet."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌ها، افراد و هزینه‌های روی این %@ را جستجو می‌کند، از جمله گروه‌های تسویه‌شده، حتی بدون اینترنت."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinahanap ang mga grupo, tao at gastos sa %@ na ito, pati ang mga grupong bayad na, kahit walang internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherche dans les groupes, personnes et dépenses de ton %@, groupes réglés compris, même sans internet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיפוש בקבוצות, באנשים ובהוצאות ב-%@ הזה, כולל קבוצות סגורות, גם בלי אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस %@ पर ग्रुप, लोग और खर्च खोजता है, हिसाब बराबर हो चुके ग्रुप समेत, इंटरनेट के बिना भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretražuje grupe, osobe i troškove na uređaju %@, uključujući podmirene grupe, čak i bez interneta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keres a csoportok, emberek és kiadások között ezen az eszközön (%@), az elszámolt csoportokat is beleértve, internet nélkül is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencari grup, orang, dan pengeluaran di %@ ini, termasuk grup yang sudah lunas, bahkan tanpa internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca tra gruppi, persone e spese su questo %@, compresi i gruppi in pari, anche senza internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@のグループ、メンバー、支出を、精算済みのグループも含めて検索します。インターネットがなくても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷이 없어도 정산된 그룹을 포함해 이 %@에 있는 그룹, 사람, 지출을 검색해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencari kumpulan, orang dan perbelanjaan pada %@ ini, termasuk kumpulan yang selesai, walaupun tanpa internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorzoekt de groepen, mensen en uitgaven op deze %@, ook verrekende groepen, zelfs zonder internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeszukuje grupy, osoby i wydatki na tym urządzeniu (%@), także rozliczone grupy, nawet bez internetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procura em grupos, pessoas e despesas deste %@, inclusive nos grupos quitados, sem precisar de internet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa em grupos, pessoas e despesas deste %@, incluindo os grupos liquidados, sem precisar de internet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caută în grupurile, persoanele și cheltuielile de pe acest %@, inclusiv grupurile achitate, chiar și fără internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет группы, людей и расходы на этом %@, включая закрытые группы, даже без интернета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehľadáva skupiny, ľudí a výdavky v tomto zariadení (%@) vrátane vyrovnaných skupín, aj bez internetu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretražuje grupe, osobe i troškove na ovom uređaju (%@), uključujući izmirene grupe, čak i bez interneta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker bland grupper, personer och utgifter på din %@, även uppgjorda grupper, även utan internet."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த %@ சாதனத்தில் உள்ள குழுக்கள், நபர்கள், செலவுகளைத் தேடுகிறது, கணக்கு தீர்ந்த குழுக்கள் உட்பட, இணையம் இல்லாமலும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหากลุ่ม คน และบิลบน %@ นี้ รวมกลุ่มที่เคลียร์แล้ว แม้ไม่มีอินเทอร์เน็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu %@ üzerindeki grupları, kişileri ve harcamaları, hesaplaşılan gruplar dahil, internet olmasa bile arar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукає групи, людей і витрати на цьому пристрої (%@), включно з розрахованими групами, навіть без інтернету."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس %@ پر گروپس، لوگوں اور خرچوں میں تلاش کرتا ہے، حساب برابر شدہ گروپس سمیت، انٹرنیٹ کے بغیر بھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm các nhóm, người và khoản chi trên %@ này, kể cả nhóm đã thanh toán xong, ngay cả khi không có internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索这台%@上的群组、人和账单，包括已结清的群组，没有网络也可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋這台%@上的群組、人和帳單，包括已結清的群組，沒有網路也可以。"
          }
        }
      }
    },
