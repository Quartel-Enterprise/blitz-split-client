    "Allow the camera to scan the receipt, or choose a photo of it from Photos." : {
      "comment" : "Receipt camera: access refused",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك السماح بالوصول إلى الكاميرا لمسح الإيصال، أو اختيار صورة له من «الصور»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши камерата, за да сканираш бележката, или избери нейна снимка от Снимки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রসিদ স্ক্যান করতে ক্যামেরার অনুমতি দিন, অথবা Photos থেকে রসিদের একটি ছবি বেছে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povol kameru pro skenování účtenky, nebo vyber její fotku z Fotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff, um den Beleg zu scannen, oder wähl ein Foto davon aus Fotos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε την πρόσβαση στην κάμερα για να σαρώσεις την απόδειξη ή διάλεξε μια φωτογραφία της από τις Φωτογραφίες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la cámara para escanear el recibo, o elige una foto de él en Fotos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازه دهید دوربین رسید را اسکن کند، یا عکسی از آن را از Photos انتخاب کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang camera na i-scan ang resibo, o pumili ng larawan nito sa Photos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’appareil photo à scanner le reçu, ou choisis-en une photo dans Photos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפשר גישה למצלמה כדי לסרוק את הקבלה, או לבחור תמונה שלה מ-Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसीद स्कैन करने के लिए कैमरे की अनुमति दें, या फ़ोटो से उसकी कोई फ़ोटो चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopusti pristup kameri za skeniranje računa ili odaberi njegovu fotografiju iz aplikacije Fotografije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezd a kamerát a nyugta beolvasásához, vagy válassz róla fotót a Fotók appból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan kamera untuk memindai struk, atau pilih fotonya dari Foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la fotocamera per scansionare lo scontrino, o scegline una foto da Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートをスキャンするにはカメラを許可するか、写真からレシートの写真を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영수증을 스캔하려면 카메라를 허용하거나 사진 앱에서 영수증 사진을 고르세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan kamera untuk mengimbas resit, atau pilih fotonya daripada Foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef toegang tot de camera om het bonnetje te scannen, of kies een foto ervan in Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do aparatu, aby zeskanować paragon, albo wybierz jego zdjęcie ze Zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a câmera para ler o cupom, ou escolha uma foto dele nas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a câmara para ler o talão, ou escolhe uma foto dele nas Fotos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite accesul la cameră ca să scanezi bonul sau alege o fotografie a lui din Poze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши доступ к камере, чтобы сканировать чек, или выбери его фото в Фото."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľ kameru na skenovanie účtenky alebo vyber jej fotku z Fotiek."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozvoli kameri da skenira fiskalni račun ili izaberi njegovu fotografiju iz Fotografija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt kameran för att skanna kvittot, eller välj ett foto av det från Bilder."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ரசீதை ஸ்கேன் செய்ய கேமராவை அனுமதியுங்கள், அல்லது Photos-இலிருந்து அதன் புகைப்படத்தைத் தேர்ந்தெடுங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ใช้กล้องเพื่อสแกนใบเสร็จ หรือเลือกรูปใบเสร็จจากแอปรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fişi taramak için kameraya izin ver ya da Fotoğraflar'dan fişin fotoğrafını seç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволь камеру, щоб сканувати чек, або обери його фото з Фото."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسید اسکین کرنے کے لیے کیمرے کی اجازت دیں، یا Photos سے اس کی تصویر منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho phép dùng camera để quét hóa đơn, hoặc chọn ảnh hóa đơn từ Ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许使用相机来扫描小票，或从“照片”中选择小票的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許使用相機來掃描收據，或從「照片」中選擇收據的照片。"
