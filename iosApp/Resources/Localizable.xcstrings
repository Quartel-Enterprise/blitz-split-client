        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일 단위는 3개월 이하 기간에서 사용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag werkt voor periodes tot 3 maanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
