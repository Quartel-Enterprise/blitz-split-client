    "Bills you marked with it will no longer show it." : {
      "comment" : "Asks before deleting a payment method",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفواتير التي وسمتها بها لن تعرضها بعد الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разходите, маркирани с него, вече няма да го показват."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেসব বিলে আপনি এটি চিহ্নিত করেছিলেন, সেগুলোতে এটি আর দেখাবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdaje, které jsi jím označil(a), ho už nebudou ukazovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben, die du damit markiert hast, zeigen sie nicht mehr an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα έξοδα που σημείωσες με αυτόν δεν θα τον εμφανίζουν πια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos que marcaste con él dejarán de mostrarlo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos que has marcado con él dejarán de mostrarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه‌هایی که با آن علامت زده‌اید دیگر آن را نشان نمی‌دهند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na ito makikita sa mga bill na minarkahan mo nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses où vous l'avez indiqué ne l'afficheront plus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות שסומנו בו כבר לא יציגו אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन खर्चों पर आपने इसे लगाया था, उन पर यह अब नहीं दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troškovi označeni njime više ga neće prikazivati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezzel jelölt számláid többé nem mutatják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagihan yang kamu tandai dengan metode ini tidak akan menampilkannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese segnate con questo non lo mostreranno più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
