    "%@ already exists in %@. Pick another name." : {
      "comment" : "New category: the name is taken in that category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gibt es in %2$@ schon. Wähl einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe %1$@ en %2$@. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ existe déjà dans %2$@. Choisis un autre nom."
          }
