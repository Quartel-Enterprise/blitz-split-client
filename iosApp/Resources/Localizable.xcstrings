    "Sees it without signing in. To comment, they sign in with an account, even outside the group." : {
      "comment" : "Share bill: what anyone with the link can do",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht sie ohne Anmeldung. Zum Kommentieren meldet man sich mit einem Konto an, auch außerhalb der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo ve sin iniciar sesión. Para comentar, inicia sesión con una cuenta, aunque no esté en el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit la dépense sans se connecter. Pour commenter, la personne se connecte avec un compte, même hors du groupe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa melihatnya tanpa masuk. Untuk berkomentar, mereka masuk dengan akun, meski di luar grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vede senza accedere. Per commentare accede con un account, anche fuori dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインせずに見られます。コメントするには、グループ外の人でもアカウントでログインします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziet hem zonder in te loggen. Om te reageren logt diegene in met een account, ook van buiten de groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można go zobaczyć bez logowania. Aby komentować, trzeba zalogować się na konto, nawet spoza grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
