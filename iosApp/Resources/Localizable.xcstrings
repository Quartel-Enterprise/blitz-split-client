            "state" : "translated",
            "value" : "יש להזין את ההכנסה נטו של כל אחד, אחרי מסים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर किसी की टैक्स के बाद की शुद्ध आय डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
