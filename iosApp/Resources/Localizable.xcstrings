    "If it was you, ask %@ to release the name in Members." : {
      "comment" : "The group's creator, who can release a member taken by someone else on the Members screen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كنت أنت، فاطلب من %@ تحرير الاسم في «الأعضاء»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако си бил(а) ти, помоли %@ да освободи името в Членове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি এটি আপনি হয়ে থাকেন, “সদস্য” অংশ থেকে নামটি ছেড়ে দিতে %@-কে বলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eres tu, demana a %@ que alliberi el nom a Membres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi to byl(a) ty, požádej uživatele %@, aby uvolnil(a) jméno v Členech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det var dig, så bed %@ om at frigive navnet under Medlemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, bitte %@, den Namen unter „Mitglieder“ freizugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ήσουν εσύ, ζήτησε από %@ να αποδεσμεύσει το όνομα στα Μέλη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuiste tú, pide a %@ que libere el nombre en Miembros."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui see olid sina, palu kasutajal %@ nimi vaates Liikmed vabastada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر خودتان بودید، از %@ بخواهید نام را در بخش اعضا آزاد کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos se olit sinä, pyydä henkilöä %@ vapauttamaan nimi Jäsenissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung ikaw ito, hilingin kay %@ na palayain ang pangalan sa Mga miyembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c’était toi, demande à %@ de libérer le nom dans Membres."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
