        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till det så får utgifter med det här ordet i titeln rätt kategori."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liongeze na gharama zenye neno hili katika kichwa chake zitafika na aina sahihi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதைச் சேர்த்தால், தலைப்பில் இந்தச் சொல் உள்ள செலவுகள் சரியான வகையுடன் வரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దీన్ని జోడిస్తే, శీర్షికలో ఈ పదం ఉన్న ఖర్చులు సరైన కేటగిరీతో వస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มคำนี้ แล้วบิลที่มีคำนี้ในชื่อจะได้หมวดหมู่ที่ถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekle, başlığında bu kelime geçen harcamalar doğru kategoriyle gelsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай його, і рахунки з цим словом у назві отримуватимуть правильну категорію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے شامل کریں، پھر جن خرچوں کے عنوان میں یہ لفظ ہو گا وہ صحیح کیٹیگری کے ساتھ آئیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm vào và các khoản chi có từ này trong tiêu đề sẽ có đúng danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加后，标题中含有这个词的账单会自动归入正确的类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增後，標題中含有這個詞的帳單會自動歸入正確的類別。"
          }
        }
      }
    },
