    "Whoever isn't in an expense leaves it when splitting." : {
      "comment" : "Default split, Equal: under the example",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من ليس ضمن مصروف يخرج منه عند التقسيم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Който не участва в разход, излиза от него при разделянето."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যিনি কোনো খরচে নেই, ভাগ করার সময় তিনি তা থেকে বাদ পড়বেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo ve výdaji není, z rozdělení vypadne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer nicht an einer Ausgabe beteiligt ist, wird beim Aufteilen herausgenommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος δεν συμμετέχει σε ένα έξοδο μένει εκτός κατά τη μοιρασιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien no esté en un gasto sale de él al dividir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی که در یک هزینه نیست، هنگام تقسیم از آن بیرون می‌رود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang hindi kasali sa isang gastos ay aalis dito kapag naghahati."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui n’est pas dans une dépense en sort au moment de répartir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מי שלא בהוצאה יוצא ממנה בחלוקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो किसी खर्च में नहीं है, वह बांटते समय उससे बाहर हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tko nije u trošku, izlazi iz njega pri dijeljenju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aki nem szerepel egy kiadásban, a felosztásnál kimarad belőle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang tidak ikut suatu pengeluaran dikeluarkan saat membagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi non è in una spesa ne esce al momento di dividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出の対象外の人は、割り勘のときに外れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출에 포함되지 않은 사람은 나눌 때 빠져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiapa yang tiada dalam sesuatu perbelanjaan dikecualikan semasa pembahagian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie niet in een uitgave zit, valt eruit bij het verdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto nie bierze udziału w wydatku, wypada z niego przy dzieleniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem não estiver numa despesa sai dela na hora de rachar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem não estiver numa despesa sai dela na hora de dividir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cine nu participă la o cheltuială iese din ea la împărțire."
          }
