    "“%@” (%@) leaves the bill and the service is redone." : {
      "comment" : "Delete this item?: the item and its total",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخرج «%@» (%@) من الفاتورة ويُعاد حساب الخدمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ (%2$@) verschwindet aus der Ausgabe, und die Bedienung wird neu berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) sale del gasto y se rehace el servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » (%2$@) sort de la dépense et le service est recalculé."
