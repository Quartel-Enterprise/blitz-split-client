    "Use the same account as your iPhone here. Then the watch works on its own." : {
      "comment" : "Apple Watch, first launch (15.9): under the app name, before Connect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هنا الحساب نفسه الموجود على iPhone. بعد ذلك تعمل الساعة وحدها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвай тук същия акаунт като на iPhone. После часовникът работи сам."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এর একই অ্যাকাউন্ট এখানে ব্যবহার করুন। তারপর ঘড়ি নিজেই চলবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použij tady stejný účet jako v iPhonu. Pak hodinky fungují samy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze hier dasselbe Konto wie auf deinem iPhone. Danach läuft die Uhr von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποίησε εδώ τον ίδιο λογαριασμό με το iPhone. Μετά το ρολόι λειτουργεί μόνο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa aquí la misma cuenta del iPhone. Después, el reloj funciona solo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اینجا از همان حساب کاربری iPhone خود استفاده کنید. سپس ساعت به‌تنهایی کار می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin dito ang parehong account sa iPhone mo. Pagkatapos, gagana na nang mag-isa ang watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise ici le même compte que sur ton iPhone. Ensuite, la montre fonctionne seule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאן משתמשים באותו חשבון כמו ב-iPhone. אחר כך השעון עובד לבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां वही अकाउंट इस्तेमाल करें जो iPhone पर है। फिर वॉच अपने आप चलेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje koristi isti račun kao na iPhoneu. Nakon toga sat radi sam."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itt is ugyanazt a fiókot használd, mint az iPhone-odon. Utána az óra magától működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan akun yang sama dengan di iPhone-mu di sini. Setelah itu, jam tangan bekerja sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa qui lo stesso account dell’iPhone. Poi l’orologio funziona da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneと同じアカウントをここで使います。その後はウォッチだけで動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone과 같은 계정을 여기서 사용하세요. 그다음엔 워치가 알아서 작동해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan akaun yang sama seperti di iPhone anda di sini. Selepas itu, jam tangan berfungsi sendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik hier hetzelfde account als op je iPhone. Daarna werkt het horloge zelfstandig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj tu tego samego konta co na iPhonie. Potem zegarek działa sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use aqui a mesma conta do iPhone. Depois, o relógio funciona sozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa aqui a mesma conta do iPhone. Depois, o relógio funciona sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește aici același cont ca pe iPhone. Apoi ceasul merge singur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй здесь тот же аккаунт, что на iPhone. Дальше часы работают сами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použi tu rovnaký účet ako na iPhone. Potom budú hodinky fungovať samy."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovde koristi isti nalog kao na iPhone-u. Tada sat radi sam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd samma konto som på din iPhone här. Sedan klarar sig klockan själv."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் iPhone-இல் உள்ள அதே அக்கவுண்ட்டை இங்கே பயன்படுத்துங்கள். பிறகு வாட்ச் தானாகவே வேலை செய்யும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้บัญชีเดียวกับใน iPhone ที่นี่ จากนั้นนาฬิกาจะทำงานเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'undaki hesabın aynısını burada kullan. Sonra saat kendi başına çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуй тут той самий обліковий запис, що й на iPhone. Далі годинник працює сам."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں وہی اکاؤنٹ استعمال کریں جو آپ کے iPhone پر ہے۔ پھر واچ خود سے چلے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng tại đây cùng tài khoản như trên iPhone. Sau đó đồng hồ tự hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里使用和iPhone上相同的账号。之后手表可独立运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡使用和iPhone上相同的帳號。之後手錶可獨立運作。"
          }
        }
      }
    },
