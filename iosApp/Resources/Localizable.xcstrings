    "We saw you on your phone. Your groups are already there, and the invite to download the app won't show again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رأيناك على هاتفك. مجموعاتك موجودة هناك بالفعل، ولن تظهر دعوة تنزيل التطبيق مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видяхме те на телефона. Групите ти вече са там и поканата за изтегляне на приложението няма да се показва повече."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনাকে ফোনে দেখেছি। আপনার গ্রুপগুলো ইতিমধ্যে সেখানে আছে, আর অ্যাপ ডাউনলোডের আমন্ত্রণ আর দেখানো হবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T’hem vist al mòbil. Els teus grups ja hi són, i la invitació per baixar l’app no es tornarà a mostrar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viděli jsme tě na telefonu. Tvoje skupiny už tam jsou a pozvánka ke stažení aplikace se už nezobrazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har set dig på din telefon. Dine grupper er der allerede, og invitationen til at hente appen vises ikke igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dich auf deinem Handy gesehen. Deine Gruppen sind schon dort, und die Einladung, die App zu laden, erscheint nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε είδαμε στο κινητό σου. Οι ομάδες σου είναι ήδη εκεί και η πρόσκληση για λήψη της εφαρμογής δεν θα εμφανιστεί ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vimos en tu celular. Tus grupos ya están ahí, y la invitación para descargar la app no volverá a aparecer."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vimos en tu móvil. Tus grupos ya están ahí, y la invitación para descargar la app no volverá a aparecer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nägime sind telefonis. Sinu grupid on juba seal ja kutset rakendus alla laadida enam ei kuvata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما را در گوشی‌تان دیدیم. گروه‌هایتان از قبل آنجا هستند و دعوت به دانلود برنامه دیگر نمایش داده نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näimme sinut puhelimellasi. Ryhmäsi ovat jo siellä, eikä kutsua ladata sovellusta näytetä enää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakita ka namin sa phone mo. Nandoon na ang mga grupo mo, at hindi na lalabas ang imbitasyong i-download ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On t’a vu sur ton téléphone. Tes groupes y sont déjà, et l’invitation à télécharger l’app ne s’affichera plus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અમે તમને તમારા ફોન પર જોયા. તમારા ગ્રુપ ત્યાં પહેલેથી છે, અને ઍપ ડાઉનલોડ કરવાનું આમંત્રણ ફરી દેખાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ראינו שהאפליקציה כבר בטלפון שלך. הקבוצות שלך כבר שם, וההזמנה להוריד את האפליקציה לא תוצג שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने आपको आपके फ़ोन पर देखा। आपके ग्रुप पहले से वहां हैं, और ऐप डाउनलोड करने का आमंत्रण फिर नहीं दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidjeli smo te na telefonu. Tvoje su grupe već tamo, a poziv za preuzimanje aplikacije više se neće prikazivati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Láttunk a telefonodon. A csoportjaid már ott vannak, és az app letöltésére hívó üzenet nem jelenik meg többé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami melihatmu di ponsel. Grupmu sudah ada di sana, dan ajakan untuk mengunduh aplikasi tidak akan tampil lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti abbiamo visto sul telefono. I tuoi gruppi sono già lì e l’invito a scaricare l’app non comparirà più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンでの利用を確認しました。グループはすでにそちらにあり、アプリのダウンロード案内は今後表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰에서 사용 중인 것을 확인했어요. 그룹은 이미 그곳에 있고, 앱 다운로드 안내는 다시 표시되지 않아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matėme tave telefone. Tavo grupės jau ten, o kvietimas atsisiųsti programėlę daugiau nebus rodomas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redzam, ka izmanto lietotni tālrunī. Tavas grupas jau ir tur, un uzaicinājums lejupielādēt lietotni vairs netiks rādīts."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही फोनवर असल्याचे आम्हाला दिसले. तुमचे ग्रुप तिथे आधीच आहेत, आणि ॲप डाउनलोड करण्याचे आमंत्रण पुन्हा दिसणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami nampak anda menggunakan telefon. Kumpulan anda sudah ada di sana, dan jemputan untuk memuat turun aplikasi tidak akan dipaparkan lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi så deg på telefonen. Gruppene dine er allerede der, og invitasjonen til å laste ned appen vises ikke igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zagen je op je telefoon. Je groepen staan er al, en de uitnodiging om de app te downloaden verschijnt niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzimy, że masz aplikację na telefonie. Twoje grupy już tam są, a zaproszenie do pobrania aplikacji nie pojawi się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vimos você no celular. Seus grupos já estão lá, e o convite para baixar o app não aparece mais."
