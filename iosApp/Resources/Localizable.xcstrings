        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 수단으로 표시한 지출에 더 이상 표시되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil yang anda tandakan dengannya tidak akan memaparkannya lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgaven die je ermee hebt gemarkeerd, tonen hem niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydatki oznaczone tą metodą przestaną ją pokazywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas marcadas com ela deixam de mostrá-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuielile marcate cu ea nu o vor mai afișa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счета, отмеченные этим способом, больше не будут его показывать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdavky, ktoré si ním označil(a), ho už nebudú zobrazovať."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Računi koje si njime označio/la više ga neće prikazivati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgifter du markerade med det visar det inte längre."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதைக் குறித்த செலவுகளில் இனி இது காட்டப்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลที่คุณทำเครื่องหมายไว้ด้วยช่องทางนี้จะไม่แสดงช่องทางนี้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bununla işaretlediğin harcamalar artık onu göstermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахунки, які ти позначив цим способом, більше не показуватимуть його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جن خرچوں پر آپ نے اسے لگایا تھا، ان پر یہ اب نظر نہیں آئے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản chi bạn đã đánh dấu bằng phương thức này sẽ không hiện nó nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用它标记过的账单将不再显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用它標記過的帳單將不再顯示它。"
          }
        }
      }
    },
