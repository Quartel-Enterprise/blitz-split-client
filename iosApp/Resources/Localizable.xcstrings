    "See and edit the words that pick a bill's category from its title." : {
      "comment" : "Category map card",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطّلع على الكلمات التي تختار فئة الفاتورة من عنوانها وعدّلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виж и редактирай думите, които избират категорията на разхода по заглавието му."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেসব শব্দ বিলের শিরোনাম থেকে ক্যাটাগরি ঠিক করে, সেগুলো দেখুন ও সম্পাদনা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraz a uprav slova, která podle názvu výdaje vybírají jeho kategorii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die Wörter an, die die Kategorie einer Ausgabe aus ihrem Titel bestimmen, und bearbeite sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες και επεξεργάσου τις λέξεις που επιλέγουν την κατηγορία ενός εξόδου από τον τίτλο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira y edita las palabras que eligen la categoría de un gasto según su título."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژه‌هایی را که دسته‌بندی هزینه را از روی عنوانش انتخاب می‌کنند ببینید و ویرایش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan at i-edit ang mga salitang pumipili ng kategorya ng bill mula sa pamagat nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois et modifie les mots qui choisissent la catégorie d’une dépense d’après son titre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לראות ולערוך את המילים שבוחרות את הקטגוריה של חשבון לפי הכותרת שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे शब्द देखें और बदलें जो खर्च के टाइटल से उसकी श्रेणी चुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledaj i uredi riječi koje iz naslova troška biraju njegovu kategoriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nézd meg és szerkeszd azokat a szavakat, amelyek a címből kiválasztják a számla kategóriáját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat dan edit kata-kata yang menentukan kategori tagihan dari judulnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi e modifica le parole che scelgono la categoria di una spesa dal suo titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルから支出のカテゴリを決める単語を確認・編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출 제목으로 카테고리를 정하는 단어를 보고 수정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat dan edit perkataan yang memilih kategori bil daripada tajuknya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk en bewerk de woorden die de categorie van een uitgave uit de titel kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz i edytuj słowa, które wybierają kategorię wydatku na podstawie tytułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja e edite as palavras que escolhem a categoria pelo título da conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê e edita as palavras que escolhem a categoria pelo título da conta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezi și editează cuvintele care aleg categoria unei cheltuieli din titlul ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри и редактируй слова, которые выбирают категорию счёта по его названию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozri a uprav slová, ktoré vyberajú kategóriu výdavku podľa jeho názvu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledaj i izmeni reči koje određuju kategoriju računa prema naslovu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se och redigera orden som väljer en utgifts kategori utifrån titeln."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செலவின் தலைப்பிலிருந்து அதன் வகையைத் தேர்ந்தெடுக்கும் சொற்களைப் பார்த்துத் திருத்துங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูและแก้ไขคำที่ใช้เลือกหมวดหมู่ของบิลจากชื่อบิล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir harcamanın kategorisini başlığından seçen kelimeleri gör ve düzenle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переглянь і зміни слова, що обирають категорію рахунку за його назвою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ الفاظ دیکھیں اور ان میں ترمیم کریں جو خرچ کے عنوان سے اس کی کیٹیگری چنتے ہیں۔"
          }
