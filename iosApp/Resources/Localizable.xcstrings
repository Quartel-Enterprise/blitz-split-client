    "When someone owes, just pick here who paid." : {
      "comment" : "Who paid whom?: no open pair",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون على أحد دين، اختر هنا فقط من دفع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато някой дължи, просто избери тук кой плати."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কারও দেনা থাকলে এখানে শুধু বেছে নিন কে পরিশোধ করেছেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan algú degui, tria aquí qui ha pagat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když někdo dluží, stačí tady vybrat, kdo platil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når nogen skylder, skal du bare vælge her, hvem der betalte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn jemand etwas schuldet, wähl hier einfach, wer bezahlt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν κάποιος χρωστάει, απλώς διάλεξε εδώ ποιος πλήρωσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien deba, solo elige aquí quién pagó."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui keegi võlgneb, vali siin lihtsalt, kes maksis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی کسی بدهکار است، فقط اینجا انتخاب کنید چه کسی پرداخت کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun joku on velkaa, valitse tästä vain kuka maksoi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag may may utang, piliin lang dito kung sino ang nagbayad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu’un doit, choisis simplement ici qui a payé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જ્યારે કોઈએ આપવાના હોય, ત્યારે અહીં બસ કોણે ચૂકવ્યું તે પસંદ કરો."
