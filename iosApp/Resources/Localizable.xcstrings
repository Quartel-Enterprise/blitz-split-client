        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleg konnte nicht gelesen werden. Versuch es mit mehr Licht und dem ganzen Beleg im Foto erneut, oder füll es von Hand aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση της απόδειξης. Δοκίμασε ξανά με περισσότερο φως και ολόκληρη την απόδειξη στη φωτογραφία, ή συμπλήρωσέ το με το χέρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el recibo. Inténtalo de nuevo con más luz y el recibo completo en la foto, o complétalo a mano."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tšekki ei õnnestunud lugeda. Proovi uuesti parema valgusega ja nii, et kogu tšekk on fotol, või täida käsitsi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسید خوانده نشد. با نور بیشتر و کل رسید در عکس دوباره تلاش کنید، یا آن را دستی پر کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuitin lukeminen epäonnistui. Yritä uudelleen paremmassa valossa niin, että koko kuitti on kuvassa, tai täytä tiedot käsin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nabasa ang resibo. Subukan ulit nang mas maliwanag at kita ang buong resibo sa larawan, o punan ito nang mano-mano."
