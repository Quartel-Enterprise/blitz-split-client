    "We kept the link. As soon as the device connects, the invite opens by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الاحتفاظ بالرابط. بمجرد اتصال الجهاز، تُفتح الدعوة تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазихме линка. Щом устройството се свърже, поканата ще се отвори сама."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা লিংকটি রেখে দিয়েছি। ডিভাইস সংযুক্ত হলেই আমন্ত্রণটি নিজে থেকে খুলে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz jsme si uložili. Jakmile se zařízení připojí, pozvánka se otevře sama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben den Link behalten. Sobald das Gerät verbunden ist, öffnet sich die Einladung von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήσαμε τον σύνδεσμο. Μόλις η συσκευή συνδεθεί, η πρόσκληση θα ανοίξει αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos el enlace. En cuanto el dispositivo se conecte, la invitación se abre sola."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینک را نگه داشتیم. به محض اتصال دستگاه، دعوت خودبه‌خود باز می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinago namin ang link. Kapag nakakonekta na ang device, kusang magbubukas ang imbitasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a gardé le lien. Dès que l’appareil se connecte, l’invitation s’ouvre toute seule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרנו את הקישור. ברגע שהמכשיר יתחבר, ההזמנה תיפתח לבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने लिंक रख लिया है। डिवाइस कनेक्ट होते ही आमंत्रण अपने आप खुल जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sačuvali smo poveznicu. Čim se uređaj poveže, pozivnica će se sama otvoriti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megőriztük a linket. Amint az eszköz csatlakozik, a meghívó magától megnyílik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautannya kami simpan. Begitu perangkat terhubung, undangan akan terbuka sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo conservato il link. Appena il dispositivo si connette, l’invito si apre da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクは保持しています。デバイスが接続されると、招待が自動で開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크를 보관했어요. 기기가 연결되면 초대가 자동으로 열려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami menyimpan pautan ini. Sebaik sahaja peranti disambungkan, jemputan akan dibuka dengan sendirinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben de link bewaard. Zodra het apparaat verbinding heeft, opent de uitnodiging vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaliśmy link. Gdy tylko urządzenie połączy się z siecią, zaproszenie otworzy się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos o link. Assim que o aparelho conectar, o convite abre sozinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardámos o link. Assim que o aparelho tiver ligação, o convite abre sozinho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am păstrat linkul. Imediat ce dispozitivul se conectează, invitația se deschide singură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы сохранили ссылку. Как только устройство подключится, приглашение откроется само."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz sme si uložili. Hneď ako sa zariadenie pripojí, pozvánka sa otvorí sama."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sačuvali smo link. Čim se uređaj poveže, pozivnica se otvara sama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sparade länken. Så fort enheten är ansluten öppnas inbjudan av sig själv."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "லிங்க்கை வைத்துள்ளோம். சாதனம் இணைந்தவுடன், அழைப்பு தானாகத் திறக்கும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราเก็บลิงก์ไว้แล้ว ทันทีที่อุปกรณ์เชื่อมต่อ คำเชิญจะเปิดขึ้นเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı sakladık. Cihaz bağlanır bağlanmaz davet kendiliğinden açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми зберегли посилання. Щойно пристрій підключиться, запрошення відкриється саме."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم نے لنک محفوظ رکھا ہے۔ جیسے ہی ڈیوائس کنیکٹ ہو گی، دعوت خود بخود کھل جائے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi đã giữ liên kết. Ngay khi thiết bị có kết nối, lời mời sẽ tự mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接已保存。设备一联网，邀请就会自动打开。"
