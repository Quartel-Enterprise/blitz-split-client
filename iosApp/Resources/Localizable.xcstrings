          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα είναι συγχρονισμένα με τον λογαριασμό σου %@. Όταν αποσυνδεθείς, διαγράφουμε το αντίγραφο από αυτό το %@. Οι ομάδες σου επιστρέφουν όταν συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
