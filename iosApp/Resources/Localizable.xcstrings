    "Your data stays on this %@ until the sync finishes. Once everything is uploaded, we sign out and erase the local copy." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem %@, bis die Synchronisierung fertig ist. Sobald alles hochgeladen ist, melden wir dich ab und löschen die lokale Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este %@ hasta que termine la sincronización. En cuanto todo se suba, cerramos sesión y borramos la copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données restent sur ton %@ jusqu’à la fin de la synchronisation. Une fois tout envoyé, on te déconnecte et on efface la copie locale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamu tetap di %@ ini sampai sinkronisasi selesai. Begitu semuanya terunggah, kami keluarkan kamu dan menghapus salinan lokalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati restano su questo %@ finché la sincronizzazione non finisce. Quando tutto è stato caricato, ti disconnettiamo e cancelliamo la copia locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が終わるまでデータはこの%@に残ります。すべてアップロードされたら、ログアウトしてローカルのコピーを消去します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens blijven op deze %@ tot de synchronisatie klaar is. Zodra alles is geüpload, loggen we uit en wissen we de lokale kopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje dane zostają na tym urządzeniu (%@) do końca synchronizacji. Gdy wszystko zostanie wysłane, wylogujemy cię i wymażemy kopię lokalną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados ficam neste %@ até a sincronização terminar. Assim que tudo subir, saímos e apagamos a cópia local."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verilerin eşitleme bitene kadar bu %@ cihazında kalır. Her şey yüklenince çıkış yaparız ve yerel kopyayı sileriz."
          }
        }
      }
    },
