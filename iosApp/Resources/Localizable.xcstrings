    "Nobody owes anything in this group. If the trip is over, you can delete the group for everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد عليه شيء في هذه المجموعة. إن انتهت الرحلة، يمكنك حذف المجموعة للجميع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никой не дължи нищо в тази група. Ако пътуването е приключило, можеш да изтриеш групата за всички."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই গ্রুপে কারও কোনো দেনা নেই। ভ্রমণ শেষ হয়ে গেলে আপনি সবার জন্য গ্রুপটি মুছে ফেলতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
