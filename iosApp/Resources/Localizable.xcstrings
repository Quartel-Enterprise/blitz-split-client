    "The last saved edit wins: if you save now, your edit replaces that change." : {
      "comment" : "Conflict banner of Edit bill, after who changed it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر تعديل محفوظ هو المعتمد: إن حفظت الآن، فسيحل تعديلك محل ذلك التغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Печели последната запазена редакция: ако запазиш сега, твоята редакция заменя онази промяна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবশেষে সংরক্ষিত সম্পাদনাই থাকবে: এখন সংরক্ষণ করলে আপনার সম্পাদনা ওই পরিবর্তনের জায়গা নেবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guanya l’última edició desada: si deses ara, la teva edició substitueix aquest canvi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhrává poslední uložená úprava: pokud teď uložíš, tvoje úprava tu změnu nahradí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den senest gemte ændring vinder: gemmer du nu, erstatter din ændring den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zuletzt gespeicherte Änderung gewinnt: Wenn du jetzt speicherst, ersetzt deine Änderung diese."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει η τελευταία αποθηκευμένη αλλαγή: αν αποθηκεύσεις τώρα, η δική σου αλλαγή θα την αντικαταστήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la última edición guardada: si guardas ahora, tu edición reemplaza ese cambio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimati salvestatud muudatus jääb kehtima: kui salvestad nüüd, asendab sinu muudatus selle."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخرین ویرایش ذخیره‌شده برنده است: اگر الان ذخیره کنید، ویرایش شما جایگزین آن تغییر می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeksi tallennettu muokkaus voittaa: jos tallennat nyt, muokkauksesi korvaa tuon muutoksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang huling na-save na edit ang masusunod: kung mag-save ka ngayon, papalitan ng edit mo ang pagbabagong iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière modification enregistrée l’emporte : si tu enregistres maintenant, ta modification remplace ce changement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "છેલ્લે સેવ થયેલો ફેરફાર માન્ય રહે છે: જો તમે હમણાં સેવ કરશો, તો તમારો ફેરફાર તે ફેરફારની જગ્યા લેશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העריכה האחרונה שנשמרת קובעת: שמירה עכשיו תחליף את השינוי הזה בעריכה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आखिरी सहेजा गया बदलाव ही रहता है: अगर आप अभी सहेजते हैं, तो आपका बदलाव उस बदलाव की जगह ले लेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobjeđuje zadnja spremljena izmjena: ako sada spremiš, tvoja izmjena zamjenjuje tu promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utoljára mentett módosítás nyer: ha most mentesz, a módosításod felülírja azt a változtatást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suntingan terakhir yang disimpan yang berlaku: kalau kamu simpan sekarang, suntinganmu menggantikan perubahan itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vince l’ultima modifica salvata: se salvi ora, la tua modifica sostituisce quella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に保存された編集が優先されます：今保存すると、あなたの編集でその変更が置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막에 저장한 수정이 적용돼요: 지금 저장하면 내 수정이 그 변경을 덮어써요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laimi paskutinis išsaugotas pakeitimas: jei išsaugosi dabar, tavo pakeitimas pakeis anąjį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzvar pēdējais saglabātais labojums: ja saglabāsi tagad, tavs labojums aizstās šo izmaiņu."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेवटचे सेव्ह केलेले संपादन टिकते: तुम्ही आता सेव्ह केल्यास, तुमचे संपादन तो बदल बदलून टाकेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suntingan terakhir yang disimpan akan digunakan: jika anda simpan sekarang, suntingan anda menggantikan perubahan itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sist lagrede endringen vinner: hvis du lagrer nå, erstatter endringen din den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatst opgeslagen wijziging wint: als je nu opslaat, vervangt jouw wijziging die van de ander."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygrywa ostatnia zapisana edycja: jeśli zapiszesz teraz, twoja edycja zastąpi tę zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a última edição salva: se você salvar agora, a sua edição substitui essa mudança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a última edição guardada: se guardares agora, a tua edição substitui essa alteração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câștigă ultima modificare salvată: dacă salvezi acum, modificarea ta o înlocuiește pe aceea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Побеждает последнее сохранённое изменение: если сохранишь сейчас, твоё изменение заменит то."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí posledná uložená úprava: ak teraz uložíš, tvoja úprava nahradí tú zmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvelja zadnja shranjena sprememba: če shraniš zdaj, tvoja sprememba nadomesti tisto."
