    "Invite someone from your contacts with one of your groups' links. Their numbers stay on this %@." : {
      "comment" : "The agenda before the system asks; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك دعوة شخص من جهات اتصالك برابط إحدى مجموعاتك. تبقى الأرقام على %@ الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade jemanden aus deinen Kontakten mit dem Link einer deiner Gruppen ein. Die Nummern bleiben auf diesem %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a alguien de tus contactos con el enlace de uno de tus grupos. Los números quedan solo en este %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite quelqu’un de tes contacts avec le lien d’un de tes groupes. Leurs numéros restent sur ton %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להזמין מישהו מאנשי הקשר עם קישור של אחת הקבוצות. המספרים נשארים ב-%@ הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने किसी ग्रुप के लिंक से अपने संपर्कों में से किसी को आमंत्रित करें। उनके नंबर इसी %@ पर रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undang seseorang dari kontakmu dengan salah satu tautan grupmu. Nomor mereka tetap di %@ ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita qualcuno dai tuoi contatti con il link di uno dei tuoi gruppi. I loro numeri restano su questo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループのリンクで連絡先から誰かを招待できます。電話番号はこの%@から出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 그룹 링크로 연락처에서 누군가를 초대하세요. 전화번호는 이 %@ 기기에만 남아 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig iemand uit je contacten uit met de link van een van je groepen. Hun nummers blijven op deze %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproś kogoś z kontaktów, używając linku do jednej z twoich grup. Numery zostają na tym urządzeniu (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide alguém da sua agenda com o link de um grupo seu. Os números ficam só neste %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida alguém dos teus contactos com o link de um dos teus grupos. Os números ficam só neste %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригласи кого-нибудь из контактов по ссылке одной из твоих групп. Их номера остаются на этом %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชิญคนจากรายชื่อติดต่อด้วยลิงก์ของกลุ่มใดกลุ่มหนึ่งของคุณ เบอร์โทรของพวกเขาจะอยู่แค่ใน %@ เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruplarından birinin bağlantısıyla kişilerinden birini davet et. Numaraları bu %@ cihazında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запроси когось зі своїх контактів за посиланням на одну з твоїх груп. Їхні номери залишаються на цьому пристрої (%@)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mời ai đó từ danh bạ của bạn bằng liên kết của một trong các nhóm của bạn. Số điện thoại của họ chỉ nằm trên %@ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你某个群组的链接邀请联系人。他们的号码只保存在这台%@上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你某個群組的連結邀請聯絡人。他們的號碼只儲存在這台%@上。"
          }
        }
      }
    },
    "It's also in %@." : {
      "comment" : "%@ is where the recovery code lives: Profile › Recovery on iOS, Settings › Recovery on the Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
