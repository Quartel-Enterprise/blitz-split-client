          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad kalder dine venner dig?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie nennen dich deine Freunde?"
