    "No word of your map. The bill stays in Other; tap the icon to pick one." : {
      "comment" : "Under a bill's description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد كلمة من خريطتك. تبقى الفاتورة في «أخرى»؛ اضغط على الأيقونة لاختيار فئة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма дума от твоята карта. Разходът остава в „Друго“; докосни иконата, за да избереш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ম্যাপের কোনো শব্দ মেলেনি। বিলটি অন্যান্য ক্যাটাগরিতে থাকবে; বেছে নিতে আইকনে ট্যাপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap paraula del teu mapa. La despesa es queda a Altres; toca la icona per triar-ne una."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné slovo z tvé mapy. Výdaj zůstane v kategorii Ostatní; klepnutím na ikonu nějakou vyber."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet ord fra dit kort. Udgiften bliver i Andet; tryk på ikonet for at vælge en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Wort deiner Zuordnung. Die Ausgabe bleibt in „Sonstiges“; tippe auf das Symbol, um eine zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία λέξη του χάρτη σου. Το έξοδο μένει στην κατηγορία Άλλο. Πάτα το εικονίδιο για να διαλέξεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna palabra de tu mapa. El gasto queda en Otros; toca el ícono para elegir una."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna palabra de tu mapa. El gasto queda en Otros; toca el icono para elegir una."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu kaardil pole sobivat sõna. Kulu jääb kategooriasse Muu; puuduta ikooni, et kategooria valida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ واژه‌ای از نقشه شما نیست. هزینه در «سایر» می‌ماند؛ برای انتخاب، روی نماد بزنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään karttasi sana ei täsmää. Kulu jää luokkaan Muut; valitse luokka napauttamalla kuvaketta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang salita sa mapa mo. Mananatili ang bill sa Iba pa; i-tap ang icon para pumili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mot de ta carte. La dépense reste dans Autre ; touche l’icône pour en choisir un."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા મૅપનો કોઈ શબ્દ નથી. ખર્ચ ‘અન્ય’ માં રહે છે; એક પસંદ કરવા માટે આઇકન પર ટૅપ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אף מילה מהמפה שלך. החשבון נשאר בקטגוריה \"אחר\"; אפשר להקיש על הסמל כדי לבחור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके मैप का कोई शब्द नहीं मिला। खर्च अन्य में रहेगा; कोई श्रेणी चुनने के लिए आइकन पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna riječ iz tvoje mape. Trošak ostaje u kategoriji Ostalo; dodirni ikonu da odabereš drugu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térképed egyik szava sem illik rá. A számla az Egyéb kategóriában marad; koppints az ikonra a választáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada kata dari petamu. Tagihan tetap di Lainnya; ketuk ikon untuk memilih kategori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna parola della tua mappa. La spesa resta in Altro; tocca l’icona per sceglierne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップの単語がありません。支出は「その他」のままです。アイコンをタップして選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 키워드에 해당하는 단어가 없어요. 지출은 기타에 남아요. 아이콘을 탭해서 고르세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nė vieno tavo žemėlapio žodžio. Išlaida lieka kategorijoje „Kita“; paliesk piktogramą, kad pasirinktum."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav neviena vārda no tavas kartes. Rēķins paliek kategorijā Citi; pieskaries ikonai, lai izvēlētos kategoriju."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या मॅपमधील कोणताही शब्द नाही. खर्च ‘इतर’ कॅटेगरीत राहतो; एक निवडण्यासाठी आयकॉनवर टॅप करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada perkataan daripada peta anda. Bil kekal dalam Lain-lain; ketik ikon untuk memilih kategori."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ord fra kartet ditt. Utgiften blir i Annet; trykk på ikonet for å velge en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen woord uit je kaart. De uitgave blijft in Overig; tik op het icoon om er een te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak słowa z twojej mapy. Wydatek zostaje w kategorii Inne; stuknij ikonę, aby wybrać kategorię."
