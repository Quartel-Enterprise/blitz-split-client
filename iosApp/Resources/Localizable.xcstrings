          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Консумираното е делът на всеки от разходите според разделянето на всеки разход."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“নিজের অংশ” মানে খরচে প্রত্যেকের ভাগ, প্রতিটি বিল যেভাবে ভাগ করা হয়েছে সেই অনুযায়ী।"
