    "The link was changed or the group was deleted. Ask whoever invited you for a new link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link wurde geändert oder die Gruppe gelöscht. Bitte die Person, die dich eingeladen hat, um einen neuen Link."
