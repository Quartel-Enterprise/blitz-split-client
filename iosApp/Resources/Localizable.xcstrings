    "Couldn't read the receipt. Try again with more light and the whole receipt in the photo, or fill it in by hand." : {
      "comment" : "Split a bill: the receipt couldn't be read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleg konnte nicht gelesen werden. Versuch es mit mehr Licht und dem ganzen Beleg im Foto erneut, oder füll es von Hand aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el recibo. Inténtalo de nuevo con más luz y el recibo completo en la foto, o complétalo a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le reçu. Réessaie avec plus de lumière et tout le reçu dans la photo, ou remplis-le à la main."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal membaca struk. Coba lagi dengan cahaya lebih terang dan seluruh struk di foto, atau isi manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere lo scontrino. Riprova con più luce e lo scontrino intero nella foto, o compila a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートを読み取れませんでした。明るい場所でレシート全体が写るように撮り直すか、手動で入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan het bonnetje niet lezen. Probeer het opnieuw met meer licht en het hele bonnetje op de foto, of vul het met de hand in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać paragonu. Spróbuj ponownie przy lepszym świetle i z całym paragonem na zdjęciu albo wpisz dane ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu para ler o cupom. Tente de novo com mais luz e o cupom inteiro na foto, ou preencha à mão."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiş okunamadı. Daha fazla ışıkla ve fişin tamamı fotoğrafta olacak şekilde tekrar dene ya da elle doldur."
          }
        }
      }
    },
