    "%@ deleted “%@” after everyone settled up. Nothing was left open, and the group leaves your list." : {
      "comment" : "Someone else deleted the group while it was open; the first %@ is who, the second the group",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: حذف «%@» بعد أن تمت التسوية بين الجميع. لم يبقَ شيء مفتوح، وتخرج المجموعة من قائمتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ изтри „%@“, след като всички уредиха сметките. Нищо не остана неуредено и групата излиза от списъка ти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবার হিসাব মেটার পর %@ “%@” মুছে ফেলেছেন। কিছুই বাকি ছিল না, আর গ্রুপটি আপনার তালিকা থেকে সরে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha suprimit «%@» després que tothom liquidés comptes. No quedava res pendent, i el grup surt de la teva llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ smazal(a) „%@“ poté, co se všichni vyrovnali. Nic nezůstalo otevřené a skupina zmizí z tvého seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slettede »%@«, efter at alle havde gjort op. Intet stod åbent, og gruppen forsvinder fra din liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat „%2$@“ gelöscht, nachdem alle beglichen hatten. Nichts war mehr offen, und die Gruppe verschwindet aus deiner Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ διέγραψε την ομάδα «%@» αφού όλοι εξόφλησαν. Δεν έμεινε τίποτα ανοιχτό και η ομάδα φεύγει από τη λίστα σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eliminó “%2$@” después de que todos saldaron cuentas. No quedó nada pendiente, y el grupo sale de tu lista."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on kustutanud grupi „%@“ pärast seda, kui kõik olid arveldanud. Midagi ei jäänud lahtiseks ja grupp kaob sinu loendist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ گروه «%@» را پس از تسویه حساب همه حذف کرد. چیزی باز نماند و گروه از فهرست شما حذف می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on poistanut ryhmän ”%@”, kun kaikki olivat tasanneet. Mitään ei jäänyt avoimeksi, ja ryhmä poistuu listaltasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binura ni %@ ang “%@” matapos magbayaran ng lahat. Walang natirang bukas, at aalis ang grupo sa listahan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a supprimé « %2$@ » après que tout le monde a réglé. Il ne restait rien d’ouvert, et le groupe quitte ta liste."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બધાનો હિસાબ પતી ગયા પછી %@ એ “%@” ડિલીટ કર્યું. કંઈ બાકી ન હતું, અને ગ્રુપ તમારી સૂચિમાંથી નીકળી જાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: מחיקת \"%@\" אחרי שכולם סגרו חשבון. לא נשאר שום דבר פתוח, והקבוצה יוצאת מהרשימה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने सबका हिसाब बराबर होने के बाद “%@” हटा दिया। कुछ भी बाकी नहीं था, और ग्रुप आपकी सूची से हट जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je izbrisao/la „%@“ nakon što su svi podmirili dugove. Ništa nije ostalo otvoreno i grupa nestaje s tvog popisa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ törölte a csoportot: „%@”, miután mindenki elszámolt. Semmi sem maradt nyitva, és a csoport kikerül a listádból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghapus “%@” setelah semua lunas. Tidak ada yang tersisa, dan grup ini hilang dari daftarmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha eliminato «%@» dopo che tutti avevano saldato. Non era rimasto nulla in sospeso e il gruppo esce dalla tua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が精算した後、%@が「%@」を削除しました。未精算のものはなく、グループはリストから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 모두 정산한 뒤 ‘%@’ 그룹을 삭제했어요. 미정산 금액은 없었고, 그룹은 목록에서 사라져요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ištrynė „%@“, kai visi atsiskaitė. Neliko nieko neapmokėto, ir grupė dingsta iš tavo sąrašo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ izdzēsa „%@”, kad visi bija norēķinājušies. Nekas nepalika atvērts, un grupa pazūd no tava saraksta."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वांचा हिशोब पूर्ण झाल्यावर %@ यांनी “%@” ग्रुप हटवला. काहीही बाकी नव्हते, आणि ग्रुप तुमच्या यादीतून निघून जातो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ memadam “%@” selepas semua orang menyelesaikan hutang. Tiada baki belum selesai, dan kumpulan ini hilang daripada senarai anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slettet «%@» etter at alle hadde gjort opp. Ingenting sto åpent, og gruppen forsvinner fra listen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft “%2$@” verwijderd nadat iedereen had verrekend. Er stond niets meer open en de groep verdwijnt uit je lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skasował(a) „%2$@” po pełnym rozliczeniu. Nic nie zostało otwarte, a grupa znika z twojej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ apagou “%2$@” depois que todo mundo acertou. Nada ficou pendente, e o grupo sai da sua lista."
          }
