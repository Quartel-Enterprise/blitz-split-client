          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開いた人は、グループのリストから自分の名前を選ぶか、新しいメンバーとして参加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크를 연 사람은 그룹 목록에서 자기 이름을 고르거나 새 멤버로 참여해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de link opent, kiest zijn naam in de lijst van de groep of doet mee als nieuw lid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto otworzy link, wybierze swoje imię z listy grupy albo dołączy jako nowy członek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir o link escolhe o nome na lista do grupo ou entra como membro novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто откроет ссылку, выберет своё имя в списке группы или присоединится как новый участник."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครที่เปิดลิงก์จะเลือกชื่อของตัวเองในรายชื่อของกลุ่ม หรือเข้าร่วมเป็นสมาชิกใหม่"
