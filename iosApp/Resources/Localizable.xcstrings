    "Create a group first: an invite is always a group's link." : {
      "comment" : "Contacts' invite with no group yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعة أولًا: الدعوة دائمًا رابط لمجموعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първо създай група: поканата винаги е линк към група."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগে একটি গ্রুপ তৈরি করুন: আমন্ত্রণ সব সময় কোনো গ্রুপের লিংক হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer crea un grup: una invitació sempre és l’enllaç d’un grup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív vytvoř skupinu: pozvánka je vždy odkaz na skupinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en gruppe først: en invitation er altid en gruppes link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle zuerst eine Gruppe: Eine Einladung ist immer der Link einer Gruppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιούργησε πρώτα μια ομάδα: η πρόσκληση είναι πάντα σύνδεσμος ομάδας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero crea un grupo: una invitación siempre es el enlace de un grupo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loo esmalt grupp: kutse on alati grupi link."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اول یک گروه بسازید: دعوت همیشه لینک یک گروه است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo ensin ryhmä: kutsu on aina ryhmän linkki."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumawa muna ng grupo: palaging link ng isang grupo ang imbitasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée d’abord un groupe : une invitation est toujours le lien d’un groupe."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પહેલાં ગ્રુપ બનાવો: આમંત્રણ હંમેશા ગ્રુપની લિંક હોય છે."
          }
        },
        "he" : {
