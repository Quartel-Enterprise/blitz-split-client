    "You can use the app meanwhile: what has arrived shows below." : {
      "comment" : "Groups: the first download's card, before the server says how many groups are coming",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استخدام التطبيق في الأثناء: ما وصل يظهر أدناه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Междувременно можеш да ползваш приложението: пристигналото се показва по-долу."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর মধ্যেই অ্যাপটি ব্যবহার করতে পারেন: যা এসেছে তা নিচে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentrestant pots fer servir l’app: el que ja ha arribat es mostra a sota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezitím můžeš aplikaci používat: co už dorazilo, vidíš níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruge appen imens: det, der er kommet, vises nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die App solange nutzen: Was schon da ist, siehst du unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να χρησιμοποιείς την εφαρμογή στο μεταξύ: ό,τι έχει φτάσει εμφανίζεται παρακάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar la app mientras tanto: lo que ya llegó aparece abajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saad rakendust vahepeal kasutada: juba saabunu on allpool."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در این مدت می‌توانید از برنامه استفاده کنید: آنچه رسیده در پایین نمایش داده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit käyttää sovellusta sillä välin: saapuneet näkyvät alla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magagamit mo na ang app habang hinihintay: lalabas sa ibaba ang mga dumating na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux utiliser l’app en attendant : ce qui est arrivé s’affiche ci-dessous."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તે દરમિયાન તમે ઍપ વાપરી શકો છો: જે આવી ગયું છે તે નીચે દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בינתיים אפשר להשתמש באפליקציה: מה שכבר הגיע מופיע למטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बीच आप ऐप इस्तेमाल कर सकते हैं: जो आ चुका है वह नीचे दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaciju možeš koristiti u međuvremenu: ono što je stiglo prikazuje se ispod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Közben is használhatod az appot: ami már megérkezett, lent látható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sementara itu kamu bisa memakai aplikasi: yang sudah tiba tampil di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare l’app nel frattempo: quello che è arrivato compare qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その間もアプリを使えます。届いたものは下に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그동안에도 앱을 사용할 수 있어요. 도착한 내용은 아래에 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo metu gali naudotis programėle: tai, kas jau atėjo, rodoma žemiau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa to laiku vari lietot lietotni: tas, kas jau ienācis, redzams zemāk."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दरम्यान तुम्ही ॲप वापरू शकता: जे आले आहे ते खाली दिसते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menggunakan aplikasi sementara menunggu: yang sudah tiba dipaparkan di bawah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruke appen så lenge: det som har kommet, vises nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de app intussen gebruiken: wat al binnen is, staat hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym czasie możesz korzystać z aplikacji: to, co już dotarło, widać poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
