          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog een openstaand saldo in “%@”. Als je nu vertrekt, blijft het voor de anderen onverrekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wciąż masz otwarte saldo w „%@”. Wyjście teraz zostawiłoby je nierozliczone dla innych."
          }
