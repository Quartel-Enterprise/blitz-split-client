        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این %@ هنوز همگام‌سازی نشده، پس فقط کارهایی که روی آن انجام داده‌اید اینجا نمایش داده می‌شود. فعالیت گروه با اولین اتصال می‌رسد، با حساب کاربری یا بدون آن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitetta %@ ei ole vielä synkronoitu, joten tässä näkyy vain se, mitä teit sillä. Ryhmien toiminta saapuu ensimmäisellä yhteydellä, tilin kanssa tai ilman."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa nagsi-sync ang %@ na ito, kaya ang ginawa mo lang dito ang makikita. Darating ang aktibidad ng grupo sa unang koneksyon, may account man o wala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton %@ n’est pas encore synchronisé, donc seul ce que tu y as fait s’affiche ici. L’activité du groupe arrive à la première connexion, avec ou sans compte."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ %@ હજુ સિંક થયું નથી, તેથી અહીં ફક્ત તમે તેના પર કરેલું જ દેખાય છે. ગ્રુપની પ્રવૃત્તિ પહેલા કનેક્શન પર આવે છે, એકાઉન્ટ સાથે કે વગર."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-%@ הזה עדיין לא סונכרן, לכן מוצג כאן רק מה שנעשה בו. הפעילות של הקבוצות תגיע בחיבור הראשון, עם או בלי חשבון משתמש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ अभी तक सिंक नहीं हुआ है, इसलिए यहां सिर्फ़ वही दिखता है जो आपने इस पर किया। ग्रुप की गतिविधि पहली बार कनेक्ट होने पर आती है, अकाउंट के साथ या बिना।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaj %@ još nije sinkroniziran pa se ovdje prikazuje samo ono što si na njemu napravio/la. Aktivnost grupe stiže pri prvom povezivanju, s računom ili bez njega."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz (%@) még nem szinkronizált, ezért itt csak az látszik, amit rajta csináltál. A csoport tevékenysége az első kapcsolódáskor érkezik, fiókkal vagy anélkül."
