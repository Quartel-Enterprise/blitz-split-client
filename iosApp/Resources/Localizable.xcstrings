    "Add the bill while you're still at the table, even offline. It syncs once you're back online." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الفاتورة وأنت ما زلت على الطاولة، حتى دون اتصال. تتم المزامنة عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добави разхода, докато още си на масата, дори офлайн. Синхронизира се, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টেবিলে বসেই বিল যোগ করুন, অফলাইনেও। আবার অনলাইনে এলে এটি সিঙ্ক হয়ে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix la despesa mentre encara ets a taula, fins i tot sense connexió. Se sincronitza quan tornes a tenir connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej výdaj, ještě když sedíš u stolu, i offline. Synchronizuje se, jakmile budeš zase online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj udgiften, mens du stadig sidder ved bordet, også offline. Den synkroniseres, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse die Ausgabe noch am Tisch, sogar offline. Sie wird synchronisiert, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε το έξοδο όσο είσαι ακόμα στο τραπέζι, ακόμα και εκτός σύνδεσης. Συγχρονίζεται μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el gasto mientras sigues en la mesa, incluso sin conexión. Se sincroniza cuando vuelvas a tener internet."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el gasto mientras sigues en la mesa, incluso sin conexión. Se sincroniza cuando vuelvas a tener internet."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa kulu, kui istud veel laua taga, isegi ilma internetita. See sünkroonitakse, kui oled taas võrgus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه را همان وقت که هنوز سر میز هستید اضافه کنید، حتی آفلاین. وقتی دوباره آنلاین شوید همگام‌سازی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kulu vielä pöydän ääressä, myös offline-tilassa. Se synkronoituu, kun olet taas verkossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang bill habang nasa mesa ka pa, kahit offline. Magsi-sync ito pagbalik mo online."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la dépense pendant que tu es encore à table, même hors ligne. Elle se synchronise dès que tu es de nouveau en ligne."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે હજુ ટેબલ પર હો ત્યારે જ ખર્ચ ઉમેરો, ઑફલાઇન પણ. તમે ફરી ઑનલાઇન થાઓ ત્યારે તે સિંક થઈ જાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף את החשבון עוד ליד השולחן, גם אופליין. הסנכרון יתבצע כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेबल पर रहते हुए ही खर्च जोड़ें, ऑफ़लाइन भी। ऑनलाइन होते ही यह सिंक हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj trošak dok si još za stolom, čak i bez veze. Sinkronizira se čim ponovno budeš na mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá a számlát, amíg még az asztalnál ülsz, akár offline is. Szinkronizálódik, amint újra online vagy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tagihan selagi masih di meja, bahkan offline. Tagihan disinkronkan saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la spesa mentre sei ancora a tavola, anche offline. Si sincronizza quando torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーブルにいるうちに支出を追加できます。オフラインでも大丈夫。オンラインに戻ると同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 식사 자리에 있을 때 지출을 추가하세요. 오프라인에서도 돼요. 다시 온라인이 되면 동기화돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridėk išlaidą dar sėdėdamas (-a) prie stalo, net be interneto. Ji susisinchronizuos, kai vėl prisijungsi prie interneto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievieno rēķinu, kamēr vēl sēdi pie galda, pat bezsaistē. Tas sinhronizēsies, kad atkal būsi tiešsaistē."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेबलवर असतानाच खर्च जोडा, ऑफलाइनसुद्धा. तुम्ही पुन्हा ऑनलाइन आल्यावर तो सिंक होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah bil semasa masih di meja, walaupun di luar talian. Bil akan disegerakkan apabila anda kembali dalam talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til utgiften mens du fortsatt sitter ved bordet, også uten nett. Den synkroniseres når du er på nett igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de uitgave toe terwijl je nog aan tafel zit, zelfs offline. Hij synchroniseert zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj wydatek, jeszcze siedząc przy stole, nawet offline. Zsynchronizuje się, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance a conta ainda na mesa, mesmo sem internet. Sincroniza quando a internet voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista a conta ainda à mesa, mesmo sem internet. Sincroniza quando a internet voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă cheltuiala cât ești încă la masă, chiar și offline. Se sincronizează când revii online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь счёт, пока ещё сидишь за столом, даже офлайн. Он синхронизируется, когда снова будет интернет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridaj výdavok, kým ešte sedíš pri stole, aj offline. Synchronizuje sa, keď budeš znova online."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj strošek, ko si še za mizo, tudi brez povezave. Ko boš spet na spletu, se sinhronizira."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj račun dok si još za stolom, čak i van mreže. Sinhronizuje se čim se vratiš na mrežu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till utgiften medan du fortfarande sitter vid bordet, även offline. Den synkroniseras när du är online igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza gharama ukiwa bado mezani, hata nje ya mtandao. Inasawazishwa ukirudi mtandaoni."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மேஜையில் இருக்கும்போதே, ஆஃப்லைனிலும் செலவைச் சேர்க்கலாம். மீண்டும் ஆன்லைனுக்கு வந்ததும் ஒத்திசைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "టేబుల్ దగ్గర ఉండగానే ఖర్చును జోడించండి, ఆఫ్‌లైన్‌లో ఉన్నా సరే. మీరు మళ్లీ ఆన్‌లైన్‌కి వచ్చాక అది సింక్ అవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มบิลได้ตั้งแต่ยังนั่งอยู่ที่โต๊ะ แม้ออฟไลน์ แล้วจะซิงค์เมื่อกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamayı daha masadayken ekle, çevrimdışı bile. Tekrar çevrimiçi olunca eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай рахунок, поки ще сидиш за столом, навіть офлайн. Він синхронізується, щойно ти знову будеш онлайн."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میز پر بیٹھے بیٹھے ہی خرچ شامل کریں، آف لائن بھی۔ آن لائن ہوتے ہی یہ سنک ہو جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm khoản chi ngay khi còn ngồi tại bàn, kể cả khi ngoại tuyến. Dữ liệu sẽ đồng bộ khi bạn có mạng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还在饭桌上就能添加账单，离线也行。恢复联网后会自动同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
