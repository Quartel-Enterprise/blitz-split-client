        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد مدين لك ولا شيء عليك لأحد. عندما يضيف أحد فاتورة، يظهر الرصيد هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никой не ти дължи и ти не дължиш на никого. Когато някой добави разход, балансът ще се появи тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ আপনাকে কিছু দেবেন না, আপনিও কাউকে কিছু দেবেন না। কেউ বিল যোগ করলে ব্যালেন্স এখানে দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdo ti nedluží a ty nedlužíš nikomu. Když někdo přidá výdaj, zůstatek se zobrazí tady."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand schuldet dir etwas, und du schuldest niemandem etwas. Wenn jemand eine Ausgabe hinzufügt, erscheint der Saldo hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανείς δεν σου χρωστάει και δεν χρωστάς σε κανέναν. Όταν κάποιος προσθέσει ένα έξοδο, το υπόλοιπο θα εμφανιστεί εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie te debe y tú no le debes a nadie. Cuando alguien añada un gasto, el saldo aparece aquí."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie te debe y tú no le debes a nadie. Cuando alguien añada un gasto, el saldo aparece aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نه کسی به شما بدهکار است و نه شما به کسی. وقتی کسی هزینه‌ای اضافه کند، تراز اینجا نمایش داده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang may utang sa iyo at wala kang utang kaninuman. Kapag may nagdagdag ng bill, lalabas dito ang balanse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne te doit rien et tu ne dois rien à personne. Quand quelqu’un ajoute une dépense, le solde s’affiche ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאף אחד אין חוב אליך ואין לך חובות. כשמישהו יוסיף חשבון, היתרה תופיע כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न किसी पर आपका बकाया है, न आप पर किसी का। जब कोई खर्च जोड़ेगा, तो बैलेंस यहां दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitko ti ne duguje i ti nikome ne duguješ. Kad netko doda trošak, saldo će se pojaviti ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senki sem tartozik neked, és te sem tartozol senkinek. Ha valaki hozzáad egy számlát, itt jelenik meg az egyenleg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang berutang ke kamu dan kamu tidak berutang ke siapa pun. Saat seseorang menambahkan tagihan, saldonya muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ti deve niente e tu non devi niente a nessuno. Quando qualcuno aggiunge una spesa, il saldo compare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貸し借りはありません。誰かが支出を追加すると、ここに残高が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받을 돈도 줄 돈도 없어요. 누군가 지출을 추가하면 여기에 잔액이 보여요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada sesiapa berhutang kepada anda dan anda tidak berhutang kepada sesiapa. Apabila seseorang menambah bil, baki akan dipaparkan di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand is je iets schuldig en jij bent niemand iets schuldig. Als iemand een uitgave toevoegt, verschijnt het saldo hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie ma ci nic do oddania, a ty nie masz nic do oddania nikomu. Gdy ktoś doda wydatek, saldo pojawi się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém te deve e você não deve a ninguém. Quando alguém lançar uma conta, o saldo aparece aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém te deve e tu não deves a ninguém. Quando alguém registar uma conta, o saldo aparece aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeni nu îți datorează și nu datorezi nimănui. Când cineva adaugă o cheltuială, soldul apare aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе никто не должен, и ты никому не должен(-на). Когда кто-то добавит счёт, баланс появится здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikto ti nedlží a ty nikomu nedlžíš. Keď niekto pridá výdavok, zostatok sa zobrazí tu."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niko ti ne duguje, a ni ti nikome. Kada neko doda račun, stanje se pojavljuje ovde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen är skyldig dig och du är inte skyldig någon. När någon lägger till en utgift visas saldot här."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுக்கு யாரும் தர வேண்டியதில்லை, நீங்களும் யாருக்கும் தர வேண்டியதில்லை. யாராவது ஒரு செலவைச் சேர்த்ததும், பேலன்ஸ் இங்கே தோன்றும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครค้างคุณและคุณก็ไม่ได้ค้างใคร เมื่อมีคนเพิ่มบิล ยอดคงเหลือจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimsenin sana borcu yok, senin de kimseye borcun yok. Biri harcama ekleyince bakiye burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тобі ніхто не винен, і ти нікому не винен(-на). Коли хтось додасть рахунок, баланс з'явиться тут."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نہ کسی نے آپ کو کچھ دینا ہے اور نہ آپ نے کسی کو۔ جب کوئی خرچ شامل کرے گا تو بیلنس یہاں نظر آئے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai nợ bạn và bạn cũng không nợ ai. Khi ai đó thêm khoản chi, số dư sẽ hiển thị ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有人欠你，你也不欠任何人。有人添加账单后，余额会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有人欠你，你也不欠任何人。有人新增帳單後，餘額會顯示在這裡。"
          }
        }
      }
    },
