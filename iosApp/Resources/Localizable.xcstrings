    "Allow camera access in Settings to take a photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الكاميرا في الإعدادات لالتقاط صورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши достъп до камерата в Настройки, за да направиш снимка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছবি তুলতে সেটিংসে ক্যামেরার অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l’accés a la càmera a Configuració per fer una foto."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chceš fotit, povol přístup k fotoaparátu v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang til kameraet i Indstillinger for at tage et billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff in den Einstellungen, um ein Foto aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε την πρόσβαση στην κάμερα στις Ρυθμίσεις για να τραβήξεις φωτογραφία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en Ajustes para tomar una foto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tegemiseks luba seadetes juurdepääs kaamerale."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
