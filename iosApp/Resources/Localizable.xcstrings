        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלום יוסר מהקבוצה והחוב יחזור ליתרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान ग्रुप से हट जाएगा और कर्ज़ फिर से बैलेंस में आ जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran keluar dari grup dan utangnya kembali ke saldo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento esce dal gruppo e il debito torna nei saldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いはグループから削除され、残高に借りが戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 그룹에서 사라지고 빚이 다시 잔액에 반영돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
