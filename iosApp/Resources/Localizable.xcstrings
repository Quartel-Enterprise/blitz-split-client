            "value" : "Desaparece del gasto para todos. Las respuestas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le commentaire disparaît de la dépense pour tout le monde. Ses réponses restent."
