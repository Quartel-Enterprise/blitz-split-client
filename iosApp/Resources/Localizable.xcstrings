    "It becomes a payment in the group: it shows in Expenses and can be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح دفعة في المجموعة: تظهر في المصروفات ويمكن التراجع عنها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zu einer Zahlung in der Gruppe: Sie erscheint in „Ausgaben“ und lässt sich rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se convierte en un pago del grupo: aparece en Gastos y se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça devient un paiement dans le groupe : il s’affiche dans Dépenses et peut être annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה נרשם כתשלום בקבוצה: הוא מופיע בהוצאות ואפשר לבטל אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ग्रुप में एक भुगतान बन जाता है: यह खर्चों में दिखता है और इसे पहले जैसा किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menjadi pembayaran di grup: tampil di Pengeluaran dan bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventa un pagamento nel gruppo: compare in Spese e si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループ内の支払いとして記録されます：「支出」に表示され、取り消すこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 송금으로 기록돼요: 지출에 표시되고 되돌릴 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt een betaling in de groep: die staat bij Uitgaven en kan ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanie się płatnością w grupie: pojawi się w Wydatkach i można ją cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vira um acerto no grupo: aparece em Despesas e dá para desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a ser um acerto no grupo: aparece em Despesas e é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это станет платежом в группе: он появится в Расходах, и его можно будет отменить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะกลายเป็นการจ่ายเงินในกลุ่ม: แสดงในบิล และเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupta bir ödeme olur: Harcamalar'da görünür ve geri alınabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це стане платежем у групі: він з'явиться у Витратах, і його можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản này sẽ thành một khoản thanh toán trong nhóm: hiển thị trong Khoản chi và có thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会成为群组中的一笔付款：显示在“账单”中，并且可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會成為群組中的一筆付款：顯示在「帳單」中，並且可以復原。"
          }
        }
      }
    },
    "No internet: it's saved on this device and syncs when you reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إنترنت: تم الحفظ على هذا الجهاز وتتم المزامنة عند عودة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Sie ist auf diesem Gerät gespeichert und wird synchronisiert, wenn du wieder verbunden bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: queda guardado en el dispositivo y se sincroniza al reconectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet : c’est enregistré sur cet appareil et se synchronise à la reconnexion."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אינטרנט: זה נשמר במכשיר הזה ויסונכרן כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नहीं है: यह इस डिवाइस पर सहेजा गया है और दोबारा कनेक्ट होने पर सिंक होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada internet: tersimpan di perangkat ini dan disinkronkan saat kamu terhubung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: è salvato su questo dispositivo e si sincronizza quando ti riconnetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続がありません：このデバイスに保存され、再接続すると同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결 없음: 이 기기에 저장되고 다시 연결되면 동기화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internet: het is op dit apparaat bewaard en synchroniseert zodra je weer verbinding hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu: zapisano na tym urządzeniu, zsynchronizuje się po ponownym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: fica salvo no aparelho e sincroniza ao reconectar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: fica guardado no aparelho e sincroniza ao voltar a ter ligação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет интернета: сохранено на этом устройстве и синхронизируется, когда появится подключение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอินเทอร์เน็ต: บันทึกไว้ในอุปกรณ์นี้แล้ว และจะซิงค์เมื่อคุณกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet yok: bu cihaza kaydedildi, bağlantı gelince eşitlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає інтернету: збережено на цьому пристрої й синхронізується, коли з'явиться з'єднання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có internet: đã được lưu trên thiết bị này và sẽ đồng bộ khi bạn có mạng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有网络：已保存在此设备上，重新联网后会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有網路：已儲存在此裝置上，重新連線後會同步。"
          }
        }
      }
    },
    "Nobody owes anybody anything here." : {
      "comment" : "The balance card when the whole group is settled up",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد عليه شيء لأحد هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier schuldet niemand jemandem etwas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí nadie le debe nada a nadie."
          }
        },
        "fr" : {
