        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %@! Esta es tu invitación personal en Blitz Split: ábrela y entras con tu propio nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %@ ! Voici ton invitation personnelle sur Blitz Split : ouvre-la et tu rejoins sous ton propre nom."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היי %@! זו ההזמנה האישית שלך ב-Blitz Split: פתיחה שלה מצרפת אותך בשם שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते %@! यह Blitz Split पर आपका निजी आमंत्रण है: इसे खोलें और आप खुद के रूप में जुड़ जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai %@! Ini undangan pribadimu di Blitz Split: buka dan kamu bergabung sebagai dirimu sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Questo è il tuo invito personale su Blitz Split: aprilo ed entri direttamente con il tuo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、こんにちは！Blitz Splitでのあなた専用の招待です。開くとあなた自身として参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, %@ 님! Blitz Split 개인 초대예요. 열면 본인으로 참여해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %@! Dit is je persoonlijke uitnodiging voor Blitz Split: open hem en je doet mee als jezelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %@! To twoje osobiste zaproszenie do Blitz Split: otwórz je, a dołączysz pod swoim imieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, %@! Este é o seu convite pessoal no Bora Rachar: abra e você entra com o seu nome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, %@! Este é o teu convite pessoal no Blitz Split: abre-o e entras com o teu nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет, %@! Это твоё личное приглашение в Blitz Split: открой его, и ты присоединишься под своим именем."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวัสดี %@! นี่คือคำเชิญส่วนตัวของคุณบน Blitz Split เปิดแล้วคุณจะเข้าร่วมในฐานะตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selam %@! Bu, Blitz Split'teki kişisel davetin: aç ve kendin olarak katıl."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт, %@! Це твоє особисте запрошення в Blitz Split: відкрий його, і ти приєднаєшся як ти сам(-а)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào %@! Đây là lời mời riêng của bạn trên Blitz Split: mở ra là bạn tham gia với chính tên của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨，%@！这是你在Blitz Split的专属邀请：打开它即可以本人身份加入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨，%@！這是你在Blitz Split的專屬邀請：開啟它即可以本人身份加入。"
          }
        }
      }
    },
