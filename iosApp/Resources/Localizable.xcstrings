    "%@ simplified the debts just now. You no longer owe %@ in %@." : {
      "comment" : "Record payment, 13.5c: who turned Simplify debts on, the receiver, the group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat gerade die Schulden vereinfacht. Du schuldest %2$@ in %3$@ nichts mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó las deudas hace un momento. Ya no le debes %2$@ a %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vient de simplifier les dettes. Tu ne dois plus rien à %2$@ dans %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ baru saja menyederhanakan utang. Kamu tidak lagi berutang ke %@ di %@."
