        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ épp most csatlakozott egy másik eszközről"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ baru saja bergabung dari perangkat lain"
          }
        },
        "it" : {
          "stringUnit" : {
