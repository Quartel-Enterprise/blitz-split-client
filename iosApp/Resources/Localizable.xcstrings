          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パレットがいっぱいです。削除する色を長押ししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔레트가 가득 찼어요: 내 색상 하나를 길게 눌러 삭제하세요."
          }
        },
        "nl" : {
