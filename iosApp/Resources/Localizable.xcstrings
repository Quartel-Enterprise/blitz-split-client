        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand is je iets schuldig en jij bent niemand iets schuldig. Als iemand een uitgave toevoegt, verschijnt het saldo hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie ma ci nic do oddania, a ty nie masz nic do oddania nikomu. Gdy ktoś doda wydatek, saldo pojawi się tutaj."
