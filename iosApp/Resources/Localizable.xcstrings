            "state" : "translated",
            "value" : "%@ vstúpi do skupiny ako meno, bez podielu na starých výdavkoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vstopi v skupino kot ime, brez deleža v starih stroških."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ulazi u grupu kao ime, bez udela u starim računima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ går med i gruppen som ett namn, utan del i de gamla utgifterna."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ anajiunga na kikundi kama jina, bila sehemu katika gharama za zamani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ பழைய செலவுகளில் பங்கு இல்லாமல், ஒரு பெயராகக் குழுவில் சேர்வார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ పాత ఖర్చుల్లో ఎలాంటి భాగం లేకుండా, పేరుగా గ్రూప్‌లో చేరతారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จะเข้าร่วมกลุ่มในฐานะชื่อ โดยไม่มีส่วนในบิลเก่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
