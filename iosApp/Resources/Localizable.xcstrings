    "Know when someone records a payment or asks you to pay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre, wenn jemand eine Zahlung erfasst oder dich um eine Zahlung bittet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entérate cuando alguien registre un pago o te pida pagar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sache quand quelqu’un enregistre un paiement ou te demande de payer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketahui saat seseorang mencatat pembayaran atau memintamu membayar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sappi quando qualcuno registra un pagamento o ti chiede di pagare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かが支払いを記録したときや、支払いを依頼されたときにわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 송금을 기록하거나 나에게 송금을 요청하면 알려 드려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet wanneer iemand een betaling registreert of je vraagt te betalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowiedz się, gdy ktoś zapisze płatność lub poprosi cię o zapłatę."
          }
