    "It belongs to all of %@: anyone in the group can use, edit and delete it." : {
      "comment" : "New category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehört ganz %@: Alle in der Gruppe können sie nutzen, bearbeiten und löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es de todo el grupo %@: cualquier persona del grupo puede usarla, editarla y eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle appartient à tout %@ : n’importe qui dans le groupe peut l’utiliser, la modifier et la supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategori ini milik semua anggota %@: siapa pun di grup bisa memakai, mengedit, dan menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appartiene a tutto %@: chiunque nel gruppo può usarla, modificarla ed eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の全員のものです。グループの誰でも使用・編集・削除できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij is van heel %@: iedereen in de groep kan hem gebruiken, bewerken en verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Należy do całej grupy %@: każdy w grupie może jej używać, edytować ją i usuwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica para todo o %@: qualquer pessoa do grupo pode usar, editar e apagar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubunun tamamına ait: gruptaki herkes onu kullanabilir, düzenleyebilir ve silebilir."
          }
        }
      }
    },
