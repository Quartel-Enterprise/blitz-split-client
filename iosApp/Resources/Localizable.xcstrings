          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחת הקישור מאפשרת לבחור שם מרשימת הקבוצה או להצטרף כמשתתף חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो भी लिंक खोलेगा, वह ग्रुप की सूची में अपना नाम चुनेगा या नए सदस्य के रूप में जुड़ेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang membuka tautannya memilih namanya dari daftar grup atau bergabung sebagai anggota baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
