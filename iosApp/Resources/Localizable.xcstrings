        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি কার্ড বা ব্যাংক স্টেটমেন্ট বলে মনে হচ্ছে, যা একটি বিল হিসেবে পড়া যায় না। নিজে পূরণ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
