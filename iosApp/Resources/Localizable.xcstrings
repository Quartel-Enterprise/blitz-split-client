          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz konto; ta osoba otrzyma prośbę i ją zaakceptuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
