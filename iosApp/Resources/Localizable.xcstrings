        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich údaje sa vymažú, keď sa odošle, čo je vo fronte. Tvoj iPhone zostane prihlásený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njeni podatki se izbrišejo, ko je poslano, kar je čakalo v vrsti. Tvoj iPhone ostane prijavljen."
