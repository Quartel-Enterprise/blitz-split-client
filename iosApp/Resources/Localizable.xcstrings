    "No internet. Your data shows up once you're back online." : {
      "comment" : "Under a shimmer while the account's first full sync waits for the internet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. تظهر بياناتك عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма интернет. Данните ти ще се покажат, щом отново си онлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট নেই। আবার অনলাইনে এলে আপনার ডেটা দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetu. Tvoje data se zobrazí, jakmile budeš zase online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet. Deine Daten erscheinen, sobald du wieder online bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ίντερνετ. Τα δεδομένα σου θα εμφανιστούν μόλις συνδεθείς ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet. Tus datos aparecen cuando vuelvas a conectarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اینترنت وصل نیست. وقتی دوباره آنلاین شوید داده‌هایتان نمایش داده می‌شوند."
          }
