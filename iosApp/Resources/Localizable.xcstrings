    "No internet. Your data shows up once you're back online." : {
      "comment" : "Under a shimmer while the account's first full sync waits for the internet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. تظهر بياناتك عند عودة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet. Deine Daten erscheinen, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet. Tus datos aparecen cuando vuelvas a conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’internet. Tes données s’affichent dès que tu es de nouveau en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין אינטרנט. הנתונים שלך יופיעו כשהחיבור יחזור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट नहीं है। ऑनलाइन होते ही आपका डेटा दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada internet. Datamu akan muncul saat kamu kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione. I tuoi dati compariranno quando tornerai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットに接続されていません。オンラインに戻るとデータが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷에 연결되어 있지 않아요. 다시 온라인이 되면 데이터가 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internet. Je gegevens verschijnen zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu. Twoje dane pojawią się, gdy wrócisz do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Seus dados aparecem quando reconectar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet. Os teus dados aparecem quando voltares a ter ligação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет интернета. Твои данные появятся, когда снова будет подключение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอินเทอร์เน็ต ข้อมูลของคุณจะแสดงเมื่อกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet yok. Tekrar çevrimiçi olunca verilerin görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає інтернету. Твої дані з'являться, щойно ти знову будеш онлайн."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có internet. Dữ liệu của bạn sẽ hiện khi bạn có mạng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
