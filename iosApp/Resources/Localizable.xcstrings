    "%@ turned it on after you. The last change counts: Simplify debts is on." : {
      "comment" : "Simplify debts: someone changed it after this device; %@ is who",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: التفعيل بعدك. آخر تغيير هو المعتمد: «تبسيط الديون» مفعّل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ го включи след теб. Важи последната промяна: Опростяване на дълговете е включено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ আপনার পরে এটি চালু করেছেন। শেষ পরিবর্তনটিই গণ্য: “দেনা সহজ করুন” চালু আছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ho ha activat després de tu. Compta l’últim canvi: Simplificar deutes està activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to po tobě zapnul(a). Platí poslední změna: Zjednodušit dluhy je zapnuto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slog det til efter dig. Den seneste ændring gælder: Forenkle gæld er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat es nach dir eingeschaltet. Die letzte Änderung zählt: „Schulden vereinfachen“ ist an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ την ενεργοποίησε μετά από σένα. Ισχύει η τελευταία αλλαγή: η Απλοποίηση χρεών είναι ενεργή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo activó después de ti. Vale el último cambio: Simplificar deudas está activado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on selle pärast sind sisse lülitanud. Kehtib viimane muudatus: võlgade lihtsustamine on sees."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پس از شما آن را روشن کرد. آخرین تغییر ملاک است: ساده‌سازی بدهی‌ها روشن است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on ottanut sen käyttöön sinun jälkeesi. Viimeisin muutos ratkaisee: Yksinkertaista velat on päällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-on ito ni %@ pagkatapos mo. Ang huling pagbabago ang masusunod: naka-on ang Pasimplehin ang utang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’a activé après toi. Le dernier changement compte : Simplifier les dettes est activé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા પછી %@ એ તેને ચાલુ કર્યું. છેલ્લો ફેરફાર ગણાય છે: “દેવાં સરળ કરો” ચાલુ છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: הפעלה אחריך. השינוי האחרון קובע: פישוט חובות פעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने आपके बाद इसे चालू किया। आखिरी बदलाव ही मान्य है: “कर्ज़ सरल करें” चालू है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
