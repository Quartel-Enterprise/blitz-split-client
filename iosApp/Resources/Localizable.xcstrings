    "Matches the whole word, ignoring accents and case." : {
      "comment" : "New term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق الكلمة كاملة، مع تجاهل التشكيل وحالة الأحرف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съвпада с цялата дума, без значение от ударения и главни букви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরো শব্দ মেলায়, অ্যাকসেন্ট ও বড়-ছোট হাতের অক্ষর উপেক্ষা করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincideix amb la paraula sencera, sense tenir en compte accents ni majúscules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledá celé slovo, bez ohledu na diakritiku a velikost písmen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcher hele ordet uden hensyn til accenter og store/små bogstaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt auf das ganze Wort, Akzente und Groß-/Kleinschreibung egal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταιριάζει με ολόκληρη τη λέξη, αγνοώντας τόνους και πεζά-κεφαλαία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con la palabra completa, sin importar acentos ni mayúsculas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobitab terve sõna, arvestamata täpitähti ja suurtähti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با کل واژه مطابقت دارد، بدون توجه به اِعراب و حروف بزرگ و کوچک."
