    "The %lld bills with %@ move to %@. The category goes for all of %@." : {
      "comment" : "Delete category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$lld Ausgaben mit %2$@ wandern zu %3$@. Die Kategorie verschwindet für ganz %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %1$lld gastos con %2$@ pasan a %3$@. La categoría desaparece para todo el grupo %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
