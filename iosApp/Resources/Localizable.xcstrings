    "Adjust the percentages until they add up to %@ to save." : {
      "comment" : "Default split: why Save is disabled; %@ is 100%",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحفظ، يجب أن يكون مجموع النسب %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагласи процентите, докато сборът стане %@, за да запазиш."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষণ করতে শতাংশগুলো এমনভাবে ঠিক করুন যাতে যোগফল %@ হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta els percentatges fins que sumin %@ per poder desar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprav procenta, aby dala dohromady %@, a pak ulož."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justér procenterne, til de giver %@, for at gemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass die Prozente an, bis sie %@ ergeben, um zu speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσάρμοσε τα ποσοστά ώστε να αθροίζονται σε %@ για να αποθηκεύσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta los porcentajes hasta que sumen %@ para guardar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvestamiseks muuda protsente, kuni need annavad kokku %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ذخیره، درصدها را طوری تنظیم کنید که جمعشان %@ شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä prosentteja, kunnes ne ovat yhteensä %@, niin voit tallentaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayusin ang mga porsyento hanggang umabot ng %@ para ma-save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste les pourcentages jusqu’à ce qu’ils fassent %@ pour enregistrer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેવ કરવા માટે ટકાવારીનો સરવાળો %@ થાય ત્યાં સુધી ગોઠવો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לשמור, יש לשנות את האחוזים עד שיסתכמו ב-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजने के लिए प्रतिशत तब तक बदलें जब तक जोड़ %@ न हो जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodi postotke dok zbroj ne bude %@ da bi spremio/la."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentéshez állítsd be a százalékokat úgy, hogy összesen %@ legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan persentasenya sampai berjumlah %@ untuk menyimpan."
