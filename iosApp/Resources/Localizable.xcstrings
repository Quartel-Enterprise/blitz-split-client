    "Payments go back to being between whoever split each bill. No bill or recorded payment changes." : {
      "comment" : "How it works: a fact",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen laufen wieder zwischen denen, die die jeweilige Ausgabe geteilt haben. Keine Ausgabe und keine erfasste Zahlung ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos vuelven a ser entre quienes dividieron cada gasto. Ningún gasto ni pago registrado cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements redeviennent ceux entre les personnes qui ont partagé chaque dépense. Aucune dépense ni aucun paiement enregistré ne change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti tornano a essere tra chi ha diviso ogni spesa. Nessuna spesa né pagamento registrato cambia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności znów odbywają się między osobami, które dzieliły dany wydatek. Żaden wydatek ani zapisana płatność się nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos voltam a ser entre quem dividiu cada conta. Nenhuma despesa nem pagamento registrado muda."
          }
        }
      }
    },
