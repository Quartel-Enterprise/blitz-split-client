        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu je da znaš kojim si nalogom prijavljen/a. Ljudi iz tvojih grupa vide tvoje ime i fotografiju, nikad e-poštu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
