    "Hi %@! Let's split the bills of %@ on Blitz Split. Join with this link:" : {
      "comment" : "The message shared with an invite for someone named; the first %@ is them, the second the group",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@! Lass uns die Ausgaben von %2$@ mit Blitz Split aufteilen. Tritt über diesen Link bei:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, %1$@! Vamos a dividir los gastos de %2$@ en Blitz Split. Únete con este enlace:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! On partage les dépenses de %2$@ sur Blitz Split. Rejoins avec ce lien :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@! Dividiamo le spese di %@ su Blitz Split. Entra con questo link:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć, %1$@! Podzielmy wydatki z grupy %2$@ w Blitz Split. Dołącz przez ten link:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, %1$@! Bora rachar as contas do grupo %2$@ no Bora Rachar? Entra pelo link:"
          }
        }
      }
    },
