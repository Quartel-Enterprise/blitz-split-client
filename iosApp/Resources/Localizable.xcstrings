    "Someone already joined through this link, or it was changed. Ask whoever sent it for a new one." : {
      "comment" : "Why a personal invite link no longer works: its member joined or was removed, or the group's link changed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über diesen Link ist schon jemand beigetreten, oder er wurde geändert. Bitte die Person, die ihn geschickt hat, um einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
