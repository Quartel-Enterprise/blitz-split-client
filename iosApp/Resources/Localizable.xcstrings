    "Your map stays on this device only. To take it to your other devices, sign in with Google or Apple in your Profile." : {
      "comment" : "Category map",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى خريطتك على هذا الجهاز فقط. لنقلها إلى أجهزتك الأخرى، سجّل الدخول بحساب Google أو Apple في ملفك الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картата ти остава само на това устройство. За да я пренесеш на другите си устройства, влез с Google или Apple в Профил."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ম্যাপ শুধু এই ডিভাইসেই থাকবে। অন্য ডিভাইসে নিতে প্রোফাইলে গিয়ে Google বা Apple দিয়ে সাইন ইন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje mapa zůstává jen na tomto zařízení. Pokud ji chceš mít i na dalších zařízeních, přihlas se v Profilu přes Google nebo Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zuordnung bleibt nur auf diesem Gerät. Um sie auf deine anderen Geräte mitzunehmen, melde dich in deinem Profil mit Google oder Apple an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χάρτης σου παραμένει μόνο σε αυτή τη συσκευή. Για να τον πάρεις στις άλλες συσκευές σου, συνδέσου με Google ή Apple στο Προφίλ σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mapa queda solo en este dispositivo. Para llevarlo a tus otros dispositivos, inicia sesión con Google o Apple en tu Perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقشه شما فقط در این دستگاه می‌ماند. برای بردن آن به دستگاه‌های دیگرتان، در پروفایل با Google یا Apple وارد شوید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa device na ito lang ang mapa mo. Para madala ito sa iba mo pang device, mag-sign in gamit ang Google o Apple sa Profile mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta carte reste uniquement sur cet appareil. Pour l’emporter sur tes autres appareils, connecte-toi avec Google ou Apple dans ton Profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפה שלך נשמרת רק במכשיר הזה. כדי להעביר אותה למכשירים האחרים שלך, אפשר להתחבר עם Google או Apple בפרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मैप सिर्फ़ इस डिवाइस पर रहता है। इसे अपने दूसरे डिवाइस पर ले जाने के लिए अपनी प्रोफ़ाइल में Google या Apple से साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja mapa ostaje samo na ovom uređaju. Da je preneseš na druge uređaje, prijavi se Googleom ili Appleom u Profilu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térképed csak ezen az eszközön marad. Ha a többi eszközödre is át szeretnéd vinni, jelentkezz be Google- vagy Apple-fiókkal a Profilodban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petamu hanya ada di perangkat ini. Untuk membawanya ke perangkatmu yang lain, masuk dengan Google atau Apple di Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mappa resta solo su questo dispositivo. Per portarla sugli altri tuoi dispositivi, accedi con Google o Apple nel tuo Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップはこのデバイスにのみ保存されます。ほかのデバイスで使うには、プロフィールでGoogleまたはAppleでログインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드는 이 기기에만 저장돼요. 다른 기기로 가져가려면 프로필에서 Google 또는 Apple로 로그인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peta anda kekal pada peranti ini sahaja. Untuk membawanya ke peranti lain, log masuk dengan Google atau Apple dalam Profil anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kaart blijft alleen op dit apparaat. Om hem naar je andere apparaten mee te nemen, log je in met Google of Apple in je Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja mapa zostaje tylko na tym urządzeniu. Aby przenieść ją na inne urządzenia, zaloguj się przez Google lub Apple w Profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu mapa fica só neste aparelho. Para levar a outros aparelhos, entre com Google ou Apple no Perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu mapa fica só neste aparelho. Para o levares para os teus outros aparelhos, inicia sessão com Google ou Apple no Perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta ta rămâne doar pe acest dispozitiv. Ca s-o ai pe celelalte dispozitive, conectează-te cu Google sau Apple în Profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя карта хранится только на этом устройстве. Чтобы перенести её на другие устройства, войди через Google или Apple в Профиле."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja mapa zostáva len v tomto zariadení. Ak ju chceš preniesť do ďalších zariadení, prihlás sa cez Google alebo Apple v Profile."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja mapa ostaje samo na ovom uređaju. Da je preneseš na ostale uređaje, prijavi se Google ili Apple nalogom u Profilu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din karta finns bara på den här enheten. För att ta med den till dina andra enheter, logga in med Google eller Apple i din profil."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வரைபடம் இந்தச் சாதனத்தில் மட்டுமே இருக்கும். உங்கள் மற்ற சாதனங்களுக்குக் கொண்டு செல்ல, உங்கள் சுயவிவரத்தில் Google அல்லது Apple மூலம் உள்நுழையுங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนที่ของคุณอยู่บนอุปกรณ์นี้เท่านั้น หากต้องการใช้บนอุปกรณ์อื่น ลงชื่อเข้าใช้ด้วย Google หรือ Apple ในโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritan yalnızca bu cihazda kalır. Diğer cihazlarına taşımak için Profil'de Google veya Apple ile giriş yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя мапа зберігається лише на цьому пристрої. Щоб перенести її на інші пристрої, увійди через Google або Apple у Профілі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا میپ صرف اس ڈیوائس پر رہتا ہے۔ اسے اپنی دوسری ڈیوائسز پر لے جانے کے لیے اپنی پروفائل میں Google یا Apple سے سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản đồ của bạn chỉ ở trên thiết bị này. Để mang sang các thiết bị khác, hãy đăng nhập bằng Google hoặc Apple trong Hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的类别映射只保存在此设备上。要同步到其他设备，请在个人资料中用Google或Apple登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的類別對照表只儲存在此裝置上。要同步到其他裝置，請在個人資料中用Google或Apple登入。"
          }
        }
      }
    },
