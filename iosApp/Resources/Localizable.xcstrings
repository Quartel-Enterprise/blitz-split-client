    "%@. The group sees it right away, or when the internet is back." : {
      "comment" : "Apple Watch: confirm I paid (15.5), the group's name first",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ترى المجموعة ذلك فورًا، أو عند عودة الإنترنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Групата го вижда веднага или когато интернетът се върне."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। গ্রুপ সঙ্গে সঙ্গে দেখবে, বা ইন্টারনেট ফিরলে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El grup ho veu de seguida, o quan torni internet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Skupina to uvidí hned, nebo až se vrátí internet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gruppen ser det med det samme, eller når der er internet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Die Gruppe sieht es sofort oder sobald das Internet zurück ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Η ομάδα το βλέπει αμέσως ή όταν επιστρέψει το ίντερνετ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El grupo lo ve al instante, o cuando vuelva internet."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupp näeb seda kohe või siis, kui internet on tagasi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. گروه آن را بلافاصله، یا وقتی اینترنت برگردد، می‌بیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ryhmä näkee sen heti tai kun internetyhteys palaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Makikita ito agad ng grupo, o kapag bumalik na ang internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Le groupe le voit tout de suite, ou au retour d’internet."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ગ્રુપને તે તરત જ દેખાશે, અથવા ઇન્ટરનેટ પાછું આવે ત્યારે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. הקבוצה רואה את זה מיד, או כשהאינטרנט חוזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। ग्रुप को तुरंत दिखेगा, या इंटरनेट लौटने पर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupa to vidi odmah ili kad se internet vrati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. A csoport azonnal látja, vagy amikor visszajön az internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grup langsung melihatnya, atau saat internet kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Il gruppo lo vede subito, o quando torna internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。グループにはすぐに、またはインターネットが戻ったときに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 그룹에 바로, 또는 인터넷이 돌아오면 표시돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupė tai pamatys iškart arba kai vėl bus internetas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupa to redzēs uzreiz vai tad, kad atjaunosies internets."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ग्रुपला लगेच किंवा इंटरनेट परत आल्यावर दिसेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Kumpulan melihatnya serta-merta, atau apabila internet kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gruppen ser det med en gang, eller når nettet er tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. De groep ziet het meteen, of zodra er weer internet is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupa zobaczy to od razu albo gdy wróci internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. O grupo vê na hora, ou quando voltar a internet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupul vede imediat sau când revine internetul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Группа увидит это сразу или когда вернётся интернет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Skupina to uvidí hneď alebo keď bude internet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Skupina to vidi takoj ali ko se internet vrne."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grupa to vidi odmah ili kad se internet vrati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gruppen ser det direkt, eller när internet är tillbaka."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Kikundi kinaona mara moja, au intaneti ikirudi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. குழு இதை உடனே பார்க்கும், அல்லது இணையம் திரும்பியதும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. గ్రూప్ దీన్ని వెంటనే చూస్తుంది, లేదా ఇంటర్నెట్ తిరిగి వచ్చినప్పుడు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ กลุ่มจะเห็นทันที หรือเมื่ออินเทอร์เน็ตกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Grup bunu hemen ya da internet gelince görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Група побачить це одразу або коли повернеться інтернет."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@۔ گروپ اسے فوراً دیکھ لے گا، یا انٹرنیٹ واپس آنے پر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Nhóm thấy ngay, hoặc khi có internet trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。群组会立即看到，或在网络恢复后看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。群組會立即看到，或在網路恢復後看到。"
          }
        }
      }
    },
