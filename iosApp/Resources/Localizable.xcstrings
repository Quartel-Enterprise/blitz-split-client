    "Matches the whole word, ignoring accents and case." : {
      "comment" : "New term",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق الكلمة كاملة، مع تجاهل التشكيل وحالة الأحرف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
