    "Sign in on iPhone with the same Apple account and your groups will be there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول على iPhone بحساب Apple نفسه وستجد مجموعاتك هناك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влез в iPhone със същия Apple акаунт и групите ти ще са там."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এ একই Apple অ্যাকাউন্ট দিয়ে সাইন ইন করুন, আপনার গ্রুপগুলো সেখানে পেয়ে যাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se na iPhonu stejným účtem Apple a tvoje skupiny tam budou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich auf dem iPhone mit demselben Apple-Account an, und deine Gruppen sind da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου στο iPhone με τον ίδιο λογαριασμό Apple και οι ομάδες σου θα είναι εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en el iPhone con la misma cuenta de Apple y tus grupos estarán ahí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در iPhone با همان حساب Apple وارد شوید تا گروه‌هایتان آنجا باشند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in sa iPhone gamit ang parehong Apple account at nandoon na ang mga grupo mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi sur iPhone avec le même compte Apple et tes groupes seront là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להתחבר ב-iPhone עם אותו חשבון Apple, והקבוצות שלך יהיו שם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone पर उसी Apple अकाउंट से साइन इन करें और आपके ग्रुप वहां होंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavi se na iPhoneu istim Apple računom i tvoje će grupe biti tamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezz be iPhone-on ugyanazzal az Apple-fiókkal, és ott lesznek a csoportjaid."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk di iPhone dengan akun Apple yang sama dan grupmu akan ada di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi sull’iPhone con lo stesso account Apple e i tuoi gruppi saranno lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで同じAppleアカウントでログインすると、グループがそのまま表示されます。"
