        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» s’ha suprimit després que tothom liquidés comptes. No quedava res obert, i el grup surt de la teva llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina „%@“ byla smazána poté, co se všichni vyrovnali. Nic nezůstalo otevřené a skupina zmizí z tvého seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
