          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم التطبيق على هاتفك منذ %@. يبقى هذا الرمز دائمًا في الإعدادات، لحين تغيير iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt die App seit %@ auf deinem Handy. Dieser Code bleibt immer in den Einstellungen, für den Fall, dass du dein iPhone wechselst."
          }
