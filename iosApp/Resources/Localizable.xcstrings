        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to ty, porozmawiaj z osobą, która cię zaprosiła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se era você, fale com quem te chamou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eras tu, fala com quem te convidou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это был(а) ты, поговори с тем, кто тебя пригласил."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเป็นคุณ โปรดคุยกับคนที่เชิญคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
