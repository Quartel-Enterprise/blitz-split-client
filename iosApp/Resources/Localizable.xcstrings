    "%@ is a guest without the app. They only learn about it from this message, so it already says what went into the bill." : {
      "comment" : "Request to a guest",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ضيف دون التطبيق. هذه الرسالة هي مصدر المعلومة الوحيد، لذا تذكر بالفعل ما دخل في الفاتورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е гост без приложението. Ще научи за това само от това съобщение, затова то вече казва какво влиза в разхода."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ অ্যাপ ব্যবহার না করা একজন অতিথি। তিনি শুধু এই মেসেজ থেকেই জানবেন, তাই বিলে কী কী ছিল তা এতে আগে থেকেই লেখা আছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ és un convidat sense l’app. Només se n’assabentarà per aquest missatge, així que ja diu què hi havia a la despesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je host bez aplikace. Dozví se o tom jen z této zprávy, takže už v ní je, co šlo do výdaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er en gæst uden appen. Vedkommende hører kun om det via denne besked, så den fortæller allerede, hvad der indgik i udgiften."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App und erfährt es nur aus dieser Nachricht, daher steht schon drin, was in die Ausgabe eingeflossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: επισκέπτης χωρίς την εφαρμογή. Θα το μάθει μόνο από αυτό το μήνυμα, οπότε αναφέρει ήδη τι μπήκε στο έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Solo se entera por este mensaje, así que ya incluye lo que entró en el gasto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on külaline, kellel pole rakendust. Ta saab sellest teada ainult selle sõnumi kaudu, seega on sõnumis juba kirjas, mis kulusse läks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مهمانی است که برنامه را ندارد. فقط از طریق این پیام باخبر می‌شود، پس پیام از قبل می‌گوید چه چیزهایی در هزینه بوده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on vieras, jolla ei ole sovellusta. Hän saa tietää asiasta vain tästä viestistä, joten siinä kerrotaan jo, mitä kuluun sisältyi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisita si %@ na walang app. Sa mensaheng ito lang niya malalaman, kaya nakasaad na rito kung ano ang kasama sa bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. La personne ne le saura que par ce message, qui précise donc déjà ce qui compose la dépense."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ઍપ વગરના મહેમાન છે. તેમને આ વિશે ફક્ત આ મેસેજથી જ ખબર પડશે, એટલે તેમાં પહેલેથી લખેલું છે કે ખર્ચમાં શું શું આવ્યું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: אורח בלי האפליקציה. ההודעה הזו היא הדרך היחידה לדעת על החוב, ולכן היא כבר מפרטת מה נכלל בחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना ऐप वाले मेहमान हैं। उन्हें इसके बारे में सिर्फ़ इसी मैसेज से पता चलेगा, इसलिए इसमें पहले से लिखा है कि खर्च में क्या-क्या शामिल था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je gost bez aplikacije. Za ovo će saznati samo iz ove poruke pa ona već navodi što je ušlo u trošak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vendég, nincs meg neki az app. Csak ebből az üzenetből értesül róla, ezért az üzenet már leírja, mi került a számlába."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Dia hanya tahu dari pesan ini, jadi pesannya sudah menjelaskan isi tagihannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Lo saprà solo da questo messaggio, quindi spiega già cosa c’era nella spesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリを使っていないゲストです。このメッセージでしか知らないので、支出の内訳もすでに書いてあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 앱이 없는 게스트예요. 이 메시지로만 알게 되니, 지출에 무엇이 들어갔는지 미리 적혀 있어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neturi programėlės ir yra grupėje tik kaip vardas. Apie tai sužinos tik iš šios žinutės, todėl joje jau nurodyta, kas įėjo į išlaidą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ir viesis bez lietotnes. Par to uzzinās tikai no šīs ziņas, tāpēc tajā jau ir norādīts, kas tika iekļauts rēķinā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ हे ॲप नसलेले पाहुणे आहेत. त्यांना याबद्दल फक्त या मेसेजमधूनच कळेल, म्हणून त्यात खर्चात काय काय होते ते आधीच लिहिलेले आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ialah tetamu tanpa aplikasi ini. Mereka hanya mengetahuinya melalui mesej ini, jadi mesej ini sudah menyatakan perkara yang termasuk dalam bil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er en gjest uten appen. Vedkommende får bare vite om det gjennom denne meldingen, så den sier allerede hva som inngår i utgiften."
          }
        },
        "nl" : {
          "stringUnit" : {
