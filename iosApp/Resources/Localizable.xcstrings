    "No internet: the new split holds on this %@ now and reaches the others once it reconnects." : {
      "comment" : "Default split offline; %@ is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إنترنت: يسري التقسيم الجديد على هذا الـ %@ الآن ويصل إلى الآخرين عند عودة الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма интернет: новото разделяне важи на този %@ сега и стига до другите, щом се свърже отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট নেই: নতুন ভাগ এখন এই %@ ডিভাইসে কার্যকর থাকবে এবং আবার সংযুক্ত হলে অন্যদের কাছে পৌঁছাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetu: nové rozdělení teď platí v zařízení %@ a k ostatním se dostane, až se znovu připojí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet: Die neue Aufteilung gilt jetzt auf diesem %@ und erreicht die anderen, sobald die Verbindung zurück ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ίντερνετ: η νέα μοιρασιά ισχύει τώρα σε αυτό το %@ και θα φτάσει στους άλλους μόλις συνδεθεί ξανά."
