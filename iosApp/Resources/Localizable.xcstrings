    "%@ is a guest without the app. Click to note what they paid you; they get no notice." : {
      "comment" : "Home on the Mac: a guest's hover; %@ is their name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ضيف ليس لديه التطبيق. انقر لتسجيل ما دفعه لك؛ لن يصله أي إشعار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Gast ohne die App. Klicke, um festzuhalten, was dir gezahlt wurde; der Gast wird nicht benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una persona invitada sin la app. Haz clic para anotar lo que te pagó; no recibe aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invité sans l’app. Clique pour noter ce que cette personne t’a payé ; elle ne reçoit aucun avis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: אורח בלי האפליקציה. אפשר ללחוץ כדי לרשום תשלום שקיבלת; לא תישלח התראה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना ऐप वाले मेहमान हैं। उन्होंने आपको जो भुगतान किया, उसे दर्ज करने के लिए क्लिक करें; उन्हें कोई सूचना नहीं जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah tamu tanpa aplikasi. Klik untuk mencatat yang dia bayar ke kamu; dia tidak mendapat pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un ospite senza l’app. Fai clic per annotare quanto ti ha pagato; non riceve alcun avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアプリを使っていないゲストです。クリックして、受け取った支払いを記録できます。相手に通知は届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님은 앱이 없는 게스트예요. 클릭해서 받은 금액을 기록하세요. 상대방에게는 알림이 가지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is een gast zonder de app. Klik om te noteren wat diegene je heeft betaald; diegene krijgt geen melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to gość bez aplikacji. Kliknij, aby zapisać płatność od tej osoby. Nie dostanie powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem o app. Clique para anotar o que ele te pagou; ele não recebe aviso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é convidado e não tem a app. Clica para anotar o que ele te pagou; ele não recebe aviso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гость без приложения. Кликни, чтобы записать, сколько тебе заплатили; гость не получит уведомления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เป็นแขกที่ไม่มีแอป คลิกเพื่อบันทึกสิ่งที่เขาจ่ายให้คุณ เขาจะไม่ได้รับการแจ้งเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, uygulaması olmayan bir misafir. Sana ne ödediğini not etmek için tıkla; bildirim almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — гість без застосунку. Клацни, щоб записати, що тобі сплатили; сповіщення не надійде."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là khách không dùng ứng dụng. Bấm để ghi lại số tiền họ đã trả bạn; họ sẽ không nhận được thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是没有应用的访客。点按可记录对方付给你的款项；对方不会收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是沒有App的訪客。按一下可記錄對方付給你的款項；對方不會收到通知。"
          }
        }
      }
    },
