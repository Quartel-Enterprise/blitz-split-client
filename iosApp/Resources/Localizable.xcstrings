    "Friends join the group without creating an account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينضم الأصدقاء إلى المجموعة دون إنشاء حساب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятелите се присъединяват към групата, без да създават акаунт."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধুরা অ্যাকাউন্ট না খুলেই গ্রুপে যোগ দিতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els amics entren al grup sense crear cap compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelé se ke skupině připojí bez vytváření účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venner bliver medlem af gruppen uden at oprette en konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde treten der Gruppe bei, ohne ein Konto zu erstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φίλοι μπαίνουν στην ομάδα χωρίς να δημιουργήσουν λογαριασμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos entran al grupo sin crear una cuenta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõbrad liituvad grupiga ilma kontot loomata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوستان بدون ایجاد حساب کاربری به گروه می‌پیوندند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ystävät liittyvät ryhmään luomatta tiliä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumasali ang mga kaibigan sa grupo nang hindi gumagawa ng account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les amis rejoignent le groupe sans créer de compte."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મિત્રો એકાઉન્ટ બનાવ્યા વિના ગ્રુપમાં જોડાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חברים מצטרפים לקבוצה בלי ליצור חשבון משתמש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोस्त बिना अकाउंट बनाए ग्रुप से जुड़ते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijatelji ulaze u grupu bez stvaranja računa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barátok fiók létrehozása nélkül csatlakoznak a csoporthoz."
