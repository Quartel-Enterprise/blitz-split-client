    "%@ turned it on after you. The last change counts: Simplify debts is on." : {
      "comment" : "Simplify debts: someone changed it after this device; %@ is who",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: التفعيل بعدك. آخر تغيير هو المعتمد: «تبسيط الديون» مفعّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat es nach dir eingeschaltet. Die letzte Änderung zählt: „Schulden vereinfachen“ ist an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo activó después de ti. Vale el último cambio: Simplificar deudas está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’a activé après toi. Le dernier changement compte : Simplifier les dettes est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: הפעלה אחריך. השינוי האחרון קובע: פישוט חובות פעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने आपके बाद इसे चालू किया। आखिरी बदलाव ही मान्य है: “कर्ज़ सरल करें” चालू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengaktifkannya setelah kamu. Perubahan terakhir yang berlaku: Sederhanakan utang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’ha attivato dopo di te. Vale l’ultima modifica: Semplifica debiti è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの後に%@がオンにしました。最後の変更が優先されます：精算をシンプルにはオンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 나보다 나중에 켰어요. 마지막 변경이 적용돼요: 정산 간소화가 켜져 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft het na jou aangezet. De laatste wijziging telt: Schulden vereenvoudigen staat aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ włączył(a) to po tobie. Liczy się ostatnia zmiana: „Uprość długi” jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligou depois de você. Vale a última mudança: Simplificar dívidas está ligado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligou depois de ti. Vale a última alteração: Simplificar dívidas está ligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ включил(а) его после тебя. Действует последнее изменение: упрощение долгов включено."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เปิดหลังจากคุณ การเปลี่ยนแปลงล่าสุดจะถูกใช้: ลดความซับซ้อนของหนี้เปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ senden sonra açtı. Son değişiklik geçerli: Borçları sadeleştir açık."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ увімкнув(-ла) це після тебе. Діє остання зміна: «Спростити борги» увімкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã bật sau bạn. Thay đổi cuối cùng được áp dụng: Đơn giản hóa nợ đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在你之后开启了它。以最后一次更改为准：简化债务已开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在你之後開啟了它。以最後一次更改為準：簡化債務已開啟。"
          }
        }
      }
    },
    "%@ turned it off after you. The last change counts: Simplify debts is off." : {
