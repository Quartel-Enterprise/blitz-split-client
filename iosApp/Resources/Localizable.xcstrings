    "%@ simplified its debts, so instead of paying %@ you pay me directly; your total didn't change." : {
      "comment" : "Request's message: %1$@ is the group, %2$@ whom they would pay by the bills",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تبسيط ديون %@، لذا بدلًا من الدفع لـ %@ يكون الدفع لي مباشرة؛ ولم يتغير إجماليك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ опрости дълговете си, така че вместо да плащаш на %@, плащаш директно на мен; общата ти сума не се промени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ গ্রুপের দেনা সহজ করা হয়েছে, তাই %2$@-কে দেওয়ার বদলে আপনি সরাসরি আমাকে দেবেন; আপনার মোট পরিমাণ বদলায়নি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grup «%@» ha simplificat els deutes, així que en lloc de pagar a %@ em pagues directament a mi; el teu total no ha canviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina %@ zjednodušila dluhy, takže místo placení osobě %@ platíš přímo mně; tvoje celková částka se nezměnila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har forenklet sin gæld, så i stedet for at betale %@ betaler du mig direkte; din total er ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Schulden vereinfacht, daher zahlst du mir direkt statt an %2$@; deine Summe hat sich nicht geändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ομάδα %@ απλοποίησε τα χρέη της, οπότε αντί να πληρώσεις σε %@ πληρώνεις απευθείας εμένα. Το σύνολό σου δεν άλλαξε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ simplificó sus deudas, así que en vez de pagar %2$@ me pagas directamente a mí; tu total no cambió."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupi %@ võlad lihtsustati, nii et liikmele %@ maksmise asemel maksad otse mulle; sinu kogusumma ei muutunud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه %@ بدهی‌ها را ساده کرد، پس به جای پرداخت به %@ مستقیماً به من می‌پردازید؛ مجموع شما تغییر نکرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmän %@ velat yksinkertaistettiin, joten sen sijaan, että maksaisit henkilölle %@, maksat suoraan minulle; kokonaissummasi ei muuttunut."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinasimple ng %@ ang mga utang nito, kaya sa halip na magbayad ka ng %@, direkta kang magbabayad sa akin; hindi nagbago ang kabuuan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a simplifié ses dettes, donc au lieu de payer %2$@ tu me paies directement ; ton total n’a pas changé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ ગ્રુપે તેનાં દેવાં સરળ કર્યાં, એટલે %@ ને ચૂકવવાને બદલે તમે મને સીધા ચૂકવો; તમારી કુલ રકમ બદલાઈ નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקבוצה %1$@ היה פישוט חובות, אז במקום לשלם ל-%2$@, התשלום הוא ישירות אליי; הסכום הכולל שלך לא השתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने अपने कर्ज़ सरल कर दिए हैं, इसलिए %2$@ को भुगतान करने की जगह आप सीधे मुझे भुगतान करें; आपका कुल नहीं बदला।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa „%@“ pojednostavila je dugove pa umjesto da platiš članu %@, plaćaš izravno meni; tvoj ukupni iznos se nije promijenio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoport (%1$@) egyszerűsítette a tartozásokat, így ahelyett, hogy neki fizetnél (%2$@), közvetlenül nekem fizetsz; a teljes összeged nem változott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menyederhanakan utangnya, jadi daripada membayar %@ kamu langsung membayar ke aku; totalmu tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha semplificato i debiti, quindi invece di pagare %@ paghi direttamente me; il tuo totale non è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で精算がシンプルになったので、%@に支払う代わりに私に直接支払ってください。あなたの合計は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 그룹이 정산을 간소화해서 %2$@ 님에게 송금하는 대신 나에게 바로 송금하면 돼요. 총액은 바뀌지 않았어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupėje %@ skolos supaprastintos, todėl vietoje mokėjimo nariui %@ moki tiesiai man; tavo bendra suma nepasikeitė."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %@ vienkāršoja savus parādus, tāpēc tā vietā, lai maksātu dalībniekam %@, tu maksā tieši man; tava kopsumma nemainījās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ ग्रुपने आपली कर्जे सोपी केली आहेत, म्हणून %2$@ यांना देण्याऐवजी तुम्ही थेट मला पैसे द्या; तुमची एकूण रक्कम बदललेली नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ telah mempermudahkan hutangnya, jadi daripada membayar %@, anda membayar saya terus; jumlah anda tidak berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forenklet gjelden sin, så i stedet for å betale %@ betaler du meg direkte; totalen din endret seg ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de schulden vereenvoudigd, dus in plaats van %@ te betalen, betaal je mij rechtstreeks; je totaal is niet veranderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %1$@ uprościła długi, więc zamiast płacić osobie %2$@, płacisz bezpośrednio mnie; twoja suma się nie zmieniła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ simplificou as dívidas, então em vez de pagar %2$@ você paga direto para mim; o seu total não mudou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ simplificou as dívidas, por isso em vez de pagares %2$@ pagas diretamente a mim; o teu total não mudou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ și-a simplificat datoriile, așa că în loc să-i plătești lui %@, îmi plătești direct mie; totalul tău nu s-a schimbat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В группе %@ упростили долги, поэтому вместо того чтобы платить участнику %@, ты платишь мне напрямую; твоя сумма не изменилась."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina %@ si zjednodušila dlhy, takže namiesto platby osobe %@ zaplatíš priamo mne; tvoja celková suma sa nezmenila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina %@ je poenostavila svoje dolgove, zato namesto osebi %@ plačaš neposredno meni; tvoj skupni znesek se ni spremenil."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa „%1$@“ je pojednostavila dugove, pa umesto da plaćaš (%2$@), plaćaš direktno meni; tvoj ukupni iznos se nije promenio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ förenklade sina skulder, så i stället för att betala %@ betalar du mig direkt; din totalsumma ändrades inte."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ imerahisisha madeni yake, kwa hivyo badala ya kumlipa %@ unanilipa mimi moja kwa moja; jumla yako haijabadilika."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ குழு தன் கடன்களை எளிதாக்கியது, எனவே இவருக்குச் செலுத்துவதற்குப் பதிலாக: %2$@, நேரடியாக எனக்குச் செலுத்துங்கள்; உங்கள் மொத்தம் மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ గ్రూప్ తన అప్పులను సరళం చేసింది, కాబట్టి వీరికి చెల్లించే బదులు: %2$@, నేరుగా నాకు చెల్లించండి; మీ మొత్తం మారలేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ลดความซับซ้อนของหนี้แล้ว คุณจึงจ่ายให้ฉันโดยตรงแทนที่จะจ่ายให้ %@ ยอดรวมของคุณไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grubu borçlarını sadeleştirdi; bu yüzden %@ kişisine ödemek yerine doğrudan bana ödüyorsun. Toplamın değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У групі %@ спростили борги, тож замість платити учаснику %@ ти платиш мені напряму; твоя загальна сума не змінилася."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے اپنے قرض آسان کیے، اس لیے %@ کو ادا کرنے کے بجائے آپ مجھے سیدھا ادا کریں؛ آپ کی کل رقم نہیں بدلی۔"
