    "Add the bill while you're still at the table, even offline. It syncs once you're back online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse die Ausgabe noch am Tisch, sogar offline. Sie wird synchronisiert, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el gasto mientras sigues en la mesa, incluso sin conexión. Se sincroniza cuando vuelvas a tener internet."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el gasto mientras sigues en la mesa, incluso sin conexión. Se sincroniza cuando vuelvas a tener internet."
          }
        },
        "fr" : {
          "stringUnit" : {
