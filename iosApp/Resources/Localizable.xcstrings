    "Your account has no Google or Apple sign in. When you sign out, we erase the copy on this %@. To come back, you need the recovery code." : {
      "comment" : "%@ is the device: iPhone, iPad or Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto hat keine Anmeldung mit Google oder Apple. Wenn du dich abmeldest, löschen wir die Kopie auf diesem %@. Um zurückzukommen, brauchst du den Wiederherstellungscode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene Google ni Apple. Al cerrar sesión, borramos la copia de este %@. Para volver, necesitas el código de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n’a pas de connexion Google ni Apple. Quand tu te déconnectes, on efface la copie sur ton %@. Pour revenir, il te faut le code de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha l’accesso con Google o Apple. Quando esci, cancelliamo la copia su questo %@. Per tornare ti serve il codice di recupero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie ma logowania przez Google ani Apple. Po wylogowaniu usuniemy kopię z tego urządzenia (%@). Aby wrócić, potrzebujesz kodu odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta não tem Google nem Apple. Ao sair, apagamos a cópia deste %@. Para voltar, só com o código de recuperação."
          }
        }
      }
    },
    "Your contacts are empty. The invite link works without them." : {
