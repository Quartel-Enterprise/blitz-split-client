    "Too many attempts. Wait a few minutes and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات كثيرة جدًا. انتظر بضع دقائق ثم أعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твърде много опити. Изчакай няколко минути и опитай отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনেকবার চেষ্টা করা হয়েছে। কয়েক মিনিট অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massa intents. Espera uns minuts i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho pokusů. Počkej pár minut a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forsøg. Vent et par minutter, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Versuche. Warte ein paar Minuten und versuch es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλές προσπάθειες. Περίμενε λίγα λεπτά και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos. Espera unos minutos e inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liiga palju katseid. Oota paar minutit ja proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاش‌های بیش از حد. چند دقیقه صبر کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta yritystä. Odota muutama minuutti ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napakaraming subok. Maghintay ng ilang minuto at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives. Attends quelques minutes et réessaie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઘણા બધા પ્રયાસો થયા. થોડી મિનિટ રાહ જુઓ અને ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי ניסיונות. כדאי לחכות כמה דקות ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत ज़्यादा कोशिशें हो गईं। कुछ मिनट रुकें और फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše pokušaja. Pričekaj nekoliko minuta i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok próbálkozás. Várj néhány percet, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak percobaan. Tunggu beberapa menit lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi tentativi. Aspetta qualche minuto e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数が多すぎます。数分待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시도 횟수가 너무 많아요. 몇 분 후에 다시 시도해 주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per daug bandymų. Palauk kelias minutes ir bandyk dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārāk daudz mēģinājumu. Pagaidi dažas minūtes un mēģini vēlreiz."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खूप प्रयत्न झाले. काही मिनिटे थांबा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak percubaan. Tunggu beberapa minit dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forsøk. Vent noen minutter og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel pogingen. Wacht een paar minuten en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele prób. Odczekaj kilka minut i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas tentativas. Espere alguns minutos e tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas tentativas. Espera alguns minutos e tenta de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe încercări. Așteaptă câteva minute și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много попыток. Подожди несколько минут и попробуй ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príliš veľa pokusov. Počkaj pár minút a skús znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveč poskusov. Počakaj nekaj minut in poskusi znova."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previše pokušaja. Sačekaj nekoliko minuta i pokušaj ponovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många försök. Vänta några minuter och försök igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majaribio mengi mno. Subiri dakika chache kisha ujaribu tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிக முயற்சிகள். சில நிமிடங்கள் காத்திருந்து மீண்டும் முயலுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చాలా ఎక్కువ ప్రయత్నాలు. కొన్ని నిమిషాలు ఆగి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองหลายครั้งเกินไป รอสักครู่แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla deneme. Birkaç dakika bekleyip tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забагато спроб. Зачекай кілька хвилин і спробуй ще раз."
          }
        },
        "ur" : {
