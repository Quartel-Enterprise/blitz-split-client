    "Apple or Google only keep you from losing anything when you switch devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple oder Google sorgen nur dafür, dass du beim Gerätewechsel nichts verlierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple o Google solo sirven para no perder nada al cambiar de dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ou Google servent seulement à ne rien perdre quand tu changes d’appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple atau Google hanya menjaga agar tidak ada yang hilang saat kamu ganti perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple o Google servono solo a non perdere nulla quando cambi dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleやGoogleは、デバイスを買い替えたときに何も失わないようにするためだけのものです。"
