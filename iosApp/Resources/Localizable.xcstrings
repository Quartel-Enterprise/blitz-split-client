    "Enter each one's net income, after taxes." : {
      "comment" : "Default split's By income: under the incomes, which income to type, the net one",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخِل صافي دخل كل شخص بعد الضرائب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib das Nettoeinkommen jeder Person an, nach Steuern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon los ingresos netos de cada uno, después de impuestos."
          }
