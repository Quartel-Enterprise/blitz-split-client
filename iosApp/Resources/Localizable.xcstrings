    "%@ from the receipt. Tap the icon to change it." : {
      "comment" : "Split a bill: the receipt chose the category",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ laut Beleg. Tippe auf das Symbol, um sie zu ändern."
