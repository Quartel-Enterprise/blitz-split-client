        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีผลกับบิลใหม่ แต่ละบิลเปลี่ยนได้ทันที บิลที่เพิ่มไว้แล้วจะไม่เปลี่ยน"
