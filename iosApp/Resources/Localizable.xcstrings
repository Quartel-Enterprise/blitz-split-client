        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl deinen Namen. Du siehst die Ausgaben, die für diese Person schon hinzugefügt wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε το όνομά σου. Θα δεις τα έξοδα που έχουν ήδη προστεθεί για αυτό το άτομο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu nombre. Verás los gastos que ya se agregeron para esa persona."
          }
