          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra todo el recibo. Completamos el importe, la fecha y la descripción; tú los revisas antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
