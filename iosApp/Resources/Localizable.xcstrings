    "Everything in %@'s name (bills, payments and the balance of %@) moves to your account, in every group, and the guest goes away. This can't be undone." : {
      "comment" : "The warning before the user claims a guest",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما باسم %@ (الفواتير والدفعات ورصيد %@) ينتقل إلى حسابك في كل المجموعات، ويختفي الضيف. لا يمكن التراجع عن ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко на името на %@ (разходи, плащания и балансът на %@) се прехвърля в акаунта ти, във всяка група, а гостът изчезва. Това не може да се отмени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ নামে থাকা সবকিছু (বিল, পেমেন্ট এবং ব্যালেন্স: %@) প্রতিটি গ্রুপ থেকে আপনার অ্যাকাউন্টে চলে আসবে, আর অতিথিকে সরিয়ে দেওয়া হবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot el que hi ha a nom de %@ (despeses, pagaments i el saldo de %@) passa al teu compte, a tots els grups, i el convidat desapareix. No es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše vedené na jméno %@ (výdaje, platby a zůstatek %@) se ve všech skupinách přesune na tvůj účet a host zmizí. Tohle nejde vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt i navnet %@ (udgifter, betalinger og saldoen for %@) flyttes til din konto i alle grupper, og gæsten forsvinder. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles unter dem Namen %@ (Ausgaben, Zahlungen und der Saldo von %@) wandert in allen Gruppen auf dein Konto, und der Gast verschwindet. Das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα όσα ανήκουν στον επισκέπτη %@ (έξοδα, πληρωμές και το υπόλοιπο %@) μεταφέρονται στον λογαριασμό σου, σε κάθε ομάδα, και ο επισκέπτης καταργείται. Αυτό δεν αναιρείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que está a nombre de %@ (gastos, pagos y el saldo de %@) pasa a tu cuenta, en todos los grupos, y el invitado desaparece. No se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik, mis kuulub külalisele %@ (kulud, maksed ja saldo %@), liigub kõigis gruppides sinu kontole ning külaline kaob. Seda ei saa tagasi võtta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه چیز به نام %@ (هزینه‌ها، پرداخت‌ها و تراز %@) در همه گروه‌ها به حساب کاربری شما منتقل می‌شود و مهمان حذف می‌شود. این کار قابل بازگشت نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki nimellä %@ oleva (kulut, maksut ja saldo %@) siirtyy tilillesi kaikissa ryhmissä, ja vieras poistuu. Tätä ei voi kumota."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lahat ng nasa pangalan ni %@ (mga bill, bayad at ang balanse ni %@) ay mapupunta sa account mo, sa bawat grupo, at mawawala ang guest. Hindi na ito mababawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui est au nom de %@ (dépenses, paiements et le solde de %@) passe sur ton compte, dans tous les groupes, et l’invité disparaît. Cette action est irréversible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ના નામે રહેલું બધું (ખર્ચ, ચુકવણીઓ અને %@ નું બેલેન્સ) દરેક ગ્રુપમાં તમારા એકાઉન્ટમાં આવી જાય છે, અને મહેમાન દૂર થાય છે. આ પાછું વાળી શકાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מה שרשום על השם %@ (חשבונות, תשלומים והיתרה של %@) עובר לחשבון המשתמש שלך, בכל קבוצה, והאורח נעלם. אי אפשר לבטל את הפעולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के नाम का सब कुछ (खर्च, भुगतान और %@ का बैलेंस) हर ग्रुप में आपके अकाउंट में आ जाएगा, और मेहमान हट जाएगा। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve na ime %@ (troškovi, uplate i saldo od %@) prelazi na tvoj račun, u svim grupama, a gost nestaje. To se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden, ami %@ nevén van (számlák, fizetések és %@ egyenlege), átkerül a fiókodba minden csoportban, a vendég pedig megszűnik. Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua atas nama %@ (tagihan, pembayaran, dan saldo %@) pindah ke akunmu, di semua grup, dan tamu itu dihapus. Ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che è a nome di %@ (spese, pagamenti e il saldo di %@) passa al tuo account, in ogni gruppo, e l’ospite scompare. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の名義のすべて（支出、支払い、残高%@）が、すべてのグループであなたのアカウントに移り、ゲストは削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님 이름으로 된 모든 것(지출, 송금, 잔액 %@)이 모든 그룹에서 내 계정으로 옮겨지고 게스트는 사라져요. 되돌릴 수 없어요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viskas, kas priskirta svečiui %@ (išlaidos, mokėjimai ir %@ balansas), pereina į tavo paskyrą visose grupėse, o svečias dingsta. To anuliuoti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss, kas reģistrēts ar vārdu %@ (rēķini, maksājumi un bilance %@), visās grupās tiek pārcelts uz tavu kontu, un viesis tiek noņemts. To nevar atsaukt."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ यांच्या नावावरील सर्व काही (खर्च, पेमेंट आणि %@ यांचा बॅलन्स) प्रत्येक ग्रुपमध्ये तुमच्या अकाउंटमध्ये जाते, आणि पाहुणे काढले जातात. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua atas nama %@ (bil, bayaran dan baki sebanyak %@) akan dipindahkan ke akaun anda, dalam setiap kumpulan, dan tetamu itu akan dialih keluar. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
