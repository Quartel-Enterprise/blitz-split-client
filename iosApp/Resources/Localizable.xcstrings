    "%@ turned it on after you. The last change counts: Simplify debts is on." : {
      "comment" : "Simplify debts: someone changed it after this device; %@ is who",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat es nach dir eingeschaltet. Die letzte Änderung zählt: „Schulden vereinfachen“ ist an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo activó después de ti. Vale el último cambio: Simplificar deudas está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’a activé après toi. Le dernier changement compte : Simplifier les dettes est activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengaktifkannya setelah kamu. Perubahan terakhir yang berlaku: Sederhanakan utang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’ha attivato dopo di te. Vale l’ultima modifica: Semplifica debiti è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの後に%@がオンにしました。最後の変更が優先されます：精算をシンプルにはオンです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft het na jou aangezet. De laatste wijziging telt: Schulden vereenvoudigen staat aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ włączył(a) to po tobie. Liczy się ostatnia zmiana: „Uprość długi” jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligou depois de você. Vale a última mudança: Simplificar dívidas está ligado."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ senden sonra açtı. Son değişiklik geçerli: Borçları sadeleştir açık."
          }
        }
      }
    },
