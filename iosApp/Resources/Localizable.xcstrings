    "Name and photo came from your %@ account. Changing them here only applies to Blitz Split and doesn't change your %@ account." : {
      "comment" : "Both %@ are the account: Google or Apple",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name und Foto stammen aus deinem %1$@-Konto. Änderungen hier gelten nur für Blitz Split und ändern dein %2$@-Konto nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre y la foto vinieron de tu cuenta de %1$@. Cambiarlos aquí solo vale en Blitz Split y no modifica tu cuenta de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom et la photo viennent de ton compte %1$@. Les changer ici ne s’applique qu’à Blitz Split et ne modifie pas ton compte %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama dan foto berasal dari akun %@ kamu. Mengubahnya di sini hanya berlaku di Blitz Split dan tidak mengubah akun %@ kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome e foto provengono dal tuo account %@. Cambiarli qui vale solo per Blitz Split e non modifica il tuo account %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前と写真は%@アカウントから取得したものです。ここで変更してもBlitz Splitにのみ反映され、%@アカウントは変わりません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naam en foto komen van je %@-account. Als je ze hier wijzigt, geldt dat alleen voor Blitz Split en verandert je %@-account niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imię i zdjęcie pochodzą z twojego konta %1$@. Zmiana tutaj dotyczy tylko Blitz Split i nie zmienia twojego konta %2$@."
