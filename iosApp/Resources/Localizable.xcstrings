    "The net already offsets the groups: Request and Got paid use %@. The app records a payment in each group." : {
      "comment" : "Under the groups of someone who owes you, beside Balances' list; %@ is the net",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nettobetrag verrechnet die Gruppen schon: „Anfordern“ und „Bezahlt bekommen“ nutzen %@. Die App erfasst in jeder Gruppe eine Zahlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El saldo neto ya compensa los grupos: Cobrar y Recibido usan %@. La app registra un pago en cada grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le net compense déjà les groupes : Demander et Paiement reçu utilisent %@. L’app enregistre un paiement dans chaque groupe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo bersih sudah mengimbangkan semua grup: Tagih dan Sudah menerima memakai %@. Aplikasi mencatat pembayaran di setiap grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il netto compensa già i gruppi: Richiedi e Mi ha pagato usano %@. L’app registra un pagamento in ogni gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
