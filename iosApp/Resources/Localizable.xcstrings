    "The payment leaves the group and the debt is back in the balances." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخرج الدفعة من المجموعة ويعود الدين إلى الأرصدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащането излиза от групата и дългът се връща в балансите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্টটি গ্রুপ থেকে সরে যাবে এবং দেনা আবার ব্যালেন্সে ফিরে আসবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pagament surt del grup i el deute torna als saldos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platba zmizí ze skupiny a dluh se vrátí do zůstatků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen forsvinder fra gruppen, og gælden er tilbage i saldiene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung verschwindet aus der Gruppe, und die Schuld ist wieder in den Salden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πληρωμή φεύγει από την ομάδα και το χρέος επιστρέφει στα υπόλοιπα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago sale del grupo y la deuda vuelve a los saldos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makse eemaldatakse grupist ja võlg ilmub tagasi saldodesse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت از گروه حذف می‌شود و بدهی به ترازها برمی‌گردد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksu poistuu ryhmästä ja velka palaa saldoihin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalis ang bayad sa grupo at babalik ang utang sa mga balanse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement quitte le groupe et la dette revient dans les soldes."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચુકવણી ગ્રુપમાંથી દૂર થાય છે અને દેવું ફરી બેલેન્સમાં આવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התשלום יוסר מהקבוצה והחוב יחזור ליתרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान ग्रुप से हट जाएगा और कर्ज़ फिर से बैलेंस में आ जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplata napušta grupu i dug se vraća u salda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetés kikerül a csoportból, és a tartozás visszakerül az egyenlegekbe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran keluar dari grup dan utangnya kembali ke saldo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento esce dal gruppo e il debito torna nei saldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いはグループから削除され、残高に借りが戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "송금이 그룹에서 사라지고 빚이 다시 잔액에 반영돼요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mokėjimas pašalinamas iš grupės, o skola grįžta į balansus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksājums tiek izņemts no grupas, un parāds atkal parādās bilancēs."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेमेंट ग्रुपमधून निघून जाते आणि देणे पुन्हा बॅलन्समध्ये येते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayaran akan dikeluarkan daripada kumpulan dan hutang kembali dalam baki."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen forlater gruppen, og gjelden er tilbake i saldoene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De betaling verdwijnt uit de groep en de schuld staat weer in de saldi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatność zniknie z grupy, a dług wróci do sald."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento sai do grupo e a dívida volta aos saldos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plata iese din grup și datoria revine în solduri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платёж уйдёт из группы, а долг вернётся в балансы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platba odíde zo skupiny a dlh sa vráti do zostatkov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plačilo zapusti skupino in dolg se vrne v stanja."
