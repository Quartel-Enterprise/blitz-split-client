        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque nel gruppo può modificarla o eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループの誰でも編集・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹의 누구나 수정하거나 삭제할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
