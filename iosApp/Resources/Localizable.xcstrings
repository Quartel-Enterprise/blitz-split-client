    "If it was you, ask %@ to release the name in Members." : {
      "comment" : "The group's creator, who can release a member taken by someone else on the Members screen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كنت أنت، فاطلب من %@ تحرير الاسم في «الأعضاء»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, bitte %@, den Namen unter „Mitglieder“ freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuiste tú, pide a %@ que libere el nombre en Miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c’était toi, demande à %@ de libérer le nom dans Membres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ההצטרפות הייתה שלך, אפשר לבקש מ-%@ לשחרר את השם ב\"משתתפים\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह आप थे, तो %@ से सदस्य में जाकर नाम खाली करने के लिए कहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau itu kamu, minta %@ melepas nama itu di Anggota."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eri tu, chiedi a %@ di liberare il nome in Membri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身の場合は、%@に「メンバー」で名前を解放してもらってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인이라면 멤버 화면에서 이름을 해제해 달라고 %@ 님에게 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was jij het? Vraag %@ om de naam vrij te geven bij Leden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to ty, poproś twórcę grupy (%@) o zwolnienie imienia w Członkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se era você, peça para %@ liberar o nome em Membros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eras tu, pede a %@ para libertar o nome em Membros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это был(а) ты, попроси участника %@ освободить имя в Участниках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเป็นคุณ ขอให้ %@ ปล่อยชื่อในสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendiysen, %@ adlı kişiden Üyeler'de bu ismi serbest bırakmasını iste."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо це був ти, попроси учасника %@ звільнити ім'я в Учасниках."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đó là bạn, hãy nhờ %@ giải phóng tên trong Thành viên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果那是你，请让%@在“成员”中释放这个名字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果那是你，請讓%@在「成員」中釋放這個名字。"
          }
        }
      }
    },
    "If it was you, talk to whoever invited you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كنت أنت، فتحدّث مع من دعاك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das warst, sprich mit der Person, die dich eingeladen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fuiste tú, habla con quien te invitó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c’était toi, parle à la personne qui t’a invité."
