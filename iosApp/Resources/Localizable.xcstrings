    "Your balance is settled. Nobody else in the group has joined, so it's deleted for good." : {
      "comment" : "Leaving a group nobody else with an account is in, which deletes it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Saldo ist beglichen. Sonst ist niemand der Gruppe beigetreten, daher wird sie endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu saldo está saldado. Nadie más se ha unido al grupo, así que se elimina para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton solde est réglé. Personne d’autre n’a rejoint le groupe, donc il est supprimé définitivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldomu sudah lunas. Belum ada orang lain di grup yang bergabung, jadi grup ini dihapus permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo saldo è in pari. Nessun altro ha aderito al gruppo, quindi viene eliminato definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高は精算済みです。ほかに参加している人がいないため、グループは完全に削除されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je saldo is verrekend. Niemand anders in de groep is lid geworden, dus hij wordt definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje saldo jest rozliczone. Nikt inny z grupy nie dołączył, więc zostanie ona usunięta na zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu saldo está quitado. Ninguém mais entrou no grupo, então ele some de vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakiyen kapandı. Grupta katılmış başka kimse yok, bu yüzden grup kalıcı olarak silinir."
          }
        }
      }
    },
    "Your balance is settled. The group leaves this device and your expenses keep your name for the other %lld members. To come back, someone has to invite you again." : {
