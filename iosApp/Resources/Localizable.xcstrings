    "Tap each item and check who had it. Done unlocks once every item has someone." : {
      "comment" : "Bill items: no item has anyone yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf jede Position und wähl aus, wer sie hatte. „Fertig“ wird aktiv, sobald jede Position jemanden hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cada artículo y marca quién lo consumió. Listo se habilita cuando todos tengan a alguien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche chaque article et coche qui l’a pris. Terminé se débloque quand chaque article a quelqu’un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk setiap item dan centang siapa yang mengambilnya. Selesai aktif begitu setiap item punya orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca ogni voce e seleziona chi l’ha presa. Fine si sblocca quando ogni voce ha qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各品目をタップして、誰の分かチェックしてください。すべての品目に誰かが入ると「完了」が押せます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op elk item en vink aan wie het had. Gereed werkt zodra elk item iemand heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij każdą pozycję i zaznacz, kto ją miał. „Gotowe” odblokuje się, gdy każda pozycja będzie mieć kogoś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em cada item e marque quem consumiu. Pronto libera quando todos tiverem dono."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kaleme dokun ve kimin aldığını işaretle. Her kalemde biri olunca Bitti açılır."
          }
        }
      }
    },
    "Double-click each item and check who had it. Done unlocks once every item has someone." : {
      "comment" : "Bill items on the Mac, where a double click opens an item: no item has anyone yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke auf jede Position und wähl aus, wer sie hatte. „Fertig“ wird aktiv, sobald jede Position jemanden hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en cada artículo y marca quién lo consumió. Listo se habilita cuando todos tengan a alguien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-clique sur chaque article et coche qui l’a pris. Terminé se débloque quand chaque article a quelqu’un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
