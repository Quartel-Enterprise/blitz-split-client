            "value" : "Bewerk gerust: het blijft bewaard op deze %@ en gaat omhoog zodra de verbinding terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj śmiało: zmiany zostają zapisane na tym urządzeniu (%@) i zostaną wysłane, gdy wróci połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
