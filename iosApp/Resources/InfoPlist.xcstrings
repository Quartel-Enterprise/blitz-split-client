        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bora Rachar"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Why the app asks for the camera: scanning an invite's or the recovery QR code, and taking the profile photo and a bill's photos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scan the QR code of an invite or from your old device, and to take your profile photo and photos of bills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear el código QR de una invitación o de tu dispositivo anterior, y para tomar tu foto de perfil y fotos de gastos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler o QR code de um convite ou do seu aparelho antigo, e tirar a foto do seu perfil e fotos das contas."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Why the app asks for the contacts: inviting someone from them with a group's link",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To invite people from your contacts with a group's link. Their numbers stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para invitar a personas de tus contactos con el enlace de un grupo. Sus números se quedan solo en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para convidar gente da sua agenda com o link de um grupo. Os números ficam só neste aparelho."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Why the app asks to add to Photos: saving a bill's photo from its viewer (Download, then Save Image)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save a bill's photos to your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guardar las fotos de los gastos en tu biblioteca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para salvar as fotos das contas na sua galeria."
          }
        }
      }
    }
  },
  "version" : "1.0"
