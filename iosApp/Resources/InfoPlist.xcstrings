    "NSCameraUsageDescription" : {
      "comment" : "Why the app asks for the camera: scanning an invite's or the recovery QR code, and taking the profile photo and a bill's photos",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den QR-Code einer Einladung oder von deinem alten Gerät zu scannen und dein Profilfoto und Fotos von Ausgaben aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scan the QR code of an invite or from your old device, and to take your profile photo and photos of bills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear el código QR de una invitación o de tu dispositivo anterior, y para tomar tu foto de perfil y fotos de gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour scanner le QR code d’une invitation ou de ton ancien appareil, et pour prendre ta photo de profil et des photos de dépenses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memindai kode QR undangan atau dari perangkat lamamu, serta mengambil foto profil dan foto tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scansionare il codice QR di un invito o del tuo vecchio dispositivo, e per scattare la tua foto profilo e le foto delle spese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待や古いデバイスのQRコードのスキャン、プロフィール写真や支出の写真の撮影に使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de QR-code van een uitnodiging of van je oude apparaat te scannen, en om je profielfoto en foto’s van uitgaven te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby skanować kod QR zaproszenia lub ze starego urządzenia oraz robić zdjęcie profilowe i zdjęcia wydatków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler o QR code de um convite ou do seu aparelho antigo, e tirar a foto do seu perfil e fotos das contas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir davetin ya da eski cihazının QR kodunu taramak, profil fotoğrafını ve harcama fotoğraflarını çekmek için."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Why the app asks for the contacts: inviting someone from them with a group's link",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Personen aus deinen Kontakten mit dem Link einer Gruppe einzuladen. Ihre Nummern bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To invite people from your contacts with a group's link. Their numbers stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para invitar a personas de tus contactos con el enlace de un grupo. Sus números se quedan solo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour inviter des personnes de tes contacts avec le lien d’un groupe. Leurs numéros restent uniquement sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengundang orang dari kontakmu dengan tautan grup. Nomor mereka tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per invitare persone dai tuoi contatti con il link di un gruppo. I loro numeri restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループのリンクで連絡先から招待するために使用します。電話番号はこのデバイスから出ません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om mensen uit je contacten uit te nodigen met de link van een groep. Hun nummers blijven op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zapraszać osoby z kontaktów za pomocą linku do grupy. Ich numery zostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para convidar gente da sua agenda com o link de um grupo. Os números ficam só neste aparelho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilerinden birini bir grubun bağlantısıyla davet etmek için. Numaraları bu cihazda kalır."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Why the app asks to add to Photos: saving a bill's photo from its viewer (Download, then Save Image)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Fotos einer Ausgabe in deiner Mediathek zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save a bill's photos to your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guardar las fotos de los gastos en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour enregistrer les photos des dépenses dans ta photothèque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menyimpan foto tagihan ke galerimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per salvare le foto di una spesa nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出の写真をライブラリに保存するために使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de foto’s van een uitgave in je bibliotheek te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zapisywać zdjęcia wydatków w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para salvar as fotos das contas na sua galeria."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir harcamanın fotoğraflarını fotoğraf arşivine kaydetmek için."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
