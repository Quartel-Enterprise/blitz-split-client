    "NSCameraUsageDescription" : {
      "comment" : "Why the app asks for the camera: scanning an invite's or the recovery QR code, and taking the profile photo and a bill's photos",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمسح رمز QR الخاص بدعوة أو من جهازك القديم، ولالتقاط صورة ملفك الشخصي وصور الفواتير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да сканираш QR кода на покана или от старото си устройство и да направиш профилната си снимка и снимки на разходите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমন্ত্রণের বা আপনার পুরোনো ডিভাইসের QR কোড স্ক্যান করতে এবং আপনার প্রোফাইল ছবি ও বিলের ছবি তুলতে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke skenování QR kódu pozvánky nebo ze starého zařízení a k pořízení profilové fotky a fotek výdajů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den QR-Code einer Einladung oder von deinem alten Gerät zu scannen und dein Profilfoto und Fotos von Ausgaben aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να σαρώνεις τον κωδικό QR μιας πρόσκλησης ή της παλιάς σου συσκευής και να βγάζεις τη φωτογραφία προφίλ σου και φωτογραφίες εξόδων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scan the QR code of an invite or from your old device, and to take your profile photo and photos of bills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear el código QR de una invitación o de tu dispositivo anterior, y para tomar tu foto de perfil y fotos de gastos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اسکن کد QR یک دعوت یا دستگاه قبلی شما، و گرفتن عکس پروفایل و عکس هزینه‌ها."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para i-scan ang QR code ng imbitasyon o mula sa dati mong device, at para kunan ang iyong profile photo at mga larawan ng bill."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour scanner le QR code d’une invitation ou de ton ancien appareil, et pour prendre ta photo de profil et des photos de dépenses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לסרוק את קוד ה-QR של הזמנה או מהמכשיר הישן, ולצלם את תמונת הפרופיל ותמונות של חשבונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी आमंत्रण का या आपके पुराने डिवाइस का QR कोड स्कैन करने, और आपकी प्रोफ़ाइल फ़ोटो और खर्चों की फ़ोटो लेने के लिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za skeniranje QR koda pozivnice ili sa starog uređaja te za snimanje tvoje profilne fotografije i fotografija troškova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy beolvashasd egy meghívó vagy a régi eszközöd QR-kódját, és fotót készíthess a profilodhoz és a számlákhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memindai kode QR undangan atau dari perangkat lamamu, serta mengambil foto profil dan foto tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scansionare il codice QR di un invito o del tuo vecchio dispositivo, e per scattare la tua foto profilo e le foto delle spese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待や古いデバイスのQRコードのスキャン、プロフィール写真や支出の写真の撮影に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대나 이전 기기의 QR 코드를 스캔하고, 프로필 사진과 지출 사진을 찍기 위해 사용해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengimbas kod QR jemputan atau daripada peranti lama anda, serta mengambil foto profil dan foto bil anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de QR-code van een uitnodiging of van je oude apparaat te scannen, en om je profielfoto en foto’s van uitgaven te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby skanować kod QR zaproszenia lub ze starego urządzenia oraz robić zdjęcie profilowe i zdjęcia wydatków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler o QR code de um convite ou do seu aparelho antigo, e tirar a foto do seu perfil e fotos das contas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler o código QR de um convite ou do teu aparelho antigo, e tirar a fotografia do teu perfil e as fotografias das contas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a scana codul QR al unei invitații sau de pe dispozitivul vechi și pentru a face fotografia de profil și fotografii ale cheltuielilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сканировать QR-код приглашения или со старого устройства, а также фотографировать себя для профиля и снимать счета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na skenovanie QR kódu pozvánky alebo zo starého zariadenia a na fotenie tvojej profilovej fotky a fotiek výdavkov."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da skeniraš QR kod iz pozivnice ili sa starog uređaja, i da slikaš svoju profilnu fotografiju i fotografije računa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att skanna QR-koden i en inbjudan eller från din gamla enhet, och för att ta ditt profilfoto och foton av utgifter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อสแกนคิวอาร์โค้ดของคำเชิญหรือจากอุปกรณ์เครื่องเก่า และเพื่อถ่ายรูปโปรไฟล์และรูปภาพของบิล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir davetin ya da eski cihazının QR kodunu taramak, profil fotoğrafını ve harcama fotoğraflarını çekmek için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб сканувати QR-код запрошення або зі старого пристрою, а також робити фото профілю й фото рахунків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی دعوت کا یا آپ کی پرانی ڈیوائس کا QR کوڈ اسکین کرنے، اور آپ کی پروفائل تصویر اور خرچوں کی تصویریں لینے کے لیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để quét mã QR của lời mời hoặc từ thiết bị cũ, và để chụp ảnh hồ sơ cũng như ảnh khoản chi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于扫描邀请或旧设备上的二维码，以及拍摄个人资料照片和账单照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於掃描邀請或舊裝置上的QR Code，以及拍攝個人資料照片和帳單照片。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Why the app asks for the contacts: inviting someone from them with a group's link",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدعوة أشخاص من جهات اتصالك برابط مجموعة. تبقى أرقامهم على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да каниш хора от контактите си с линка на група. Номерата им остават на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্রুপের লিংক দিয়ে আপনার কন্টাক্ট থেকে লোকজনকে আমন্ত্রণ জানাতে। তাঁদের নম্বর এই ডিভাইসেই থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K pozvání lidí z tvých kontaktů odkazem na skupinu. Jejich čísla zůstanou v tomto zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Personen aus deinen Kontakten mit dem Link einer Gruppe einzuladen. Ihre Nummern bleiben auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να προσκαλείς άτομα από τις επαφές σου με τον σύνδεσμο μιας ομάδας. Οι αριθμοί τους μένουν σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To invite people from your contacts with a group's link. Their numbers stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para invitar a personas de tus contactos con el enlace de un grupo. Sus números se quedan solo en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
