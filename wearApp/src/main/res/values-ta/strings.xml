    <string name="group_confirm_title">இவருக்கு %1$s செலுத்தினீர்களா: %2$s?</string>
    <string name="group_confirm_body">%1$s. குழுவினர் இதை உடனே பார்ப்பார்கள், அல்லது இணையம் திரும்பியதும்.</string>
