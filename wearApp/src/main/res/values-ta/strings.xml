<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Blitz Split</string>
    <string name="pair_welcome_body">உங்கள் ஃபோனில் உள்ள அதே அக்கவுண்ட்டை இங்கேயும் பயன்படுத்துங்கள். பிறகு வாட்ச் தானாகவே வேலை செய்யும்.</string>
    <string name="pair_connect">இணைக்கவும்</string>
    <string name="pair_connecting">உங்கள் ஃபோனிலிருந்து அக்கவுண்ட்டைப் பெறுகிறது…</string>
    <string name="pair_connected_title">தயார், %1$s</string>
    <string name="pair_connected_title_unnamed">தயார்</string>
    <string name="pair_connected_body">ஃபோனிலிருந்து தொலைவில் இருந்தாலும், வாட்ச் தானாகவே ஒத்திசைக்கும்.</string>
    <string name="pair_continue">தொடரவும்</string>
    <string name="pair_local_only_title">உங்கள் தரவு ஃபோனில் மட்டுமே உள்ளது</string>
    <string name="pair_local_only_body">உங்கள் ஃபோனில், சுயவிவரத்தில் ஒரு அக்கவுண்ட்டை இணைத்து, இங்கே மீண்டும் இணைக்கவும் என்பதைத் தட்டுங்கள்.</string>
    <string name="pair_ok">சரி</string>
    <string name="pair_far_title">ஃபோன் அருகில் இல்லை</string>
    <string name="pair_far_body">ஃபோனை அருகில் கொண்டுவாருங்கள், அல்லது குறியீடு மூலம் இணையுங்கள்.</string>
    <string name="pair_try_again">மீண்டும் முயலவும்</string>
    <string name="pair_use_code">குறியீட்டைப் பயன்படுத்தவும்</string>
    <string name="pair_code_label">உங்கள் குறியீடு</string>
    <string name="pair_code_description">குறியீடு %1$s</string>
    <string name="pair_code_where">உங்கள் ஃபோனில்: சுயவிவரம் › வாட்ச்சை இணைக்கவும்</string>
    <string name="pair_code_validity">5 நிமிடங்களுக்குச் செல்லுபடியாகும்</string>
    <string name="pair_cancel">ரத்துசெய்</string>
    <string name="pair_signed_out_title">உங்கள் ஃபோனில் வெளியேறினீர்கள்</string>
    <string name="pair_signed_out_body">தரவு இந்த வாட்ச்சிலிருந்தும் நீக்கப்பட்டது.</string>
    <string name="pair_connect_again">மீண்டும் இணைக்கவும்</string>
    <string name="pair_error_offline">வாட்ச்சை இணைக்க இணையம் தேவை.</string>
    <string name="pair_error_too_many">பல முறை முயன்றுவிட்டீர்கள். சில நிமிடங்கள் காத்திருந்து மீண்டும் இணையுங்கள்.</string>
    <string name="pair_error_failed">வாட்ச்சை இணைக்க முடியவில்லை. மீண்டும் முயலுங்கள்.</string>
    <string name="balances_title">பேலன்ஸ்கள்</string>
    <string name="balances_offline">ஆஃப்லைன்</string>
    <plurals name="balances_offline_queued">
        <item quantity="one">ஆஃப்லைன் · வரிசையில் %d மாற்றம்</item>
        <item quantity="other">ஆஃப்லைன் · வரிசையில் %d மாற்றங்கள்</item>
