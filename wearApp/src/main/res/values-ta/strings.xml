    <string name="balances_waiting">அனுப்பக் காத்திருக்கிறது</string>
    <string name="balances_updated_at">புதுப்பிக்கப்பட்டது: %1$s</string>
    <string name="balances_sign_out">வெளியேறவும்</string>
    <string name="balances_sign_out_title">இந்த வாட்ச்சிலிருந்து வெளியேறவா?</string>
    <string name="balances_sign_out_body">வரிசையில் உள்ளவை அனுப்பப்பட்டதும் இதன் தரவு அழிக்கப்படும். உங்கள் ஃபோன் உள்நுழைந்தே இருக்கும்.</string>
    <string name="balances_sign_out_scheduled">வெளியேற திட்டமிடப்பட்டது</string>
    <string name="balances_sign_out_scheduled_detail">எல்லாம் பதிவேற்றப்பட்டதும் வெளியேறும்</string>
    <string name="balances_settled_title">நிலுவையில் எதுவும் இல்லை</string>
    <string name="balances_settled_body">நீங்கள் யாருக்கும் தர வேண்டியதில்லை, உங்களுக்கும் யாரும் தர வேண்டியதில்லை. புதிய குழுக்களும் செலவுகளும் தானாகவே இங்கே தோன்றும்.</string>
    <string name="group_you_owe_person">நீங்கள் இவருக்குத் தர வேண்டும்: %1$s</string>
    <string name="group_owes_you">%1$s உங்களுக்குத் தர வேண்டும்</string>
