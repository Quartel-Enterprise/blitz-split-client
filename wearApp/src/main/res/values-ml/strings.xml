    <string name="app_name">Blitz Split</string>
    <!-- Connecting the watch (15.9 to 15.13); the phone is "phone" on Wear OS -->
    <string name="pair_welcome_body">നിങ്ങളുടെ ഫോണിലെ അതേ അക്കൗണ്ട് ഇവിടെ ഉപയോഗിക്കുക. പിന്നെ വാച്ച് സ്വന്തമായി പ്രവർത്തിക്കും.</string>
    <string name="pair_connect">കണക്റ്റ് ചെയ്യുക</string>
    <string name="pair_connecting">നിങ്ങളുടെ ഫോണിൽ നിന്ന് അക്കൗണ്ട് എടുക്കുന്നു…</string>
    <string name="pair_connected_title">തയ്യാർ, %1$s</string>
    <string name="pair_connected_title_unnamed">തയ്യാർ</string>
    <string name="pair_connected_body">ഫോണിൽ നിന്ന് അകലെയായിരിക്കുമ്പോഴും വാച്ച് സ്വയം സിങ്ക് ചെയ്യും.</string>
    <string name="pair_continue">തുടരുക</string>
    <string name="pair_local_only_title">നിങ്ങളുടെ ഡാറ്റ ഫോണിൽ മാത്രമാണ്</string>
    <string name="pair_local_only_body">ഫോണിൽ, പ്രൊഫൈലിൽ ഒരു അക്കൗണ്ട് കണക്റ്റ് ചെയ്ത്, ഇവിടെ വീണ്ടും കണക്റ്റ് ചെയ്യുക ടാപ്പ് ചെയ്യുക.</string>
    <string name="pair_ok">ശരി</string>
    <string name="pair_far_title">ഫോൺ പരിധിക്ക് പുറത്താണ്</string>
    <string name="pair_far_body">ഫോൺ അടുത്തേക്ക് കൊണ്ടുവരിക, അല്ലെങ്കിൽ ഒരു കോഡ് ഉപയോഗിച്ച് കണക്റ്റ് ചെയ്യുക.</string>
    <string name="pair_try_again">വീണ്ടും ശ്രമിക്കുക</string>
