    <string name="designsystem_group_exit_leave_title">“%s” ছেড়ে যাবেন?</string>
    <plurals name="designsystem_group_exit_leave_message">
        <item quantity="one" tools:ignore="ImpliedQuantity">আপনার হিসাব মিটে গেছে। গ্রুপটি এই ডিভাইস থেকে সরে যাবে, আর অন্য সদস্যের কাছে আপনার খরচগুলোতে আপনার নাম থেকে যাবে। ফিরে আসতে হলে কাউকে আবার আপনাকে আমন্ত্রণ জানাতে হবে।</item>
        <item quantity="other">আপনার হিসাব মিটে গেছে। গ্রুপটি এই ডিভাইস থেকে সরে যাবে, আর অন্য %d জন সদস্যের কাছে আপনার খরচগুলোতে আপনার নাম থেকে যাবে। ফিরে আসতে হলে কাউকে আবার আপনাকে আমন্ত্রণ জানাতে হবে।</item>
    </plurals>
    <string name="designsystem_group_exit_leave_message_alone">আপনার হিসাব মিটে গেছে। গ্রুপে আর কেউ যোগ দেননি, তাই এটি চিরতরে মুছে যাবে।</string>
