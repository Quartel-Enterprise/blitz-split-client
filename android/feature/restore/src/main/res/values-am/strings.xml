    <string name="restore_error_sign_in_failed">አሁን መግባት አልተቻለም። እንደገና ይሞክሩ።</string>
    <string name="restore_error_unknown">የሆነ ችግር ተፈጥሯል። እንደገና ይሞክሩ።</string>
