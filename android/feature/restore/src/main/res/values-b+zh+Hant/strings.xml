<resources>
    <string name="restore_title">找回你的群組</string>
    <string name="restore_subtitle">之前用帳號登入過？再登入一次就行。如果沒有，請使用復原碼或舊裝置上的QR Code。</string>
    <string name="restore_no_connection_title">無網路連線</string>
    <string name="restore_no_connection_body">用帳號或復原碼登入需要網路才能下載你的群組。你輸入的內容會保留。</string>
    <string name="restore_code_label">或使用復原碼</string>
    <string name="restore_code_hint">按順序輸入12個詞。把它們全部貼上到一個欄位中即可填滿所有欄位。</string>
    <string name="restore_scan_qr_title">掃描舊裝置上的QR Code</string>
