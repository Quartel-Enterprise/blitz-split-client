    <string name="profile_sign_out_title">Skrá út?</string>
    <string name="profile_sign_out_body">Allt er samstillt við aðganginn þinn (%1$s). Þegar þú skráir þig út eyðum við afritinu á þessu tæki. Hóparnir þínir koma aftur þegar þú skráir þig inn á ný.</string>
    <plurals name="profile_sign_out_pending_title">
        <item quantity="one">%d breytingu hefur ekki verið hlaðið upp enn</item>
        <item quantity="other">%d breytingum hefur ekki verið hlaðið upp enn</item>
    </plurals>
    <string name="profile_sign_out_pending_body_offline">Ekkert internet. Gögnin þín eru áfram á þessu tæki þar til samstillingu lýkur. Þegar allt hefur verið hlaðið upp skráum við þig út og eyðum staðbundna afritinu.</string>
    <string name="profile_sign_out_pending_body">Gögnin þín eru áfram á þessu tæki þar til samstillingu lýkur. Þegar allt hefur verið hlaðið upp skráum við þig út og eyðum staðbundna afritinu.</string>
    <string name="profile_sign_out_when_synced">Skrá út eftir samstillingu</string>
    <string name="profile_sign_out_now">Skrá út núna og glata breytingunum</string>
    <string name="profile_sign_out_failed">Ekki tókst að skrá út. Reyndu aftur.</string>
    <string name="profile_erase_title">Eyða prófílnum af þessu tæki?</string>
    <string name="profile_erase_body">Aðgangurinn þinn er ekki með innskráningu með Google eða Apple. Þegar þú skráir þig út eyðum við afritinu á þessu tæki. Til að koma aftur þarftu endurheimtarkóðann. Eftir 30 daga án notkunar er aðganginum eytt og kóðinn hættir að virka.</string>
    <string name="profile_erase_body_no_code">Þú notar forritið án aðgangs og hefur ekki samstillt enn, svo enginn endurheimtarkóði er til. Þegar þú ferð hverfur prófíllinn þinn endanlega.</string>
    <string name="profile_erase_code_saved">Ég geymdi kóðann á öruggum stað</string>
    <string name="profile_erase_no_code_ack">Ég skil að ekki er hægt að endurheimta hann</string>
