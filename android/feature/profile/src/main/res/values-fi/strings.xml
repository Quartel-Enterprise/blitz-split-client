    <string name="profile_sign_out_title">Kirjaudutaanko ulos?</string>
    <string name="profile_sign_out_body">Kaikki on synkronoitu tiliisi (%1$s). Kun kirjaudut ulos, poistamme tämän laitteen kopion. Ryhmäsi palaavat, kun kirjaudut uudelleen sisään.</string>
    <plurals name="profile_sign_out_pending_title">
        <item quantity="one">%d muutos ei ole vielä lähetetty</item>
        <item quantity="other">%d muutosta ei ole vielä lähetetty</item>
    </plurals>
    <string name="profile_sign_out_pending_body_offline">Olet offline-tilassa. Tietosi pysyvät tällä laitteella, kunnes synkronointi on valmis. Kun kaikki on lähetetty, kirjaamme sinut ulos ja poistamme paikallisen kopion.</string>
    <string name="profile_sign_out_pending_body">Tietosi pysyvät tällä laitteella, kunnes synkronointi on valmis. Kun kaikki on lähetetty, kirjaamme sinut ulos ja poistamme paikallisen kopion.</string>
    <string name="profile_sign_out_when_synced">Kirjaudu ulos synkronoinnin jälkeen</string>
    <string name="profile_sign_out_now">Kirjaudu ulos nyt ja menetä muutokset</string>
