    <string name="profile_sign_out_title">Mag-sign out?</string>
    <string name="profile_sign_out_body">Naka-sync na ang lahat sa %1$s account mo. Kapag nag-sign out ka, buburahin namin ang kopya sa device na ito. Babalik ang mga grupo mo kapag nag-sign in ka ulit.</string>
    <plurals name="profile_sign_out_pending_title">
        <item quantity="one">%d pagbabago ang hindi pa na-upload</item>
        <item quantity="other">%d na pagbabago ang hindi pa na-upload</item>
    </plurals>
    <string name="profile_sign_out_pending_body_offline">Offline ka. Mananatili ang data mo sa device na ito hanggang matapos ang sync. Kapag na-upload na ang lahat, magsa-sign out kami at buburahin ang lokal na kopya.</string>
    <string name="profile_sign_out_pending_body">Mananatili ang data mo sa device na ito hanggang matapos ang sync. Kapag na-upload na ang lahat, magsa-sign out kami at buburahin ang lokal na kopya.</string>
    <string name="profile_sign_out_when_synced">Mag-sign out kapag na-sync na</string>
    <string name="profile_sign_out_now">Mag-sign out ngayon at mawala ang mga pagbabago</string>
    <string name="profile_sign_out_failed">Hindi makapag-sign out. Subukan ulit.</string>
    <string name="profile_erase_title">Burahin ang profile sa device na ito?</string>
    <string name="profile_erase_body">Walang Google o Apple sign in ang account mo. Kapag nag-sign out ka, buburahin namin ang kopya sa device na ito. Para makabalik, kailangan mo ang recovery code. Pagkalipas ng 30 araw na hindi nagagamit, buburahin ang account at hindi na gagana ang code.</string>
    <string name="profile_erase_body_no_code">Ginagamit mo ang app nang walang account at hindi ka pa nakapag-sync, kaya walang recovery code. Kapag umalis ka, mawawala nang tuluyan ang profile mo.</string>
    <string name="profile_erase_code_saved">Naitago ko ang code sa ligtas na lugar</string>
    <string name="profile_erase_no_code_ack">Naiintindihan kong hindi na ito mababawi</string>
