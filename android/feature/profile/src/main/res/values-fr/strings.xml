    <string name="profile_sign_out_title">Se déconnecter ?</string>
    <string name="profile_sign_out_body">Tout est synchronisé avec ton compte %1$s. Quand tu te déconnectes, on efface la copie de cet appareil. Tes groupes reviennent quand tu te reconnectes.</string>
