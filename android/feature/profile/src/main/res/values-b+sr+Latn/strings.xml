    <string name="profile_sign_out_pending_body_offline">Nisi na mreži. Tvoji podaci ostaju na ovom uređaju dok se sinhronizacija ne završi. Kad se sve pošalje, odjavljujemo te i brišemo lokalnu kopiju.</string>
    <string name="profile_sign_out_pending_body">Tvoji podaci ostaju na ovom uređaju dok se sinhronizacija ne završi. Kad se sve pošalje, odjavljujemo te i brišemo lokalnu kopiju.</string>
