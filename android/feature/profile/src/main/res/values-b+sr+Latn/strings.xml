    <string name="profile_sign_out_title">Da se odjaviš?</string>
    <string name="profile_sign_out_body">Sve je sinhronizovano sa tvojim %1$s nalogom. Kad se odjaviš, brišemo kopiju sa ovog uređaja. Tvoje grupe se vraćaju kad se ponovo prijaviš.</string>
