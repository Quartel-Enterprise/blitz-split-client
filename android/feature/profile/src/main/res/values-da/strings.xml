    <string name="profile_sign_out_title">Log ud?</string>
    <string name="profile_sign_out_body">Alt er synkroniseret med din %1$s-konto. Når du logger ud, sletter vi kopien på denne enhed. Dine grupper kommer tilbage, når du logger ind igen.</string>
    <plurals name="profile_sign_out_pending_title">
        <item quantity="one">%d ændring er ikke uploadet endnu</item>
        <item quantity="other">%d ændringer er ikke uploadet endnu</item>
    </plurals>
    <string name="profile_sign_out_pending_body_offline">Du er offline. Dine data bliver på denne enhed, indtil synkroniseringen er færdig. Når alt er uploadet, logger vi ud og sletter den lokale kopi.</string>
    <string name="profile_sign_out_pending_body">Dine data bliver på denne enhed, indtil synkroniseringen er færdig. Når alt er uploadet, logger vi ud og sletter den lokale kopi.</string>
    <string name="profile_sign_out_when_synced">Log ud, når der er synkroniseret</string>
    <string name="profile_sign_out_now">Log ud nu, og mist ændringerne</string>
    <string name="profile_sign_out_failed">Kunne ikke logge ud. Prøv igen.</string>
    <string name="profile_erase_title">Slet profilen fra denne enhed?</string>
    <string name="profile_erase_body">Din konto har intet log ind med Google eller Apple. Når du logger ud, sletter vi kopien på denne enhed. For at komme tilbage skal du bruge gendannelseskoden. Efter 30 dage uden brug slettes kontoen, og koden holder op med at virke.</string>
    <string name="profile_erase_body_no_code">Du bruger appen uden en konto og har ikke synkroniseret endnu, så der er ingen gendannelseskode. Når du går, er din profil væk for altid.</string>
