    <string name="profile_sign_out_title">Sign out?</string>
    <string name="profile_sign_out_body">Everything is synced with your %1$s account. When you sign out, we erase this device\'s copy. Your groups come back when you sign in again.</string>
    <plurals name="profile_sign_out_pending_title">
        <item quantity="one">%d change hasn\'t uploaded yet</item>
        <item quantity="other">%d changes haven\'t uploaded yet</item>
    </plurals>
    <string name="profile_sign_out_pending_body_offline">You\'re offline. Your data stays on this device until the sync finishes. Once everything is uploaded, we sign out and erase the local copy.</string>
    <string name="profile_sign_out_pending_body">Your data stays on this device until the sync finishes. Once everything is uploaded, we sign out and erase the local copy.</string>
    <string name="profile_sign_out_when_synced">Sign out once synced</string>
    <string name="profile_sign_out_now">Sign out now and lose the changes</string>
    <string name="profile_sign_out_failed">Couldn\'t sign out. Try again.</string>
    <string name="profile_erase_title">Erase the profile from this device?</string>
    <string name="profile_erase_body">Your account has no Google or Apple sign in. When you sign out, we erase this device\'s copy. To come back, you need the recovery code. After 30 days without use, the account is deleted and the code stops working.</string>
    <string name="profile_erase_body_no_code">You use the app without an account and haven\'t synced yet, so there is no recovery code. When you leave, your profile is gone for good.</string>
    <string name="profile_erase_code_saved">I kept the code somewhere safe</string>
    <string name="profile_erase_no_code_ack">I understand it can\'t be recovered</string>
    <string name="profile_erase_connect_instead">Connect Google or Apple instead</string>
    <string name="profile_erase_confirm">Erase and sign out</string>
