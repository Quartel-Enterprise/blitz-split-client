    <string name="profile_dynamic_colors_info">About dynamic colors</string>
    <string name="profile_dynamic_colors_info_body">Dynamic colors match the app to your Android system colors: buttons, backgrounds and highlights take the colors Android uses, which come from your wallpaper or from the palette you picked in Android\'s settings, and change when those do.</string>
