    <string name="profile_sign_out_title">Meld af?</string>
    <string name="profile_sign_out_body">Alles is gesinkroniseer met jou rekening: %1$s. Wanneer jy afmeld, vee ons hierdie toestel se kopie uit. Jou groepe kom terug wanneer jy weer aanmeld.</string>
