<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Profile › Connect watch (15.14): the code a watch shows when its phone is out of reach -->
    <string name="connect_watch_title">ウォッチを接続</string>
    <string name="connect_watch_close">閉じる</string>
    <string name="connect_watch_body">ウォッチに表示されたコードを入力してください。ウォッチがアカウントにログインし、その後は自動で同期します。</string>
    <string name="connect_watch_code_label">ウォッチのコード</string>
