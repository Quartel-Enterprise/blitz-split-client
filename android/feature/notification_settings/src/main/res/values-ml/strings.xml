<resources>
    <string name="notification_settings_title">അറിയിപ്പുകൾ</string>
    <string name="notification_settings_denied_title">Android-ൽ Blitz Split അറിയിപ്പുകൾ ഓഫാണ്.</string>
    <string name="notification_settings_denied_body">താഴെയുള്ള പുഷ് അറിയിപ്പുകൾ ലഭിക്കാൻ സിസ്റ്റം ക്രമീകരണങ്ങളിൽ അവ ഓണാക്കുക. ബെൽ പ്രവർത്തിച്ചുകൊണ്ടിരിക്കും.</string>
    <string name="notification_settings_open_settings">ക്രമീകരണങ്ങൾ തുറക്കുക</string>
    <string name="notification_settings_refused_body">താഴെയുള്ള പുഷ് അറിയിപ്പുകൾ ലഭിക്കാൻ ഒരിക്കൽ കൂടി അവ അനുവദിക്കാൻ Android നിങ്ങളെ അനുവദിക്കുന്നു. ബെൽ പ്രവർത്തിച്ചുകൊണ്ടിരിക്കും.</string>
    <string name="notification_settings_turn_on">ഓണാക്കുക</string>
