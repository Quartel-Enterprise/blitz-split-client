<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="notification_settings_title">அறிவிப்புகள்</string>
    <string name="notification_settings_denied_title">Blitz Split அறிவிப்புகள் Android-இல் அணைக்கப்பட்டுள்ளன.</string>
    <string name="notification_settings_denied_body">கீழே உள்ள புஷ் அறிவிப்புகளைப் பெற, சிஸ்டம் அமைப்புகளில் அவற்றை இயக்குங்கள். மணி தொடர்ந்து வேலை செய்யும்.</string>
    <string name="notification_settings_open_settings">அமைப்புகளைத் திறக்கவும்</string>
    <string name="notification_settings_refused_body">கீழே உள்ள புஷ் அறிவிப்புகளைப் பெற, அவற்றை இன்னொரு முறை அனுமதிக்க Android வாய்ப்பளிக்கிறது. மணி தொடர்ந்து வேலை செய்யும்.</string>
    <string name="notification_settings_turn_on">இயக்கவும்</string>
    <string name="notification_settings_blocked_in_android">Android-இல் தடுக்கப்பட்டது</string>
    <string name="notification_settings_open_channel_settings_description">Android அமைப்புகளைத் திறக்கவும்: %1$s</string>
    <string name="notification_settings_push_switch">புஷ் அறிவிப்புகள்</string>
    <string name="notification_settings_push_switch_detail">இந்தச் சாதனத்தில் மட்டும்</string>
    <string name="notification_settings_section">இவற்றைப் பற்றி எனக்குத் தெரிவிக்கவும்</string>
    <string name="notification_settings_push">புஷ்</string>
    <string name="notification_settings_in_app">ஆப்பில்</string>
    <string name="notification_settings_toggle_description">%1$s, %2$s</string>
    <string name="notification_settings_legend">புஷ் இந்தச் சாதனத்துக்கு அறிவிப்பை அனுப்பும். ஆப்பில் என்பது மணியிலும் செயல்பாட்டிலும் அதைப் புதியதாகக் குறிக்கும்; அணைத்தால், அது செயல்பாட்டில் ஏற்கெனவே படித்ததாகத் தோன்றும்.</string>
    <string name="notification_settings_footer">இணையம் இருக்கும்போது அறிவிப்புகள் வரும். ஒரு குழுவை மியூட் செய்ய, அதன் உள்ளே உள்ள மெனுவைப் பயன்படுத்துங்கள்.</string>
</resources>
