# Signing of the Apple betas (docs/release-process.md#apple-signing). The apple-build action runs this lane after it
# generates the Xcode project and before it archives.
#
# Why not Xcode's cloud-managed certificate: the team's certificate is "Apple Distribution: Antônio Vieira", and
# cloud signing writes the designated requirement with that name decomposed (o + U+0302) while the certificate holds
# the composed ô. The two never compare equal, so App Store Connect refuses the upload (90035, "Invalid Signature").
# Signing with the certificate itself, from the keychain, gives a requirement that matches, as Bible Planner's
# releases show with the same team and certificates repository.
TEAM_ID = "TTV2A365LG".freeze
BUNDLE_ID = "com.quare.blitzsplit".freeze
CERTS_REPO = "git@github.com:Quartel-Enterprise/bible-planner-certs.git".freeze
PROJECT = File.expand_path("../iosApp/BoraRachar.xcodeproj", __dir__)
# The scheme and its app target share a name; match and the entitlements key by platform
PLATFORMS = { "BoraRachar-iOS" => "ios", "BoraRachar-macOS" => "macos" }.freeze
KEYCHAIN = "fastlane_tmp_keychain".freeze
# The app extensions and watch app each platform embeds, by target, with their own App ID and profiles: the iPhone's
# balance widget, the Apple Watch app and the watch's complications (iosApp/project.yml). Each is signed as the app is;
# App Store Connect's profiles for the watch's ids are iOS ones, so one match of the ios platform fetches them all.
EXTENSIONS = {
  "ios" => {
    "BalanceWidget" => "com.quare.blitzsplit.BalanceWidget",
    "BoraRachar-watchOS" => "com.quare.blitzsplit.watchkitapp",
    "BalanceWidget-watchOS" => "com.quare.blitzsplit.watchkitapp.BalanceWidget",
  },
  "macos" => {},
}.freeze
# XcodeGen writes these with "development", which an App Store profile refuses under manual signing. PlistBuddy's
# Set fails when the file or the key is gone, so a change in project.yml stops the lane instead of shipping development
APS_ENVIRONMENT = {
  "ios" => [
    ["iosApp/Generated/iOS.entitlements", "aps-environment"],
    # The watch's own pushes (docs/product/watch.md#notifications)
    ["iosApp/Generated/watchOS.entitlements", "aps-environment"],
  ],
  "macos" => [["iosApp/Generated/macOS.entitlements", "com.apple.developer.aps-environment"]],
}.freeze

# No fastlane/README.md written into the checkout after each run
skip_docs

desc "Fetch the distribution certificate and the App Store (and ad hoc) profile, sign the target manually, write ExportOptions.plist"
desc "Options: scheme (BoraRachar-iOS|BoraRachar-macOS), export_options (path of the plist to write),"
desc "adhoc_export_options (iOS only: path of the ad hoc plist, for Firebase App Distribution; omit to skip)"
lane :apple_signing do |options|
  target = options.fetch(:scheme)
  platform = PLATFORMS.fetch(target)
  # Each target to sign with the bundle id its profile is for: the app's, then its extensions'
  signed_targets = { target => BUNDLE_ID }.merge(EXTENSIONS.fetch(platform))
  identifiers = signed_targets.values
  repo_root = File.expand_path("..", __dir__)

  # A temporary keychain on CI, so the certificate never lands in the login one; nothing outside CI. setup_ci locks
  # it after an hour, and the archive compiles Kotlin/Native and Firebase before it signs: no timeout instead
  setup_ci
  sh("security", "set-keychain-settings", KEYCHAIN) if is_ci

  api_key = app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_filepath: ENV.fetch("KEY_PATH"),
  )

  # readonly: CI never creates or revokes a certificate or a profile. Creating them is a one-time step on a Mac
  # (docs/release-process.md#apple-signing). The macOS package needs the installer certificate too.
  match(
    type: "appstore",
    readonly: true,
    platform: platform,
    app_identifier: identifiers,
    team_id: TEAM_ID,
    storage_mode: "git",
    git_url: CERTS_REPO,
    api_key: api_key,
    additional_cert_types: platform == "macos" ? ["mac_installer_distribution"] : [],
  )
  profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].slice(*identifiers)

  # The ad hoc profile lists the iPhones registered on the team, which are the only ones the Firebase App
  # Distribution build installs on. A new tester's iPhone needs registering and the profile made again
  # (docs/release-process.md#ios-on-firebase-app-distribution). The archive keeps the App Store profile: the ad hoc
  # export signs a copy of it again.
  adhoc_export_options = options[:adhoc_export_options]
  UI.user_error!("adhoc_export_options is iOS only") if adhoc_export_options && platform != "ios"
  # Best effort: a missing or broken ad hoc profile only costs the Firebase build. The App Store signing goes on, so
  # TestFlight still gets its build, and no ad hoc plist is written, which skips the ad hoc export.
  adhoc_profiles = nil
  if adhoc_export_options
    begin
      match(
        type: "adhoc",
        readonly: true,
        platform: platform,
        app_identifier: identifiers,
        team_id: TEAM_ID,
        storage_mode: "git",
        git_url: CERTS_REPO,
        api_key: api_key,
      )
      adhoc_profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].slice(*identifiers)
    rescue StandardError => e
      UI.error("No ad hoc profile, so no Firebase App Distribution build: #{e.message}")
    end
  end

  # Only the app and its extensions, and only Release: the Swift packages' frameworks take no profile, and the
  # committed project.yml keeps automatic signing for local builds
  signed_targets.each do |signed_target, identifier|
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: TEAM_ID,
      targets: [signed_target],
      code_sign_identity: "Apple Distribution",
      profile_name: profiles.fetch(identifier),
      build_configurations: ["Release"],
    )
  end

  # PlistBuddy, not plutil: plutil reads the dots of com.apple.developer.aps-environment as a key path
  APS_ENVIRONMENT.fetch(platform).each do |entitlements, key|
    sh("/usr/libexec/PlistBuddy", "-c", "Set :#{key} production", File.join(repo_root, entitlements))
  end

  export_options = {
    "method" => "app-store-connect",
    "teamID" => TEAM_ID,
    "signingStyle" => "manual",
    "signingCertificate" => "Apple Distribution",
    "provisioningProfiles" => profiles,
    "destination" => "export",
    "uploadSymbols" => true,
    # The workflow sets the build number itself, from version.properties
    "manageAppVersionAndBuildNumber" => false,
  }
  export_options["installerSigningCertificate"] = "3rd Party Mac Developer Installer" if platform == "macos"
  File.write(options.fetch(:export_options), Plist::Emit.dump(export_options))

  # Only the keys a release-testing export takes, not the App Store ones
  if adhoc_profiles
    File.write(adhoc_export_options, Plist::Emit.dump({
      "method" => "release-testing",
      "teamID" => TEAM_ID,
      "signingStyle" => "manual",
      "signingCertificate" => "Apple Distribution",
      "provisioningProfiles" => adhoc_profiles,
    }))
  end
end

# Store listing screenshots (docs/store-listing-screenshots.md): the Play and App Store images of every language, made
# from the sample trip, and their upload. Ported from Bible Planner's lanes, with the retries its releases needed.
ANDROID_PACKAGE = "com.quare.blitzsplit".freeze
# App Store Connect may not have finished deleting the screenshot sets deliver replaces:
SCREENSHOT_SET_RACE_MESSAGE = "Screenshot Set Already Exists".freeze
SCREENSHOT_SET_RACE_ATTEMPTS = 3
SCREENSHOT_SET_RACE_WAIT_SECONDS = 30
# Google Play's API answers a 5xx now and then, which supply reports once its own HTTP retries run out:
PLAY_SERVER_ERROR_MESSAGE = "Google Api Error: Server error".freeze
PLAY_SERVER_ERROR_ATTEMPTS = 3
PLAY_SERVER_ERROR_WAIT_SECONDS = 30
# What Google Play answers a save, the commit of an edit, once the app has had too many in a day
# (publishingDailySaveQuotaExceeded). Nothing is wrong with what was sent: it goes later
# (docs/store-listing-screenshots.md#google-plays-daily-save-quota).
PLAY_SAVE_QUOTA_MESSAGE = "Daily save quota exceeded".freeze
# App Store Connect refuses an order that doesn't name every screenshot a shelf lists, as deliver's is on a shelf
# that lists more than the 10 it reads:
SCREENSHOT_REORDER_REFUSED_MESSAGE = "Can't Add/Remove Relationship when reorder Set".freeze
# The most App Store Connect lists per page of a shelf's screenshots, which is far more than a shelf holds:
APP_STORE_SHELF_PAGE_SIZE = 200

desc "Generate the store listing screenshots of both stores in all 32 languages, then upload them"
desc "Options: skip_upload:true only generates (store_listings/ and the fastlane folders); platform:android or"
desc "platform:ios does one store (ios: iPhone, iPad, iPhone Duo and Mac); skip_capture:true reuses the Apple captures"
desc "already in build/; skip_mac:true leaves the Mac out (its capture drives this Mac's screen); locale:<store code>"
desc "uploads that locale alone (es-419, es-MX…); locales:<store code>,<store code> sends those to Google Play through"
desc "one edit, which is one of its daily saves (platform:android), and save_quota_is_no_failure:true ends the lane"
desc "well when Google Play refuses that save for the quota. Uploading needs PLAY_STORE_JSON_KEY_PATH (Play) and the"
desc "APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID with KEY_PATH or APP_STORE_CONNECT_API_KEY_P8 (App Store)."
lane :screenshots do |options|
  repo_root = File.expand_path("..", __dir__)
  platforms = options[:platform] ? [options[:platform].to_s] : %w[android ios]
  heavy_check = File.join(repo_root, "scripts/heavy-check.sh")

  if platforms.include?("ios") && !options[:skip_capture]
    sh(heavy_check, File.join(repo_root, "scripts/store-screenshots/capture-ios.sh"))
    sh(heavy_check, File.join(repo_root, "scripts/store-screenshots/capture-mac.sh")) unless options[:skip_mac]
  end
  stage_tasks = platforms.map { |platform| platform == "ios" ? "stageAppStoreScreenshots" : "stagePlayStoreScreenshots" }
  collect_tasks = platforms.map { |platform| platform == "ios" ? "collectAppStoreScreenshots" : "collectPlayStoreScreenshots" }
  Dir.chdir(repo_root) { sh(heavy_check, "./gradlew", *stage_tasks, *collect_tasks) }
  UI.success("Generated into store_listings/ for a look, and into fastlane/ for the upload")
  next if options[:skip_upload]

  upload_store_screenshots(repo_root, platforms, options)
end

desc "Upload what `fastlane screenshots skip_upload:true` staged, without generating again. Same options, and"
desc "platform:mac for the Mac's alone. validate_only:true, as VALIDATE_ONLY=true, only asks Google Play whether it"
desc "would take the images: the App Store has no such check, so its screenshots are left out of that run. A locale"
desc "whose images Google Play already holds is left out of its edit, and with nothing left no edit is saved."
lane :upload_screenshots do |options|
  repo_root = File.expand_path("..", __dir__)
  platforms = options[:platform] ? [options[:platform].to_s] : %w[android ios]
  upload_store_screenshots(repo_root, platforms, options)
end

# The Mac app is a version of its own on App Store Connect, so its screenshots go up apart (platform osx), and only
# when they were staged and skip_mac wasn't passed: a run with skip_mac leaves its listing as it is, even when an
# earlier run's Mac captures were framed again. platform:mac sends the Mac's alone, as the release does from a job of
# its own (release-production.yml). The stores name a language differently (es-419 on Play, es-MX on the App Store),
# so a locale: goes only to the stores that have it staged. locales: names several, for Google Play alone, where
# they go through one edit: the group of a job of play-store-screenshots-upload.yml. VALIDATE_ONLY is Google Play's
# check alone, as for the listing's text: the App Store has none, and its screenshots would go up for real, so they
# are left out of that run.
def upload_store_screenshots(repo_root, platforms, options)
  locale = options[:locale]
  play_locales = options[:locales].to_s.split(",").map(&:strip).reject(&:empty?)
  if options.key?(:locales)
    # Without this an empty list would read as no locale named, which sends everything staged
    UI.user_error!("locales: names no locale") if play_locales.empty?
    UI.user_error!("locales: is Google Play's alone (platform:android) and takes the place of locale:") if platforms != ["android"] || locale
  end
  quota_is_no_failure = options[:save_quota_is_no_failure].to_s == "true"
  validates_only = validate_only?(options[:validate_only])
  if validates_only && platforms != ["android"]
    UI.user_error!("VALIDATE_ONLY checks Google Play alone: the App Store has no such check") unless platforms.include?("android")
    UI.important("VALIDATE_ONLY: only Google Play is checked, the App Store's screenshots are left as they are")
    platforms = ["android"]
  end
  play_path = File.join(repo_root, "fastlane/metadata/android")
  app_store_path = File.join(repo_root, "fastlane/screenshots")
  mac_path = File.join(repo_root, "fastlane/screenshots-mac")
  stores = { "android" => play_path, "ios" => app_store_path, "mac" => mac_path }.select do |platform, path|
    platforms.include?(platform) && (locale.nil? || File.directory?(File.join(path, locale)))
  end
  UI.user_error!("No store has screenshots staged for #{locale}") if stores.empty?
  if stores.key?("android")
    upload_play_screenshots(play_path, play_locales.empty? ? [locale].compact : play_locales, validates_only, quota_is_no_failure)
  end
  upload_app_store_screenshots(mac_path, locale, "osx") if stores.key?("mac")
  return unless stores.key?("ios")

  uploads = { "ios" => -> { upload_app_store_screenshots(app_store_path, locale, "ios") } }
  if options[:skip_mac]
    UI.important("skip_mac: the Mac listing keeps its own")
  elsif Dir.glob(File.join(mac_path, "*", "*.png")).any?
    uploads["osx"] = -> { upload_app_store_screenshots(mac_path, locale, "osx") }
  else
    UI.important("No Mac screenshots staged: the Mac listing keeps its own")
  end
  each_app_store_version(uploads)
end

# Runs each version's step in turn, past one that fails, then raises the first error. The iPhone's and the Mac's
# versions are apart on App Store Connect, so a shelf that isn't as staged on one, which fails its tidy-up, doesn't
# keep the other from its upload or its tidy-up.
def each_app_store_version(steps)
  errors = steps.filter_map do |platform, step|
    step.call
    nil
  rescue => e
    UI.error("#{platform}: #{e.message.lines.first.to_s.strip}")
    e
  end
  raise errors.first unless errors.empty?
end

desc "Sort every shelf of the editable App Store version by file name and check that each holds every screen once:"
desc "a shelf short of a file, or listing one twice, fails the lane, which names it. Nothing is removed."
desc "Options: platform (ios|osx; both when left out). The release runs it after the last locale's upload, since an"
desc "upload of one locale leaves the shelves as deliver left them."
lane :finish_app_store_screenshots do |options|
  app_store_api_key
  platforms = options[:platform] ? [app_store_platform(options)] : %w[ios osx]
  each_app_store_version(platforms.to_h { |platform| [platform, -> { tidy_app_store_screenshots(platform) }] })
end

desc "Upload the stores' listing text, the files of store-listing/ (docs/store-listing.md): the name, the"
desc "descriptions, on Play the preview video of a language that names one, and, on the App Store, the subtitle,"
desc "the keywords and the promotional text, in every language,"
desc "with the App Store's support, marketing and privacy policy addresses in every locale and the version's"
desc "copyright line."
desc "Options: platform (android|ios|mac; all three when left out). Needs PLAY_STORE_JSON_KEY_PATH (Play) and the"
desc "App Store Connect key variables (App Store). version_code names the production release supply reads when the"
desc "track holds more than one (a staged rollout). VALIDATE_ONLY=true, or validate_only:true, only asks Play whether"
desc "it would take the text and changes nothing: the App Store has no such check, so it is left out of that run."
lane :upload_listing do |options|
  require "tmpdir"

  repo_root = File.expand_path("..", __dir__)
  platforms = options[:platform] ? [options[:platform].to_s] : %w[android ios mac]
  UI.user_error!("platform is one of android, ios, mac") unless (platforms - %w[android ios mac]).empty?
  validates_only = validate_only?(options[:validate_only])
  if validates_only && platforms != ["android"]
    UI.user_error!("VALIDATE_ONLY checks Google Play alone: the App Store has no such check") unless platforms.include?("android")
    UI.important("VALIDATE_ONLY: only Google Play is checked, the App Store listings are left as they are")
    platforms = ["android"]
  end
  Dir.mktmpdir("store-listing-") do |dir|
    # The script reads store-listing/ from the working directory, which fastlane sets to fastlane/. It stops on a
    # field over its store's limit, before anything is uploaded
    Dir.chdir(repo_root) { sh("node", "scripts/release/store-listing.mjs", "stage", "--out", dir) }
    upload_play_listing(File.join(dir, "play"), options[:version_code], validates_only) if platforms.include?("android")
    upload_app_store_listing(File.join(dir, "app-store"), "ios") if platforms.include?("ios")
    upload_app_store_listing(File.join(dir, "app-store"), "osx") if platforms.include?("mac")
  end
end

desc "Upload the Play feature graphic of every store video locale (docs/store-video.md): the 1024x500 image"
desc "scripts/store-video/thumbnail.sh <locale> renders, to each Play locale of the locale JSON's `listing` language"
desc "(store-listing.mjs's PLAY_LOCALES). Run thumbnail.sh for each first: a locale without its graphic fails the lane"
desc "before anything is sent. Other Play locales keep the graphic they have. Needs PLAY_STORE_JSON_KEY_PATH;"
desc "version_code names the production release supply reads when the track holds more than one (a staged rollout);"
desc "VALIDATE_ONLY=true, or validate_only:true, only asks Play whether it would take them. It commits a Play edit of"
desc "its own, so never run it while a release or a Play workflow (store-listing, play-store-screenshots) runs: a"
desc "second edit drops the one still open. Its edit also takes to review whatever waits in Publishing overview."
lane :upload_feature_graphics do |options|
  require "json"
  require "open3"
  require "tmpdir"
  require "supply"

  repo_root = File.expand_path("..", __dir__)
  # stdout alone: a warning Node prints on stderr must not reach the JSON
  out, status = Open3.capture2(
    "node", "--input-type=module", "-e",
    'import { PLAY_LOCALES } from "./scripts/release/store-listing.mjs"; console.log(JSON.stringify(PLAY_LOCALES))',
    chdir: repo_root,
  )
  UI.user_error!("Could not read PLAY_LOCALES from store-listing.mjs") unless status.success?
  play_locales = JSON.parse(out)
  claimed = {}
  Dir.mktmpdir("feature-graphics-") do |dir|
    Dir.glob(File.join(repo_root, "scripts/store-video/locales/*.json")).sort.each do |json|
      locale = File.basename(json, ".json")
      language = JSON.parse(File.read(json))["listing"]
      targets = play_locales[language]
      UI.user_error!("#{locale}.json names no listing language of store-listing.mjs (#{language.inspect})") unless targets
      # Two locales of one language would write the same Play locales' graphic, and the last would win unseen
      UI.user_error!("#{locale}.json and #{claimed[language]}.json both name the listing language #{language}") if claimed[language]
      claimed[language] = locale
      graphic = File.join(repo_root, "build/store-video", locale, "feature-#{locale}.jpg")
      UI.user_error!("No #{graphic}: run scripts/store-video/thumbnail.sh #{locale} first") unless File.exist?(graphic)
      targets.each do |target|
        images = File.join(dir, target, Supply::IMAGES_FOLDER_NAME)
        FileUtils.mkdir_p(images)
        FileUtils.cp(graphic, File.join(images, "featureGraphic.jpg"))
      end
    end
    upload_play_listing(dir, options[:version_code], validate_only?(options[:validate_only]), images: true)
  end
end

# VALIDATE_ONLY=true in the environment, or a lane's validate_only:true, asks Play whether it would take the upload
# and changes nothing.
def validate_only?(option = nil)
  [ENV["VALIDATE_ONLY"], option].any? { |value| value.to_s.strip.downcase == "true" }
end

# The listing's text only, or with images: true its images only (the feature graphics): no bundle, no track, no
# screenshots. supply adds the listing of a locale Play doesn't have yet.
# It reads the production track's release on the way, and stops when the track holds more than one unless it is
# told which, by its versionCode.
def upload_play_listing(metadata_path, version_code, validates_only, images: false)
  release = version_code.to_s.empty? ? {} : { version_code: version_code.to_s.to_i }
  retrying_on(PLAY_SERVER_ERROR_MESSAGE, attempts: PLAY_SERVER_ERROR_ATTEMPTS, wait_seconds: PLAY_SERVER_ERROR_WAIT_SECONDS) do
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key: ENV.fetch("PLAY_STORE_JSON_KEY_PATH"),
      **release,
      metadata_path: metadata_path,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: images,
      skip_upload_changelogs: true,
      skip_upload_images: !images,
      skip_upload_screenshots: true,
      validate_only: validates_only,
    )
  end
end

# The text only, on the editable version: no build, no screenshots, no submission. deliver adds the locales the
# listing doesn't have yet. The name and the subtitle are the app's, so the iPhone's and the Mac's runs write the same.
def upload_app_store_listing(metadata_path, platform)
  upload_to_app_store(
    api_key: app_store_api_key,
    app_identifier: BUNDLE_ID,
    # Unset, deliver uses the editable version; set, it creates that version when it doesn't exist yet
    app_version: ENV["APP_VERSION"],
    platform: platform,
    metadata_path: metadata_path,
    skip_binary_upload: true,
    skip_screenshots: true,
    skip_metadata: false,
    submit_for_review: false,
    force: true,
    precheck_include_in_app_purchases: false,
  )
end

# Listing images only: no bundle, no track, no text, through one Play edit that supply commits at the end, so a 5xx
# throws the edit away and the next attempt starts over. Each commit is a save, which Google Play counts against a
# daily quota (docs/store-listing-screenshots.md#google-plays-daily-save-quota), so:
# - `locales` go through one edit together, and everything staged does when none is named;
# - a locale whose staged images Google Play already holds is left out, and with none left nothing is committed.
#   sync_image_upload sends only the images whose SHA-256 differs from what Play holds, so it would upload nothing
#   for such a locale, and supply would still commit the edit;
# - a save refused for the quota is no failure of the upload, for a caller that says so (play_save_quota_reached).
def upload_play_screenshots(metadata_path, locales, validates_only, quota_is_no_failure)
  require "supply"

  json_key = ENV.fetch("PLAY_STORE_JSON_KEY_PATH")
  # Only the shelves supply uploads, and the files it uploads from them (the ones play_locales_to_send compares): a
  # locale with images anywhere else has nothing to compare, and nothing to send
  shelves = "{#{Supply::SCREENSHOT_TYPES.join(',')}}"
  images = Dir.glob("*/#{Supply::IMAGES_FOLDER_NAME}/#{shelves}/*.#{Supply::IMAGE_FILE_EXTENSIONS}", base: metadata_path)
  # supply replaces a listing's screenshots with what is staged, so an empty folder would wipe it instead of failing
  UI.user_error!("No staged screenshots under #{metadata_path}") if images.empty?
  UI.message("Found #{images.size} staged screenshot(s)")
  staged = images.map { |image| image.split("/").first }.uniq.sort
  missing = locales - staged
  UI.user_error!("No staged screenshots for #{missing.join(', ')} under #{metadata_path}") if missing.any?
  asked = locales.empty? ? staged : locales

  changed = begin
    retrying_on(PLAY_SERVER_ERROR_MESSAGE, attempts: PLAY_SERVER_ERROR_ATTEMPTS, wait_seconds: PLAY_SERVER_ERROR_WAIT_SECONDS) do
      play_locales_to_send(metadata_path, asked, json_key)
    end
  rescue => e
    # Opening the edit that reads may be refused for the quota as well: then nothing of the group went either
    raise unless e.message.include?(PLAY_SAVE_QUOTA_MESSAGE)

    return play_save_quota_reached(asked, [], quota_is_no_failure)
  end
  unchanged = asked - changed
  UI.message("Google Play already holds the staged images of #{unchanged.join(', ')}: left out of the upload") if unchanged.any?
  if changed.empty?
    UI.success("Nothing to send: Google Play holds every staged image as it is, and no save is spent")
    github_output(sent: "", unchanged: unchanged.join(","))
    return
  end

  begin
    with_locales_only(metadata_path, changed) do |path|
      retrying_on(PLAY_SERVER_ERROR_MESSAGE, attempts: PLAY_SERVER_ERROR_ATTEMPTS, wait_seconds: PLAY_SERVER_ERROR_WAIT_SECONDS) do
        upload_to_play_store(
          package_name: ANDROID_PACKAGE,
          json_key: json_key,
          metadata_path: path,
          skip_upload_aab: true,
          skip_upload_apk: true,
          skip_upload_metadata: true,
          skip_upload_changelogs: true,
          skip_upload_images: true,
          skip_upload_screenshots: false,
          sync_image_upload: true,
          validate_only: validates_only,
        )
      end
    end
  rescue => e
    raise unless e.message.include?(PLAY_SAVE_QUOTA_MESSAGE)

    return play_save_quota_reached(changed, unchanged, quota_is_no_failure)
  end
  github_output(sent: changed.join(","), unchanged: unchanged.join(","))
end

# The locales among `locales` with a shelf Google Play doesn't hold as it is staged. Read through an edit that is
# deleted, never committed, so asking costs no save. What "as it is staged" means is play-screenshot-groups.mjs's
# to say, where it has tests. A shelf Google Play can't be asked about counts as changed, so its upload says what is
# wrong with it.
def play_locales_to_send(metadata_path, locales, json_key)
  require "digest"
  require "json"
  require "open3"
  require "supply"

  client = Supply::Client.make_from_config(params: { json_key: json_key, timeout: 300 })
  client.begin_edit(package_name: ANDROID_PACKAGE)
  shelves = locales.to_h do |locale|
    by_shelf = Supply::SCREENSHOT_TYPES.filter_map do |shelf|
      # The files supply uploads to the shelf, in its order
      pattern = File.join(metadata_path, locale, Supply::IMAGES_FOLDER_NAME, shelf, "*.#{Supply::IMAGE_FILE_EXTENSIONS}")
      staged = Dir.glob(pattern, File::FNM_CASEFOLD).sort
      next if staged.empty?

      held = begin
        client.fetch_images(image_type: shelf, language: locale).map(&:sha256)
      rescue => e
        UI.important("Could not read #{locale}'s #{shelf} on Google Play, so it is sent: #{e.message.lines.first.to_s.strip}")
        nil
      end
      [shelf, { staged: staged.map { |image| Digest::SHA256.file(image).hexdigest }, held: held }]
    end
    [locale, by_shelf.to_h]
  end
  # A leftover edit expires on its own, so failing to delete it must not throw the answer away
  begin
    client.abort_current_edit
  rescue => e
    UI.error("Could not delete the Play edit used to read the screenshots: #{e.message}")
  end

  script = File.expand_path("../scripts/release/play-screenshot-groups.mjs", __dir__)
  changed, status = Open3.capture2("node", script, "changed", stdin_data: JSON.generate(shelves))
  UI.user_error!("play-screenshot-groups.mjs could not say which locales changed") unless status.success?
  JSON.parse(changed)
end

# A save Google Play refuses for its daily quota is no failure of the upload: the same images go later, as they
# are. For a caller that passed save_quota_is_no_failure:true the lane ends well and says so through the step's
# outputs, which the job turns into a warning, the run's summary and the stop of the groups after it
# (play-store-screenshots-upload.yml). For any other caller nothing reads an output, a workflow's step included, so
# the lane stops, with an error that says what happened.
def play_save_quota_reached(not_sent, unchanged, is_no_failure)
  message = "Google Play's daily save quota is used up: #{not_sent.join(', ')} not sent. Nothing is wrong with the " \
            "images: send them again later (docs/store-listing-screenshots.md#google-plays-daily-save-quota)"
  told = github_output(save_quota: "reached", not_sent: not_sent.join(","), unchanged: unchanged.join(","))
  UI.user_error!(message) unless is_no_failure && told
  UI.important(message)
end

# Writes the outputs of the step that runs the lane; false outside GitHub Actions, where nothing reads them.
def github_output(values)
  file = ENV["GITHUB_OUTPUT"].to_s
  return false if file.empty?

  File.open(file, "a") { |out| values.each { |name, value| out.puts("#{name}=#{value}") } }
  true
end

# deliver deletes a locale's screenshots and recreates its sets; a set recreated before App Store Connect finished
# deleting it is refused with "Screenshot Set Already Exists!", and waiting and running deliver again recovers. A shelf
# it can't reorder (one that lists a screenshot twice: deliver reads 10 of its 11) doesn't fail an upload that
# landed: the tidy-up after the last locale sorts it, and names it. An upload that fails on one shelf (a size App Store
# Connect refuses, as the iPhone Duo's inner display might) has put the other shelves up by then, unsorted, since
# deliver sorts last: the tidy-up runs for them too, and the upload's failure is the one reported.
def upload_app_store_screenshots(screenshots_path, locale, platform)
  api_key = app_store_api_key
  upload_error = nil
  with_locale_only(screenshots_path, locale) do |path|
    ensure_screenshots_staged(File.join(path, "*", "*.png"))
    begin
      tolerating(SCREENSHOT_REORDER_REFUSED_MESSAGE) do
        retrying_on(SCREENSHOT_SET_RACE_MESSAGE, attempts: SCREENSHOT_SET_RACE_ATTEMPTS, wait_seconds: SCREENSHOT_SET_RACE_WAIT_SECONDS) do
          upload_to_app_store(
            api_key: api_key,
            app_identifier: BUNDLE_ID,
            # Unset, deliver uses the editable version; set, it creates that version when it doesn't exist yet
            app_version: ENV["APP_VERSION"],
            platform: platform,
            screenshots_path: path,
            skip_binary_upload: true,
            skip_metadata: true,
            skip_screenshots: false,
            submit_for_review: false,
            force: true,
            precheck_include_in_app_purchases: false,
            overwrite_screenshots: true,
          )
        end
      end
    rescue => e
      upload_error = e
    end
  end
  if locale.nil?
    begin
      tidy_app_store_screenshots(platform)
    rescue => e
      raise if upload_error.nil?

      UI.error("Could not tidy the shelves up after the failed upload: #{e.message.lines.first.to_s.strip}")
    end
  end
  raise upload_error unless upload_error.nil?
end

def app_store_api_key
  key = {
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    set_spaceship_token: true,
  }
  if ENV["APP_STORE_CONNECT_API_KEY_P8"]
    key.merge!(key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"], is_key_content_base64: true)
  else
    key[:key_filepath] = ENV.fetch("KEY_PATH")
  end
  app_store_connect_api_key(**key)
end

# Both stores replace a listing's screenshots with what is staged, so an empty folder would wipe it instead of failing.
def ensure_screenshots_staged(glob)
  staged = Dir.glob(glob)
  UI.user_error!("No staged screenshots matching #{glob}") if staged.empty?
  UI.message("Found #{staged.size} staged screenshot(s)")
end

# Yields `path`, or a temporary copy holding only `locale`'s folder: supply and deliver upload every locale they find.
def with_locale_only(path, locale, &block)
  with_locales_only(path, locale.nil? ? nil : [locale], &block)
end

# The same for several locales' folders; `path` itself when `locales` is nil.
def with_locales_only(path, locales)
  return yield(path) if locales.nil?

  require "tmpdir"
  Dir.mktmpdir("screenshots-") do |dir|
    locales.each do |locale|
      source = File.join(path, locale)
      UI.user_error!("No staged screenshots for #{locale} under #{path}") unless File.directory?(source)
      FileUtils.cp_r(source, File.join(dir, locale))
    end
    yield(dir)
  end
end

# Runs the block again when it fails with an error whose message includes `message`, `attempts` times in all.
def retrying_on(message, attempts:, wait_seconds:)
  attempt = 1
  begin
    yield
  rescue => e
    raise unless e.message.include?(message) && attempt < attempts

    UI.important("#{e.message.lines.first.strip} (attempt #{attempt} of #{attempts}), trying again in #{wait_seconds}s")
    sleep(wait_seconds)
    attempt += 1
    retry
  end
end

# Runs the block and carries on past an error whose message includes `message`; returns whether it did.
def tolerating(message)
  yield
  false
rescue => e
  raise unless e.message.include?(message)

  UI.important("Carrying on past: #{e.message.lines.first.strip}")
  true
end

# Sorts every shelf of the editable version by file name, the shelf order, then checks that each is as it was
# staged. A shelf is one locale's screenshots for one device size.
#
# It removes nothing. An upload can leave a shelf listing one screenshot twice, under two ids with the same file name
# and checksum, so a shelf of ten lists 11. Deleting one of the two ids deletes both: the lane used to remove "the
# later copy" of a file name, and the first set's tidy-up took `08_payers_and_currencies_iphone_6_7.png` off a shelf
# that way (run 44324532909, November 2026; seen in App Store Connect). Such a shelf can still be sorted, with an
# order that names all 11, and is then reported: sending its locale again is what leaves it with ten
# (docs/store-listing-screenshots.md#repairing-shelves).
#
# How to sort and what to report is decided by scripts/store-screenshots/shelves.mjs, which has the tests. Every
# shelf is read again after the sorting and checked: a shelf short of a screen, listing a file twice, or holding one
# that never finished uploading is an error that names the locale, the shelf and the file.
def tidy_app_store_screenshots(platform)
  require "spaceship"

  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform.map(platform.to_sym))
  # The Mac app may have no version open for editing while the iOS one has, or the other way round: nothing to tidy
  if version.nil?
    UI.important("No editable #{platform} App Store version: no screenshots to tidy up there")
    return
  end

  localizations = version.get_app_store_version_localizations
  locales = localizations.map(&:locale)
  sets = localizations.flat_map do |localization|
    localization.get_app_screenshot_sets.map { |set| [localization.locale, set] }
  end
  # The 10 at most that came with the shelf are held against the full read, which must start with them, in their
  # order. Spaceship takes them in the order of the shelf's relationship, the one the full read lists and a reorder
  # replaces, so a read that differs is of another moment, or not the shelf's order, and not one to sort by
  shelves = sets.map { |locale, set| read_app_store_shelf(locale, set, came_with_it: (set.app_screenshots || []).map(&:id)) }
  UI.message("Read #{shelves.size} shelves, #{shelves.sum { |shelf| shelf[:screenshots].size }} screenshots")
  shelves.reject { |shelf| shelf[:isWhole] }.each do |shelf|
    UI.important("#{shelf[:locale]}/#{shelf[:shelf]} could not be read whole, or gave two different answers: left as it is")
  end

  said, planned = app_store_shelves("plan", { locales: locales, shelves: shelves })
  UI.user_error!("shelves.mjs could not plan the tidy-up: #{said}") unless planned
  # The last line: fastlane hands over what the script wrote to both of its outputs, a warning of Node's included
  todo_of = JSON.parse(said.lines.last).fetch("shelves").to_h { |todo| [todo.fetch("id"), todo] }
  sent_an_order = shelves.select do |shelf|
    tidy_app_store_shelf(shelf, todo_of.fetch(shelf[:id]))
  rescue => e
    # Not the end of the lane: the other shelves are sorted, and the check below names this one
    UI.error("Could not sort #{shelf[:locale]}/#{shelf[:shelf]}: #{e.message.lines.first.to_s.strip}")
    true
  end

  # Read again where an order was sent or the first read wasn't whole, so what is checked there is what App Store
  # Connect holds now, not what the lane meant to leave. A shelf nothing was done to is as it was just read
  after = sets.zip(shelves).map do |(locale, set), shelf|
    sent_an_order.include?(shelf) || !shelf[:isWhole] ? read_app_store_shelf(locale, set) : shelf
  end
  said, as_staged = app_store_shelves("check", { locales: locales, shelves: after })
  if as_staged
    UI.success("#{platform}: #{said}")
    return
  end
  # In the log whoever catches the error, since a caller may print only its first line
  UI.error(said)
  UI.user_error!("The #{platform} shelves are not as staged: #{said.lines.first.to_s.strip.delete_suffix(':')}, listed above")
end

# One shelf, as scripts/store-screenshots/shelves.mjs takes it: every screenshot it holds, in shelf order, and
# whether that is known to be all of them.
#
# Not `set.app_screenshots`: that is the relationship App Store Connect includes with the shelf, 10 at most, whatever
# the shelf lists. A shelf listing 11 read through it showed 10 distinct files, and the order sent for those 10 was
# refused every time, since it left one out (run 44324532909, November 2026). Read here through the shelf's own two
# lists, paged: the relationship, which is the order and what a reorder replaces, and the screenshots, for each
# one's file name, state and checksum.
def read_app_store_shelf(locale, set, came_with_it: [])
  shelf = { id: set.id, locale: locale, shelf: set.screenshot_display_type }
  client = Spaceship::ConnectAPI.tunes_request_client
  pages = lambda do |path|
    first = client.get("v1/appScreenshotSets/#{set.id}/#{path}", { limit: APP_STORE_SHELF_PAGE_SIZE })
    first.nil? ? [] : first.all_pages
  end
  linkage = pages.call("relationships/appScreenshots")
  ids = linkage.flat_map { |page| page.body.fetch("data").map { |each| each.fetch("id") } }
  attributes_of = pages.call("appScreenshots").flat_map { |page| page.body.fetch("data") }.to_h { |each| [each.fetch("id"), each.fetch("attributes")] }
  total = linkage.first&.body&.dig("meta", "paging", "total")
  whole = ids.uniq.size == ids.size && ids.sort == attributes_of.keys.sort && (total.nil? || total == ids.size) && ids.first(came_with_it.size) == came_with_it
  screenshots = ids.select { |id| attributes_of.key?(id) }.map do |id|
    {
      id: id,
      fileName: attributes_of[id]["fileName"],
      state: attributes_of[id].dig("assetDeliveryState", "state"),
      checksum: attributes_of[id]["sourceFileChecksum"],
    }
  end
  shelf.merge(isWhole: whole, screenshots: screenshots)
rescue => e
  # One shelf that can't be read doesn't stop the others' tidy-up: it is left as it is, and reported as not whole
  UI.error("Could not read #{locale}/#{set.screenshot_display_type}: #{e.message.lines.first.to_s.strip}")
  shelf.merge(isWhole: false, screenshots: [])
end

# Puts a shelf in the plan's order, which names every screenshot the shelf lists: App Store Connect refuses an order
# that adds or leaves out one. Answers whether an order was sent. Tried once: an order of everything just read is
# only refused for a shelf that changed since, which the check after the tidy-up reads again and names.
def tidy_app_store_shelf(shelf, todo)
  order = todo.fetch("order")
  # Not read whole: nothing is touched, and the check after the tidy-up says so
  return false if order.nil? || order == shelf[:screenshots].map { |screenshot| screenshot[:id] }

  UI.message("Sorting #{shelf[:locale]}/#{shelf[:shelf]}, #{order.size} screenshots")
  Spaceship::ConnectAPI.patch_app_screenshot_set_screenshots(app_screenshot_set_id: shelf[:id], app_screenshot_ids: order)
  true
end

# Runs a command of scripts/store-screenshots/shelves.mjs on what was read of the version: its locales and their
# shelves. Answers what the script said and whether it passed.
def app_store_shelves(command, read)
  require "json"
  require "tempfile"

  repo_root = File.expand_path("..", __dir__)
  Tempfile.create(["app-store-shelves-", ".json"]) do |file|
    file.write(JSON.generate(read))
    file.flush
    passed = true
    said = Dir.chdir(repo_root) do
      sh("node", "scripts/store-screenshots/shelves.mjs", command, file.path, log: false, error_callback: ->(_) { passed = false })
    end
    [said.to_s.strip, passed]
  end
end

# The stable releases (docs/release-process.md#releasing-a-stable-version): the bundle to a Google Play track and the
# uploaded builds to App Store review, each with the version's "What's new" in the languages its listing has.
# release-production.yml runs these lanes; nothing here builds.
PLAY_TRACKS = %w[production beta alpha internal].freeze
# The Wear OS form factor's tracks, by the phone's track they mirror: the API names a form factor's track
# "<prefix>:<default name>", and internal testing's default name is "qa" (developers.google.com/android-publisher/tracks).
# Closed testing has no default: the watch's is the closed track named alpha, as the phone's.
PLAY_FORM_FACTOR_TRACKS = {
  "wear" => { "production" => "wear:production", "beta" => "wear:beta", "alpha" => "wear:alpha", "internal" => "wear:qa" },
}.freeze
# How long App Store Connect may take to process an upload before the build can be selected:
BUILD_PROCESSING_TIMEOUT_SECONDS = 45 * 60
# The states of a version that was submitted already, from waiting for its review to being on the store:
SUBMITTED_STATES = %w[
  WAITING_FOR_REVIEW IN_REVIEW ACCEPTED PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE PROCESSING_FOR_DISTRIBUTION
  READY_FOR_DISTRIBUTION
].freeze
# What Google Play answers to a bundle whose versionCode it already holds:
PLAY_VERSION_CODE_USED_MESSAGE = "has already been used".freeze

desc "Upload a signed AAB to a Google Play track with the version's \"What's new\""
desc "Options: aab (its path, or a pattern that finds it alone); track (production|beta|alpha|internal); rollout (the percentage of the users who get"
desc "it, 1 to 100: a staged rollout, production only); form_factor (wear: the same track of the Wear OS form factor, for the"
desc "watch's bundle; omitted: the phone's); notes (the folder of <language>.txt that release-notes.mjs"
desc "collect --out writes as stores/play); version_code (the bundle's, which lets a retry after a server error"
desc "tell that the release landed). Needs PLAY_STORE_JSON_KEY_PATH."
lane :play_upload do |options|
  repo_root = File.expand_path("..", __dir__)
  track = options.fetch(:track).to_s
  UI.user_error!("track is one of #{PLAY_TRACKS.join(', ')}") unless PLAY_TRACKS.include?(track)
  # Staged or not by the track it mirrors, then sent to the form factor's own
  play_track = track
  form_factor = options[:form_factor].to_s
  unless form_factor.empty?
    tracks = PLAY_FORM_FACTOR_TRACKS.fetch(form_factor) { UI.user_error!("form_factor is one of #{PLAY_FORM_FACTOR_TRACKS.keys.join(', ')}") }
    play_track = tracks.fetch(track)
  end
  percentage = options.fetch(:rollout, 100).to_s
  UI.user_error!("rollout is a percentage of the users, from 1 to 100") unless percentage.match?(/\A\d+\z/) && (1..100).cover?(percentage.to_i)
  # Only production is rolled out in stages: a testing track gets the release whole
  staged = track == "production" && percentage.to_i < 100
  aabs = Dir.glob(File.expand_path(options.fetch(:aab), repo_root))
  UI.user_error!("Expected one AAB at #{options[:aab]}, found #{aabs.size}") unless aabs.size == 1
  json_key = ENV.fetch("PLAY_STORE_JSON_KEY_PATH")
  listed = retrying_on(PLAY_SERVER_ERROR_MESSAGE, attempts: PLAY_SERVER_ERROR_ATTEMPTS, wait_seconds: PLAY_SERVER_ERROR_WAIT_SECONDS) do
    play_listing_locales(json_key)
  end

  with_notes_for(File.expand_path(options.fetch(:notes), repo_root), listed, "changelogs/default.txt") do |changelogs|
    release = staged ? { release_status: "inProgress", rollout: (percentage.to_i / 100.0).to_s } : { release_status: "completed" }
    # supply sends the bundle, the track and the notes through one edit and commits it at the end, so a 5xx throws
    # the edit away and the next attempt starts over: Play holds nothing of a failed one. Unless the 5xx answered a
    # commit that did land: the next attempt is then refused the versionCode. That alone could be another upload's,
    # so it counts as landed only when the track now lists this versionCode.
    attempt = 0
    retrying_on(PLAY_SERVER_ERROR_MESSAGE, attempts: PLAY_SERVER_ERROR_ATTEMPTS, wait_seconds: PLAY_SERVER_ERROR_WAIT_SECONDS) do
      attempt += 1
      begin
        upload_to_play_store(
          package_name: ANDROID_PACKAGE,
          json_key: json_key,
          aab: aabs.first,
          track: play_track,
          **release,
          metadata_path: changelogs,
          skip_upload_changelogs: false,
          # The listing's text and images are not this lane's: upload_listing and the screenshots lanes send them
          skip_upload_apk: true,
          skip_upload_metadata: true,
          skip_upload_images: true,
          skip_upload_screenshots: true,
        )
      rescue => e
        landed = attempt > 1 && e.message.include?(PLAY_VERSION_CODE_USED_MESSAGE) && play_track_has?(play_track, options[:version_code], json_key)
        raise unless landed

        UI.important("The #{play_track} track already lists this versionCode: the attempt Google Play answered with a server error had landed")
      end
    end
  end
end

desc "Make X.Y.Z the editable App Store version, creating it when it doesn't exist yet"
desc "Options: platform (ios|osx); version (X.Y.Z). The release runs it before the screenshots are captured, so App"
desc "Store Connect is done copying the previous version's screenshots into the new one long before the upload"
desc "replaces them (deliver deleting a shelf mid-copy leaves strays it then can't sort)."
lane :app_store_prepare_version do |options|
  app_store_api_key
  platform = app_store_platform(options)
  version = options.fetch(:version).to_s
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  if app.ensure_version!(version, platform: Spaceship::ConnectAPI::Platform.map(platform))
    UI.success("#{version} is now the editable #{platform} App Store version")
  else
    UI.message("#{version} is already the editable #{platform} App Store version")
  end
end

desc "Put the version's \"What's new\" on the App Store version of an uploaded build and send it for review"
desc "Options: platform (ios|osx); version (X.Y.Z); build (the build number, already uploaded); notes (the folder of"
desc "<language>.txt that release-notes.mjs collect --out writes as stores/app-store-ios and -mac); submit:false"
desc "selects the build and writes the text without sending it for review; phased:true releases"
desc "an update over seven days. An approved version goes out by itself. Needs the App Store Connect key, as the"
desc "screenshots lanes."
lane :app_store_submit do |options|
  require "fastlane_core/build_watcher"

  repo_root = File.expand_path("..", __dir__)
  api_key = app_store_api_key
  platform = app_store_platform(options)
  connect_platform = Spaceship::ConnectAPI::Platform.map(platform)
  version = options.fetch(:version).to_s
  build = options.fetch(:build).to_s
  submit = options.fetch(:submit, true).to_s == "true"
  phased = options.fetch(:phased, false).to_s == "true"
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)

  # A re-run after the submission landed: App Store Connect refuses a second one, and nothing is left to do. Looked up
  # by its number, since a version Apple has started to review is no longer the editable one. With another build
  # on it, this run's was never submitted, and saying nothing would record it as sent.
  submitted = app.get_app_store_versions(filter: { versionString: version, platform: connect_platform })
                 .find { |each| SUBMITTED_STATES.include?(each.app_version_state) }
  if submit && submitted
    state = submitted.app_version_state.downcase.tr("_", " ")
    on_it = submitted.build&.version
    if on_it && on_it != build
      UI.user_error!("#{version} (#{platform}) is already #{state} with build #{on_it}: build #{build} was not submitted. Remove that submission in App Store Connect to send this one")
    end
    UI.important("#{version} (#{platform}) is already #{state}: nothing to submit")
    next
  end

  # A build App Store Connect is still processing can't be selected, and deliver only waits for one it uploaded itself
  FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
    app_id: app.id,
    platform: connect_platform,
    app_version: version,
    build_version: build,
    poll_interval: 30,
    timeout_duration: BUILD_PROCESSING_TIMEOUT_SECONDS,
    return_when_build_appears: false,
    return_spaceship_testflight_build: false,
    select_latest: false,
  )

  app.ensure_version!(version, platform: connect_platform)
  localizations = app.get_edit_app_store_version(platform: connect_platform).get_app_store_version_localizations
  if submit
    # deliver deletes a locale's screenshots before it uploads the new ones, so an upload that failed halfway can
    # leave a locale with none. The App Store then shows the primary language's there (a language added to a
    # listing starts with them), so only the primary one with none stops the submission: run again once they are up
    bare = localizations.reject { |localization| localization.get_app_screenshot_sets.any? { |set| set.app_screenshots.any? } }.map(&:locale)
    UI.user_error!("No screenshots for #{app.primary_locale}, the primary language, on #{version} (#{platform}): upload them, then run this again") if bare.include?(app.primary_locale)
    if bare.any?
      message = "No screenshots of their own, so the App Store shows #{app.primary_locale}'s: #{bare.join(', ')}"
      UI.important(message)
      # A release leaves the screenshots alone unless it is asked to make them, so a language the listing gained
      # since the last time shows up here: said on the run's page, where someone reads it, not only in this log
      github_warning("Locales without screenshots on #{version} (#{platform})", "#{message}. A release with screenshots on uploads theirs")
    end
  end
  # Not an update while the platform has no version on the store, whatever versions were made and never released:
  # there is nothing to phase, and App Store Connect refuses a phased release then
  never_released = app.get_live_app_store_version(platform: connect_platform).nil?

  with_notes_for(File.expand_path(options.fetch(:notes), repo_root), localizations.map(&:locale), "release_notes.txt") do |metadata|
    # The copyright line, which carries the current year: a version starts with the one before it's, so a release
    # is what moves the year on. Beside the locales' folders, where deliver reads it (docs/store-listing.md)
    copyright = Dir.chdir(repo_root) { sh("node", "scripts/release/store-listing.mjs", "copyright", log: false) }.strip
    UI.user_error!("store-listing.mjs printed no copyright line") if copyright.empty?
    File.write(File.join(metadata, "copyright.txt"), copyright)
    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      platform: platform,
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      skip_screenshots: true,
      # Only release_notes.txt and the copyright line are there, so the rest of the listing stays as App Store Connect has it; deliver
      # leaves the text out by itself on an app's first version, which has no "What's new"
      skip_metadata: false,
      metadata_path: metadata,
      submit_for_review: submit,
      automatic_release: true,
      **(never_released ? {} : { phased_release: phased }),
      # Its findings would skip the submission without failing the lane; Apple's review is the check
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end

# An annotation on the run's page. Nothing outside GitHub Actions, where the line would only be noise. A workflow
# command reads a colon or a comma in the title as its own, and takes the message up to the end of the line. Written
# to the standard output itself: a Fastfile's `puts` is fastlane's, which starts the line with the time, and the
# runner only reads a command that starts its line.
def github_warning(title, message)
  return unless ENV["GITHUB_ACTIONS"] == "true"

  escaped = ->(text) { text.gsub("%", "%25").gsub("\r", "%0D").gsub("\n", "%0A") }
  $stdout.puts("::warning title=#{escaped.call(title).gsub(":", "%3A").gsub(",", "%2C")}::#{escaped.call(message)}")
  $stdout.flush
end

def app_store_platform(options)
  platform = options.fetch(:platform).to_s
  UI.user_error!("platform is ios or osx") unless %w[ios osx].include?(platform)
  platform
end

# The languages the Play listing has. Read with the key the upload uses, so a failure here is one the upload would
# meet too.
def play_listing_locales(json_key)
  require "supply"

  client = Supply::Client.make_from_config(params: { json_key: json_key, timeout: 300 })
  client.begin_edit(package_name: ANDROID_PACKAGE)
  locales = client.listings.map(&:language)
  # A leftover edit expires on its own, so failing to delete it must not throw the answer away
  begin
    client.abort_current_edit
  rescue => e
    UI.error("Could not delete the Play edit used to read the listing: #{e.message}")
  end
  locales
end

# Whether a Play track lists a versionCode among its releases; false when the lane wasn't told the versionCode.
def play_track_has?(track, version_code, json_key)
  return false if version_code.to_s.empty?

  google_play_track_version_codes(package_name: ANDROID_PACKAGE, track: track, json_key: json_key).include?(version_code.to_s.to_i)
end

# Yields a folder with the version's notes for each locale the store's listing has (`listed`), each in the file the
# store's tool reads (`file`: changelogs/default.txt for supply, which takes it for a versionCode with no file of its
# own, and release_notes.txt for deliver). `notes` holds them by the notes' language, <language>.txt. A locale reads
# the file of its own name (pt-PT), else its language's (pt-BR reads pt, es-419 and es-MX read es, en-GB reads en),
# else English's: the App Store refuses to review a version with a locale whose "What's new" is empty. Only the
# listing's locales are written, since a store refuses a language its listing doesn't have or, on the App Store,
# opens an empty listing for it.
def with_notes_for(notes, listed, file)
  require "tmpdir"

  langs = Dir.glob(File.join(notes, "*.txt")).map { |path| File.basename(path, ".txt") }
  UI.user_error!("No release notes in English under #{notes}") unless langs.include?("en")
  Dir.mktmpdir("release-notes-") do |dir|
    listed.each do |locale|
      lang = [locale, locale.split("-").first, "en"].find { |each| langs.include?(each) }
      UI.message("#{locale} gets the notes in #{lang}")
      target = File.join(dir, locale, file)
      FileUtils.mkdir_p(File.dirname(target))
      FileUtils.cp(File.join(notes, "#{lang}.txt"), target)
    end
    yield(dir)
  end
end
